+/* ==========================================================================
+   Telefon (≤ 760 px): wygląd wariantu „Portal”
+   Na komputerze i tablecie (≥ 761 px) strona wygląda dokładnie tak jak bez tego pliku — każda reguła poniżej
+   (poza .tylko-telefon) siedzi w @media (max-width: 760px).
+   Wartości są przeniesione z wariantu „Portal” (gałąź wariant-portal: global.css i tlo.css; tam obowiązują
+   na każdej szerokości). Plik ładuje się po global.css i tlo.css, więc reguły z węższych progów tamtych plików
+   (720, 560 px), które nadpisywały te same właściwości, są tu powtórzone niżej — inaczej przegrałyby kolejnością.
+   Klocki wariantu (.pt-box, .pt-list, …) są w portal.css; na tej gałęzi używają ich tylko bloki .tylko-telefon.
+   PO PORZĄDKACH (zlecenie 12, 5.11.2026): telefon ma nowy wygląd (src/styles/zal-telefon.css i końce plików bloków).
+   Tu zostały tylko reguły dawnego telefonu, które nadal trafiają w elementy (nagłówek .hdr z Naglowek.astro,
+   tokeny kolorów, odstępy treści); bloki .tylko-telefon / .tylko-komputer i ich przełączanie usunięte.
+   ========================================================================== */
+
+/* ---------- bloki tylko na jeden rodzaj ekranu ----------
+   Gdy telefonowy układ wymaga innych znaczników (inna kolejność lub liczba pozycji), strona ma oba bloki:
+   .tylko-komputer (dotychczasowy) i .tylko-telefon (portalowy, z data-pagefind-ignore, bez powtórzonych id). */
+
+@media (max-width: 760px) {
+  /* ---------- podstawy ---------- */
+  :root { --section: clamp(22px, 2.8vw, 34px); --hdr-h: 61px; }
+  body { font-size: 16px; line-height: 1.55; }
+  .btn { min-height: 44px; padding: 0 18px; }
+
+  /* ---------- nagłówek ---------- */
+  .hdr-row { min-height: 60px; }
+  .brand-logo { height: 36px; }
+  /* +40 px = miejsce po logotypie UWr nad tytułem (30 px + odstęp 10 px) — tytuł zostaje tam, gdzie był, nie klei się do nagłówka */
+  .js .hdr-foto ~ main .hero-in { padding-top: calc(var(--hdr-h) + 62px); }
+
+  /* ---------- wydarzenia i seminaria ---------- */
+  .event { gap: 14px; padding: 14px; }
+
+  /* ---------- studia (strona główna) ---------- */
+  .prog .l { font-size: 12px; }
+  .prog .n { font-size: 17px; }
+  .prog .o { font-size: 14px; }
+
+  /* ---------- stopka ---------- */
+  .ftr-main .n { font-size: 18px; }
+
+  /* ---------- podstrony ---------- */
+  .page-head .wrap { padding-top: clamp(16px, 2.2vw, 26px); padding-bottom: clamp(16px, 2.2vw, 24px); gap: 8px; }
+  .page-head h1 { font-size: clamp(28px, 3.4vw, 42px); }
+  .page-head .lead { max-width: 820px; font-size: 16px; line-height: 1.55; }
+  .side-box { gap: 8px; padding: 14px 16px; }
+  .side-box h2 { font-size: 18px; }
+  .side-box .event { padding: 10px; gap: 12px; border-radius: 12px; }
+
+  /* treść artykułów i stron */
+  .prose { max-width: 800px; font-size: 16px; line-height: 1.65; }
+  .prose h2 { margin: 1.4em 0 .45em; font-size: 21px; }
+  .prose h3 { margin: 1.2em 0 .35em; font-size: 18px; }
+  .prose p, .prose ul, .prose ol { margin: 0 0 .8em; }
+  .prose table { margin: .8em 0 1.1em; font-size: 15px; }
+  .prose th, .prose td { padding: 6px 10px; }
+  .prose blockquote { margin: 1em 0; padding: 10px 16px; font-size: 16px; }
+
+  /* listy wpisów — rytm wiersza (decyzja 31.10.2026): Aktualności, Kalendarz, obrony, konferencje, sukcesy (wszystko z .row-item;
+     siatka .wa-row — WierszAktualnosci.astro). 18 px odstępu nad i pod treścią wiersza i między kolumnami (column-gap —
+     w siatce .wa-row samo gap ustawiłoby też odstęp między jej wierszami); tytuł 17,5 px / 1,3 (!important — widoki dają
+     tytułom własny rozmiar w atrybucie style albo w stylach widoku); opis 15 px / 1,55 w kolorze --muted, najwyżej 2 linie;
+     miniatura 76 × 76 px z zaokrągleniem 14 px (tam, gdzie jest widoczna — ≤ 560 px zwykłe listy chowają miniatury, global.css). */
+  .month { margin: 14px 0 2px; }
+  .row-item .body { gap: 3px; }
+  .row-item .t { font-size: 17.5px !important; line-height: 1.3; }
+  .row-item .x { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden;
+    font-size: 15px; line-height: 1.55; color: var(--muted); }
+  /* Jasne kafelki dat — tylko jasny motyw (decyzja 31.10.2026): tło #eef2f9 z cienką ramką, dzień i miesiąc w granacie zamiast
+     pełnego granatowego kwadratu. .datebox (Kalendarz, obrony, konferencje, wydarzenia, wpis) i .pt-dbox (konferencje
+     na „Nauce”). Minione (szare) bez zmian; ciemny motyw — token --znacznik (blok „Znaczniki i etykiety” niżej). */
+  :root:not([data-theme='dark']) :is(.datebox, .pt-dbox):not(.minione) { border: 1px solid var(--line); background: #eef2f9; color: var(--primary); }
+  .files { gap: 6px; }
+  .files a { gap: 10px; min-height: 44px; padding: 8px 14px; border-radius: 10px; font-size: 15px; }
+
+  /* seminaria */
+  .sem-card .t { font-size: 18px; }
+  article.talk { padding: 12px 0; }
+  .talk h3 { margin: 4px 0 2px; font-size: 17px; }
+  .article-head .lead { font-size: 17px; }
+
+  /* granty */
+  .grant { padding: 10px 0; }
+  .grant h3 { margin: 4px 0 2px; font-size: 16px; }
+
+  /* zakłady, liczby, osoby */
+  .stat .n { font-size: 26px; }
+  .dept .t { font-size: 17px; }
+  .people { grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 6px; }
+  .person { gap: 1px; padding: 9px 12px; }
+
+  /* kierunek studiów */
+  .entry { gap: 12px; padding: 10px 14px; border-radius: var(--radius); }
+  .entry strong { font-size: 16px; }
+  .faq summary { min-height: 44px; font-size: 15px; }
+
+  /* Lżejsze podkreślenia (decyzja 31.10.2026): linki w treści, listach i banerze — kreska 1 px w 40% koloru tekstu, 3 px od liter
+     (gdzie link jest podkreślony; przyciski bez zmian). Spis pracowników niżej: zakład zwykłym szarym tekstem (nadal link), e-mail z cienką jasną kreską. */
+  main a:not(.btn) { text-decoration-thickness: 1px; text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); text-underline-offset: 3px; }
+  /* zakład bez podkreślenia; e-mail jako całość przechodzi do nowej linii, zanim się złamie — w środku tylko w miejscu
+     łącznika, w dowolnym miejscu dopiero w ostateczności (break-word zamiast anywhere z .staff-row; decyzja 31.10.2026) */
+  .staff-row .n small a { text-decoration: none; }
+  .staff-row .c { min-width: 0; }
+  .staff-row .n { flex: 1 1 100%; margin-bottom: 0; }
+  .staff-row .n small { font-weight: 400; line-height: 1.4; }
+
+  /* ---------- tlo.css: nagłówki podstron (pas) ---------- */
+  .ph .wrap { min-height: 0; padding-top: 12px; padding-bottom: 18px; }
+  .js .hdr-foto ~ main > .ph:first-child > .wrap { min-height: 0; padding-top: calc(12px + var(--hdr-h)); }
+  .ph h1 { font-size: clamp(28px, 3.4vw, 42px); }
+  /* długi tytuł (> 20 znaków, klasa .ph-dlugi z NaglowekStrony.astro; decyzja 31.10.2026): 27 px zamiast 28 px (tyle daje
+     clamp wyżej na każdej szerokości ≤ 760 px); rysunek działu bez zmian */
+  .ph.ph-dlugi h1 { font-size: 27px; }
+  /* Oddech pod banerem (decyzja 31.10.2026): pierwszy element treści zawsze 26 px pod dolną krawędzią pasa — jedna reguła
+     dla każdego kontenera pod pasem (.dz-wrap, .ls-wrap, .lz-wrap, .pr-wrap, .layout, .kal-wrap, .kier…); !important, bo
+     widoki ustawiają ten odstęp w swoich stylach (o większej wadze) albo w atrybucie style. */
+  main > .ph + .wrap { padding-top: 26px !important; }
+  .ph-zdjecie.ph-z-foto .ph-m, .ph-granat.ph-z-foto .ph-m { height: 120px; width: 70%; opacity: .7; }
+  /* Hasło działu zamiast opisu (NaglowekStrony.astro: .ph-haslo.tylko-telefon, opis dostaje wtedy .tylko-komputer;
+     decyzja 31.10.2026): jedno krótkie zdanie, bursztynowe na granatowym pasie (--accent = #f2a33a w .ph-granat),
+     bez kreski pod spodem. Na jasnym pasie (inne warianty) — kolor tytułu, bo bursztyn na jasnym tle byłby nieczytelny.
+     Odstęp do kreski nad liczbami działu: 8 px więcej niż pod zwykłym opisem. */
+  .ph-haslo ~ .pt-liczby { margin-top: 10px; }
+  /* baner z samym hasłem, bez kreski i liczb (Władze, Plan zajęć, Szukaj…; zlecenie 01): 4 px oddechu pod hasłem jak w prototypie */
+  .ph .wrap:not(:has(> .pt-liczby:not(.tylko-komputer))) > .ph-haslo { padding-bottom: 4px; }
+  /* Animacja w tle banera (src/scripts/baner/silnik.ts, motyw z data-animacja; zlecenie 02, decyzje 31.10.2026): płótna
+     .ph-anim na całą szerokość pasa, pod tekstem; po pierwszej klatce pas dostaje .ph-anim-gra — płótna łagodnie się
+     pojawiają, a statyczny rysunek .ph-m gaśnie. Kolor rysunku: token --ph-rysunek (składowe RGB, krycie daje motyw) —
+     szaro-biały, słabo widoczny (wzór: Lorenz v3). */
+  .ph { --ph-rysunek: 27, 45, 82; }
+  .ph-granat { --ph-rysunek: 255, 255, 255; }
+  :root[data-theme='dark'] .ph { --ph-rysunek: 210, 222, 240; }
+  .ph-anim { position: absolute; left: 0; z-index: -1; pointer-events: none; opacity: 0; transition: opacity .8s ease; }
+  .ph-anim-gra .ph-anim { opacity: 1; }
+  .ph.ph-anim-gra .ph-m { opacity: 0; }
+
+  /* ---------- tlo.css: sekcje ---------- */
+  body[data-sekcje='pasy'] .wrap > .zsec { padding: clamp(16px, 2.2vw, 26px) 0; }
+  body[data-sekcje='pasy'] .main .zsec { padding: 16px 0; }
+  body[data-sekcje='pasy'] .prose h2 { margin: 1.4em 0 .55em; padding: .3em .7em .3em .85em; }
+  body[data-sekcje='pasy'] .prose > h2:first-child { margin-top: 0; }
+  body[data-sekcje='linia'] .prose h2 { margin-top: 1.6em; padding-top: 14px; }
+}
+
+/* ---------- Znaczniki i etykiety (decyzja 31.10.2026: ciemny motyw A1 „stalowy granat”, etykiety B1) ----------
+   Na razie tylko telefon. Reguły, które używają tokenów --znacznik*, są w global.css i portal.css (z zapasem
+   var(--znacznik, var(--primary)) — bez tokenu jak dotąd); tu tylko wartości tokenów i reguły etykiet B1.
+   Rozszerzenie na komputer: definicje tokenów przenieść do global.css (:root i :root[data-theme='dark']),
+   a reguły etykiet B1 — wyjąć z @media. */
+@media (max-width: 760px) {
+  /* A1. Znacznik: kafelek daty (.datebox, .pt-dbox), etykieta „Wydarzenie”, aktywny filtr (.chip[aria-pressed]),
+     przycisk menu (.burger). Jasny motyw: ten sam granat co --primary (nic się nie zmienia). Ciemny motyw: stalowy
+     granat zamiast bursztynu, miesiąc na kafelku bursztynowy; tekstowe akcenty (.pt-k, .pt-all, .link-arrow, .event .k,
+     .sem-row .sem, .talk summary, .more summary) jasnoniebieskie; tekst na jasnym tle --tint jasnoszary zamiast bursztynu.
+     Granatowy baner (.ph-granat, oba motywy): aktywny filtr biały z granatowym tekstem.
+     Bursztyn zostaje: hasło, rysunek w banerze, miesiąc na kafelku, kreski sekcji, linki w treści, przyciski .btn-primary. */
+  :root { --znacznik: #1b2d52; --znacznik-ink: #ffffff; }
+  :root[data-theme='dark'] { --znacznik: #2b4170; --znacznik-ink: #f1f4fa; --znacznik-tekst: #a9c0e8; --znacznik-miesiac: #f2a33a; }
+  :root[data-theme='dark'] { --tint-ink: #d3dcea; }
+  .ph-granat { --znacznik: #ffffff; --znacznik-ink: #1b2d52; }
+
+  /* B1. Etykiety w wierszach list (.news-meta .badge: Aktualności, Kalendarz, wpis, konferencje, projekty…) — jedna
+     rodzina: lekko zaokrąglony prostokąt (6 px, nie pastylka — etykieta nie udaje przycisku filtra), jeden rozmiar,
+     rodzaj rozróżnia odcień „mgiełki”: szara (domyślna: Seminarium, Ogłoszenie, Kariera, Termin, odwołana…), granatowa
+     (Wydarzenie), bursztynowa z ciemnym tekstem (Sukces, Konferencja), mocniejsza granatowa z biretem (Obrona doktorska;
+     ikonka — EtykietaRodzaju.astro). Odbiorcy (studenci, doktoranci…) to zwykły szary tekst — WierszAktualnosci.astro
+     (kolor --et-dla). */
+  :root {
+    --et-promien: 6px;
+    --et-szary-tlo: #eceef2; --et-szary: #4a5466;
+    --et-granat-tlo: #dce6f7; --et-granat: #18305f;
+    --et-burs-tlo: #fcebd2; --et-burs: #6b3f05;
+    --et-obrona-tlo: #c3d2ee; --et-obrona: #0f2552;
+    --et-dla: #5b6577;
+  }
+  :root[data-theme='dark'] {
+    --et-szary-tlo: rgb(255 255 255 / .065); --et-szary: #aab5c7;
+    --et-granat-tlo: rgb(110 150 230 / .26); --et-granat: #d3e1fb;
+    --et-burs-tlo: rgb(242 163 58 / .16); --et-burs: #f6c47a;
+    --et-obrona-tlo: rgb(120 160 235 / .42); --et-obrona: #eef3ff;
+    --et-dla: #9da9be;
+  }
+  .news-meta .badge { padding: 1px 8px; border-radius: var(--et-promien); font-size: 12.5px; font-weight: 700; line-height: 1.5; letter-spacing: 0;
+    background: var(--et-szary-tlo); color: var(--et-szary); box-shadow: none; }
+  .news-meta .badge-wydarzenie { background: var(--et-granat-tlo); color: var(--et-granat); }
+  .news-meta :is(.badge-sukces, .badge-konferencja) { background: var(--et-burs-tlo); color: var(--et-burs); }
+  .news-meta .badge > .et-ikona { display: block; }
+}
+
+/* ---------- Wiersz filtrów list (decyzja 31.10.2026; Aktualności i Kalendarz — FiltrISzukaj.astro) ---------- */
+@media (max-width: 760px) {
+  /* Z lewej lista rozwijana rodzajów
+     (ok. 42% szerokości; szersza, gdy najdłuższa nazwa się nie mieści — np. „Announcements” po angielsku albo „Wydarzenia”
+     przy 360 px), z prawej pole szukania z krótką podpowiedzią; obie 44 px wysokości, zaokrąglone jak pole szukania.
+     Czcionka listy 16 px — mniejsza powoduje powiększanie strony na iPhonie. Przyciski rodzajów (komputer) mają
+     .tylko-komputer. Strzałka listy to ikona „dol”. */
+  .filters.filters-lewo { flex-wrap: nowrap; gap: 8px; }
+  .fl-rodzaj .ico { position: absolute; top: 50%; right: 12px; translate: 0 -50%; pointer-events: none; }
+  .fl-szukaj .search { flex: 1 1 auto; min-width: 0; height: 44px; }
+}
+
+/* węższe progi z global.css — powtórzone, bo reguły wyżej przyszły później */
+@media (max-width: 720px) {
+  /* tytuł zaczyna się tuż nad dolnym brzegiem zdjęcia, na przejściu w granat (+40 px po logotypie UWr, jak wyżej) */
+  .js .hdr-foto ~ main .hero-in { padding-top: calc(var(--hdr-h) + 148px); }
+}
+@media (max-width: 560px) {
+  .brand-logo { height: 38px; }
+}
+
+/* ---------- Strona główna B2: zwijany baner ze zdjęciem (zlecenie 06; decyzja 31.10.2026, 23:36) ----------
+   Wzór kodu i wartości: .przekazanie/prototypy/strona-glowna-b2/b2.html (makieta ma nagłówek 64 px, tu --hdr-h = 61 px).
+   Baner (.hero-b2, StronaGlowna.astro) zajmuje cały pierwszy ekran (100svh): zdjęcie budynku od 107 px w dół (dół wychodzi
+   poza ekran), u dołu tytuł, bursztynowe hasło i podtytuł na ciemnej otoczce, pod nimi przycisk „Na skróty i wydarzenia”.
+   Z JS baner jest przyklejony (sticky) z top = pas − 100svh, więc po przewinięciu zostaje z niego pas o wysokości
+   nagłówka + 36 px (--pas) z samym hasłem — to robi samo CSS, aż do końca treści (przy stopce pas odjeżdża z treścią).
+   Skrypt ustawia tylko postęp zwijania --p (0 = zdjęcie, 1 = pas) i przesunięcie zdjęcia --przes (paralaksa), a przy
+   p > .25 / p > .8 klasy .hero-dalej-ukryty i .hdr-zwiniety. Bez JS: zwykły blok 100svh pod zwykłym nagłówkiem.
+   Kolejność warstw w banerze: zdjęcie (.hero-fig, z −1) z przyciemnieniem u góry (::before) i ciemnieniem przy zwijaniu
+   (::after), nad nim tekst z otoczką (.hero-txt::before), mały napis w pasie, przycisk i podpis zdjęcia. Komputer bez zmian. */
+@media (max-width: 760px) {
+  :root { --pas: calc(var(--hdr-h) + 36px); }
+  /* kotwice i fokus nie chowają się pod pasem */
+  :root.js:has(.hero-b2) { scroll-padding-top: calc(var(--pas) + 8px); }
+
+  /* --scrim: kolor otoczki tekstu, przycisku i przyciemnienia u góry; --zwin: ciemnienie całego banera przy zwijaniu */
+  .js .hero.hero-b2 { position: sticky; top: calc(var(--pas) - 100vh); top: calc(var(--pas) - 100svh); }
+  /* zamiast dzisiejszych gradientów komputera: przyciemnienie u góry (124 px, pod napisami nagłówka) i ciemnienie całego
+     banera przy zwijaniu; podpis komputera (figcaption) wyłączony — telefon ma własny (.hero-podpis, pole podpis_telefon) */
+  .js .hdr-foto ~ main .hero-b2 .hero-fig::after { content: ''; position: absolute; inset: 0; z-index: 1; height: auto; pointer-events: none;
+    background: var(--zwin); opacity: clamp(0, calc((var(--p, 0) - .35) * 1.6), 1); }
+
+  /* ruch przy załadowaniu: wejście tytułu, hasła i podtytułu (10 px w górę) i dwa podskoki strzałki przycisku —
+     tylko gdy użytkownik nie prosi o ograniczenie ruchu */
+  @media (prefers-reduced-motion: no-preference) {
+    .hero-dalej .ico { animation: hero-b2-podskok 1.4s 1.4s 2 ease-in-out; }
+  }
+  /* .01 zamiast 0 — jak w przejscia.css (inaczej Chrome liczy LCP dopiero po końcu animacji) */
+  @keyframes hero-b2-wejscie { from { opacity: .01; transform: translateY(10px); } }
+  @keyframes hero-b2-podskok { 0%, 100% { transform: none; } 50% { transform: translateY(5px); } }
+
+  /* Nagłówek strony głównej (.hdr-glowna) — przez cały czas ciemny, półprzezroczysty i rozmyty (na zdjęciu i nad pasem);
+     dzisiejsze bielenie po przewinięciu (.przewiniety) i animacja hero-hdr wyłączone. Na zdjęciu bez dolnej linii
+     i bez nazwy Instytutu; po zwinięciu banera (.hdr-zwiniety, p > .8) — cienka linia i nazwa jak na podstronach. Logo,
+     lupa, motyw i menu białe. Przy stopce (.hdr-stopka) i z otwartym menu (.menu-otwarte) — jak dotąd. */
+  .js .hdr.hdr-glowna.hdr-foto { animation: none; }
+  .js .hdr.hdr-glowna:not(.hdr-stopka):not(.menu-otwarte) { background: rgb(10 18 38 / .58); -webkit-backdrop-filter: blur(10px) saturate(1.15); backdrop-filter: blur(10px) saturate(1.15);
+    border-bottom-color: transparent; box-shadow: none; }
+  .js .hdr.hdr-glowna.hdr-zwiniety:not(.hdr-stopka):not(.menu-otwarte) { box-shadow: 0 1px 0 rgb(255 255 255 / .06); }
+  .js .hdr.hdr-glowna:not(.menu-otwarte) :is(.brand-name, .icon-btn:not(.burger)) { color: #fff; }
+  .js .hdr.hdr-glowna:not(.menu-otwarte) .brand-sub { color: rgb(255 255 255 / .82); }
+  .js .hdr.hdr-glowna:not(.menu-otwarte) .brand-logo { background: #fff; }
+  .js .hdr.hdr-glowna:not(.menu-otwarte) .icon-btn:not(.burger):hover { background: rgb(255 255 255 / .16); color: #fff; }
+  .hdr-glowna .brand-txt { transition: opacity var(--t-sredni) var(--rytm), transform var(--t-sredni) var(--rytm), visibility 0s; }
+  .js .hdr-glowna:not(.hdr-zwiniety) .brand-txt { opacity: 0; transform: translateY(4px); visibility: hidden; transition: opacity var(--t-sredni) var(--rytm), transform var(--t-sredni) var(--rytm), visibility 0s linear var(--t-sredni); }
+}
