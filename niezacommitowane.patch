-/* ---------- Karty na komputerze (≥ 761 px): białe tło strony zamiast szarego --surface ----------
-   Większość kart (.tile, .stat, .side-box, .event-box, .why, .person, .dz-card, .cz …) jest biała dzięki tłu strony
-   (tlo.css, „Kafelki wypełnione kolorem --surface”). Tu karty, których tamta reguła nie obejmuje: kierunki (.prog)
-   i konferencje na liście (.event-szare); karty z własnym szarym tłem w stylach widoków (.gr-karta, .cz, .dz-card,
-   konferencje na „Nauce”) — tam, w @media (min-width: 761px).
-   Szare zostają: podświetlenia po najechaniu, menu, wyszukiwarka, nagłówki tabel, weekendy w kalendarzu, liczniki,
-   notki i nieaktywne specjalności (.spec-off). Telefon (≤ 760 px) bez zmian — wygląd „Portal”. */
+/* ==========================================================================
+   Instytut Matematyczny UWr — style strony
+   Wszystkie kolory, odstępy i zaokrąglenia są tokenami poniżej.
+   Zmiana palety = zmiana wartości w :root (jasny) i [data-theme="dark"] (ciemny).
+   PO PORZĄDKACH (zlecenie 12, 5.11.2026): usunięte reguły, które nie trafiały w żaden element żadnej strony (dawne menu
+   komputera, baner strony głównej, karty, kafelki…); zostały podstawy (tokeny, typografia, .wrap, .prose, .sr-only…)
+   i reguły jeszcze używane przez nowy wygląd.
+   ========================================================================== */
+
+:root {
+  /* jeden rytm ruchu na całej stronie (zlecenie 13, punkt 9): krzywa i czasy przejść 0,15–0,35 s; dłuższe ruchy (szkic,
+     ciekawostka, barwienie okładki, przejazd) mają własne czasy z wcześniejszych zleceń, ale tę samą krzywą tam, gdzie to ruch */
+  --rytm: cubic-bezier(.22, .8, .2, 1);
+  --t-krotki: .15s;
+  --t-sredni: .25s;
+  --t-dlugi: .35s;
+  --uwr: #05649c;
+  /* paleta „zmierzch” (granat + bursztyn) */
+  --bg: #ffffff;
+  --surface: #f2f5fb;
+  --ink: #111a2e;
+  --text: #1e293b;
+  --muted: #475569;
+  --line: #dce3ee;
+  --primary: #1b2d52;
+  --primary-ink: #ffffff;
+  --accent: #f2a33a;
+  --accent-ink: #1b2d52;
+  --tint: #e8edf5;
+  --tint-ink: #1b2d52;
+  --minione-tlo: #e5e8ed;
+  --minione-tekst: #5b6577;
+  --photo: #d9e1ee;
+  --footer-bg: #111a2e;
+  --footer-text: #ffffff;
+  --footer-muted: #b9c2d3;
+  --footer-line: rgba(255, 255, 255, 0.16);
+  --shadow: 0 12px 32px rgba(11, 27, 58, 0.1);
+
+  --font: 'Manrope Variable', 'Manrope zast', 'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif;
+  --radius-s: 10px;
+  --radius: 16px;
+  --radius-l: 20px;
+  --wrap: 1280px;
+  --gutter: clamp(16px, 4vw, 40px);
+  --section: clamp(40px, 6vw, 64px);
+  color-scheme: light;
+}
+
+:root[data-theme='dark'] {
+  --uwr: #d9e6f2;
+  --bg: #0a1020;
+  --surface: #111a2e;
+  --ink: #ecf0f7;
+  --text: #d6ddea;
+  --muted: #9da9be;
+  --line: #243049;
+  --primary: #f2a33a;
+  --primary-ink: #101828;
+  --accent: #f2a33a;
+  --accent-ink: #101828;
+  --tint: #1c2740;
+  --tint-ink: #f6c47a;
+  --minione-tlo: #232a38;
+  --minione-tekst: #8e99ad;
+  --photo: #1a2440;
+  --footer-bg: #060b16;
+  --footer-text: #ecf0f7;
+  --footer-muted: #a6b2c5;
+  --footer-line: #1e2a42;
+  --shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
+  color-scheme: dark;
+}
+/* Znaczniki i etykiety (decyzja 31.10.2026; na razie tylko telefon): kafelki dat, etykieta „Wydarzenie”, aktywne filtry
+   i przycisk menu biorą kolor z tokenu --znacznik (--znacznik-ink — tekst na nim), tekstowe akcenty w ciemnym motywie
+   (.link-arrow, .pt-k, .pt-all…) — z --znacznik-tekst, miesiąc na kafelku daty — z --znacznik-miesiac; etykiety
+   w wierszach list (.news-meta .badge) — z tokenów --et-*. Reguły niżej mają zapas: var(--znacznik, var(--primary)) itd.,
+   więc bez tokenów wszystko wygląda jak dotąd. Tokeny są zdefiniowane w telefon.css (@media (max-width: 760px), blok
+   „Znaczniki i etykiety”) — żeby objąć komputer, wystarczy przenieść tamte definicje tutaj (i reguły etykiet B1). */
+
+/* ---------- podstawy ---------- */
+*, *::before, *::after { box-sizing: border-box; }
+html { -webkit-text-size-adjust: 100%; }
+/* stopka zawsze na dole okna, także na krótkich stronach (np. pusty kalendarz): body jako kolumna, <main> wypełnia resztę */
+body {
+  display: flex;
+  flex-direction: column;
+  min-height: 100vh;
+  min-height: 100svh;
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font-family: var(--font);
+  font-size: 17px;
+  line-height: 1.6;
+  -webkit-font-smoothing: antialiased;
+}
+img { max-width: 100%; height: auto; }
+/* zdjęcia z astro:assets (src/components/ZdjecieZ.astro; zlecenie 13, punkt 6): <picture> nie tworzy własnego pudełka, więc
+   style dla img działają jak dotąd; pełne zdjęcie łagodnie wchodzi na malutką rozmytą wersję (tylko z JS) */
+picture.z-obraz { display: contents; }
+/* <source> bez pudełka — inaczej w siatce (np. wiersz z miniaturą) zajmowałby komórkę zamiast zdjęcia */
+picture.z-obraz > source { display: none; }
+html.js img.z-pelne:not(.z-wczytane) { opacity: 0; }
+img.z-pelne { transition: opacity var(--t-dlugi) var(--rytm); }
+@media (prefers-reduced-motion: reduce) { img.z-pelne { transition: none; } }
+a { color: var(--ink); }
+a:hover { color: var(--primary); }
+:root[data-theme='dark'] a:hover { color: var(--accent); }
+:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
+/* wciśnięcie (zlecenie 13, punkt 10): link i przycisk przygasają od razu, bez przejścia — myszą i palcem. Na dotyku zamiast
+   szarego prostokąta przeglądarki; Safari na iOS zgłasza :active po dotknięciu dzięki pustemu touchstart (Baza.astro). */
+html { -webkit-tap-highlight-color: transparent; }
+:where(a[href], button:not(:disabled), summary, [role="button"], label[for]):active { opacity: .72; transition: none; }
+h1, h2, h3, h4 { color: var(--ink); line-height: 1.2; letter-spacing: -0.01em; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
+/* link poza stronę (zlecenie 14, zalecenie 23): klasa zew (Link.astro, wtyczka rehype-zewn.mjs) — strzałka ↗ z CSS, sklejona
+   twardą spacją z ostatnim słowem (nie spada sama do nowej linii), w tekście .8em. :where() — zerowa szczegółowość, więc
+   miejsca z własną strzałką (listy linków, menu działu, „Zobacz też”, przyciski, panel menu) ustawiają ją po swojemu. */
+:where(a.zew)::after { content: '\00a0↗'; font-size: .8em; }
+.skip { position: absolute; left: 12px; top: -60px; z-index: 100; padding: 10px 16px; border-radius: 999px; background: var(--primary); color: var(--primary-ink); font-weight: 700; }
+.skip:focus { top: 12px; }
+.wrap { max-width: var(--wrap); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
+.ico { width: 1em; height: 1em; flex: 0 0 auto; }
+.muted { color: var(--muted); }
+
+/* ---------- przyciski i etykiety ---------- */
+.btn { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 22px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--bg); color: var(--ink); font: inherit; font-weight: 700; font-size: 15px; text-decoration: none; cursor: pointer; }
+.btn:hover { border-color: var(--ink); color: var(--ink); }
+.btn-primary { background: var(--primary); border-color: var(--primary); color: var(--primary-ink); }
+.btn-primary:hover { color: var(--primary-ink); filter: brightness(1.12); }
+.link-arrow { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 700; font-size: 15px; text-decoration: none; color: var(--primary); }
+:root[data-theme='dark'] .link-arrow { color: var(--znacznik-tekst, var(--accent)); }
+.badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 700; line-height: 1.4; background: var(--tint); color: var(--tint-ink); }
+/* ikonka w etykiecie (biret przy „Obronie doktorskiej”, EtykietaRodzaju.astro) — widoczna tylko z etykietami B1 (telefon.css) */
+.badge > .et-ikona { display: none; }
+.badge-wydarzenie { background: var(--znacznik, var(--primary)); color: var(--znacznik-ink, var(--primary-ink)); }
+.badge-sukces { background: var(--accent); color: var(--accent-ink); }
+
+/* ---------- nagłówek ---------- */
+:root { --hdr-h: 71px; }
+/* Pływający nagłówek: zostaje u góry przy przewijaniu; kotwice i spis treści omijają jego wysokość. */
+html { scroll-padding-top: calc(var(--hdr-h) + 8px); }
+body > main { flex: 1 0 auto; }
+.hdr { position: sticky; top: 0; z-index: 30; background: var(--bg); border-bottom: 1px solid var(--line); transition: background-color var(--t-sredni) var(--rytm), border-color var(--t-sredni) var(--rytm), box-shadow var(--t-sredni) var(--rytm); }
+.hdr.przewiniety { box-shadow: 0 4px 18px rgb(0 0 0 / .08); }
+:root[data-theme='dark'] .hdr.przewiniety { box-shadow: 0 4px 18px rgb(0 0 0 / .45); }
+/* Strona główna: nagłówek na zdjęciu (przyciemnionym u góry), po przewinięciu kawałka — białe tło. Bez JS zwykły nagłówek. */
+.js .hdr-foto { margin-bottom: calc(-1 * var(--hdr-h)); transition: background-color var(--t-sredni) var(--rytm), border-color var(--t-sredni) var(--rytm), box-shadow var(--t-sredni) var(--rytm); }
+.js .hdr-foto:not(.przewiniety):not(.menu-otwarte) { background: transparent; border-bottom-color: transparent; }
