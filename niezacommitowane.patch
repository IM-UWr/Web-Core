+.js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .brand-name, .js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .nav > a, .js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .nav-pill, .js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .icon-btn:not(.burger), .js .hdr.hdr-stopka:not(.menu-otwarte) .brand-name, .js .hdr.hdr-stopka:not(.menu-otwarte) .nav > a, .js .hdr.hdr-stopka:not(.menu-otwarte) .nav-pill, .js .hdr.hdr-stopka:not(.menu-otwarte) .icon-btn:not(.burger) { color: #fff; }
+.js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .brand-sub, .js .hdr.hdr-stopka:not(.menu-otwarte) .brand-sub { color: rgb(255 255 255 / .82); }
+.js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .brand-logo, .js .hdr.hdr-stopka:not(.menu-otwarte) .brand-logo { background: #fff; }
+.js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .brand-txt, .js .hdr.hdr-stopka:not(.menu-otwarte) .brand-txt { border-left-color: rgb(255 255 255 / .35); }
+.js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .nav > a:hover, .js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .nav-item:hover > .nav-pill, .js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .nav-item.open > .nav-pill, .js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .icon-btn:not(.burger):hover, .js .hdr.hdr-stopka:not(.menu-otwarte) .nav > a:hover, .js .hdr.hdr-stopka:not(.menu-otwarte) .nav-item:hover > .nav-pill, .js .hdr.hdr-stopka:not(.menu-otwarte) .nav-item.open > .nav-pill, .js .hdr.hdr-stopka:not(.menu-otwarte) .icon-btn:not(.burger):hover { background: rgb(255 255 255 / .16); color: #fff; }
+.js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .nav > a[aria-current='page'], .js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .nav .is-current > .nav-pill, .js .hdr.hdr-stopka:not(.menu-otwarte) .nav > a[aria-current='page'], .js .hdr.hdr-stopka:not(.menu-otwarte) .nav .is-current > .nav-pill { background: rgb(255 255 255 / .22); color: #fff; }
+.js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .hdr-search, .js .hdr.hdr-stopka:not(.menu-otwarte) .hdr-search { background: rgb(0 0 0 / .62); color: rgb(255 255 255 / .9); }
+.js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .hdr-search input, .js .hdr.hdr-stopka:not(.menu-otwarte) .hdr-search input { color: #fff; }
+.js .hdr-foto:not(.przewiniety):not(.menu-otwarte) .hdr-search input::placeholder, .js .hdr.hdr-stopka:not(.menu-otwarte) .hdr-search input::placeholder { color: rgb(255 255 255 / .8); }
+.hdr .brand-name, .hdr .brand-sub, .hdr .nav > a, .hdr .nav-pill, .hdr .icon-btn { transition: color var(--t-sredni) var(--rytm), background-color var(--t-sredni) var(--rytm); }
+.hdr-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 70px; }
+/* nagłówek szerszy niż treść strony, żeby logotyp, nazwa i menu miały oddech */
+.hdr > .wrap.hdr-row { max-width: 1520px; }
+.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; min-width: 0; }
+.brand img { width: auto; height: 44px; }
+/* logo UWr i nazwa instytutu to dwa osobne linki (uwr.edu.pl i nasza strona główna), ułożone jak dotąd */
+.brand-uwr { display: flex; flex: none; }
+.brand-uwr, .brand-txt { text-decoration: none; }
+/* pełny logotyp UWr (orzeł + napis) jako maska w kolorze UWr; na zdjęciu i przy stopce — biały; na telefonie samo godło */
+.brand-logo { display: block; flex: none; height: 40px; aspect-ratio: 500 / 160; background: var(--uwr); -webkit-mask: var(--logo-pelne) left center / contain no-repeat; mask: var(--logo-pelne) left center / contain no-repeat; transition: background-color var(--t-sredni) var(--rytm); }
+.brand-uwr-logo + .brand-txt { padding-left: 12px; border-left: 1px solid var(--line); transition: border-color var(--t-sredni) var(--rytm); }
+@media (max-width: 640px) {
+  .brand-logo { aspect-ratio: 1; -webkit-mask-image: var(--logo-godlo); mask-image: var(--logo-godlo); }
+  .brand-uwr-logo + .brand-txt { padding-left: 0; border-left: 0; }
+}
+.brand-name, .brand-sub { white-space: nowrap; }
+/* nazwa się nie ściska (inaczej tekst wchodził pod menu); progi menu i wyszukiwarki dobrane pomiarem */
+@media (min-width: 561px) { .brand { flex: none; } .brand-txt { min-width: auto; } }
+.brand-txt { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; }
+.brand-name { font-size: 17px; font-weight: 800; letter-spacing: -0.01em; color: var(--ink); }
+.brand-sub { font-size: 13px; font-weight: 500; color: var(--muted); }
+/* pozycja działu: napis = link do strony działu, strzałka = rozwinięcie; lista także po najechaniu myszką */
+.nav-item.open > .nav-pill { background: var(--surface); color: var(--ink); }
+.nav-item.open > .dropdown { visibility: visible; opacity: 1; pointer-events: auto; transition: opacity var(--t-krotki) var(--rytm), visibility 0s; }
+.nav-item:not(.bez-hover):hover .nav-arrow .chev, .nav-item.open .nav-arrow .chev { transform: rotate(180deg); }
+.hdr-row { position: relative; }
+/* link zewnętrzny: zwykły tekst z ikonką za ostatnim słowem (flex odsuwał ikonkę do prawej krawędzi, gdy napis się zawijał) */
+.dropdown-group a.zew { display: block; }
+.dropdown-group a.zew .nw { white-space: nowrap; }
+.dropdown-group a.zew .ico { display: inline-block; margin-left: 6px; vertical-align: -1px; }
+.hdr-tools { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }
+.icon-btn { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 999px; background: transparent; color: var(--ink); font: inherit; font-size: 14px; font-weight: 700; text-decoration: none; cursor: pointer; }
+.icon-btn:hover { background: var(--surface); color: var(--ink); }
+.icon-btn svg { width: 20px; height: 20px; }
+.burger { display: none; background: var(--znacznik, var(--primary)); color: var(--znacznik-ink, var(--primary-ink)); }
+.burger:hover { background: var(--znacznik, var(--primary)); color: var(--znacznik-ink, var(--primary-ink)); filter: brightness(1.12); }
+.chev { transition: transform var(--t-krotki) var(--rytm); }
+details[open] > summary .chev { transform: rotate(180deg); }
+@media (max-width: 1180px) {
+  .burger { display: inline-flex; }
+}
+@media (max-width: 560px) {
+  .brand img { height: 38px; }
+  .brand-logo { height: 38px; }
+  .brand { gap: 10px; }
+  .brand-sub { font-size: 12px; }
+  .brand-name { font-size: 16px; }
+}
+/* najwęższe telefony: nazwa w dwóch liniach, bez podtytułu (inaczej nie mieści się obok przycisków) */
+@media (max-width: 420px) {
+  .brand-name { white-space: normal; line-height: 1.1; }
+  .brand-sub { display: none; }
+  .brand-name { font-size: 16px; }
+}
+
+/* ---------- baner (strona główna) ----------
+   Zdjęcie na całą szerokość, na nim z lewej u dołu: plakietka wyróżnionej aktualności, nazwa, wstęp i przyciski
+   (bez karty; bez logotypu UWr — logo uczelni jest w nagłówku). Przyciemnienie tylko pod tekstem: pas od lewej
+   do końca kolumny tekstu (--hero-tekst), dalej wygasa — prawa część zdjęcia zostaje naturalna. Najsłabsze miejsce pod tekstem ma krycie 0.68, więc biały
+   tekst ma kontrast ≥ 4.5:1 nawet na całkiem białym zdjęciu. U góry osobne przyciemnienie pod napisami nagłówka.
+   Nagłówek (.hdr-foto) jest przezroczysty, dopóki dół .hero-fig nie dojdzie do nagłówka (skrypt w Naglowek.astro).
+   Telefon: zdjęcie u góry przechodzi od dołu w granat, tekst pod nim na granacie. */
+.js .hdr-foto ~ main .hero-fig::after { content: ''; position: absolute; inset: 0 0 auto 0; height: calc(var(--hdr-h) + 110px); pointer-events: none;
+  background: linear-gradient(rgb(6 11 22 / .78), rgb(6 11 22 / .58) 40%, rgb(6 11 22 / 0)); }
+.js .hdr-foto ~ main .hero-in { padding-top: calc(var(--hdr-h) + 36px); }
+.hero .btn { background: transparent; border-color: rgb(255 255 255 / .6); color: #fff; }
+.hero .btn:hover { background: rgb(255 255 255 / .14); border-color: #fff; color: #fff; }
+.hero .btn-primary { background: var(--accent); border-color: var(--accent); color: #1b2d52; }
+.hero .btn-primary:hover { background: var(--accent); border-color: var(--accent); color: #1b2d52; filter: brightness(1.06); }
+.btn-row { display: flex; flex-wrap: wrap; gap: 10px; }
+/* Przy przewijaniu po zdjęciu przezroczysty nagłówek po ~80 px dostaje ciemne, matowe tło (aż do zmiany na białe przy
+   końcu zdjęcia) — napisy menu nie nakładają się na tytuł banera ani na jasne niebo. Tylko przeglądarki z
+   animation-timeline; w pozostałych nagłówek zostaje przezroczysty jak dotąd. */
+@supports (animation-timeline: scroll()) {
+  .js .hdr-foto:not(.przewiniety):not(.menu-otwarte) { animation: hero-hdr linear both; animation-timeline: scroll(root); animation-range: 0px 80px; }
+  @keyframes hero-hdr { from { background-color: rgb(9 16 34 / 0); } to { background-color: rgb(9 16 34 / .84); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); } }
+}
+@media (max-width: 720px) {
+  .js .hdr-foto ~ main .hero-in { padding-top: calc(var(--hdr-h) + 170px); }
+}
+
+/* ---------- sekcje ---------- */
+.section { padding-top: var(--section); padding-bottom: var(--section); }
+
+/* ---------- karty aktualności ---------- */
+.news-card .t { font-size: 20px; font-weight: 800; line-height: 1.25; letter-spacing: -0.01em; color: var(--ink); }
+.news-card .x { font-size: 15px; line-height: 1.6; }
+/* Separator „·” w wierszu z odstępami (flex + gap: .news-meta, .talk-meta…), np. „pt. 10:15 · sala 603” — kropka nigdy
+   nie zaczyna linii (decyzja 31.10.2026; każda szerokość). Kontener .kropki, element po separatorze .kropka (bez „· ” w tekście).
+   Kropka stoi w lewym wypełnieniu elementu (szerokość „· ” w Manrope = 0,427 em), element jest o tyle cofnięty w lewo, a element
+   przed nim dostaje tyle samo marginesu z prawej — w środku linii wszystko stoi tam, gdzie dawne „· sala”. Gdy element
+   przechodzi do nowej linii, kropka wypada poza lewą krawędź kontenera i jest ucinana (clip-path tylko z lewej), tekst
+   zaczyna się równo z krawędzią, a para „· sala” nigdy się nie rozrywa. Kontener nie może mieć lewego wypełnienia.
+   Przycięcie 1 px na lewo od krawędzi: wygładzone brzegi pierwszego elementu (np. plakietki) zostają, kropka i tak znika. */
+.news-card.featured .img { flex: 1 1 260px; min-height: 240px; background: var(--photo); }
+.news-card.featured .img img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
+.news-card.featured .body { flex: 1 1 260px; display: flex; flex-direction: column; gap: 10px; padding: 24px; }
+.news-card.featured .t { font-size: 24px; }
+/* zwykła karta ze zdjęciem: zdjęcie na całą szerokość karty nad tekstem (od krawędzi do krawędzi) */
+.news-card.z-foto .img-nad { display: block; margin: -22px -22px 4px; height: 150px; background: var(--photo); border-radius: var(--radius-l) var(--radius-l) 0 0; overflow: hidden; }
+.news-card.z-foto .img-nad img { display: block; width: 100%; height: 100%; object-fit: cover; }
+
+/* ---------- wydarzenia i seminaria ---------- */
+.event { display: flex; gap: 18px; padding: 18px; border-radius: var(--radius-l); background: var(--bg); text-decoration: none; color: var(--text); }
+.event:hover { color: var(--text); box-shadow: inset 0 0 0 1.5px var(--line); }
+.datebox .d { font-size: 28px; font-weight: 800; line-height: 1; }
+.datebox .m { font-size: 13px; font-weight: 700; text-transform: uppercase; }
+/* miesiąc na nadchodzącym kafelku: własny kolor tylko z tokenem --znacznik-miesiac (ciemny motyw na telefonie — bursztyn);
+   bez tokenu currentColor = kolor kafelka, jak dotąd */
+:is(.datebox, .pt-dbox):not(.minione) .m { color: var(--znacznik-miesiac, currentColor); }
+.datebox.small .d { font-size: 22px; }
+/* Kafelek daty — jedna zasada na całej stronie: granatowy (domyślny) = nadchodzące lub trwające, szary (.minione) = już się
+   odbyło (liczone przy budowaniu strony, funkcja trwaLubBedzie; ten sam szary w kafelkach .pt-dbox wyglądu „Portal”). */
+.datebox.minione { background: var(--minione-tlo); color: var(--minione-tekst); }
+.event .k { font-size: 13px; font-weight: 700; color: var(--primary); }
+:root[data-theme='dark'] .event .k { color: var(--znacznik-tekst, var(--accent)); }
+.event .t { font-size: 17px; font-weight: 800; line-height: 1.3; color: var(--ink); }
+.event .s { font-size: 14px; color: var(--muted); }
+/* pasek „Najbliższe wydarzenia” nad aktualnościami — pokazuje się tylko, gdy wydarzenie jest blisko */
+.sem-row .day, .sem-row .time { font-size: 15px; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
+.sem-row .room { font-size: 14px; color: var(--muted); }
+.sem-row .sem { font-size: 14px; font-weight: 700; color: var(--primary); }
+:root[data-theme='dark'] .sem-row .sem { color: var(--znacznik-tekst, var(--accent)); }
+.sem-row .talk b { font-size: 15px; color: var(--ink); }
+.sem-row .talk span { font-size: 14px; color: var(--muted); }
+@media (max-width: 760px) {
+  .sem-row .sem, .sem-row .talk { grid-column: 1 / -1; }
+}
+
+/* ---------- studia ---------- */
+.studia { border-top: 1px solid var(--line); }
+.prog .l { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
+.prog .n { font-size: 20px; font-weight: 800; line-height: 1.25; }
+.prog .o { font-size: 15px; line-height: 1.5; color: var(--text); }
+
+/* ---------- stopka ---------- */
+.ftr-main .n { font-size: 20px; font-weight: 800; }
+.ftr-main .a { font-size: 15px; line-height: 1.6; color: var(--footer-muted); }
+/* Komputer (≥ 761 px): stopka w wersji „zwartej” — mniejsze odstępy, ta sama treść. Telefon: telefon.css (Portal). */
+@media (min-width: 761px) {
+  .ftr-main .n { font-size: 18px; }
+  .ftr-main .a { line-height: 1.5; }
+}
+/* Telefon (≤ 760 px): adres i kolumny linków w dwóch kolumnach, w tej samej kolejności (decyzja 31.10.2026) —
+   stopka ok. 1/3 niższa niż przy jednej kolumnie. Odstępy — telefon.css. */
+
+/* ---------- podstrony ---------- */
+.page-head { background: var(--surface); border-bottom: 1px solid var(--line); }
+.page-head .wrap { padding-top: clamp(24px, 4vw, 44px); padding-bottom: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; gap: 12px; }
+.page-head h1 { margin: 0; font-size: clamp(32px, 5vw, 50px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.06; }
+.page-head .lead { margin: 0; max-width: 760px; font-size: 18px; color: var(--muted); }
+.layout > .main { flex: 999 1 560px; min-width: 0; }
+.side-box { display: flex; flex-direction: column; gap: 12px; padding: 22px; border-radius: var(--radius-l); background: var(--surface); min-width: 0; overflow-wrap: anywhere; }
+.side-box h2 { margin: 0; font-size: 20px; font-weight: 800; }
+.side-box .event { padding: 12px; border-radius: 14px; }
+.notice { padding: 14px 18px; border-radius: var(--radius); background: var(--tint); color: var(--tint-ink); font-weight: 600; }
+.notice-warn { background: var(--accent); color: var(--accent-ink); }
+
+/* treść artykułów i stron */
+.prose { max-width: 760px; font-size: 18px; line-height: 1.7; }
+.prose > :first-child { margin-top: 0; }
+.prose h2 { margin: 1.6em 0 .5em; font-size: 26px; font-weight: 800; }
+.prose h3 { margin: 1.4em 0 .4em; font-size: 21px; font-weight: 800; }
+.prose p, .prose ul, .prose ol { margin: 0 0 1em; }
+.prose li { margin: .25em 0; }
+.prose a { color: var(--primary); text-underline-offset: 3px; }
+:root[data-theme='dark'] .prose a { color: var(--accent); }
+.prose img { border-radius: 14px; }
+.prose table { width: 100%; border-collapse: collapse; margin: 1em 0 1.4em; font-size: 16px; display: block; overflow-x: auto; }
+.prose th, .prose td { padding: 8px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
+.prose th { font-weight: 800; color: var(--ink); background: var(--surface); }
+/* Cytat w Markdown („> ...”) służy jako wyróżniona ramka z ważną informacją. */
+.prose blockquote { margin: 1.2em 0; padding: 14px 18px; border-left: 4px solid var(--accent); border-radius: 0 var(--radius) var(--radius) 0; background: var(--tint); color: var(--tint-ink); font-size: 17px; }
+.prose blockquote > :last-child { margin-bottom: 0; }
+.prose blockquote a { color: inherit; }
+.prose code { padding: 1px 6px; border-radius: 6px; background: var(--surface); font-size: .92em; }
+.prose .katex-display { overflow-x: auto; overflow-y: hidden; padding: 4px 0; }
+
+/* listy wpisów */
+.month { margin: 18px 0 4px; font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
+.row-item:hover .t { text-decoration: underline; text-underline-offset: 4px; }
+.row-item .body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
+.row-item .t { font-size: 21px; font-weight: 800; line-height: 1.25; color: var(--ink); }
+.row-item .x { font-size: 16px; line-height: 1.6; }
+/* Lista pozycji w osobnych białych kartach (komputer ≥ 761 px) — wspólny styl list: kalendarz, aktualności, konferencje
+   (miesiące: .lista-miesiac niżej).
+   Kontener .karty-lista (kolumna z odstępem 10 px — karty się nie stykają; schowane pozycje nie zostawiają przerwy),
+   pozycje .row-item jako karty: tło strony, cienka ramka, zaokrąglenie jak .spec. Telefon (≤ 760 px) bez zmian. */
+@media (min-width: 761px) {
+  /* miesiąc listy (.lista-miesiac z nagłówkiem h2.month) jako sekcja z kreską i bursztynowym początkiem — te same wartości
+     co .zsec przy oprawie „linia” w wyglądzie „Zwarta” (tlo.css + uklad-zwarta.css) */
+  .lista-miesiac > .month { margin: 0 0 12px; font-size: clamp(21px, 2.2vw, 24px); font-weight: 800; letter-spacing: -0.02em; text-transform: none; color: var(--ink); }
+}
+.filters { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-top: 8px; }
+.filters .chips { display: flex; flex-wrap: wrap; gap: 8px; }
+.filters.filters-lewo { justify-content: flex-start; padding-top: 0; margin-bottom: 8px; }
+
+/* załączniki i dokumenty */
+.files { display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0; list-style: none; }
+.files a { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 12px; border: 1px solid var(--line); text-decoration: none; font-weight: 700; color: var(--ink); }
+.files a:hover { border-color: var(--ink); }
+.files svg { width: 20px; height: 20px; color: var(--primary); }
+:root[data-theme='dark'] .files svg { color: var(--accent); }
+
+/* galeria */
+.gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
+.gallery button { padding: 0; border: 0; border-radius: 12px; overflow: hidden; cursor: zoom-in; background: var(--photo); aspect-ratio: 4 / 3; }
+.gallery img { width: 100%; height: 100%; object-fit: cover; display: block; }
+.lightbox { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 24px; background: rgba(6, 11, 22, .92); }
+.lightbox figure { margin: 0; max-width: min(1200px, 100%); max-height: 100%; display: flex; flex-direction: column; gap: 10px; align-items: center; }
+.lightbox img { max-height: calc(100vh - 120px); width: auto; border-radius: 8px; }
+.lightbox figcaption { color: #fff; font-size: 15px; text-align: center; }
+.lightbox .lb-btn { position: absolute; width: 48px; height: 48px; border-radius: 999px; border: 0; background: rgba(255, 255, 255, .14); color: #fff; font-size: 22px; cursor: pointer; }
+.lightbox .lb-close { top: 16px; right: 16px; }
+.lightbox .lb-prev { left: 16px; top: 50%; transform: translateY(-50%); }
+.lightbox .lb-next { right: 16px; top: 50%; transform: translateY(-50%); }
+
+/* nawigacja nowszy / starszy */
+.pn .l { font-size: 13px; font-weight: 700; color: var(--muted); }
+.pn .t { font-size: 16px; font-weight: 800; color: var(--ink); }
