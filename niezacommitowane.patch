+---
+// Nagłówek na telefon (≤ 760 px; na komputerze schowany — tam jest pasek menu zal/PasekMenu.astro): logo, nazwa, przełącznik
+// języka z flagą języka docelowego, tryb ciemny i hamburger. Menu to ten sam panel co na komputerze (zal/PanelMenu.astro,
+// zlecenie 18, punkt 6); renderuje go PasekMenu, id przychodzi z Baza.astro, otwiera src/scripts/zal/menu.ts.
+import Ikona from './Ikona.astro';
+import Flaga from './zal/Flaga.astro';
+import ustawienia from '../data/ustawienia.json';
+import { u } from '../lib/url';
+import { t, wJezyku } from '../lib/i18n';
+import type { Lang } from '../lib/daty';
+
+interface Props { lang: Lang; sciezka: string; inny: string | null; idPanelu: string }
+const { lang, inny, idPanelu } = Astro.props;
+const logo = (ustawienia as any).logo as string | undefined;
+// logo UWr prowadzi na stronę uczelni (w tej samej karcie), nazwa instytutu — na naszą stronę główną
+const uwrAdres = lang === 'en' ? 'https://uwr.edu.pl/en/' : 'https://uwr.edu.pl/';
+const doJezyka = lang === 'pl' ? 'en' : 'pl';
+---
+<header class="hdr">
+  <div class="wrap hdr-row">
+    <div class="brand">
+      <a class:list={['brand-uwr', { 'brand-uwr-logo': !logo }]} href={uwrAdres} aria-label={t(lang, 'uwrStronaGlowna')}>
+        {logo
+          ? <img src={u(logo)} alt="" width="44" height="44" />
+          : <span class="brand-logo" aria-hidden="true" style={`--logo-pelne:url(${u('/pliki/uwr-logo.png')});--logo-godlo:url(${u('/pliki/uwr-godlo.png')})`}></span>}
+      </a>
+      <a class="brand-txt" href={u(wJezyku('/', lang))}>
+        <span class="brand-name">{t(lang, 'instytut')}</span>
+        <span class="brand-sub">{t(lang, 'wydzial')}</span>
+      </a>
+    </div>
+
+    <div class="hdr-tools">
+      {inny && <a class="icon-btn z-jezyk" href={u(inny)} hreflang={doJezyka} lang={doJezyka} aria-label={t(lang, 'innyJezyk')}><Flaga jezyk={doJezyka} />{t(lang, 'innyJezykKrotko')}</a>}
+      <button type="button" class="icon-btn" data-motyw aria-label={t(lang, 'motyw')}>
+        <Ikona nazwa="ksiezyc" class="when-light" />
+        <Ikona nazwa="slonce" class="when-dark" />
+      </button>
+      <button type="button" class="icon-btn burger" aria-label={t(lang, 'otworzMenu')} aria-expanded="false" aria-controls={idPanelu} data-burger data-z-menu-otworz data-otworz={t(lang, 'otworzMenu')} data-zamknij={t(lang, 'zamknijMenu')}>
+        <Ikona nazwa="menu" class="when-closed" />
+        <Ikona nazwa="zamknij" class="when-open" />
+      </button>
+    </div>
+  </div>
+</header>
+
+{/* przyciemnienie strony pod panelem menu: panel to zal/PanelMenu.astro, przy pasku menu (src/styles/zal-menu.css) */}
+<div class="z-menu-tlo" data-z-menu-tlo aria-hidden="true"></div>
+
+<script>
+  import '../scripts/zal/menu';
+
+  // Tryb ciemny
+  document.querySelectorAll<HTMLButtonElement>('[data-motyw]').forEach((b) =>
+    b.addEventListener('click', () => {
+      const d = document.documentElement;
+      const nowy = d.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
+      d.setAttribute('data-theme', nowy);
+      try { localStorage.setItem('motyw', nowy); } catch (e) {}
+    })
+  );
+</script>
