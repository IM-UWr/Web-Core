{
  "name": "im-uwr-strona",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Strona Instytutu Matematycznego Uniwersytetu Wrocławskiego (Astro + Pages CMS)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --glob \"**/*.html\"",
    "preview": "astro preview",
    "check": "astro check",
    "test:bloki": "node --test src/plugins/rehype-bloki.test.mjs",
    "test:jawne": "node --test src/plugins/rehype-bloki.test.mjs src/plugins/jawne-bloki.test.mjs",
    "test:jawne-ui": "node skrypty/test-jawny-markdown-ui.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^6.0.0",
    "@astrojs/react": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@fontsource-variable/brygada-1918": "^5.3.0",
    "@fontsource-variable/manrope": "^5.1.0",
    "astro": "^5.0.0",
    "katex": "^0.16.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "pagefind": "^1.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  }
