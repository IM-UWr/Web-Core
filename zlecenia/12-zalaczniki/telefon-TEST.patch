index 00000000..a1dd3860
--- /dev/null
+++ b/src/styles/zal-telefon-TEST.css
@@ -0,0 +1,249 @@
+/* ==========================================================================
+   ⚠️ TEST — wersja „Założycieli” na telefon (≤ 760 px). NIE WZOROWAĆ SIĘ, NIE SCALAĆ.
+   Łatka testowa z repozytorium Web-Podglad (testy/telefon-TEST.patch), próba do obejrzenia (TEST-TELEFON.md). Projekt telefonu nie jest ustalony.
+   Bloki nowego wyglądu mają klasę .z-tel (widoczne też na telefonie); tu ich układ na wąski ekran,
+   kolory i kroje jak na komputerze (paleta „Atramenty”, Brygada 1918 + Manrope, ciepłe tło).
+   ========================================================================== */
+.z-test-plakietka { display: none; }
+.z-okl-sygnet { display: none; }
+
+@media (max-width: 760px) {
+  /* ---------- plakietka TEST ---------- */
+  .z-test-plakietka { display: block; position: fixed; left: 8px; bottom: 8px; z-index: 200; padding: 3px 8px; border-radius: 4px;
+    background: #c4122f; color: #fff; font: 700 11px/1.3 var(--f-text); letter-spacing: .03em; pointer-events: none; box-shadow: 0 2px 8px rgb(0 0 0 / .25); }
+
+  /* ---------- bloki nowego wyglądu widoczne na telefonie ---------- */
+  .tylko-komputer.z-tel { display: block !important; }
+
+  /* ---------- kolory i kroje (jak na komputerze) ---------- */
+  :root {
+    --bg: #fcfaf6; --surface: #f4f1ea; --line: #e5e0d6;
+    --ink: #131c31; --text: #2b3245; --muted: #5b6375;
+    --tint: #efeae0; --tint-ink: #131c31;
+    --primary: var(--granat); --accent: var(--d-a); --accent-ink: #ffffff;
+    --znacznik: var(--granat); --znacznik-ink: #fff;
+    --font: var(--f-text);
+  }
+  :root[data-theme="dark"] {
+    --bg: #0a1020; --surface: #111a2e; --line: #243049;
+    --ink: #ecf0f7; --text: #d3d9e6; --muted: #98a3b8;
+    --tint: #16213a; --tint-ink: #ecf0f7;
+    --primary: #c9d0de; --accent: var(--d-a); --accent-ink: #0a1020;
+  }
+  [data-dzial] { --accent: var(--d-a); }
+  body { font-family: var(--f-text); }
+  main :is(h1, h2, h3) { font-family: var(--f-display); font-weight: 500; letter-spacing: -.005em; }
+  body[data-tlo] { background: var(--bg); }
+  body[data-tlo]::before, body[data-tlo]::after { content: none !important; }
+
+  /* ---------- nagłówek strony: granat, nazwa Brygadą ---------- */
+  .hdr, .js .hdr.hdr-glowna:not(.hdr-stopka):not(.menu-otwarte), .js .hdr-foto:not(.przewiniety):not(.menu-otwarte), .hdr.menu-otwarte {
+    background: var(--granat) !important; border-bottom-color: rgb(255 255 255 / .12) !important; -webkit-backdrop-filter: none !important; backdrop-filter: none !important; box-shadow: none !important; }
+  .hdr .brand-name { font-family: var(--f-display); font-weight: 600; letter-spacing: 0; color: #fff !important; }
+  .hdr .brand-sub { color: var(--na-ciemnym-2) !important; }
+  .hdr .brand-logo { background: #fff !important; }
+  .hdr .icon-btn { color: #fff !important; background: transparent; }
+  .hdr .icon-btn.burger { background: rgb(255 255 255 / .14) !important; color: #fff !important; }
+  .js .hdr-glowna:not(.hdr-zwiniety) .brand-txt { opacity: 1; transform: none; visibility: visible; }
+  /* stary układ podciągał baner pod przezroczysty nagłówek (.hdr-foto) — nowy nagłówek stoi pod paskiem */
+  .js .hdr-foto { margin-bottom: 0 !important; }
+
+  /* ---------- menu na telefonie: granat, działy Brygadą z sygnetem i kreską w kolorze działu ---------- */
+  .mnav { background: var(--granat) !important; color: #fff; }
+  .mnav a, .mnav .mrow-link, .mnav .mgroup a { color: #fff !important; }
+  .mnav .mgroup a { color: var(--na-ciemnym-2) !important; font-weight: 500; }
+  .mnav .mgroup h3 { color: var(--d-j, var(--na-ciemnym-2)) !important; letter-spacing: .02em; text-transform: none; font-size: 12.5px; }
+  .mnav .mitem, .mnav > a { border-color: rgb(255 255 255 / .12) !important; }
+  .mnav .mrow-btn { color: #fff !important; }
+  .mnav .mitem[data-dzial] .mrow { align-items: center; gap: 12px; }
+  .mnav .mitem[data-dzial] .mrow-link { font-family: var(--f-display); font-weight: 500; font-size: 24px; line-height: 1.1; flex-direction: column; align-items: flex-start; }
+  .mnav .mitem[data-dzial] .mrow-link::after { content: ''; display: block; width: 26px; height: 2px; margin-top: 5px; background: var(--d-j); }
+  .z-mnav-sygnet { flex: none; width: 34px; height: 41px; }
+  .z-mnav-sygnet path { fill: none; stroke: color-mix(in srgb, var(--d-j) 80%, #fff); stroke-width: 1.4px; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
+
