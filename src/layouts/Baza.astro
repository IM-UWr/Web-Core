---
// Wspólny szkielet każdej strony: <head>, nagłówek, stopka.
import '@fontsource-variable/manrope';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/tlo.css';
// Komputer (≥ 761 px): wygląd wybrany dla danej podstrony (prop `uklad` → <body data-uklad>; bez niego — wygląd z main).
import '../styles/uklad-zwarta.css';
import '../styles/uklad-portal.css';
// Telefon (≤ 760 px): wygląd wariantu „Portal” — klocki (portal.css) i nadpisania odstępów i skali (telefon.css).
import '../styles/portal.css';
import '../styles/telefon.css';
// Cała strona (telefon i komputer, na próbę): przejścia między stronami i łagodne wejście treści.
import '../styles/przejscia.css';
import Naglowek from '../components/Naglowek.astro';
import Stopka from '../components/Stopka.astro';
import { u, absolute, stripBase } from '../lib/url';
import { t, jezykZeSciezki, drugiJezyk } from '../lib/i18n';
import ustawienia from '../data/ustawienia.json';

interface Props {
  tytul: string;
  opis?: string;
  obraz?: string;
  // false = strona w trybie podglądu (pole „Opublikowany” odznaczone)
  opublikowany?: boolean;
  // true = strona poza wyszukiwarkami i indeksem Pagefind (noindex, bez canonical i hreflang), ale bez paska podglądu —
  // strona błędu 404 (zlecenie 01)
  pozaIndeksem?: boolean;
  // adres strony w drugim języku, jeśli inny niż domyślny /en/...
  alternatywa?: string | null;
  typ?: 'website' | 'article';
  stronaGlowna?: boolean;
  // czy indeksować treść w wyszukiwarce (Pagefind)
  szukaj?: boolean;
  // Wygląd tej podstrony na komputerze (≥ 761 px), słowa oddzielone spacją → <body data-uklad="…">; telefon bez zmian.
  // zwarta — treść pod banerem jak w wariancie Zwarta (src/styles/uklad-zwarta.css); zwarta-baner — baner jak w Zwarta;
  // portal-baner — baner jak w Portal (src/styles/uklad-portal.css). Np. uklad="zwarta portal-baner". Bez propu — jak dotąd.
  uklad?: string;
}

const { tytul, opis, obraz, opublikowany = true, pozaIndeksem = false, alternatywa, typ = 'website', stronaGlowna = false, szukaj = true, uklad } = Astro.props;
// do indeksu (canonical, hreflang, Pagefind) — tylko strony opublikowane i nie oznaczone jako poza indeksem
const wIndeksie = opublikowany && !pozaIndeksem;
const sciezka = stripBase(Astro.url.pathname);
const lang = jezykZeSciezki(sciezka);
const pelnyTytul = stronaGlowna ? `${t(lang, 'instytut')} · ${t(lang, 'uwr')}` : `${tytul} · ${t(lang, 'instytut')} UWr`;
const opisMeta = opis || (lang === 'en' ? ustawienia.wstep_en : ustawienia.wstep);
const kanoniczny = absolute(sciezka, Astro.site);
const inny = alternatywa === null ? null : alternatywa ?? drugiJezyk(sciezka);
const plAdres = lang === 'pl' ? sciezka : inny;
const enAdres = lang === 'en' ? sciezka : inny;
const ogObraz = absolute(obraz || ustawienia.baner.zdjecie, Astro.site);
// Wersja testowa na github.io nie powinna trafiać do Google (docelowo strona będzie pod domeną UWr).
const testowa = (Astro.site?.hostname ?? '').endsWith('github.io');
// Tło strony i oprawa sekcji (Ustawienia → „Tło strony”, „Sekcje”; style w src/styles/tlo.css).
// tlo_strony: pole | kratka | penrose | zmierzch | fale | brak (stare true/false z pola-przełącznika = pole / brak).
const tloUst = (ustawienia as any).tlo_strony;
const tlo = tloUst === true ? 'pole' : ['pole', 'kratka', 'penrose', 'zmierzch', 'fale'].includes(tloUst) ? tloUst : undefined;
// sekcje: pasy | linia | karty | brak (bez pola w ustawieniach — pasy).
const sekcjeUst = (ustawienia as any).sekcje ?? 'pasy';
const sekcje = ['pasy', 'linia', 'karty'].includes(sekcjeUst) ? sekcjeUst : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pelnyTytul}</title>
    <meta name="description" content={opisMeta} />
    {wIndeksie && <link rel="canonical" href={kanoniczny} />}
    {(!wIndeksie || testowa) && <meta name="robots" content="noindex, nofollow" />}
    {wIndeksie && plAdres && <link rel="alternate" hreflang="pl" href={absolute(plAdres, Astro.site)} />}
    {wIndeksie && enAdres && <link rel="alternate" hreflang="en" href={absolute(enAdres, Astro.site)} />}
    <meta property="og:type" content={typ} />
    <meta property="og:title" content={stronaGlowna ? t(lang, 'instytut') : tytul} />
    <meta property="og:description" content={opisMeta} />
    <meta property="og:url" content={kanoniczny} />
    <meta property="og:image" content={ogObraz} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'pl_PL'} />
    <meta property="og:site_name" content={`${t(lang, 'instytut')} UWr`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${t(lang, 'aktualnosci')} — ${t(lang, 'instytut')}`} href={u('/rss.xml')} />
    <meta name="theme-color" content="#1b2d52" />
    <script is:inline>
      (function () {
        var d = document.documentElement, m;
        d.classList.add('js');
        try { m = localStorage.getItem('motyw'); } catch (e) {}
        // Domyślnie tryb jasny (także na telefonach z ciemnym motywem systemu); ciemny tylko po wybraniu przyciskiem.
        if (m !== 'dark' && m !== 'light') m = 'light';
        d.setAttribute('data-theme', m);
      })();
    </script>
    {/* Wczytywanie z wyprzedzeniem stron, nad którymi stoi kursor (Chrome/Edge; inne przeglądarki pomijają). Bez plików z /pliki i /grafiki. */}
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prefetch: [{
        where: { and: [
          { href_matches: u('/*') },
          { not: { href_matches: [u('/pliki/*'), u('/grafiki/*'), u('/pagefind/*'), u('/*.xml'), u('/*.pdf')] } },
          { not: { selector_matches: '[download], [target=_blank]' } },
        ] },
        eagerness: 'moderate',
      }],
    })} />
    <slot name="head" />
  </head>
  <body data-tlo={tlo} data-sekcje={sekcje} data-uklad={uklad?.trim() || undefined}>
    <a class="skip" href="#tresc">{lang === 'en' ? 'Skip to content' : 'Przejdź do treści'}</a>
    <Naglowek lang={lang} sciezka={sciezka} inny={inny} naZdjeciu={stronaGlowna && !!ustawienia.baner?.zdjecie} />
    {!opublikowany && (
      <div class="notice notice-warn" role="status" style="border-radius:0;text-align:center">{t(lang, 'podglad')}</div>
    )}
    <main id="tresc" {...(wIndeksie && szukaj ? { 'data-pagefind-body': '' } : {})}>
      <slot />
    </main>
    <Stopka lang={lang} />
  </body>
</html>
