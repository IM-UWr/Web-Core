const svg = IKONY[nazwa] ?? IKONY.strzalka;
const style = rozmiar ? `width:${rozmiar}px;height:${rozmiar}px` : undefined;
---
<svg class={`ico ${klasa}`} style={style} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg} />
