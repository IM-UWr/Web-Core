---
// Nagłówek podstrony (kierunek „Założyciele”): NaglowekZ.astro — na stronie działu (/instytut, /nauka, /studia, /popularyzacja)
// baner działu, na pozostałych nagłówek podstrony. Jedna wersja HTML na każdą szerokość (komputer: zalozyciele.css,
// telefon: zal-telefon.css). Treść przekazana w slocie (liczby .pt-liczby, plakietki, linki) trafia pod tytuł.
// Link „← poziom wyżej”: `wstecz` albo ostatni z `okruszki`, który ma adres, albo strona główna; podstrona z menu działu
// (link prowadzi do strony działu) dostaje „← Dział” i znak patrona z opisem.
// haslo: krótkie hasło działu (pola `haslo` / `haslo_en` w danych) — pokazywane razem z liczbami, a z hasloBezLiczb także bez nich.
// Pola lead, nadtytul, nadtytulTelefon, motyw i motywDane zostają w Props dla zgodności widoków; nowy nagłówek ich nie pokazuje
// (opis strony trafia do meta description). Silnik animacji banerów (src/scripts/baner/) jest odłączony — README tamże.
import NaglowekZ from './zal/NaglowekZ.astro';
import { PATRONI, dzialZeSciezki, pole } from '../lib/patroni';
import { t } from '../lib/i18n';
import { stripBase } from '../lib/url';
import type { Lang } from '../lib/daty';
import ustawienia from '../data/ustawienia.json';

interface Props { tytul: string; tytulLang?: string; lead?: string; haslo?: string; hasloBezLiczb?: boolean; bezPodpisu?: boolean; lang: Lang; okruszki?: { etykieta: string; adres?: string }[]; wstecz?: { etykieta: string; adres: string; telefon?: string }; nadtytul?: string; nadtytulTelefon?: string; motyw?: string; motywDane?: unknown }
const { tytul, tytulLang, lang, okruszki = [], wstecz, bezPodpisu, hasloBezLiczb } = Astro.props;
const haslo = Astro.props.haslo?.trim() || undefined;
const zOkruszkow = [...okruszki].reverse().find((o) => o.adres) as { etykieta: string; adres: string } | undefined;
const cel: { etykieta: string; adres: string; telefon?: string } = wstecz ?? zOkruszkow ?? { etykieta: t(lang, 'stronaGlowna'), adres: '/' };

// Klasy i atrybuty opakowania jak w dotychczasowym banerze (.page-head.ph-z — na każdej szerokości display: contents),
// bo od nich zależą odstępy treści na stronach jeszcze nieprzeniesionych na wspólny szablon.
const DZIALY: Record<string, string> = {
  instytut: 'instytut', pracownicy: 'instytut', 'warto-wiedziec': 'instytut',
  nauka: 'nauka', seminaria: 'nauka', 'obrony-doktorskie': 'nauka', kalendarz: 'nauka',
  studia: 'studia', aktualnosci: 'aktualnosci', popularyzacja: 'popularyzacja',
};
const czlon = stripBase(Astro.url.pathname).replace(/^\/en(?=\/|$)/, '').split('/').filter(Boolean)[0] ?? '';
const dzial = DZIALY[czlon] ?? 'inne';
const ust = ((ustawienia as any).naglowki_podstron ?? {}) as { wariant?: string; zdjecia?: Record<string, { zdjecie?: string }> };
const wariant = ['motyw', 'zdjecie', 'granat', 'prosty'].includes(ust.wariant ?? '') ? ust.wariant! : 'granat';
const domyslneZdjecia = Object.fromEntries(['instytut', 'nauka', 'studia', 'aktualnosci', 'popularyzacja'].map((d) => [d, { zdjecie: `/pliki/naglowki/${d}.jpg` }]));
const zdjecie = (wariant === 'zdjecie' || wariant === 'granat') && !!(ust.zdjecia ?? domyslneZdjecia)[dzial]?.zdjecie;
const ozdobny = wariant !== 'prosty';
const dlugi = ozdobny && tytul.trim().length > 20;

const sciezkaZ = stripBase(Astro.url.pathname);
const bezJezykaZ = sciezkaZ.replace(/^\/en(?=\/|$)/, '').replace(/\/$/, '') || '/';
const dzialZ = dzialZeSciezki(sciezkaZ);
const patronZ = dzialZ ? PATRONI[dzialZ] : undefined;
const stronaDzialuZ = !!patronZ && bezJezykaZ === patronZ.adres;
const zMenuDzialuZ = !!patronZ && !stronaDzialuZ && cel.adres.replace(/\/$/, '') === patronZ.adres;
const slotZ = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const wsteczZ = zMenuDzialuZ ? { etykieta: pole(patronZ!, 'nazwa', lang), adres: patronZ!.adres } : cel;
---
<div class:list={['page-head', ozdobny && ['ph', `ph-${wariant}`], zdjecie && 'ph-z-foto', dlugi && 'ph-dlugi', 'ph-z']} data-dzial={ozdobny ? dzial : undefined}>
  {stronaDzialuZ
    ? <NaglowekZ rodzaj="dzial" dzial={dzialZ} tytul={tytul} haslo={haslo} lang={lang} slot={slotZ} wstecz={cel} />
    : <NaglowekZ rodzaj="podstrona" dzial={dzialZ} tytul={tytul} tytulLang={tytulLang} haslo={haslo} hasloBezLiczb={hasloBezLiczb} lang={lang} slot={slotZ} wstecz={wsteczZ} znak={zMenuDzialuZ} bezPodpisu={bezPodpisu} />}
</div>
