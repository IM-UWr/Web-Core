---
// Pasek tytułu podstrony: link „← poziom wyżej”, tytuł, opis i motyw graficzny działu.
// Wygląd: Ustawienia → „Nagłówki podstron” (ustawienia.naglowki_podstron) — style w src/styles/tlo.css.
import Wstecz from './Wstecz.astro';
import { t } from '../lib/i18n';
import { u, stripBase } from '../lib/url';
import type { Lang } from '../lib/daty';
import ustawienia from '../data/ustawienia.json';

// Nad tytułem: link „← poziom wyżej”. Cel: `wstecz` albo ostatni z `okruszki`, który ma adres, albo strona główna.
// nadtytul: mała etykieta nad tytułem (np. „Studia I i II stopnia” na stronie kierunku).
// haslo: krótkie hasło działu — na telefonie (≤ 760 px) zamiast opisu `lead`, wyróżnione (bursztyn na granatowym pasie);
// na komputerze niewidoczne, tam zostaje pełny opis (decyzja 31.10.2026). Puste/brak = telefon pokazuje opis jak dotąd.
// Działy: pola `haslo` / `haslo_en` w src/data/dzialy/*.json i src/data/popularyzacja.json; Aktualności — w kodzie widoku.
interface Props { tytul: string; lead?: string; haslo?: string; lang: Lang; okruszki?: { etykieta: string; adres?: string }[]; wstecz?: { etykieta: string; adres: string }; nadtytul?: string }
const { tytul, lead, lang, okruszki = [], wstecz, nadtytul } = Astro.props;
const haslo = Astro.props.haslo?.trim() || undefined;
const zOkruszkow = [...okruszki].reverse().find((o) => o.adres) as { etykieta: string; adres: string } | undefined;
const cel = wstecz ?? zOkruszkow ?? { etykieta: t(lang, 'stronaGlowna'), adres: '/' };

// Dział strony (po pierwszym członie adresu, bez /en) — od niego zależy motyw graficzny i zdjęcie.
const DZIALY: Record<string, string> = {
  instytut: 'instytut', pracownicy: 'instytut', 'warto-wiedziec': 'instytut',
  nauka: 'nauka', seminaria: 'nauka', 'obrony-doktorskie': 'nauka', kalendarz: 'nauka',
  studia: 'studia', aktualnosci: 'aktualnosci', popularyzacja: 'popularyzacja',
};
const czlon = stripBase(Astro.url.pathname).replace(/^\/en(?=\/|$)/, '').split('/').filter(Boolean)[0] ?? '';
const dzial = DZIALY[czlon] ?? 'inne';

// Wariant: motyw (rysunek działu) | zdjecie (zdjęcie działu, bez zdjęcia — rysunek) | granat (ciemny pas) | prosty (jak dawniej).
// Zdjęcia działów: naglowki_podstron.zdjecia.<dział> = { zdjecie, kadr }. Bez pola w ustawieniach — wartości domyślne poniżej.
type Zdjecie = { zdjecie?: string; kadr?: string };
const DOMYSLNE: { wariant: string; zdjecia: Record<string, Zdjecie> } = {
  wariant: 'granat',
  zdjecia: {
    instytut: { zdjecie: '/pliki/naglowki/instytut.jpg', kadr: 'center 45%' },
    nauka: { zdjecie: '/pliki/naglowki/nauka.jpg', kadr: 'center 40%' },
    studia: { zdjecie: '/pliki/naglowki/studia.jpg', kadr: 'center 35%' },
    aktualnosci: { zdjecie: '/pliki/naglowki/aktualnosci.jpg', kadr: 'center 40%' },
    popularyzacja: { zdjecie: '/pliki/naglowki/popularyzacja.jpg', kadr: 'center 50%' },
  },
};
const ust = ((ustawienia as any).naglowki_podstron ?? {}) as Partial<typeof DOMYSLNE>;
const wariant = ['motyw', 'zdjecie', 'granat', 'prosty'].includes(ust.wariant ?? '') ? ust.wariant! : DOMYSLNE.wariant;
const foto = wariant === 'zdjecie' || wariant === 'granat' ? (ust.zdjecia ?? DOMYSLNE.zdjecia)[dzial] : undefined;
const zdjecie = foto?.zdjecie ? u(foto.zdjecie) : undefined;
const ozdobny = wariant !== 'prosty';
// Długi tytuł (> 20 znaków, np. „Analiza harmoniczna i rozwinięcia ortogonalne”): klasa .ph-dlugi — na telefonie tytuł
// 27 px zamiast 28 px (telefon.css); rysunek działu bez zmian. Komputer bez zmian (decyzja 31.10.2026).
const dlugi = ozdobny && tytul.trim().length > 20;
// Granatowy pas na samej górze strony: nagłówek strony (menu) jest u góry przezroczysty i leży na pasie,
// jak na stronie głównej na zdjęciu (klasa .hdr-foto, style w global.css). Skrypt działa od razu przy wczytywaniu,
// zanim pas się narysuje, żeby nic nie przeskakiwało; bez JS — zwykły biały nagłówek nad pasem.
// Między nagłówkiem a <main> mogą stać tylko skrypty/style i menu na telefon (.mnav, .mnav-tlo).
const naPasie = wariant === 'granat'
  ? "(function(s){var p=s.parentElement,h=document.querySelector('.hdr');if(h&&p&&!p.previousElementSibling&&p.parentElement&&p.parentElement.id==='tresc'&&(function(n){while(n&&(/^(SCRIPT|TEMPLATE|STYLE|LINK)$/.test(n.tagName)||/(^| )mnav/.test(n.className)))n=n.nextElementSibling;return n===p.parentElement;})(h.nextElementSibling))h.classList.add('hdr-foto');})(document.currentScript)"
  : '';

// Aktualności: bursztynowa fala to suma częściowa szeregu Fouriera fali prostokątnej (harmoniczne 1, 3, …, 27; szare
// linie motywu to sumy do 1, 3 i 7). Rysowana jako SVG w tych samych proporcjach co maska (src/assets/naglowki/aktualnosci-b.svg).
// Skrypt płynnie dokłada i odejmuje kolejne harmoniczne (od samej sinusoidy do „prostokąta” z uszami Gibbsa i z powrotem);
// bez JS albo przy „ogranicz ruch” fala stoi w pełnej postaci. Animacja staje, gdy pas jest poza ekranem albo karta w tle.
const FALA = { x0: 150, x1: 641, okres: 248, y0: 168, amp: 92, harmoniczne: 14 };
const fala = dzial === 'aktualnosci' && ozdobny ? (() => {
  let d = '';
  for (let x = FALA.x0; x <= FALA.x1; x++) {
    const th = ((x - FALA.x0) / FALA.okres) * 2 * Math.PI;
    let v = 0;
    for (let j = 0; j < FALA.harmoniczne; j++) v += Math.sin((2 * j + 1) * th) / (2 * j + 1);
    d += `${x === FALA.x0 ? 'M' : 'L'}${x} ${(FALA.y0 - (FALA.amp * 4 / Math.PI) * v).toFixed(1)}`;
  }
  return d;
})() : '';
const falaSkrypt = `(function(s){
  var path = s.previousElementSibling && s.previousElementSibling.querySelector('path');
  if (!path || !window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var X0 = ${FALA.x0}, X1 = ${FALA.x1}, P = ${FALA.okres}, Y0 = ${FALA.y0}, A = ${FALA.amp} * 4 / Math.PI, J = ${FALA.harmoniczne};
  var S = [];
  for (var x = X0; x <= X1; x++) { var th = (x - X0) / P * 2 * Math.PI, r = []; for (var j = 0; j < J; j++) r.push(Math.sin((2 * j + 1) * th) / (2 * j + 1)); S.push(r); }
  // M: ile harmonicznych (ciągle, 1…J); każda kolejna wchodzi płynnie (smoothstep)
  function rysuj(M) {
    var w = [], d = '';
    for (var j = 0; j < J; j++) { var t = Math.min(1, Math.max(0, M - j)); w.push(t * t * (3 - 2 * t)); }
    for (var i = 0; i < S.length; i++) { var v = 0, r = S[i]; for (var j = 0; j < J; j++) v += w[j] * r[j]; d += (i ? 'L' : 'M') + (X0 + i) + ' ' + (Y0 - A * v).toFixed(1); }
    path.setAttribute('d', d);
  }
  // cykl (s): dokładanie 0–9, pełna fala 9–13, odejmowanie 13–20, sama sinusoida 20–22
  var ease = function (u) { return 0.5 - 0.5 * Math.cos(Math.PI * u); };
  function M(t) {
    t = t % 22;
    if (t < 9) return 1 + (J - 1) * ease(t / 9);
    if (t < 13) return J;
    if (t < 20) return J - (J - 1) * ease((t - 13) / 7);
    return 1;
  }
  rysuj(1);
  var czas = 0, poprz = 0, widac = true, id = 0;
  function klatka(now) { if (poprz) czas += Math.min(now - poprz, 100) / 1000; poprz = now; rysuj(M(czas)); id = requestAnimationFrame(klatka); }
  function ustaw() { var gra = widac && !document.hidden; if (gra && !id) { poprz = 0; id = requestAnimationFrame(klatka); } else if (!gra && id) { cancelAnimationFrame(id); id = 0; } }
  if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { widac = e[0].isIntersecting; ustaw(); }).observe(path.ownerSVGElement);
  document.addEventListener('visibilitychange', ustaw);
  ustaw();
})(document.currentScript)`;
---
<div class:list={['page-head', ozdobny && ['ph', `ph-${wariant}`], zdjecie && 'ph-z-foto', dlugi && 'ph-dlugi']} data-dzial={ozdobny ? dzial : undefined}>
  {naPasie && <script is:inline set:html={naPasie} />}
  <div class="wrap">
    {ozdobny && (
      <span class="ph-m" aria-hidden="true">
        {fala && <svg class="ph-fala" viewBox="0 0 640 320" preserveAspectRatio="xMaxYMid meet" focusable="false"><path d={fala} /></svg>}
        {fala && <script is:inline set:html={falaSkrypt} />}
      </span>
    )}
    {zdjecie && (
      <figure class="ph-foto" aria-hidden="true">
        <img src={zdjecie} alt="" decoding="async" style={foto?.kadr ? `object-position:${foto.kadr}` : undefined} />
      </figure>
    )}
    <Wstecz etykieta={cel.etykieta} adres={cel.adres} lang={lang} />
    {nadtytul && <p class="eyebrow">{nadtytul}</p>}
    <h1>{tytul}</h1>
    {/* Hasło i opis jako dwa rodzeństwa w .wrap (wchodzą z tą samą animacją co tytuł — przejscia.css);
         przełączanie klasami .tylko-telefon / .tylko-komputer (telefon.css), style hasła w telefon.css. */}
    {haslo && <p class="ph-haslo tylko-telefon" data-pagefind-ignore>{haslo}</p>}
    {lead && <p class:list={['lead', haslo && 'tylko-komputer']}>{lead}</p>}
    <slot />
  </div>
</div>
