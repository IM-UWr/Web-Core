---
// Liczby pod hasłem w banerze — na razie tylko na telefonie (decyzja 31.10.2026; komputer później): wspólne dla Aktualności
// i Kalendarza. Trzy kolumny z kreską nad nimi (.pt-liczby w portal.css): liczba, pod nią etykieta „<rzeczownik> <okres>”,
// np. „2 / ogłoszenia z 30 dni”, „5 / seminariów w ciągu 30 dni”, łamana równo (text-wrap: balance) — najwyżej dwie linijki
// przy 360 i 390 px (sprawdzone pomiarem dla PL i EN; stałe złamanie przed okresem dawało po angielsku trzy linijki:
// „seminars / in the next 30 / days”). Rzeczownik w odmianie po liczebniku (odmiana w i18n.ts), jednoliterowe wyrazy
// z twardą spacją (bezSierotek). Pozycje z zerem pomijamy; bez żadnej — bez listy. Zwykłe liczby, nieklikalne.
import { odmiana, bezSierotek } from '../lib/i18n';
import type { Lang } from '../lib/daty';

interface Props { lang: Lang; okres: string; pozycje: { n: number; pl: [string, string, string]; en: [string, string] }[] }
const { lang, okres, pozycje } = Astro.props;
const liczby = pozycje.filter((x) => x.n > 0).map((x) => ({ n: x.n, l: bezSierotek(`${odmiana(x.n, x.pl, x.en, lang)} ${okres}`) }));
---
{liczby.length > 0 && (
  <ul class="pt-liczby tylko-telefon" data-pagefind-ignore>
    {liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}
  </ul>
)}
