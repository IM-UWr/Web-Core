---
// Karta aktualności na stronie głównej (wyróżniona = szeroka, ze zdjęciem z boku; zwykła ze zdjęciem — zdjęcie nad tekstem).
import { u, isExternal } from '../lib/url';
import { wJezyku } from '../lib/i18n';
import { RODZAJE, ODBIORCY } from '../lib/i18n';
import { short, type Lang } from '../lib/daty';
import type { PozycjaListy } from '../lib/tresci';

interface Props { p: PozycjaListy; lang: Lang; wyrozniona?: boolean }
const { p, lang, wyrozniona = false } = Astro.props;
const etykieta = p.rodzaj !== 'ogloszenie' ? RODZAJE[p.rodzaj]?.[lang] : p.dla[0] ? ODBIORCY[p.dla[0]]?.[lang] : RODZAJE.ogloszenie[lang];
const zdjecie = wyrozniona && p.zdjecie;
const zdjecieNad = !wyrozniona && p.zdjecie;
const href = isExternal(p.href) ? p.href : u(wJezyku(p.href, lang));
---
<a class={`news-card${zdjecie ? ' featured' : ''}${zdjecieNad ? ' z-foto' : ''}`} href={href}>
  {zdjecie ? (
    <>
      <span class="img"><img src={u(p.zdjecie!)} alt={p.zdjecie_opis ?? ''} loading="lazy" /></span>
      <span class="body">
        <span class="news-meta"><span class={`badge badge-${p.rodzaj}`}>{etykieta}</span><time datetime={p.data}>{short(p.data)}</time></span>
        <span class="t">{p.tytul}</span>
        {p.zajawka && <span class="x">{p.zajawka}</span>}
      </span>
    </>
  ) : (
    <>
      {zdjecieNad && <span class="img-nad"><img src={u(p.zdjecie!)} alt={p.zdjecie_opis ?? ''} loading="lazy" /></span>}
      <span class="news-meta"><span class={`badge badge-${p.rodzaj}`}>{etykieta}</span><time datetime={p.data}>{short(p.data)}</time></span>
      <span class="t">{p.tytul}</span>
      {p.zajawka && <span class="x">{p.zajawka}</span>}
    </>
  )}
</a>
