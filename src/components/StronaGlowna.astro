---
// Strona główna (wspólna dla wersji polskiej i angielskiej).
import Baza from '../layouts/Baza.astro';
import Ikona from './Ikona.astro';
import KartaAktualnosci from './KartaAktualnosci.astro';
import KartaWydarzenia from './KartaWydarzenia.astro';
import TabelaReferatow from './TabelaReferatow.astro';
import ListaReferatow from './ListaReferatow.astro';
import KafelekKoloryDni from './KafelekKoloryDni.astro';
import WartoWiedziec from './WartoWiedziec.astro';
import ustawienia from '../data/ustawienia.json';
import skroty from '../data/skroty.json';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz, RODZAJE, ODBIORCY } from '../lib/i18n';
import { range, short, type Lang } from '../lib/daty';
import { listaKierunkow } from '../lib/menu';
import { wydarzeniaNaGlowna, aktualnosciNaGlowna, wyroznionaAktualnosc, referatyWTygodniu, tydzienSeminariow } from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
// Kafelek „Na skróty” z tym adresem pokazuje dzisiejszy kolor dnia (KafelekKoloryDni).
const KOLORY_DNI = '/studia/rok-akademicki';

// Wydarzenia tylko, gdy są blisko (domyślnie 5 dni roboczych przed początkiem) — inaczej sekcji nie ma.
const dniWydarzen = Number((ustawienia as any).wydarzenia_dni_robocze ?? 5) || 5;
const wydarzenia = await wydarzeniaNaGlowna(3, lang, dniWydarzen);
const wyrozniona = await wyroznionaAktualnosc(lang);
const lista = await aktualnosciNaGlowna(6, lang);
// Pierwsza aktualność ze zdjęciem zajmuje dwie kolumny — wtedy pokazujemy o jedną mniej.
const pierwszaZeZdjeciem = !!lista[0]?.zdjecie;
const aktualnosci = pierwszaZeZdjeciem ? lista.slice(0, 5) : lista;
// Telefon (wygląd „Portal”): zawsze sześć najnowszych w zwartej liście — data, rodzaj lub adresat, tytuł, miniatura.
const etykieta = (p: (typeof lista)[number]) =>
  p.rodzaj !== 'ogloszenie' ? RODZAJE[p.rodzaj]?.[lang] : p.dla[0] ? ODBIORCY[p.dla[0]]?.[lang] : RODZAJE.ogloszenie[lang];
const referaty = await referatyWTygodniu(lang);
const tydzien = tydzienSeminariow();
const baner = ustawienia.baner;
const st = ustawienia.studia;
// Kafelki „Studia”: kierunki z sekcji Kierunki (pole „Pokaż na stronie głównej”) + dodatkowe kafelki z Ustawień.
const kafelki = [
  ...(await listaKierunkow()).filter((k) => k.data.na_stronie_glownej).map((k) => ({
    poziom: k.data.kafelek_poziom || 'Kierunek',
    poziom_en: k.data.kafelek_poziom_en || 'Programme',
    nazwa: k.data.menu_etykieta || k.data.nazwa,
    nazwa_en: k.data.menu_etykieta_en || k.data.nazwa_en,
    opis: k.data.kafelek_opis || k.data.opis || '',
    opis_en: k.data.kafelek_opis_en || k.data.opis_en,
    adres: `/studia/${k.id}`,
  })),
  ...((st.kierunki ?? []) as any[]),
];
---
<Baza tytul={t(lang, 'instytut')} stronaGlowna>
  {/* Baner: zdjęcie na całą szerokość, tekst na przyciemnieniu z lewej (na telefonie pod zdjęciem). Style: global.css, „baner (strona główna)”. */}
  <section class:list={['hero', { 'hero-bez-zdjecia': !baner.zdjecie }]} aria-labelledby="h1-glowna">
    {baner.zdjecie && (
      <figure class="hero-fig">
        <img
          src={u(baner.zdjecie)}
          srcset={(baner as any).zdjecie_male ? `${u((baner as any).zdjecie_male)} 1200w, ${u(baner.zdjecie)} 2400w` : undefined}
          sizes="100vw"
          alt={baner.opis}
          style={`object-position:${baner.kadr || 'center'}`}
          fetchpriority="high"
        />
        {baner.podpis && <figcaption>{baner.podpis}</figcaption>}
      </figure>
    )}
    <div class="wrap hero-in">
      <div class="hero-txt">
        {wyrozniona && (
          <a class="hero-flag" href={href(wyrozniona.href)}>{wyrozniona.tytul}<Ikona nazwa="strzalka" rozmiar={15} /></a>
        )}
        <span class="hero-logo" role="img" aria-label={t(lang, 'uwr')} style={`--logo-pelne:url(${u('/pliki/uwr-logo.png')})`}></span>
        <h1 id="h1-glowna">{t(lang, 'instytut')}</h1>
        <p class="hero-lead">{lang === 'en' ? ustawienia.wstep_en : ustawienia.wstep}</p>
        <div class="btn-row hero-btns">
          {ustawienia.przyciski.map((b, i) => (
            <a class={`btn${i === 0 ? ' btn-primary' : ''}`} href={href(b.adres)}>
              {wybierz(b, 'etykieta', lang)}{i === 0 && <Ikona nazwa="strzalka" rozmiar={16} />}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Telefon (≤ 760 px) — wygląd „Portal”: pod banerem ramki jedna pod drugą: Na skróty (kafelki jako wiersze),
       Aktualności (osobna, zwarta lista), Najbliższe wydarzenia, Seminaria, Warto wiedzieć (osobna lista), Studia.
       Sekcje wspólne z komputerem zmieniają tylko wygląd (style na dole); bloki .tylko-telefon są z data-pagefind-ignore. */}
  <section class="gl-skroty" aria-label={t(lang, 'naSkroty')}>
    <div class="wrap tiles">
      <div class="pt-h tylko-telefon"><h2 id="h2-skroty">{t(lang, 'naSkroty')}</h2></div>
      {skroty.kafelki.map((k) => (
        k.adres === KOLORY_DNI ? (
          <KafelekKoloryDni lang={lang} adres={k.adres} etykieta={wybierz(k, 'etykieta', lang)} />
        ) : (
          <a class="tile" href={href(k.adres)}>
            <Ikona nazwa={k.ikona} />
            <span>{wybierz(k, 'etykieta', lang)}</span>
          </a>
        )
      ))}
    </div>
  </section>

  <div class="wrap gl-tel tylko-telefon" data-pagefind-ignore>
    <section class="pt-box" aria-labelledby="h2-akt-tel">
      <div class="pt-h">
        <h2 id="h2-akt-tel">{t(lang, 'aktualnosci')}</h2>
        <a class="pt-all" href={href('/aktualnosci')}>{t(lang, 'wszystkieAktualnosci')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
      </div>
      <ul class="pt-list">
        {lista.map((p) => (
          <li>
            <a class="pt-item" href={href(p.href)}>
              <time class="pt-d" datetime={p.data}>{short(p.data).slice(0, 5)}</time>
              <span class="pt-b">
                <span class="pt-k">{etykieta(p)}</span>
                <span class="pt-t">{p.tytul}</span>
              </span>
              {p.zdjecie && <span class="pt-min"><img src={u(p.zdjecie)} alt="" loading="lazy" decoding="async" /></span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  {/* Najbliższe wydarzenia — sekcja jest zawsze; gdy nic nie ma (albo skrypt niżej schowa zakończone), pokazuje
       komunikat „Brak zapowiedzianych wydarzeń.” (jak puste „Najbliższe seminaria”). */}
  <section class="section wydarzenia-pas gl-box gl-wyd" aria-labelledby="h2-wyd" data-wydarzenia>
    <div class="wrap">
      <div class="section-head">
        <h2 id="h2-wyd">{t(lang, 'najblizsze')}</h2>
        <a class="link-arrow" href={href('/kalendarz')}>{t(lang, 'kalendarz')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
      </div>
      <div class="event-grid">
        {wydarzenia.map((w) => <KartaWydarzenia w={w} lang={lang} />)}
      </div>
      <p class="sem-empty" data-wydarzenia-pusto hidden={wydarzenia.length > 0}>{t(lang, 'brakWydarzen')}</p>
    </div>
  </section>

  <section class="section tylko-komputer" aria-labelledby="h2-akt">
    <div class="wrap">
      <div class="section-head">
        <h2 id="h2-akt">{t(lang, 'aktualnosci')}</h2>
        <a class="link-arrow" href={href('/aktualnosci')}>{t(lang, 'wszystkieAktualnosci')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
      </div>
      <div class="news-grid">
        {aktualnosci.map((p, i) => <KartaAktualnosci p={p} lang={lang} wyrozniona={i === 0 && pierwszaZeZdjeciem} />)}
      </div>
    </div>
  </section>

  <section class="section section-alt gl-box gl-sem" aria-labelledby="h3-sem">
    <div class="wrap">
      <div class="sem-week sem-week-sam">
        <div class="section-head gl-sem-head">
          <div class="gl-sem-l">
            <h2 id="h3-sem" class="sem-week-h">{t(lang, tydzien.przyszly ? 'seminariaPrzyszly' : 'seminariaTydzien')}</h2>
            <span class="muted gl-sem-zakres">{range(tydzien.od, tydzien.do, lang)}</span>
          </div>
          <div class="gl-sem-r">
            <a class="link-arrow" href={href('/seminaria')}>{t(lang, 'wszystkieSeminaria')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
          </div>
        </div>
        <div class="tylko-komputer">
          <TabelaReferatow
            wiersze={referaty}
            lang={lang}
            etykieta={t(lang, tydzien.przyszly ? 'seminariaPrzyszly' : 'seminariaTydzien')}
            pusty={t(lang, tydzien.przyszly ? 'brakReferatowPrzyszly' : 'brakReferatow')}
          />
        </div>
        <div class="tylko-telefon" data-pagefind-ignore>
          <ListaReferatow
            wiersze={referaty}
            lang={lang}
            etykieta={t(lang, tydzien.przyszly ? 'seminariaPrzyszly' : 'seminariaTydzien')}
            pusty={t(lang, tydzien.przyszly ? 'brakReferatowPrzyszly' : 'brakReferatow')}
          />
        </div>
      </div>
    </div>
  </section>

  <div class="wrap gl-tel tylko-telefon" data-pagefind-ignore>
    <WartoWiedziec lang={lang} uklad="portal" glowna limit={4} />
  </div>

  <section class="section studia gl-box gl-studia" aria-labelledby="h2-studia">
    <div class="wrap">
      <div class="studia-head">
        <div>
          <h2 id="h2-studia">{wybierz(st, 'tytul', lang)}</h2>
          <p>{wybierz(st, 'opis', lang)}</p>
        </div>
        <a class="btn btn-accent tylko-komputer" href={st.rekrutacja}>{t(lang, 'rekrutacja')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
      </div>
      <div class="prog-grid">
        {kafelki.map((k) => (
          <a class="prog" href={href(k.adres)}>
            <span class="l">{wybierz(k, 'poziom', lang)}</span>
            <span class="n">{wybierz(k, 'nazwa', lang)}</span>
            <span class="o">{wybierz(k, 'opis', lang)}</span>
          </a>
        ))}
      </div>
      <p class="pt-stopka tylko-telefon" data-pagefind-ignore><a class="btn btn-accent btn-small" href={st.rekrutacja}>{t(lang, 'rekrutacja')}<Ikona nazwa="strzalka" rozmiar={15} /></a></p>
    </div>
  </section>

  <WartoWiedziec lang={lang} uklad="glowna" limit={4} klasa="tylko-komputer" />
</Baza>

<script>
  // Strona przebudowuje się 2× dziennie — wydarzenia, które już się skończyły, chowamy od razu w przeglądarce.
  import { now, today, hasTime } from '../lib/daty';
  const sekcja = document.querySelector<HTMLElement>('[data-wydarzenia]');
  if (sekcja) {
    const n = now();
    const d = today();
    const karty = Array.from(sekcja.querySelectorAll<HTMLElement>('[data-koniec]'));
    karty.forEach((k) => {
      const koniec = k.dataset.koniec || '';
      if (koniec && (hasTime(koniec) ? koniec < n : koniec < d)) k.remove();
    });
    // wszystkie się skończyły → komunikat zamiast pustej sekcji
    if (!sekcja.querySelector('[data-koniec]')) sekcja.querySelector<HTMLElement>('[data-wydarzenia-pusto]')?.removeAttribute('hidden');
  }
</script>

<style>
  /* Seminaria tygodnia: tytuł i zakres dat obok siebie, link „Wszystkie seminaria” z prawej — na komputerze i na telefonie
     (tam w nagłówku ramki, jak „Kalendarz” przy wydarzeniach; gdy się nie mieści — pod tytułem), nie na dole ramki */
  .gl-sem-head { margin-bottom: 14px; }
  .gl-sem-l { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .gl-sem-zakres { font-size: 14px; font-weight: 600; }
  .gl-sem-r { display: flex; flex-wrap: wrap; gap: 0 20px; }
  /* komputer: odstęp między kafelkami „Na skróty” a kreską sekcji „Najbliższe wydarzenia” (dotąd kreska stykała się z kafelkami) */
  @media (min-width: 761px) { .gl-skroty { padding-bottom: 40px; } }

  /* ---------- telefon (≤ 760 px): wygląd „Portal” — ramki jedna pod drugą ---------- */
  @media (max-width: 760px) {
    .pt-stopka { padding-top: 8px; }
    .gl-tel { margin-top: 12px; }
    /* sekcje wspólne z komputerem jako ramki: 12 px odstępu, ramka na .wrap, bez kreski sekcji „linia” */
    .section.gl-box { margin-top: 12px; padding: 0; border-top: 0; background: none; }
    .section.gl-box > .wrap { margin: 0 var(--gutter); padding: 10px 14px 8px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); }
    .section.section-alt.gl-box.gl-sem { background: none; }
    .section.gl-box > .wrap:first-child::before, .section.gl-box > .wrap:first-child::after { content: none; }
    .section.gl-box.gl-studia { padding-bottom: 20px; }
    /* nagłówek ramki: tytuł z bursztynowym znacznikiem, link z prawej, gruba kreska pod spodem */
    .gl-box .section-head { flex-wrap: wrap; align-items: baseline; gap: 2px 14px; margin: 0 0 4px; padding-bottom: 7px; border-bottom: 2px solid var(--ink); }
    .gl-box .section-head h2, .gl-studia .studia-head h2 { margin: 0; font-size: 18px; font-weight: 800; line-height: 1.3; letter-spacing: -0.01em; }
    .gl-box .section-head h2::before, .gl-studia .studia-head h2::before { content: ''; display: inline-block; width: 4px; height: .85em; margin: 0 9px 0 0; border-radius: 2px; background: var(--accent); vertical-align: -.05em; }
    :global(:root[data-theme='dark']) .gl-box .section-head, :global(:root[data-theme='dark']) .gl-studia .studia-head h2 { border-bottom-color: var(--line); }
    .gl-box .link-arrow { gap: 5px; min-height: 40px; font-size: 14px; white-space: nowrap; }
    .gl-box .link-arrow :global(svg) { width: 14px !important; height: 14px !important; }
    .gl-sem-l { gap: 0 10px; min-width: 0; }
    .gl-sem-zakres { font-size: 13px; font-weight: 700; }

    /* Na skróty: kafelki jako wiersze w ramce (ikona z lewej, napis obok; kafelek koloru dnia z opisem pod napisem) */
    .gl-skroty .tiles { display: block; margin: 16px var(--gutter) 0; padding: 10px 14px 8px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); }
    .gl-skroty :global(.tile) { position: relative; display: grid; grid-template-columns: 24px minmax(0, 1fr); align-items: center; gap: 0 12px; min-height: 44px; padding: 8px 6px; border: 0; border-radius: 8px; background: transparent; box-shadow: none; font-size: 15px; line-height: 1.3; }
    /* (~, nie +: za kafelkiem koloru dnia stoi jego <script>) */
    .gl-skroty :global(.tile ~ .tile) { margin-top: 1px; }
    .gl-skroty :global(.tile ~ .tile)::before { content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 1px; background: var(--line); }
    .gl-skroty :global(.tile:hover) { background: var(--tint); }
    .gl-skroty :global(.tile .kd-pod) { grid-column: 2; margin-top: 1px; }

    /* Najbliższe wydarzenia: zwarte wiersze z małym kafelkiem daty */
    .gl-wyd .event-grid { display: block; }
    .gl-wyd :global(.event) { align-items: flex-start; gap: 12px; min-height: 40px; padding: 8px 2px; border-radius: 0; background: transparent; }
    .gl-wyd :global(.event + .event) { border-top: 1px solid var(--line); }
    .gl-wyd :global(.event:hover) { background: var(--surface); box-shadow: none; }
    .gl-wyd :global(.event:hover .t) { text-decoration: underline; text-underline-offset: 3px; }
    .gl-wyd :global(.datebox) { flex: 0 0 46px; height: 48px; border-radius: 10px; line-height: 1; }
    .gl-wyd :global(.datebox .d) { font-size: 19px; }
    .gl-wyd :global(.datebox .m) { margin-top: 2px; font-size: 11.5px; font-weight: 800; }
    .gl-wyd :global(.event-body) { flex: 1 1 auto; gap: 1px; }
    .gl-wyd :global(.event .k) { font-size: 12.5px; font-weight: 800; letter-spacing: .02em; line-height: 1.35; }
    .gl-wyd :global(.event .t) { font-size: 15px; font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }
    .gl-wyd :global(.event .s) { font-size: 14px; line-height: 1.45; overflow-wrap: anywhere; }

    /* Studia: opis pod kreską, kierunki jako wiersze listy, przycisk rekrutacji na dole ramki */
    .gl-studia .studia-head { display: block; margin: 0; }
    .gl-studia .studia-head h2 { margin-bottom: 4px; padding-bottom: 7px; border-bottom: 2px solid var(--ink); }
    .gl-studia .studia-head p { margin: 10px 0 4px; font-size: 14px; line-height: 1.45; color: var(--muted); }
    .gl-studia .prog-grid { display: block; }
    .gl-studia .prog { gap: 1px; min-height: 40px; padding: 8px 2px; border: 0; border-radius: 0; background: transparent; color: var(--text); }
    .gl-studia .prog + .prog { border-top: 1px solid var(--line); }
    .gl-studia .prog:hover { background: var(--surface); }
    .gl-studia .prog:hover .n { text-decoration: underline; text-underline-offset: 3px; }
    .gl-studia .prog .l { font-size: 12.5px; font-weight: 800; letter-spacing: .02em; line-height: 1.35; text-transform: none; color: var(--primary); }
    :global(:root[data-theme='dark']) .gl-studia .prog .l { color: var(--accent); }
    .gl-studia .prog .n { font-size: 15px; font-weight: 700; line-height: 1.35; color: var(--ink); overflow-wrap: anywhere; }
    .gl-studia .prog .o { font-size: 14px; line-height: 1.45; color: var(--muted); }
    .gl-studia .prog .o:empty { display: none; }
  }
</style>
