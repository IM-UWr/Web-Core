---
// Strona główna (wspólna dla wersji polskiej i angielskiej), kierunek „Założyciele” (dok/estetyka.md):
// okładka na pierwszy ekran (zal/Okladka.astro), pasek menu na górze drugiego ekranu i drugi ekran (zal/DrugiEkran.astro).
// Jedna wersja HTML na każdą szerokość: komputer — zalozyciele.css i zalozyciele-strony.css, telefon (≤ 760 px) — zal-telefon.css.
import Baza from '../layouts/Baza.astro';
import Okladka from './zal/Okladka.astro';
import PasekMenu from './zal/PasekMenu.astro';
import DrugiEkran from './zal/DrugiEkran.astro';
import { stripBase } from '../lib/url';
import { t, drugiJezyk } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { wyroznionaAktualnosc } from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const sciezka = stripBase(Astro.url.pathname);
// wpis z polem „Wyróżnij do…” — plakietka nad logo okładki
const wyrozniona = await wyroznionaAktualnosc(lang);
---
<Baza tytul={t(lang, 'instytut')} stronaGlowna>
  <Okladka lang={lang} inny={drugiJezyk(sciezka)} wyrozniona={wyrozniona ? { tytul: wyrozniona.tytul, adres: wyrozniona.href } : undefined} />
  <div id="szybki-dostep" class="z-druga-start"></div>
  <PasekMenu lang={lang} sciezka={sciezka} inny={drugiJezyk(sciezka)} class="z-pasek-jasny" />
  <DrugiEkran lang={lang} />
</Baza>
