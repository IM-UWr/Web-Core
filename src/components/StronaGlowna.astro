    .gl-studia .prog .l { font-size: 12.5px; font-weight: 800; letter-spacing: .02em; line-height: 1.35; text-transform: none; color: var(--primary); }
    :global(:root[data-theme='dark']) .gl-studia .prog .l { color: var(--accent); }
    .gl-studia .prog .n { font-size: 15px; font-weight: 700; line-height: 1.35; color: var(--ink); overflow-wrap: anywhere; }
    .gl-studia .prog .o { font-size: 14px; line-height: 1.45; color: var(--muted); }
    .gl-studia .prog .o:empty { display: none; }
  }
</style>
