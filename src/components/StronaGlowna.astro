    .gl-tel-warto { padding-bottom: 20px; }
    /* nagłówek ramki: tytuł z bursztynowym znacznikiem, link z prawej, gruba kreska pod spodem */
    .gl-box .section-head { flex-wrap: wrap; align-items: baseline; gap: 2px 14px; margin: 0 0 4px; padding-bottom: 7px; border-bottom: 2px solid var(--ink); }
