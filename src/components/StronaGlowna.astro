    :global(:root[data-theme='dark']) .gl-box .section-head, :global(:root[data-theme='dark']) .gl-studia .studia-head h2 { border-bottom-color: var(--line); }
    .gl-box .link-arrow { gap: 5px; min-height: 40px; font-size: 14px; white-space: nowrap; }
    .gl-box .link-arrow :global(svg) { width: 14px !important; height: 14px !important; }
    .gl-sem-l { gap: 0 10px; min-width: 0; }
    .gl-sem-zakres { font-size: 13px; font-weight: 700; }

    /* Na skróty: kafelki jako wiersze w ramce (ikona z lewej, napis obok; kafelek koloru dnia z opisem pod napisem) */
    .gl-skroty .tiles { display: block; margin: 16px var(--gutter) 0; padding: 10px 14px 8px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); }
    .gl-skroty :global(.tile) { position: relative; display: grid; grid-template-columns: 24px minmax(0, 1fr); align-items: center; gap: 0 12px; min-height: 44px; padding: 8px 6px; border: 0; border-radius: 8px; background: transparent; box-shadow: none; font-size: 15px; line-height: 1.3; }
    /* (~, nie +: za kafelkiem koloru dnia stoi jego <script>) */
    .gl-skroty :global(.tile ~ .tile) { margin-top: 1px; }
    .gl-skroty :global(.tile ~ .tile)::before { content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 1px; background: var(--line); }
    .gl-skroty :global(.tile:hover) { background: var(--tint); }
    .gl-skroty :global(.tile .kd-pod) { grid-column: 2; margin-top: 1px; }

    /* Najbliższe wydarzenia: zwarte wiersze z małym kafelkiem daty */
    .gl-wyd .event-grid { display: block; }
    .gl-wyd :global(.event) { align-items: flex-start; gap: 12px; min-height: 40px; padding: 8px 2px; border-radius: 0; background: transparent; }
    .gl-wyd :global(.event + .event) { border-top: 1px solid var(--line); }
    .gl-wyd :global(.event:hover) { background: var(--surface); box-shadow: none; }
    .gl-wyd :global(.event:hover .t) { text-decoration: underline; text-underline-offset: 3px; }
    .gl-wyd :global(.datebox) { flex: 0 0 46px; height: 48px; border-radius: 10px; line-height: 1; }
    .gl-wyd :global(.datebox .d) { font-size: 19px; }
