---
// Strona główna (wspólna dla wersji polskiej i angielskiej), kierunek „Założyciele” (dok/estetyka.md):
// okładka na pierwszy ekran (zal/Okladka.astro), pasek menu na górze drugiego ekranu i drugi ekran (zal/DrugiEkran.astro).
// Jedna wersja HTML na każdą szerokość: komputer — zalozyciele.css i zalozyciele-strony.css, telefon (≤ 1023 px) — zal-telefon.css.
import Baza from '../layouts/Baza.astro';
import Okladka from './zal/Okladka.astro';
import PasekMenu from './zal/PasekMenu.astro';
import DrugiEkran from './zal/DrugiEkran.astro';
import ZdjeciePreload from './ZdjeciePreload.astro';
import ustawienia from '../data/ustawienia.json';
import { rozmiarOkl } from '../lib/zdjecia';
import { stripBase } from '../lib/url';
import { t, drugiJezyk } from '../lib/i18n';
import type { Lang } from '../lib/daty';

interface Props { lang: Lang }
const { lang } = Astro.props;
const sciezka = stripBase(Astro.url.pathname);
---
<Baza tytul={t(lang, 'instytut')} stronaGlowna>
  <ZdjeciePreload slot="head" src={ustawienia.baner.zdjecie} sizes={rozmiarOkl} />
  <Okladka lang={lang} inny={drugiJezyk(sciezka)} />
  {/* drugi ekran razem z paskiem jako jeden obszar: drugi z dwóch stanów strony (okładka albo Szybki dostęp, zlecenie 23, punkt 2;
      src/scripts/zal/przejazd.ts); w tym obszarze przewija się zwyczajnie */}
  <div id="szybki-dostep" class="z-druga-obszar" tabindex="-1">
    <PasekMenu lang={lang} sciezka={sciezka} inny={drugiJezyk(sciezka)} class="z-pasek-jasny" />
    <DrugiEkran lang={lang} />
  </div>
</Baza>
