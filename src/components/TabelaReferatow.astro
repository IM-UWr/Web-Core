---
// Zwarta lista referatów (strona główna: „Seminaria w tym tygodniu”).
import { u } from '../lib/url';
import { wJezyku } from '../lib/i18n';
import { dayShort, short, time, type Lang } from '../lib/daty';
import { sala } from '../lib/tresci';
import TytulReferatu from './TytulReferatu.astro';

interface Wiersz { termin: string; sala?: string; seminarium: string; tytul: string; prelegent: string; href: string }
interface Props { wiersze: Wiersz[]; lang: Lang; pusty: string; etykieta: string }
const { wiersze, lang, pusty, etykieta } = Astro.props;
---
<div class="sem-table" role="table" aria-label={etykieta}>
  {wiersze.length === 0 && <p class="sem-empty">{pusty}</p>}
  {wiersze.map((w) => (
    <a class="sem-row" role="row" href={u(wJezyku(w.href, lang))}>
      <span class="day" role="cell">{dayShort(w.termin, lang)} {short(w.termin).slice(0, 5)}</span>
      <span class="time" role="cell">{time(w.termin)}</span>
      <span class="room" role="cell">{sala(w.sala, lang) ?? ''}</span>
      <span class="sem" role="cell">{w.seminarium}</span>
      <span class="talk" role="cell"><b><TytulReferatu tekst={w.tytul} /></b><span> — {w.prelegent}</span></span>
    </a>
  ))}
</div>
