---
// Kafelek „Dziś: dzień niebieski / pomarańczowy” w sekcji „Na skróty” na stronie głównej.
// Pokazuje się zamiast zwykłego kafelka, którego adres to /studia/rok-akademicki (src/data/skroty.json, stała KOLORY_DNI
// w StronaGlowna.astro). W dniu zamiany główny napis to „Dziś zajęcia jak w środę”, a w kropce skrót „ŚR”.
// HTML ma stan z dnia budowania; skrypt odświeża go dla dzisiejszej daty (Europe/Warsaw).
import { u, isExternal } from '../lib/url';
import { wJezyku } from '../lib/i18n';
import { today, type Lang } from '../lib/daty';
import { tekstDnia } from '../lib/kolory-dni';

interface Props { lang: Lang; adres: string; etykieta: string }
const { lang, adres, etykieta } = Astro.props;
const t0 = tekstDnia(today(), lang);
const brakDanych = !t0.kolor && !t0.nastepny;
---
<a
  class="tile kd-kafelek"
  href={isExternal(adres) ? adres : u(wJezyku(adres, lang))}
  data-kd-kafelek
  data-etykieta={etykieta}
  data-kolor={t0.kolor ?? 'brak'}
  data-zamiana={t0.zamiana ?? ''}
  data-nastepny={t0.nastepnyKolor ?? ''}
>
  <span class="kd-kropka" aria-hidden="true" data-kd-litera>{t0.litera}</span>
  <span data-kd-tytul>{brakDanych ? etykieta : t0.tytul}</span>
  <span class="kd-pod" data-kd-opis hidden={!t0.opis}>{t0.opis}</span>
</a>

<script>
  import { tekstDnia } from '../lib/kolory-dni';
  import { today } from '../lib/daty';

  const lang = document.documentElement.lang === 'en' ? 'en' : 'pl';
  const t = tekstDnia(today(), lang);
  document.querySelectorAll<HTMLElement>('[data-kd-kafelek]').forEach((el) => {
    const brak = !t.kolor && !t.nastepny;
    el.dataset.kolor = t.kolor ?? 'brak';
    el.dataset.zamiana = t.zamiana ? String(t.zamiana) : '';
    el.dataset.nastepny = t.nastepnyKolor ?? '';
    const ust = (sel: string, txt: string, ukryj = true) => {
      const x = el.querySelector<HTMLElement>(sel);
      if (x) { x.textContent = txt; if (ukryj) x.hidden = !txt; }
    };
    ust('[data-kd-litera]', t.litera, false);
    ust('[data-kd-tytul]', brak ? el.dataset.etykieta || t.tytul : t.tytul);
    ust('[data-kd-opis]', t.opis);
  });
</script>

<style>
  /* Wygląd jak pozostałe kafelki (.tile w global.css); zamiast ikony — kolorowa kropka (w dniu zamiany pigułka ze skrótem dnia planu). */
  .kd-kafelek {
    --kd-n-mocny: #0e9cbc; --kd-p-mocny: #e0841b;
  }
  :global(:root[data-theme='dark']) .kd-kafelek { --kd-n-mocny: #3cc8e6; --kd-p-mocny: #f2a33a; }
  .kd-kropka { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; border: 2px dashed var(--muted); color: var(--muted); font-size: 12px; font-weight: 800; line-height: 1; }
  .kd-kafelek:not([data-zamiana='']) > .kd-kropka { width: auto; min-width: 24px; height: 26px; padding: 0 8px; border-radius: 999px; font-size: 12.5px; font-weight: 900; letter-spacing: .02em; align-self: flex-start; }
  .kd-kafelek:not([data-zamiana='']) > [data-kd-tytul] { font-weight: 800; }
  /* dzień zamiany: obwódka w kolorze dnia, jak komórka w kalendarzu */
  .kd-kafelek[data-kolor='niebieski']:not([data-zamiana='']) { box-shadow: inset 0 0 0 2px var(--kd-n-mocny); }
  .kd-kafelek[data-kolor='pomaranczowy']:not([data-zamiana='']) { box-shadow: inset 0 0 0 2px var(--kd-p-mocny); }
  [data-kolor='niebieski'] > .kd-kropka { border: 0; background: var(--kd-n-mocny); color: #04222b; }
  [data-kolor='pomaranczowy'] > .kd-kropka { border: 0; background: var(--kd-p-mocny); color: #2b1700; }
  .kd-pod { font-size: 13px; font-weight: 600; line-height: 1.35; color: var(--muted); }
  @media (max-width: 760px) { .kd-pod { margin-top: -6px; } }
  @media (min-width: 761px) { .kd-pod { margin-top: 0; } }
  [data-kolor='brak'][data-nastepny] > .kd-pod::before { content: ''; display: inline-block; width: 9px; height: 9px; margin-right: 6px; border-radius: 50%; vertical-align: 0; }
  [data-kolor='brak'][data-nastepny='niebieski'] > .kd-pod::before { background: var(--kd-n-mocny); }
  [data-kolor='brak'][data-nastepny='pomaranczowy'] > .kd-pod::before { background: var(--kd-p-mocny); }
  [data-kolor='brak'][data-nastepny=''] > .kd-pod::before { display: none; }
</style>
