---
// Wiersz wydarzenia (Kalendarz, „Najbliższe wydarzenia” pod aktualnością) w języku podstron „Założycieli”: data jak na
// stronach działów (zal/dzial/Wiersz.astro — dzień dużą Brygadą, pod nim „mie rrrr”; minione — szarym), obok mała etykieta
// „Rodzaj · dzień i godzina · miejsce”, tytuł Brygadą (referat — wzory przez KaTeX, strona zewnętrzna — z ikoną), podtytuł
// i opis referatu. Cały wiersz klikalny (link w tytule); konferencja bez strony — wiersz bez linku. Wiersze rozdzielone
// cienką linią. Jedna wersja HTML: komputer (≥ 1024 px) i telefon (≤ 1023 px, węższa kolumna daty).
// data-ww i data-rodzaj — filtr i szukanie w Kalendarzu i na liście Obron (szukanie w .ww-tresc, bez daty).
// zwarty — listy w stylu Aktualności (Kalendarz, Obrony; zlecenie 27): na komputerze ten sam wzór wiersza co WierszAktualnosci.astro
//   (węższa kolumna daty, mniejsze pismo), a data także minionych pozycji w kolorze działu. bezRodzaju — etykieta bez rodzaju (lista Obron).
// Slot: dodatkowe linie pod opisem (np. promotor na liście Obron).
import Link from './Link.astro';
import TytulReferatu from './TytulReferatu.astro';
import { u, isExternal } from '../lib/url';
import { wJezyku, RODZAJE } from '../lib/i18n';
import { dayNum, monthShort, dayShort, parse, range, time, hasTime, type Lang } from '../lib/daty';
import { trwaLubBedzie, type Wydarzenie } from '../lib/tresci';
import type { Dzial } from '../lib/patroni';

// dzial — własny kolor wiersza pod wpisem o wydarzeniu (zlecenie 21, punkt 6); bez niego kolor otoczenia
interface Props { w: Wydarzenie; lang: Lang; poziom?: 'h2' | 'h3'; dzial?: Dzial; zwarty?: boolean; bezRodzaju?: boolean }
const { w, lang, poziom = 'h3', dzial, zwarty = false, bezRodzaju = false } = Astro.props;
const H = poziom;
const zewn = !!w.href && isExternal(w.href);
const adres = w.href ? (zewn ? w.href : u(wJezyku(w.href, lang))) : undefined;
const minione = !trwaLubBedzie(w);
const kiedy = hasTime(w.poczatek) ? `${dayShort(w.poczatek, lang)} ${time(w.poczatek)}` : range(w.poczatek, w.koniec, lang);
const etykieta = [bezRodzaju ? '' : RODZAJE[w.rodzaj]?.[lang], kiedy, w.miejsce].filter(Boolean).join(' · ');
---
<article class:list={['ww', adres && 'ww-klik', minione && 'ww-minione', zwarty && 'ww-zwarty']} data-ww data-rodzaj={w.rodzaj} data-dzial={dzial}>
  <time class="ww-data" datetime={w.poczatek.slice(0, 10)}>{dayNum(w.poczatek)}<small>{monthShort(w.poczatek, lang)} {parse(w.poczatek).y}</small></time>
  <div class="ww-tresc">
    <div class="ww-rodz">{etykieta}</div>
    <H class="ww-t" lang={w.tytulLang}>
      {adres
        ? <Link href={adres}>{w.rodzaj === 'referat' ? <TytulReferatu tekst={w.tytul} jezyk={w.jezyk} lang={lang} /> : w.tytul}</Link>
        : w.rodzaj === 'referat' ? <TytulReferatu tekst={w.tytul} jezyk={w.jezyk} lang={lang} /> : w.tytul}
    </H>
    {w.podtytul && <p lang={w.rodzaj === 'obrona' ? 'en' : undefined}>{w.podtytul}</p>}
    {w.rodzaj === 'referat' && w.opis && <p class="ww-opis">{w.opis}</p>}
    <slot />
  </div>
</article>

<style>
  .ww { position: relative; display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .ww[hidden] { display: none; }
  .ww-data { font-family: var(--f-display); font-weight: 500; font-size: 34px; line-height: 1; color: var(--d-a); font-variant-numeric: lining-nums; }
  .ww-data small { display: block; margin-top: 4px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  .ww-minione .ww-data { color: var(--muted); }
  .ww-rodz { font-size: 13px; font-weight: 700; line-height: 1.4; color: var(--d-a); }
  .ww-t { margin: 2px 0 4px; font-family: var(--f-display); font-weight: 500; font-size: 21px; line-height: 1.3; letter-spacing: normal; color: var(--ink); }
  .ww-t a { color: inherit; text-decoration: none; }
  /* cały wiersz klikalny; fokus rysowany na całym wierszu */
  .ww-t a::before { content: ''; position: absolute; inset: 0; } /* nakładka na ::before — ::after to strzałka ↗ linku poza stronę */
  .ww-t a:focus-visible { outline: none; }
  .ww:has(.ww-t a:focus-visible) { outline: 3px solid var(--d-a); outline-offset: 4px; }
  .ww-klik:hover .ww-t a { color: var(--d-a); }
  .ww p { margin: 0; max-width: none; font-size: 15.5px; line-height: 1.55; color: var(--text); }
  .ww .ww-opis { margin-top: 2px; font-size: 14px; color: var(--muted); }
  /* lista w stylu Aktualności: kolor działu także dla minionych */
  .ww-zwarty.ww-minione .ww-data { color: var(--d-a); }

  /* Telefon i komputer: ta sama definicja co MQ_TELEFON i MQ_KOMPUTER w src/lib/media.ts (zlecenie 23, punkt 1) */
  /* komputer, lista w stylu Aktualności: wymiary wiersza z WierszAktualnosci.astro */
  @media (min-width: 1024px) and (min-height: 501px), (min-width: 1024px) and (pointer: fine) {
    .ww-zwarty { grid-template-columns: 58px minmax(0, 1fr); gap: 12px; padding: 14px 0; }
    .ww-zwarty .ww-data { font-size: 26px; }
    .ww-zwarty .ww-data small { font-size: 12px; white-space: nowrap; }
    .ww-zwarty .ww-t { margin: 1px 0 3px; font-size: 18.5px; line-height: 1.28; }
    .ww-zwarty p { font-size: 14.5px; line-height: 1.5; }
    .ww-zwarty .ww-opis { font-size: 13px; }
  }

  @media (max-width: 1023px), (max-height: 500px) and (pointer: coarse) {
    .ww { grid-template-columns: 54px minmax(0, 1fr); gap: 12px; padding: 13px 0; }
    .ww-data { font-size: 28px; }
    .ww-data small { font-size: 12px; }
    .ww-t { font-size: 18.5px; }
    .ww p { font-size: 15px; }
  }
</style>
