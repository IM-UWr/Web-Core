---
// Nagłówki stron (kierunek „Założyciele”, dok/estetyka.md), wstawiane przez NaglowekStrony.astro. Jedna wersja HTML:
// komputer (≥ 761 px) — src/styles/zalozyciele.css, telefon (≤ 760 px) — src/styles/zal-telefon.css.
//
// rodzaj „dzial” — baner strony działu („opcja 4”): granat przechodzi w zdjęcie działu w dwóch kolorach (cienie granatowe,
//   światła w jasnym kolorze działu), szkic patrona jasną kreską z poświatą, notka o patronie i podpis. Szkic i podpis rysują
//   się tylko przy pierwszym wejściu w wizycie (src/scripts/zal/szkice.ts). Pod tytułem hasło i liczby — tylko gdy są liczby.
// rodzaj „podstrona” — nagłówek podstrony: głęboki kolor działu na zdjęciu działu (mocniej z lewej, słabiej w prawo),
//   „← Dział”, sygnet z małym podpisem w lewym marginesie i znak patrona z opisem przy prawej krawędzi. Bez animacji.
//   Znak i opis (ciekawostka) tylko na podstronach z menu działu; strony głębiej mają sygnet i tytuł. Hasło i liczby — gdy są.
//   Strony bez działu (Aktualności, Kalendarz, strony ogólne) — granat, bez sygnetu i znaku.
import Szkic from './Szkic.astro';
import ZdjecieZ from '../ZdjecieZ.astro';
import { u, stripBase } from '../../lib/url';
import { t, wJezyku, wybierz } from '../../lib/i18n';
import { menuGlowne } from '../../lib/menu';
import { PATRONI, pole, znakDzialu, ramkaZnaku, dzialZeSciezki, type Dzial } from '../../lib/patroni';
import { pulaDzialu, stronyDzialu, ukladStaly, pulaDoSkryptu, tytulCiekawostki, zdanieCiekawostki, type Ciekawostka } from '../../lib/ciekawostki';
import type { Lang } from '../../lib/daty';

interface Props {
  rodzaj: 'dzial' | 'podstrona';
  dzial?: Dzial;
  tytul: string;
  tytulLang?: string;
  haslo?: string;
  lang: Lang;
  // HTML przekazany do banera przez widok (liczby .pt-liczby, plakietki, linki) — pokazywany pod tytułem
  slot?: string;
  // link „← …” (podstrona: dział albo poziom wyżej)
  wstecz: { etykieta: string; adres: string };
  // ciekawostka patrona: znak z opisem, losowana na wizytę (podstrony z menu działu; zlecenie 11, zalecenie 19)
  znak?: boolean;
}
const { rodzaj, dzial, tytul, tytulLang, lang, slot: slotWidoku = '', wstecz, znak = false } = Astro.props;
const P = dzial ? PATRONI[dzial] : undefined;
// Trzy style banerów (zlecenie 11, zalecenie 2): baner działu; podstrona z liczbami (tytuł, hasło, kreska, liczby);
// podstrona bez liczb (sam tytuł). Hasło i liczby razem albo wcale: liczby bez hasła w danych nie pokazują się
// (styl 3), hasło bez liczb też nie. Baner działu: gdy w CMS hasło działu puste — hasło z prototypu (decyzja 2.11).
// liczby w banerze: lista .pt-liczby przekazana przez widok (LiczbyBanera.astro albo własna lista widoku)
const LISTA_LICZB = /<ul class="pt-liczby[^"]*"[^>]*>[\s\S]*?<\/ul>/g;
const maLiczby = /<ul class="pt-liczby/.test(slotWidoku);
const hasloDanych = Astro.props.haslo?.trim() || (rodzaj === 'dzial' && P ? pole(P, 'haslo', lang) : undefined);
const zLiczbami = maLiczby && !!hasloDanych;
const haslo = zLiczbami ? hasloDanych : undefined;
const slot = zLiczbami ? slotWidoku : slotWidoku.replace(LISTA_LICZB, '').trim();
// do uzupełnienia w CMS: ostrzeżenie przy budowaniu (lista stron w RAPORT-ZLECENIE-11.md)
if (maLiczby && !hasloDanych) console.warn(`[baner] liczby bez hasła (brak pola hasła w CMS): ${Astro.url.pathname}`);

// Zdjęcia działów (na razie z public/pliki/naglowki, repozytorium treści Web-Ustawienia): kadr i jasność dobrane w prototypie.
// Studia (zlecenie 11, zalecenie 17): sala HS od tyłu (3200 px), domyślny filtr bez rozjaśnienia; na komputerze zdjęcie przypięte
// do szkicu patrona (zalozyciele.css), na telefonie zwykłe object-fit: cover.
const FOTO: Record<string, { zdjecie: string; kadr: string; filtr?: string; alt?: { pl: string; en: string } }> = {
  instytut: { zdjecie: '/pliki/naglowki/instytut.jpg', kadr: '50% 42%' },
  nauka: { zdjecie: '/pliki/naglowki/nauka.jpg', kadr: '50% 30%', filtr: 'grayscale(1) contrast(1.15) brightness(1.45)' },
  studia: { zdjecie: '/pliki/naglowki/studia.jpg', kadr: '50% 40%', alt: {
    pl: 'Sala wykładowa HS: wykład przy tablicach, studenci w ławkach od tyłu',
    en: 'Lecture room HS: a lecture at the blackboards, students in the benches seen from behind' } },
  popularyzacja: { zdjecie: '/pliki/naglowki/popularyzacja.jpg', kadr: '50% 40%' },
  granat: { zdjecie: '/pliki/naglowki/aktualnosci.jpg', kadr: '50% 40%' },
};
const f = FOTO[dzial ?? 'granat'];
const altFoto = f.alt ? f.alt[lang] : '';
const styl = `object-position:${rodzaj === 'podstrona' ? '50% 40%' : f.kadr}${f.filtr ? `;--filtr:${f.filtr}` : ''}`;
// szerokość zdjęcia na ekranie (sizes; zlecenie 13, punkt 6) — jak w zalozyciele.css: baner działu od 36% szerokości, Studia
// w szerokości --sz przypiętej do szkicu (zlecenie 11, zalecenie 17), podstrona Studiów 122% (same tablice), telefon — cały ekran.
// Zdjęcie wypełnia pole przez object-fit: cover, więc gdy pole jest wyższe niż zdjęcie w tej szerokości, potrzebna szerokość
// to wysokość pola × proporcje zdjęcia (p): baner działu ma ok. 366 px wysokości na komputerze i do ok. 410 px na telefonie,
// nagłówek podstrony na telefonie do ok. 300 px (pomiar 5.11.2026 w Edge, 390–1920 px)
const KOMPUTER = '(min-width: 761px)';
const px = (wys: number, p: number) => `${Math.ceil(wys * p)}px`;
const rozmiar = (p: number) => rodzaj === 'dzial'
  ? (dzial === 'studia'
    ? `${KOMPUTER} max(1454px, calc((max(64px, (100vw - 1240px) / 2) + 155px) / .4025)), max(100vw, ${px(410, p)})`
    : `${KOMPUTER} max(64vw, ${px(370, p)}), max(100vw, ${px(410, p)})`)
  : (dzial === 'studia' ? `${KOMPUTER} 122vw, max(100vw, ${px(300, p)})` : `max(100vw, ${px(300, p)})`);

// Ciekawostka patrona (zalecenie 19): każda podstrona z menu działu dostaje inną ciekawostkę patrona, losowaną raz na wizytę
// (sessionStorage „im-ciek-zestaw”: {dział: {strona: id}}) skryptem w linii za znakiem, zanim strona się narysuje; pula działu
// w linii (tylko to, co widać). Bez JS albo bez sessionStorage: ciekawostka stała z budowania (ukladStaly). Pusta pula:
// dawny stały znak działu.
const strona = stripBase(Astro.url.pathname).replace(/^\/en(?=\/|$)/, '').replace(/\/$/, '') || '/';
const pulaCk = P && znak ? pulaDzialu(P.dzial) : [];
let ck: Ciekawostka | undefined;
let ckDane = '';
if (P && pulaCk.length) {
  const strony = stronyDzialu(await menuGlowne(), P.adres, (a) => dzialZeSciezki(a) === P.dzial);
  if (!strony.includes(strona)) strony.push(strona);
  const idStaly = ukladStaly(pulaCk, strony)[strona];
  ck = pulaCk.find((c) => c.id === idStaly) ?? pulaCk[0];
  ckDane = JSON.stringify(pulaDoSkryptu(pulaCk, strony, lang)).replace(/</g, '\\u003c');
}
const kreski = ck ? ck.sciezki : P && znak ? znakDzialu(P.dzial, true) : [];
const ramka = !ck && kreski.length && zLiczbami ? ramkaZnaku(kreski).join(' ') : '0 0 200 240';
const opisZnaku = P && ck ? [tytulCiekawostki(ck, lang), zdanieCiekawostki(ck, lang)] : P ? [pole(P, 'znakNazwa', lang), pole(P, 'znakFakt', lang)] : [];
// EN krócej (zlecenie 14, zalecenie 26): „1887–1972 · section patron · room HS” mieści się w jednej linii
const patronDzialu = lang === 'en' ? 'section patron' : 'patron działu';
// Baner działu: tytułem jest nazwa działu z menu (np. „Popularyzacja”), a nie tytuł strony z danych („Popularyzacja
// matematyki” zostaje w <title> i na telefonie).
const zMenu = rodzaj === 'dzial' && P ? (await menuGlowne()).find((m) => m.adres === P.adres) : undefined;
const tytulBanera = rodzaj === 'dzial' && P ? ((zMenu && (wybierz(zMenu, 'etykieta', lang) as string)) || pole(P, 'nazwa', lang)) : tytul;
// Stan szkicu ustawiany od razu, zanim strona się narysuje (opis w zalozyciele.css i src/scripts/zal/szkice.ts), i start
// rysowania stąd, bez czekania na moduł (zlecenie 13, punkt 2): .z-czeka przy pierwszym wejściu w dział w tej wizycie
// (zapis w sessionStorage „im-wizyta-dzialy” potwierdzony odczytem), gdy szkic widać — dwie klatki i .z-rysuj, czas startu
// w data-z-start, zdarzenie „z-rysuj” dla modułu (tempo podpisu). Ograniczony ruch, powrót albo brak zapisu: .z-gotowe.
// Strona główna czyści ten zapis (Okladka.astro, zlecenie 14, zalecenie 28) — po okładce dział znowu się rysuje.
// Wczytywanie z wyprzedzeniem (prerender, punkt 4): w tle tylko odczyt (szkic czeka niewidoczny), zapis i rysowanie po
// pokazaniu strony (prerenderingchange).
const STAN = `(function(b){var k='im-wizyta-dzialy',dz=b.getAttribute('data-z-baner-dzialu'),sz=b.querySelector('.z-szkic');` +
  `function nowy(zapis){try{if(matchMedia('(prefers-reduced-motion: reduce)').matches)return false;` +
  `var z=JSON.parse(sessionStorage.getItem(k)||'[]');if(z.indexOf(dz)>=0)return false;if(!zapis)return true;` +
  `z.push(dz);sessionStorage.setItem(k,JSON.stringify(z));return JSON.parse(sessionStorage.getItem(k)||'[]').indexOf(dz)>=0}catch(e){return false}}` +
  `function rysuj(){function go(){requestAnimationFrame(function(){requestAnimationFrame(function(){` +
  `b.classList.add('z-rysuj');b.classList.remove('z-czeka');b.setAttribute('data-z-start',performance.now());b.dispatchEvent(new Event('z-rysuj'))})})}` +
  `if(!sz||!window.IntersectionObserver)return go();var io=new IntersectionObserver(function(w){` +
  `for(var i=0;i<w.length;i++)if(w[i].isIntersecting){io.disconnect();return go()}});io.observe(sz)}` +
  `function gotowe(){b.classList.remove('z-czeka');b.classList.add('z-gotowe')}` +
  `if(document.prerendering&&nowy(false)){b.classList.add('z-czeka');` +
  `document.addEventListener('prerenderingchange',function(){if(nowy(true))rysuj();else gotowe()},{once:true})}` +
  `else if(!document.prerendering&&nowy(true)){b.classList.add('z-czeka');rysuj()}else gotowe()})(document.currentScript.parentElement);`;
const salaNapis = lang === 'en' ? 'room' : 'sala';
// Losowanie ciekawostki (wzór: prototyp, ckUloz / ckStart): 1) przypięte na swoich stronach, 2) zestaw tej wizyty (ważne
// pozycje zostają), 3) reszta stron dostaje ciekawostki w kolejności ważonej Math.random() ** (1 / waga), waga 3 dla
// ulubionych; bez powtórzeń w dziale. Wczytywanie z wyprzedzeniem (prerender, zlecenie 13): pokaz bez zapisu, po pokazaniu
// strony uzgodnienie z zestawem wizyty (gdy go nie ma — ten wybór staje się zestawem). Do końca skryptu znak i opis
// niewidoczne (klasa z-ck-losuje), więc stała ciekawostka z budowania nie mignie.
// Dane: D = {s: strony działu, p: {strona: id} przypięte, c: [[id, tytuł, zdanie, waga, [[d, gruba?], …]], …]}.
const CK = `(function(n,D,dz,st){var K='im-ciek-zestaw',ids={},i;for(i=0;i<D.c.length;i++)ids[D.c[i][0]]=D.c[i];` +
  `function uloz(pop){var u={},uz={},s,j,k=0,r;` +
  `for(s in D.p)if(ids[D.p[s]]&&!uz[D.p[s]]){u[s]=D.p[s];uz[D.p[s]]=1}` +
  `if(pop)for(j=0;j<D.s.length;j++){s=D.s[j];if(!u[s]&&ids[pop[s]]&&!uz[pop[s]]){u[s]=pop[s];uz[pop[s]]=1}}` +
  `r=D.c.filter(function(c){return!uz[c[0]]}).map(function(c){return[Math.pow(Math.random(),1/c[3]),c[0]]}).sort(function(a,b){return b[0]-a[0]});` +
  `for(j=0;j<D.s.length;j++){s=D.s[j];if(!u[s])u[s]=r.length?r[k++%r.length][1]:D.c[j%D.c.length][0]}return u}` +
  `function czytaj(){try{return JSON.parse(sessionStorage.getItem(K)||'{}')||{}}catch(e){return null}}` +
  `function zapisz(z,u){try{z[dz]=u;sessionStorage.setItem(K,JSON.stringify(z));return!!(JSON.parse(sessionStorage.getItem(K))[dz]||{})[st]}catch(e){return false}}` +
  `function pokaz(id){var c=ids[id],v=n.querySelector('.z-znak'),o=n.querySelector('.z-znak-opis'),p,j;if(!c||!v||!o||n.getAttribute('data-ck')===id)return;` +
  `while(v.firstChild)v.removeChild(v.firstChild);for(j=0;j<c[4].length;j++){p=document.createElementNS('http://www.w3.org/2000/svg','path');` +
  `p.setAttribute('d',c[4][j][0]);p.setAttribute('pathLength','1');if(c[4][j][1])p.setAttribute('class','gruba');v.appendChild(p)}` +
  `o.querySelector('b').textContent=c[1];o.querySelector('span').textContent=c[2];n.setAttribute('data-ck',id)}` +
  `try{var z=czytaj(),u;if(z){u=uloz(z[dz]);` +
  `if(document.prerendering)document.addEventListener('prerenderingchange',function(){var z2=czytaj(),u2;if(!z2)return;u2=uloz(z2[dz]||u);` +
  `if(zapisz(z2,u2)&&u2[st]!==u[st]){pokaz(u2[st]);dispatchEvent(new Event('resize'))}},{once:true});` +
  `if(document.prerendering||zapisz(z,u))pokaz(u[st])}}catch(e){}finally{n.classList.remove('z-ck-losuje')}})`;
// Dopasowanie nagłówka (zlecenie 11, zalecenia 2 i 9), w linii na końcu nagłówka — zanim strona się narysuje, potem przy
// zmianie rozmiaru okna i po wczytaniu krojów:
// - granica z prawej: lewa krawędź ciekawostki (znak z opisem) albo notki o patronie; odstęp tytułu 40 px (zalecenie 9),
//   rzędu liczb 20 px (zalecenie 2, zmiana 5.11, 11:30 z 40 px);
// - tytuł podstrony najwyżej w dwóch liniach: jeśli zająłby więcej, stopień maleje co 4 px, najwyżej do 44 px; szerokość
//   do granicy; przy dwóch liniach sygnet (z podpisem) podnosi się o pół linii — środek blisko środka dwóch linii tytułu;
// - liczby zawsze w jednym rzędzie (CSS: zawijanie i wysokość jednego rzędu): szerokość rzędu do granicy, liczby
//   z drugiego rzędu są niewidoczne w całości i dostają aria-hidden; pierwsza zostaje zawsze. Telefon: najwyżej trzy.
const DOPASUJ = `(function(n){function px(v){return parseFloat(v)||0}` +
  `function dopasuj(){var tel=innerWidth<761,h1=n.querySelector('h1'),ul=n.querySelector('.z-slot .pt-liczby'),g=n.querySelector('.z-tyt-g'),` +
  `ty=n.querySelector('.z-tyt,.z-tytul'),nr=n.getBoundingClientRect(),gr=Infinity;` +
  // granica z prawej: lewy brzeg tekstu ciekawostki (nie jej pudełka — tekst jest wyrównany do prawej) i znaku; w opisie
  // znaku tylko linie tekstu (tytuł ciekawostki ma pudełko wysunięte o 160 px w lewo, zalecenie 19)
  `n.querySelectorAll('.z-ciek,.z-ciek-opis,.z-znak,.z-znak-opis,.z-patron').forEach(function(e){var rs,g,w,t;` +
  `if(e instanceof SVGElement||!e.textContent.trim())rs=[e.getBoundingClientRect()];` +
  `else if(e.classList.contains('z-znak-opis')){rs=[];w=document.createTreeWalker(e,4);while(t=w.nextNode()){g=document.createRange();g.selectNodeContents(t);rs.push.apply(rs,[].slice.call(g.getClientRects()))}}` +
  `else{g=document.createRange();g.selectNodeContents(e);rs=g.getClientRects()}` +
  `for(var i=0;i<rs.length;i++)if(rs[i].width&&rs[i].height)gr=Math.min(gr,rs[i].left)});` +
  `var gl=gr===Infinity?nr.right-(ty?ty.getBoundingClientRect().left-nr.left:64):gr-20;gr=gr===Infinity?gl:gr-40;` +
  `if(h1&&n.classList.contains('z-nagl-pod')){h1.style.fontSize='';h1.style.maxWidth='';var lin=1;` +
  `if(!tel){h1.style.maxWidth=Math.max(240,gr-h1.getBoundingClientRect().left)+'px';var fs=px(getComputedStyle(h1).fontSize),lh=px(getComputedStyle(h1).lineHeight);lin=Math.round(h1.offsetHeight/lh);` +
  `while(lin>2&&fs>44){fs=Math.max(44,fs-4);h1.style.fontSize=fs+'px';lh=px(getComputedStyle(h1).lineHeight);lin=Math.round(h1.offsetHeight/lh)}` +
  `if(g)g.style.setProperty('--syg-podnies',Math.max(0,lin-1)*lh/2+'px')}else if(g)g.style.removeProperty('--syg-podnies');` +
  `n.classList.toggle('z-tyt-dlugi',lin>1)}` +
  `if(ul){ul.style.maxWidth='';if(!tel)ul.style.maxWidth=Math.max(0,gl-ul.getBoundingClientRect().left)+'px';var li=ul.children,t0=li.length?li[0].offsetTop:0;` +
  `for(var i=0;i<li.length;i++){if(tel?i>2:li[i].offsetTop>t0+4)li[i].setAttribute('aria-hidden','true');else li[i].removeAttribute('aria-hidden')}}}` +
  `dopasuj();var cz;addEventListener('resize',function(){cancelAnimationFrame(cz);cz=requestAnimationFrame(dopasuj)});` +
  `if(document.fonts)document.fonts.ready.then(dopasuj)})(document.currentScript.parentElement);`;
---
{rodzaj === 'dzial' && P && (
  <div class="z-nagl z-baner-dzialu" data-dzial={P.dzial} data-z-baner-dzialu={P.dzial} data-pagefind-ignore>
    <div class="z-foto"><span class="z-foto-obr"><ZdjecieZ src={f.zdjecie} alt={altFoto} sizes={rozmiar} loading="eager" fetchpriority="high" style={styl} zastepczy /></span></div>
    <div class="z-szkic-ramka"><Szkic dzial={P.dzial} rodzaj="pelny" /></div>
    <div class="z-tytul">
      <a class="z-wstecz" href={u(wJezyku('/', lang))}>← {t(lang, 'stronaGlowna')}</a>
      <h1 data-pagefind-meta="title">{tytulBanera}</h1>
      {haslo && <p class="z-haslo">{haslo}</p>}
      {zLiczbami && <div class="z-slot" set:html={slot} />}
    </div>
    <span class="z-podpis-ramka"><Szkic dzial={P.dzial} rodzaj="podpis" pisze id="baner" /></span>
    <div class="z-patron">
      <b>{P.patron}</b>
      <span>{`${P.lata} · ${patronDzialu} · ${salaNapis} ${P.sala}`}</span>
      <p>{pole(P, 'notka', lang)}</p>
    </div>
    <script is:inline set:html={STAN} />
    {zLiczbami && <script is:inline set:html={DOPASUJ} />}
  </div>
)}
{rodzaj === 'podstrona' && (
  <div class:list={['z-nagl', 'z-nagl-pod', zLiczbami && 'z-liczbami', !P && 'z-granat', ck && 'z-ck-losuje']} data-dzial={P?.dzial} data-ck={ck?.id} data-pagefind-ignore>
    <div class="z-foto"><span class="z-foto-obr"><ZdjecieZ src={f.zdjecie} alt={altFoto} sizes={rozmiar} loading="eager" fetchpriority="high" style={styl} zastepczy /></span></div>
    <div class="z-tyt">
      <div class="z-tyt-g">
        {P && <Szkic dzial={P.dzial} rodzaj="sygnet" class="z-sygnet-nagl" />}
        <p class="z-sciezka"><a href={u(wJezyku(wstecz.adres, lang))}>← {wstecz.etykieta}</a></p>
        <h1 data-pagefind-meta="title" lang={tytulLang}>{tytul}</h1>
        {P && <span class="z-podpis-maly"><Szkic dzial={P.dzial} rodzaj="podpis" /></span>}
      </div>
      {haslo && <p class="z-haslo">{haslo}</p>}
      {slot && <div class="z-slot" set:html={slot} />}
    </div>
    {P && kreski.length > 0 && (
      <>
        <svg class="z-znak" viewBox={ramka} aria-hidden="true" focusable="false">
          {kreski.map((k) => <path d={k.d} pathLength="1" class={k.gruba ? 'gruba' : undefined} />)}
        </svg>
        <p class="z-znak-opis"><b>{opisZnaku[0]}</b><span>{opisZnaku[1]}</span></p>
        {ck && <script is:inline set:html={`${CK}(document.currentScript.parentElement,${ckDane},${JSON.stringify(P.dzial)},${JSON.stringify(strona)});`} />}
      </>
    )}
    <script is:inline set:html={DOPASUJ} />
  </div>
)}
{rodzaj === 'dzial' && P && <script>import '../../scripts/zal/szkice';</script>}
