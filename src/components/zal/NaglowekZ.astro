---
// Nagłówki stron (kierunek „Założyciele”, dok/estetyka.md), wstawiane przez NaglowekStrony.astro. Jedna wersja HTML:
// komputer (≥ 761 px) — src/styles/zalozyciele.css, telefon (≤ 760 px) — src/styles/zal-telefon.css.
//
// rodzaj „dzial” — baner strony działu („opcja 4”): granat przechodzi w zdjęcie działu w dwóch kolorach (cienie granatowe,
//   światła w jasnym kolorze działu), szkic patrona jasną kreską z poświatą, notka o patronie i podpis. Szkic i podpis rysują
//   się tylko przy pierwszym wejściu w wizycie (src/scripts/zal/szkice.ts). Pod tytułem hasło i liczby — tylko gdy są liczby.
// rodzaj „podstrona” — nagłówek podstrony: głęboki kolor działu na zdjęciu działu (mocniej z lewej, słabiej w prawo),
//   „← Dział”, sygnet z małym podpisem w lewym marginesie i znak patrona z opisem przy prawej krawędzi. Bez animacji.
//   Znak i opis (ciekawostka) tylko na podstronach z menu działu; strony głębiej mają sygnet i tytuł. Hasło i liczby — gdy są.
//   Strony bez działu (Aktualności, Kalendarz, strony ogólne) — granat, bez sygnetu i znaku.
import Szkic from './Szkic.astro';
import { u } from '../../lib/url';
import { t, wJezyku, wybierz } from '../../lib/i18n';
import { menuGlowne } from '../../lib/menu';
import { PATRONI, pole, znakDzialu, ramkaZnaku, type Dzial } from '../../lib/patroni';
import type { Lang } from '../../lib/daty';

interface Props {
  rodzaj: 'dzial' | 'podstrona';
  dzial?: Dzial;
  tytul: string;
  haslo?: string;
  lang: Lang;
  // HTML przekazany do banera przez widok (liczby .pt-liczby, plakietki, linki) — pokazywany pod tytułem
  slot?: string;
  // link „← …” (podstrona: dział albo poziom wyżej)
  wstecz: { etykieta: string; adres: string };
  // ciekawostka: znak patrona z opisem (podstrony z menu działu)
  znak?: boolean;
}
const { rodzaj, dzial, tytul, lang, slot: slotWidoku = '', wstecz, znak = false } = Astro.props;
const P = dzial ? PATRONI[dzial] : undefined;
// Trzy style banerów (zlecenie 11, zalecenie 2): baner działu; podstrona z liczbami (tytuł, hasło, kreska, liczby);
// podstrona bez liczb (sam tytuł). Hasło i liczby razem albo wcale: liczby bez hasła w danych nie pokazują się
// (styl 3), hasło bez liczb też nie. Baner działu: gdy w CMS hasło działu puste — hasło z prototypu (decyzja 2.11).
// liczby w banerze: lista .pt-liczby przekazana przez widok (LiczbyBanera.astro albo własna lista widoku)
const LISTA_LICZB = /<ul class="pt-liczby[^"]*"[^>]*>[\s\S]*?<\/ul>/g;
const maLiczby = /<ul class="pt-liczby/.test(slotWidoku);
const hasloDanych = Astro.props.haslo?.trim() || (rodzaj === 'dzial' && P ? pole(P, 'haslo', lang) : undefined);
const zLiczbami = maLiczby && !!hasloDanych;
const haslo = zLiczbami ? hasloDanych : undefined;
const slot = zLiczbami ? slotWidoku : slotWidoku.replace(LISTA_LICZB, '').trim();
// do uzupełnienia w CMS: ostrzeżenie przy budowaniu (lista stron w RAPORT-ZLECENIE-11.md)
if (maLiczby && !hasloDanych) console.warn(`[baner] liczby bez hasła (brak pola hasła w CMS): ${Astro.url.pathname}`);

// Zdjęcia działów (na razie z public/pliki/naglowki): kadr i jasność dobrane w prototypie.
const FOTO: Record<string, { zdjecie: string; kadr: string; filtr?: string }> = {
  instytut: { zdjecie: '/pliki/naglowki/instytut.jpg', kadr: '50% 42%' },
  nauka: { zdjecie: '/pliki/naglowki/nauka.jpg', kadr: '50% 30%', filtr: 'grayscale(1) contrast(1.15) brightness(1.45)' },
  studia: { zdjecie: '/pliki/naglowki/studia.jpg', kadr: '50% 40%', filtr: 'grayscale(1) contrast(1.15) brightness(1.25)' },
  popularyzacja: { zdjecie: '/pliki/naglowki/popularyzacja.jpg', kadr: '50% 40%' },
  granat: { zdjecie: '/pliki/naglowki/aktualnosci.jpg', kadr: '50% 40%' },
};
const f = FOTO[dzial ?? 'granat'];
const styl = `object-position:${rodzaj === 'podstrona' ? '50% 40%' : f.kadr}${f.filtr ? `;filter:${f.filtr}` : ''}`;

const kreski = P && znak ? znakDzialu(P.dzial, true) : [];
const ramka = kreski.length && zLiczbami ? ramkaZnaku(kreski).join(' ') : '0 0 200 240';
const patronDzialu = lang === 'en' ? 'patron of the section' : 'patron działu';
// Baner działu: tytułem jest nazwa działu z menu (np. „Popularyzacja”), a nie tytuł strony z danych („Popularyzacja
// matematyki” zostaje w <title> i na telefonie).
const zMenu = rodzaj === 'dzial' && P ? (await menuGlowne()).find((m) => m.adres === P.adres) : undefined;
const tytulBanera = rodzaj === 'dzial' && P ? ((zMenu && (wybierz(zMenu, 'etykieta', lang) as string)) || pole(P, 'nazwa', lang)) : tytul;
// Stan szkicu ustawiany od razu, zanim strona się narysuje (opis w zalozyciele.css i src/scripts/zal/szkice.ts).
const STAN = `(function(b){var s='z-gotowe',k='im-wizyta-dzialy',dz=b.getAttribute('data-z-baner-dzialu');try{` +
  `if(!matchMedia('(prefers-reduced-motion: reduce)').matches){` +
  `var z=JSON.parse(sessionStorage.getItem(k)||'[]');if(z.indexOf(dz)<0){z.push(dz);sessionStorage.setItem(k,JSON.stringify(z));` +
  `if(JSON.parse(sessionStorage.getItem(k)||'[]').indexOf(dz)>=0)s='z-czeka';}}}catch(e){}` +
  `b.classList.add(s);})(document.currentScript.parentElement);`;
const salaNapis = lang === 'en' ? 'lecture room' : 'sala';
// Dopasowanie nagłówka (zlecenie 11, zalecenia 2 i 9), w linii na końcu nagłówka — zanim strona się narysuje, potem przy
// zmianie rozmiaru okna i po wczytaniu krojów:
// - granica z prawej: lewa krawędź ciekawostki (znak z opisem) albo notki o patronie, minus 40 px odstępu;
// - tytuł podstrony najwyżej w dwóch liniach: jeśli zająłby więcej, stopień maleje co 4 px, najwyżej do 44 px; szerokość
//   do granicy; przy dwóch liniach sygnet (z podpisem) podnosi się o pół linii — środek blisko środka dwóch linii tytułu;
// - liczby zawsze w jednym rzędzie (CSS: zawijanie i wysokość jednego rzędu): szerokość rzędu do granicy, liczby
//   z drugiego rzędu są niewidoczne w całości i dostają aria-hidden; pierwsza zostaje zawsze. Telefon: najwyżej trzy.
const DOPASUJ = `(function(n){function px(v){return parseFloat(v)||0}` +
  `function dopasuj(){var tel=innerWidth<761,h1=n.querySelector('h1'),ul=n.querySelector('.z-slot .pt-liczby'),g=n.querySelector('.z-tyt-g'),` +
  `ty=n.querySelector('.z-tyt,.z-tytul'),nr=n.getBoundingClientRect(),gr=Infinity;` +
  // granica z prawej: lewy brzeg tekstu ciekawostki (nie jej pudełka — tekst jest wyrównany do prawej) i znaku
  `n.querySelectorAll('.z-ciek,.z-ciek-opis,.z-znak,.z-znak-opis,.z-patron').forEach(function(e){var rs;` +
  `if(e instanceof SVGElement||!e.textContent.trim())rs=[e.getBoundingClientRect()];else{var g=document.createRange();g.selectNodeContents(e);rs=g.getClientRects()}` +
  `for(var i=0;i<rs.length;i++)if(rs[i].width&&rs[i].height)gr=Math.min(gr,rs[i].left)});` +
  `gr=gr===Infinity?nr.right-(ty?ty.getBoundingClientRect().left-nr.left:64):gr-40;` +
  `if(h1&&n.classList.contains('z-nagl-pod')){h1.style.fontSize='';h1.style.maxWidth='';var lin=1;` +
  `if(!tel){h1.style.maxWidth=Math.max(240,gr-h1.getBoundingClientRect().left)+'px';var fs=px(getComputedStyle(h1).fontSize),lh=px(getComputedStyle(h1).lineHeight);lin=Math.round(h1.offsetHeight/lh);` +
  `while(lin>2&&fs>44){fs=Math.max(44,fs-4);h1.style.fontSize=fs+'px';lh=px(getComputedStyle(h1).lineHeight);lin=Math.round(h1.offsetHeight/lh)}` +
  `if(g)g.style.setProperty('--syg-podnies',Math.max(0,lin-1)*lh/2+'px')}else if(g)g.style.removeProperty('--syg-podnies');` +
  `n.classList.toggle('z-tyt-dlugi',lin>1)}` +
  `if(ul){ul.style.maxWidth='';if(!tel)ul.style.maxWidth=Math.max(0,gr-ul.getBoundingClientRect().left)+'px';var li=ul.children,t0=li.length?li[0].offsetTop:0;` +
  `for(var i=0;i<li.length;i++){if(tel?i>2:li[i].offsetTop>t0+4)li[i].setAttribute('aria-hidden','true');else li[i].removeAttribute('aria-hidden')}}}` +
  `dopasuj();var cz;addEventListener('resize',function(){cancelAnimationFrame(cz);cz=requestAnimationFrame(dopasuj)});` +
  `if(document.fonts)document.fonts.ready.then(dopasuj)})(document.currentScript.parentElement);`;
---
{rodzaj === 'dzial' && P && (
  <div class="z-nagl z-baner-dzialu" data-dzial={P.dzial} data-z-baner-dzialu={P.dzial} data-pagefind-ignore>
    <div class="z-foto"><img src={u(f.zdjecie)} alt="" fetchpriority="high" style={styl} /></div>
    <div class="z-szkic-ramka"><Szkic dzial={P.dzial} rodzaj="pelny" /></div>
    <div class="z-tytul">
      <a class="z-wstecz" href={u(wJezyku('/', lang))}>← {t(lang, 'stronaGlowna')}</a>
      <h1 data-pagefind-meta="title">{tytulBanera}</h1>
      {haslo && <p class="z-haslo">{haslo}</p>}
      {zLiczbami && <div class="z-slot" set:html={slot} />}
    </div>
    <span class="z-podpis-ramka"><Szkic dzial={P.dzial} rodzaj="podpis" pisze id="baner" /></span>
    <div class="z-patron">
      <b>{P.patron}</b>
      <span>{`${P.lata} · ${patronDzialu} · ${salaNapis} ${P.sala}`}</span>
      <p>{pole(P, 'notka', lang)}</p>
    </div>
    <script is:inline set:html={STAN} />
    {zLiczbami && <script is:inline set:html={DOPASUJ} />}
  </div>
)}
{rodzaj === 'podstrona' && (
  <div class:list={['z-nagl', 'z-nagl-pod', zLiczbami && 'z-liczbami', !P && 'z-granat']} data-dzial={P?.dzial} data-pagefind-ignore>
    <div class="z-foto"><img src={u(f.zdjecie)} alt="" fetchpriority="high" style={styl} /></div>
    <div class="z-tyt">
      <div class="z-tyt-g">
        {P && <Szkic dzial={P.dzial} rodzaj="sygnet" class="z-sygnet-nagl" />}
        <p class="z-sciezka"><a href={u(wJezyku(wstecz.adres, lang))}>← {wstecz.etykieta}</a></p>
        <h1 data-pagefind-meta="title">{tytul}</h1>
        {P && <span class="z-podpis-maly"><Szkic dzial={P.dzial} rodzaj="podpis" /></span>}
      </div>
      {haslo && <p class="z-haslo">{haslo}</p>}
      {slot && <div class="z-slot" set:html={slot} />}
    </div>
    {P && kreski.length > 0 && (
      <>
        <svg class="z-znak" viewBox={ramka} aria-hidden="true" focusable="false">
          {kreski.map((k) => <path d={k.d} class={k.gruba ? 'gruba' : undefined} />)}
        </svg>
        <p class="z-znak-opis"><b>{pole(P, 'znakNazwa', lang)}</b>{pole(P, 'znakFakt', lang)}</p>
      </>
    )}
    <script is:inline set:html={DOPASUJ} />
  </div>
)}
{rodzaj === 'dzial' && P && <script>import '../../scripts/zal/szkice';</script>}
