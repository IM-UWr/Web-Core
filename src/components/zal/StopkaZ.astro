---
// Odchudzona stopka na komputer (≥ 1024 px; kierunek „Założyciele”): jedna linia na granacie, w kolumnie 1240 px —
// nazwa, adres, telefon i e-mail; deklaracja dostępności, polityka prywatności, „O stronie” i „© … · Created by Szymon Cygan”.
// „Archiwum starej strony” nie ma w stopce (zlecenie 14, zalecenie 27): prowadzą do niego strona „O stronie” i strona 404.
// Telefon (≤ 1023 px): ta sama stopka w kilku wierszach (zal-telefon.css).
// Elementy (nazwa, adres, telefon, e-mail; „© …” i „Created by …”) nie łamią się w środku, a kropka „·” między nimi to ::before
// następnego elementu: kropka na początku linii po zawinięciu jest ucięta (zlecenie 27, punkt 6.1), więc żadna nie zostaje na końcu
// ani na początku linii.
import ustawienia from '../../data/ustawienia.json';
import { u } from '../../lib/url';
import { t, wJezyku } from '../../lib/i18n';
import type { Lang } from '../../lib/daty';

interface Props { lang: Lang }
const { lang } = Astro.props;
const k = ustawienia.kontakt;
const rok = new Date().getFullYear();
---
<footer class="z-stopka">
  <div class="z-stopka-in">
    <div class="z-st-lista"><div class="z-st-w">
      <b class="z-st">{lang === 'en' ? `${t(lang, 'instytut')}, ${t(lang, 'uwr')}` : `${t(lang, 'instytut')} UWr`}</b>
      <span class="z-st">{k.adres}</span>
      <span class="z-st"><a href={`tel:${k.telefon.replace(/\s/g, '')}`}>{k.telefon}</a></span>
      <span class="z-st"><a href={`mailto:${k.email}`}>{k.email}</a></span>
    </div></div>
    <nav aria-label={lang === 'en' ? 'Legal' : 'Informacje prawne'}>
      <a href={u(wJezyku('/deklaracja-dostepnosci', lang))}>{t(lang, 'deklaracja')}</a>
      <a href={u(wJezyku('/polityka-prywatnosci', lang))}>{t(lang, 'prywatnosc')}</a>
      <a href={u(wJezyku('/o-stronie', lang))}>{t(lang, 'oStronie')}</a>
      <span class="z-autor"><span class="z-st-lista"><span class="z-st-w"><span class="z-st">© {rok} {t(lang, 'uwr')}</span><span class="z-st"><span lang="en">Created by</span> Szymon Cygan</span></span></span></span>
    </nav>
  </div>
</footer>

<style>
  /* Kropka (12 px szerokości) przed każdym elementem; rząd przesunięty o 12 px w lewo, więc kropka elementu, który zaczyna linię,
     wypada przed lewą krawędzią .z-st-lista i jest ucięta (clip-path tylko z lewej, 2 px zapasu na obrys fokusu linku; środek
     kropki 6 px przed krawędzią). Z góry, z prawej i z dołu nic nie jest ucinane. */
  .z-st-lista { display: block; clip-path: inset(-8px -8px -8px -2px); }
  .z-st-w { display: flex; flex-wrap: wrap; align-items: baseline; margin-left: -12px; }
  .z-st { white-space: nowrap; }
  .z-st::before { content: '·'; content: '·' / ''; display: inline-block; width: 12px; font-family: var(--f-text); font-size: 13.5px; font-weight: 400; text-align: center; }
  .z-st a:focus-visible { outline-width: 2px; outline-offset: 0; }
  .z-stopka nav > a { white-space: nowrap; }
</style>
