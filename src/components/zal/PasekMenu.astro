---
// Pasek menu na komputer (≥ 1024 px; kierunek „Założyciele”, dok/estetyka.md; zlecenie 11, zalecenie 6): Instytut, Nauka,
// Studia, Popularyzacja, Aktualności, za cienką kreską tryb ciemny, przełącznik języka z flagą języka docelowego i hamburger
// (panel PanelMenu.astro — w nim Szukaj i Rekrutacja). Bieżący dział pogrubiony, pod działami krótkie kreski w ich kolorach.
// Przyklejony u góry (poza stroną główną): przezroczysty na samej górze nad banerem, po przewinięciu nad banerem ciemny
// z rozmyciem, nad treścią jasny, nad stopką znowu ciemny — kolor wybiera src/scripts/zal/pasek.ts (style: zalozyciele.css).
// Strona główna: zwykły jasny pasek na górze drugiego ekranu (klasa z-pasek-jasny).
// Na telefonie (≤ 1023 px) sam pasek jest schowany (zal-telefon.css), tam jest nagłówek Naglowek.astro; panel zostaje i otwiera go
// hamburger z nagłówka (id panelu: Baza.astro).
import PanelMenu from './PanelMenu.astro';
import Flaga from './Flaga.astro';
import { menuGlowne } from '../../lib/menu';
import { u, isExternal } from '../../lib/url';
import { t, wJezyku, wybierz } from '../../lib/i18n';
import { PATRONI, DZIALY, dzialZeSciezki } from '../../lib/patroni';
import type { Lang } from '../../lib/daty';

interface Props { lang: Lang; sciezka: string; inny: string | null; class?: string }
const { lang, sciezka, inny, class: klasa } = Astro.props;
const menu = await menuGlowne();
const bezJezyka = sciezka.replace(/^\/en(?=\/|$)/, '') || '/';
const href = (adres: string) => (isExternal(adres) ? adres : u(wJezyku(adres, lang)));
const biezacy = dzialZeSciezki(sciezka);
const jasny = !!klasa?.includes('z-pasek-jasny');
const idPanelu = jasny ? 'z-menu-druga' : 'z-menu-pasek';

const pozycje = menu.filter((p) => p.w_pasku !== false).map((p) => ({
  adres: p.adres, etykieta: wybierz(p, 'etykieta', lang),
  dz: DZIALY.find((dz) => PATRONI[dz].adres === p.adres),
}));
const doJezyka = lang === 'pl' ? 'en' : 'pl';
---
<header class:list={['z-pasek', klasa]} data-z-pasek>
  {!jasny && <span class="z-pasek-tlo" aria-hidden="true"></span>}
  <div class="z-pasek-in">
    <a class="z-marka" href={u(wJezyku('/', lang))}>
      <span class="z-logo" aria-hidden="true" style={`--logo:url(${u('/pliki/uwr-logo.png')})`}></span>
      <span><b>{t(lang, 'instytut')}</b><small>{t(lang, 'wydzial')}</small></span>
    </a>
    <nav aria-label={lang === 'en' ? 'Main menu' : 'Menu główne'}>
      {pozycje.map((d) => (
        <a href={href(d.adres)} data-dzial={d.dz} aria-current={bezJezyka === d.adres ? 'page' : (d.dz ? biezacy === d.dz : bezJezyka.startsWith(d.adres + '/')) ? 'true' : undefined}>{d.etykieta}</a>
      ))}
      <span class="z-pasek-narz">
        <button type="button" data-motyw aria-label={t(lang, 'motyw')}>
          <svg class="z-ks" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          <svg class="z-sl" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        {inny && (
          <a class="z-jezyk" href={u(inny)} hreflang={doJezyka} lang={doJezyka} aria-label={t(lang, 'innyJezyk')}>
            <Flaga jezyk={doJezyka} />{t(lang, 'innyJezykKrotko')}
          </a>
        )}
        <button type="button" class="z-burger" aria-label={t(lang, 'otworzMenu')} aria-expanded="false" aria-controls={idPanelu} data-z-menu-otworz>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </span>
    </nav>
  </div>
</header>
<PanelMenu lang={lang} id={idPanelu} sciezka={sciezka} jasny={jasny} class="z-menu-pasek" />
<script>import '../../scripts/zal/menu'; import '../../scripts/zal/pasek';</script>
