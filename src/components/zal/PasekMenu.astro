---
// Pasek menu na komputer (≥ 761 px; kierunek „Założyciele”, dok/estetyka.md): leży na banerze — przezroczysty, biały tekst,
// zwężony do kolumny 1240 px. Instytut, Nauka, Studia, Popularyzacja, Aktualności, za kreską Rekrutacja, Szukaj i EN z flagą.
// Bieżący dział pogrubiony, pod działami krótkie kreski w ich kolorach. Bez podmenu (wyłączone 2.11).
// Strony bez banera (np. pojedyncza aktualność) — pasek na granacie (style w src/styles/zalozyciele.css).
// Na telefonie schowany (.tylko-komputer) — tam zostaje dotychczasowy nagłówek (Naglowek.astro).
import { menuGlowne } from '../../lib/menu';
import { u, isExternal } from '../../lib/url';
import { t, wJezyku, wybierz } from '../../lib/i18n';
import { PATRONI, DZIALY, dzialZeSciezki, pole } from '../../lib/patroni';
import Flaga from './Flaga.astro';
import type { Lang } from '../../lib/daty';

interface Props { lang: Lang; sciezka: string; inny: string | null; class?: string }
const { lang, sciezka, inny, class: klasa } = Astro.props;
const menu = await menuGlowne();
const bezJezyka = sciezka.replace(/^\/en(?=\/|$)/, '') || '/';
const href = (adres: string) => (isExternal(adres) ? adres : u(wJezyku(adres, lang)));
const zMenu = (adres: string) => menu.find((p) => p.adres === adres);
const biezacy = dzialZeSciezki(sciezka);

const dzialy = DZIALY.map((dz) => {
  const p = zMenu(PATRONI[dz].adres);
  return { dz, adres: PATRONI[dz].adres, etykieta: (p && (wybierz(p, 'etykieta', lang) as string)) || pole(PATRONI[dz], 'nazwa', lang) };
});
const akt = zMenu('/aktualnosci');
const aktualnosci = { adres: '/aktualnosci', etykieta: (akt && (wybierz(akt, 'etykieta', lang) as string)) || t(lang, 'aktualnosci') };
// Rekrutacja: pozycja menu prowadząca na stronę rekrutacji (dziś https://studia-wmi.uwr.edu.pl/)
const rek = menu.find((p) => !p.grupy && p.adres && /rekrutac|admission/i.test(`${p.etykieta} ${p.etykieta_en ?? ''}`));
const rekrutacja = { adres: rek?.adres ?? 'https://studia-wmi.uwr.edu.pl/', etykieta: (rek && (wybierz(rek, 'etykieta', lang) as string)) || (lang === 'en' ? 'Admission' : 'Rekrutacja') };
const naAktualnosciach = bezJezyka === '/aktualnosci' || bezJezyka.startsWith('/aktualnosci/');
---
<header class:list={['z-pasek', 'tylko-komputer', klasa]}>
  <div class="z-pasek-in">
    <a class="z-marka" href={u(wJezyku('/', lang))}>
      <span class="z-logo" aria-hidden="true" style={`--logo:url(${u('/pliki/uwr-logo.png')})`}></span>
      <span><b>{t(lang, 'instytut')}</b><small>{t(lang, 'wydzial')}</small></span>
    </a>
    <nav aria-label={lang === 'en' ? 'Main menu' : 'Menu główne'}>
      {dzialy.map((d) => (
        <a href={href(d.adres)} data-dzial={d.dz} aria-current={bezJezyka === d.adres ? 'page' : biezacy === d.dz ? 'true' : undefined}>{d.etykieta}</a>
      ))}
      <a href={href(aktualnosci.adres)} aria-current={bezJezyka === '/aktualnosci' ? 'page' : naAktualnosciach ? 'true' : undefined}>{aktualnosci.etykieta}</a>
      <a class="z-rekr" href={href(rekrutacja.adres)}>{rekrutacja.etykieta}</a>
      <a href={href('/szukaj')}>{t(lang, 'szukaj')}</a>
      {inny && (
        <a class="z-jezyk" href={u(inny)} hreflang={lang === 'pl' ? 'en' : 'pl'} lang={lang === 'pl' ? 'en' : 'pl'} aria-label={t(lang, 'innyJezyk')}>
          {lang === 'pl' && <Flaga />}{t(lang, 'innyJezykKrotko')}
        </a>
      )}
    </nav>
  </div>
</header>
