---
// Sekcja strony działu na komputerze (TrescDzialu.astro): kreska na całą szerokość, tytuł Brygadą 34 px, linki do pełnych
// podstron po prawej („Wszystkie … →”, zewnętrzne z ↗), pod tytułem opcjonalny opis; treść w slocie. Style: zal-dzialy.css.
import Link from '../../Link.astro';
import { u, isExternal } from '../../../lib/url';
import { wJezyku } from '../../../lib/i18n';
import { jedenAkapit } from '../../../lib/tekstyStron';
import type { Lang } from '../../../lib/daty';

interface Props {
  id: string;
  tytul: string;
  lang: Lang;
  linki?: { etykieta: string; adres: string }[];
  opis?: string;
  // opis z Markdownu (zlecenie 30, np. zdanie nad sukcesami z treści strony działu): jeden akapit — w miejscu opisu, więcej — w bloku
  opisHtml?: string;
  class?: string;
}
const { id, tytul, lang, linki = [], opis, opisHtml, class: klasa } = Astro.props;
const opisAkapit = opisHtml ? jedenAkapit(opisHtml) : undefined;
const en = lang === 'en';
---
<section class:list={['z-dz-sek', klasa]} aria-labelledby={id}>
  <div class="z-dz-glowa">
    <h2 id={id}>{tytul}</h2>
    {linki.length > 0 && (
      <div class="z-dz-linki">
        {linki.map((l) => {
          const zew = isExternal(l.adres);
          return (
            <Link href={zew ? l.adres : u(wJezyku(l.adres, lang))}>{l.etykieta}</Link>
          );
        })}
      </div>
    )}
  </div>
  {opis && <p class="z-dz-opis">{opis}</p>}
  {opisHtml && (opisAkapit !== undefined ? <p class="z-dz-opis" set:html={opisAkapit} /> : <div class="z-dz-opis" set:html={opisHtml} />)}
  <slot />
</section>
