---
// Boczna nawigacja podstron działu (komputer; kierunek „Założyciele”, dok/estetyka.md „Podstrony działów”):
// nazwa działu, podstrony w grupach jak w menu (bieżąca z kreską w kolorze działu), pod spodem „Na tej stronie”.
// Grupy i linki z menu głównego (src/data/nawigacja.json przez lib/menu.ts) — nowa podstrona w menu sama się tu pojawi.
import { menuGlowne } from '../../lib/menu';
import { u, isExternal, stripBase } from '../../lib/url';
import { wJezyku, wybierz } from '../../lib/i18n';
import { PATRONI, pole, skrotNazwy, type Dzial } from '../../lib/patroni';
import type { Lang } from '../../lib/daty';

interface Props { dzial: Dzial; lang: Lang; spis?: { id: string; etykieta: string }[] }
const { dzial, lang, spis = [] } = Astro.props;
const P = PATRONI[dzial];
const pozycja = (await menuGlowne()).find((m) => m.adres === P.adres);
const grupy = (pozycja?.grupy ?? []).filter((g) => g.linki.length > 0);
const nazwa = (pozycja && (wybierz(pozycja, 'etykieta', lang) as string)) || pole(P, 'nazwa', lang);
const tu = (stripBase(Astro.url.pathname).replace(/^\/en(?=\/|$)/, '').replace(/\/$/, '') || '/');
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
const biezaca = (a: string) => !isExternal(a) && a.replace(/\/$/, '') === tu;
---
<nav class="z-bok" aria-label={nazwa} data-dzial={dzial}>
  <a class="z-bok-dzial" href={href(P.adres)}>{nazwa}</a>
  {grupy.map((g) => (
    <>
      <p class="z-bok-gr">{wybierz(g, 'nazwa', lang)}</p>
      <ul>
        {g.linki.map((l) => {
          const e = wybierz(l, 'etykieta', lang) as string;
          const sk = skrotNazwy(e);
          return <li><a href={href(l.adres)} title={sk ? e : undefined} aria-current={biezaca(l.adres) ? 'page' : undefined}>{sk ?? e}{isExternal(l.adres) && ' ↗'}</a></li>;
        })}
      </ul>
    </>
  ))}
  {spis.length > 0 && (
    <div class="z-bok-spis">
      <p class="z-bok-gr">{lang === 'en' ? 'On this page' : 'Na tej stronie'}</p>
      <ul>{spis.map((s) => <li><a href={`#${s.id}`}>{s.etykieta}</a></li>)}</ul>
    </div>
  )}
</nav>
