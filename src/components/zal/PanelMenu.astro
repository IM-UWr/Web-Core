---
// Panel menu z hamburgera (zlecenie 11, zalecenie 6; prototyp: .ok-menu): ten sam na okładce i przy pasku menu na każdej
// stronie, także na telefonie (zlecenie 18, punkt 6: otwiera go hamburger z Naglowek.astro). Wysuwa się z prawej. Na górze pole „Szukaj na stronie” (formularz do /szukaj?q=…), cztery działy z podstronami —
// przed każdym mała twarz patrona (sygnet 40×48, kreska w kolorze działu) — i na dole duże „Aktualności” i „Rekrutacja ↗”
// (Rekrutacja nie dubluje się w liście Studiów). Kolor: granatowy; przy jasnym pasku albo nagłówku telefonu jasny (klasa .z-menu-jasny,
// ustawia src/scripts/zal/pasek.ts). Style: src/styles/zal-menu.css. Otwieranie i zamykanie: src/scripts/zal/menu.ts.
// Zwijane działy (zlecenie 14, zalecenie 24; prototyp v90 „Zwijane działy”): pod nazwą działu grupy jak w menu działu
// (nawigacja.json — mały nagłówek grupy, pod nim linki), przy nazwie przycisk ze strzałką; otwarty jeden dział naraz.
// Bez JS grupy są widoczne, a przycisk schowany (zwijanie włącza skrypt klasą .zwijane). Przez .z-menu-grupy-w płynnie zmienia się
// wysokość grup na komputerze (zlecenie 20, punkt 1).
// Bieżąca strona (zlecenie 18, punkt 6): aria-current="page" na najdłuższym pasującym adresie, także dla podstron głębszych niż
// pozycja menu; na komputerze panel otwiera się z rozwiniętym działem tej strony (section[data-biezacy]), poza działami wszystkie zwinięte.
// Na telefonie zawsze złożony i bez koloru bieżącej strony (prośba właściciela, 6.11); aria-current zostaje dla czytników ekranu.
// SIAD jako skrót z pełną nazwą w podpowiedzi (skrotNazwy).
import Szkic from './Szkic.astro';
import Link from '../Link.astro';
import { menuGlowne, sciezkaBezJezyka, pasujeDoSciezki } from '../../lib/menu';
import { u, isExternal } from '../../lib/url';
import { t, wJezyku, wybierz } from '../../lib/i18n';
import { PATRONI, DZIALY, dzialZeSciezki, skrotNazwy } from '../../lib/patroni';
import type { Lang } from '../../lib/daty';

interface Props { lang: Lang; id: string; sciezka: string; jasny?: boolean; class?: string }
const { lang, id, sciezka, jasny = false, class: klasa } = Astro.props;
const en = lang === 'en';
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
const menu = await menuGlowne();
const pozycje = menu.map((m, i) => ({
  dz: DZIALY.find((dz) => PATRONI[dz].adres === m.adres),
  klucz: `pozycja-${i}`, adres: m.adres, nazwa: wybierz(m, 'etykieta', lang),
  grupy: (m.grupy ?? []).map((g) => ({ nazwa: wybierz(g, 'nazwa', lang), linki: g.linki })),
}));
const tu = sciezkaBezJezyka(sciezka);
const linki = pozycje.flatMap((d) => d.grupy.flatMap((g) => g.linki.map((l) => ({ dz: d.dz, klucz: d.klucz, adres: l.adres }))));
const biezacy = linki.filter((l) => pasujeDoSciezki(tu, l.adres)).sort((a, b) => b.adres.length - a.adres.length)[0];
// dział ze ścieżki (strona działu nie ma swojego linku w grupach), chyba że link tej strony stoi tylko w innym dziale: wtedy dział
// z linkiem, żeby bieżąca strona była widoczna. Ten sam adres w dwóch działach (Szkoła doktorska: Nauka i Studia): oznaczony w tym ze ścieżki.
const zeSciezki = dzialZeSciezki(sciezka);
const dzialBiezacy = !biezacy || linki.some((l) => l.dz === zeSciezki && l.adres === biezacy.adres) ? zeSciezki : biezacy.dz;
const pozycjaBiezaca = pozycje.find((p) => p.dz && p.dz === dzialBiezacy)?.klucz
  ?? biezacy?.klucz ?? pozycje.find((p) => pasujeDoSciezki(tu, p.adres))?.klucz;
---
<nav class:list={['z-menu', jasny && 'z-menu-jasny', klasa]} id={id} aria-label={en ? 'Main menu' : 'Menu główne'} tabindex="-1" data-z-menu>
  <span class="z-zamknij"><button type="button" data-z-menu-zamknij aria-label={t(lang, 'zamknijMenu')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button></span>
  <form class="z-menu-szukaj" action={u(wJezyku('/szukaj', lang))} method="get" role="search">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <label class="sr-only" for={`${id}-q`}>{t(lang, 'szukaj')}</label>
    <input id={`${id}-q`} type="search" name="q" placeholder={en ? 'Search the website' : 'Szukaj na stronie'} autocomplete="off" />
  </form>
  {pozycje.map((d) => (
    <section class:list={[d.grupy.length === 0 && 'duza']} data-dzial={d.dz} data-biezacy={d.klucz === pozycjaBiezaca ? '' : undefined}>
      {d.dz && <Szkic dzial={d.dz} rodzaj="sygnet" class="z-menu-sygnet" />}
      <h2>
        <Link href={href(d.adres)} aria-current={(d.grupy.length ? tu === d.adres : pasujeDoSciezki(tu, d.adres)) ? 'page' : undefined}>{d.nazwa}</Link>
        {d.grupy.length > 0 && (
          <button type="button" class="z-menu-rozwin" aria-expanded="false" aria-controls={`${id}-${d.klucz}`} aria-label={`${en ? 'Show pages' : 'Pokaż podstrony'}: ${d.nazwa}`} data-z-menu-rozwin>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </button>
        )}
      </h2>
      <div class="z-menu-grupy" id={`${id}-${d.klucz}`}>
        <div class="z-menu-grupy-w">
          {d.grupy.map((g) => (
            <div class="z-menu-grupa">
              <h3>{g.nazwa}</h3>
              <ul>{g.linki.map((l) => {
                const e = wybierz(l, 'etykieta', lang) as string;
                const sk = skrotNazwy(e);
                return <li><Link href={href(l.adres)} title={sk ? e : undefined} aria-current={d.klucz === pozycjaBiezaca && l.adres === biezacy?.adres ? 'page' : undefined}>{sk ?? e}</Link></li>;
              })}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}
</nav>
