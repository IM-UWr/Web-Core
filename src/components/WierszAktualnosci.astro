---
// Wiersz listy aktualności (ListaAktualnosci.astro) w języku podstron „Założycieli”: data jak na stronach działów
// (zal/dzial/Wiersz.astro — dzień dużą Brygadą, pod nim „mie rrrr”), obok mała etykieta „Rodzaj · odbiorcy”, tytuł Brygadą,
// „Kiedy:” przy wydarzeniach i zajawka; miniatura zdjęcia wpisu z prawej. Cały wiersz klikalny (link w tytule), wiersze
// rozdzielone cienką linią. Kolor daty i etykiety — kolor działu treści (poza działami granat, w ciemnym motywie jasny).
// Jedna wersja HTML: komputer (≥ 761 px) i telefon (≤ 760 px, węższa kolumna daty i mniejsza miniatura).
// data-wa, data-rodzaj, data-dla — filtr i szukanie listy (skrypt w ListaAktualnosci.astro).
import { u, isExternal } from '../lib/url';
import ZdjecieZ from './ZdjecieZ.astro';
import { rozmiarPola } from '../lib/zdjecia';
import { wJezyku, RODZAJE, odbiorcyMalymi } from '../lib/i18n';
import { dayNum, monthShort, parse, range, type Lang } from '../lib/daty';
import type { PozycjaListy } from '../lib/tresci';

interface Props { p: PozycjaListy; lang: Lang }
const { p, lang } = Astro.props;
const href = isExternal(p.href) ? p.href : u(wJezyku(p.href, lang));
const etykieta = [RODZAJE[p.rodzaj]?.[lang], p.dla.map((d) => odbiorcyMalymi(d, lang)).join(', ')].filter(Boolean).join(' · ');
---
<article class="wa" data-wa data-rodzaj={p.rodzaj} data-dla={p.dla.join(' ')}>
  <time class="wa-data" datetime={p.data.slice(0, 10)}>{dayNum(p.data)}<small>{monthShort(p.data, lang)} {parse(p.data).y}</small></time>
  <div class="wa-tresc">
    <div class="wa-rodz">{etykieta}</div>
    <h3><a href={href}>{p.tytul}</a></h3>
    {p.wydarzenie && <p class="wa-kiedy"><strong>{lang === 'en' ? 'When:' : 'Kiedy:'}</strong> {range(p.wydarzenie, undefined, lang)}</p>}
    {p.zajawka && <p class="wa-zaj">{p.zajawka}</p>}
  </div>
  {p.zdjecie && <span class="wa-fot" aria-hidden="true"><ZdjecieZ src={p.zdjecie} sizes={rozmiarPola(['(max-width: 760px)', 54, 54], [null, 120, 80])} /></span>}
</article>

<style>
  .wa { position: relative; display: grid; grid-template-columns: 76px minmax(0, 1fr) auto; gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .wa[hidden] { display: none; }
  .wa-data { font-family: var(--f-display); font-weight: 500; font-size: 34px; line-height: 1; color: var(--d-a); font-variant-numeric: lining-nums; }
  .wa-data small { display: block; margin-top: 4px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  .wa-rodz { font-size: 13px; font-weight: 700; line-height: 1.4; color: var(--d-a); }
  .wa h3 { margin: 2px 0 4px; font-family: var(--f-display); font-weight: 500; font-size: 21px; line-height: 1.3; letter-spacing: normal; color: var(--ink); }
  .wa h3 a { color: inherit; text-decoration: none; }
  /* cały wiersz klikalny; fokus rysowany na całym wierszu */
  .wa h3 a::before { content: ''; position: absolute; inset: 0; } /* nakładka na ::before — ::after to strzałka ↗ linku poza stronę */
  .wa h3 a:focus-visible { outline: none; }
  .wa:has(h3 a:focus-visible) { outline: 3px solid var(--d-a); outline-offset: 4px; }
  .wa:hover h3 a { color: var(--d-a); }
  .wa p { margin: 0; max-width: none; font-size: 15.5px; line-height: 1.55; color: var(--text); }
  .wa .wa-kiedy { margin-bottom: 2px; font-size: 14px; color: var(--muted); }
  .wa .wa-kiedy strong { font-weight: 700; color: var(--ink); }
  .wa-fot { display: block; width: 120px; aspect-ratio: 3 / 2; overflow: hidden; background: var(--d-t); }
  .wa-fot :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 760px) {
    /* miniatura pod datą (kolumna daty), żeby tekst miał całą szerokość */
    .wa { grid-template-columns: 54px minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); gap: 0 12px; padding: 13px 0; }
    .wa-data { grid-column: 1; grid-row: 1; font-size: 28px; }
    .wa-tresc { grid-column: 2; grid-row: 1 / 3; }
    .wa-fot { grid-column: 1; grid-row: 2; align-self: start; margin-top: 10px; }
    .wa-data small { font-size: 12px; }
    .wa h3 { font-size: 18.5px; }
    .wa p { font-size: 15px; }
    .wa .wa-kiedy { font-size: 13.5px; }
    .wa-fot { width: 54px; aspect-ratio: 1; }
  }
</style>
