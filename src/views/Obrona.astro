---
// Pojedyncza obrona doktorska z dokumentami.
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal” (tytuł rozprawy bez zmian), reszta strony jak w wariancie „Zwarta”
// (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok na końcu pliku).
// Telefon (≤ 760 px): baner w układzie działów (zlecenie 01) — opis przy `haslo` w src/lib/widoki/obrona.ts.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import Ikona from '../components/Ikona.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import { u, isExternal } from '../lib/url';
import { t } from '../lib/i18n';
import { longWithDay, short, dayNum, monthShort, type Lang } from '../lib/daty';
import { miejsce, type Obrona } from '../lib/tresci';
import { daneObrony } from '../lib/widoki/obrona';

interface Props { obrona: Obrona; lang: Lang }
const { obrona, lang } = Astro.props;
const d = obrona.data;
const href = (a: string) => (isExternal(a) ? a : u(a));
const { Content, tytul, przyszla, opisZdjecia, dokumenty, haslo, liczby } = await daneObrony(obrona, lang);
---
<Baza tytul={tytul} opis={d.tytul_rozprawy} opublikowany={d.opublikowany} typ="article" uklad="zwarta portal-baner">
  <NaglowekStrony tytul={d.kandydat} haslo={haslo} lang={lang} wstecz={{ etykieta: lang === 'en' ? 'All PhD defences' : 'Wszystkie obrony doktorskie', telefon: t(lang, 'obrony'), adres: '/obrony-doktorskie' }}>
    <LiczbyBanera lang={lang} pozycje={liczby} />
    <p class="lead tylko-komputer" lang="en" style="font-weight:600;color:var(--ink)">{d.tytul_rozprawy}</p>
  </NaglowekStrony>
  <div class="wrap layout">
    <div class="main">
      {/* telefon: tytuł rozprawy zaraz pod banerem (kopia z banera, bez indeksowania) */}
      <p class="ob-rozprawa tylko-telefon" lang="en" data-pagefind-ignore>{d.tytul_rozprawy}</p>
      <section class="event-box" aria-label={lang === 'en' ? 'Defence details' : 'Szczegóły obrony'}>
        <span class:list={['datebox', { minione: !przyszla }]} aria-hidden="true"><span class="d">{dayNum(d.termin)}</span><span class="m">{monthShort(d.termin, lang)}</span></span>
        <dl>
          <dt>{t(lang, 'kiedy')}</dt><dd>{longWithDay(d.termin, lang)}</dd>
          {d.miejsce && <><dt>{t(lang, 'gdzie')}</dt><dd>{miejsce(d.miejsce, lang)}</dd></>}
          {d.promotorzy.length > 0 && <><dt>{t(lang, 'promotorzy')}</dt><dd>{d.promotorzy.join(', ')}</dd></>}
        </dl>
        {/* bez przycisku „Dodaj do kalendarza” (decyzja: nigdzie na stronie); po terminie — informacja, że obrona się odbyła */}
        {!przyszla && <div class="actions"><span class="status">{t(lang, 'odbylo')}</span></div>}
      </section>

      {d.zdjecie && (
        <figure class="article-figure" style="margin-top:24px">
          <img src={u(d.zdjecie)} alt={opisZdjecia} />
          {opisZdjecia && <figcaption>{opisZdjecia}</figcaption>}
        </figure>
      )}
      <div class="prose" style="margin-top:24px"><Content /></div>

      {dokumenty.length > 0 && (
        <section class="article-block" aria-labelledby="h-dok">
          <h2 id="h-dok">{t(lang, 'dokumenty')}</h2>
          <ul class="files">{dokumenty.map((x) => <li><a href={href(x.plik)}><Ikona nazwa="plik" />{x.nazwa}</a></li>)}</ul>
        </section>
      )}
      {d.bip && <p class="article-block"><a class="link-arrow" href={d.bip}>{t(lang, 'bip')}<Ikona nazwa="zewnetrzny" rozmiar={14} /></a></p>}
      {d.data_ogloszenia && <p class="muted" style="font-size:14px;margin-top:24px">{t(lang, 'opublikowano')} {short(d.data_ogloszenia)}</p>}
    </div>
    <div class="side" aria-hidden="true"></div>
  </div>
</Baza>

<style>
  /* komputer (≥ 761 px): odstęp nad pierwszym blokiem stały (24 px), jak na stronie działu „Nauka” — treść nie przylega
     do banera (reszta odstępów .layout — uklad-zwarta.css) */
  @media (min-width: 761px) { .layout { padding-top: 24px; } }
  /* telefon (≤ 760 px; zlecenie 01): tytuł rozprawy pod banerem — jak dawniej w banerze (półgruby, w kolorze tytułów) */
  @media (max-width: 760px) {
    .ob-rozprawa { margin: 0 0 18px; font-size: 17px; font-weight: 600; line-height: 1.4; color: var(--ink); text-wrap: pretty; }
  }
</style>
