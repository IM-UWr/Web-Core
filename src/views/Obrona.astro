---
// Pojedyncza obrona doktorska (/obrony-doktorskie/<slug>), kierunek „Założyciele”, szablon podstrony zal/Podstrona.astro.
// Baner: imię i nazwisko, hasło, liczby (data, godzina, recenzje) i tytuł rozprawy (na każdej szerokości).
// Treść: termin jednym wzorem daty (jak zal/dzial/Wiersz.astro: dzień dużą Brygadą w kolorze działu, pod nim „mie rrrr”)
// z parami Kiedy / Gdzie / Promotor (dl.para), po terminie — „Wydarzenie się odbyło”; zdjęcie, opis, dokumenty (ul.pliki),
// ogłoszenie w BIP i data publikacji. Na /en treść z pola tresc_en albo zaproszenie po angielsku z danych obrony. Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css, klasa .tresc).
// Bez spisu „Na tej stronie” (mniej niż 2 sekcje z nagłówkiem). Jedna wersja HTML: komputer (≥ 761 px) i telefon (≤ 760 px).
import Link from '../components/Link.astro';
import Podstrona from '../components/zal/Podstrona.astro';
import Ikona from '../components/Ikona.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import ZdjecieZ from '../components/ZdjecieZ.astro';
import { u, isExternal } from '../lib/url';
import { t } from '../lib/i18n';
import { longWithDay, short, dayNum, monthShort, parse, type Lang } from '../lib/daty';
import { miejsce, type Obrona } from '../lib/tresci';
import { daneObrony } from '../lib/widoki/obrona';
import { tytulyWJezyku } from '../lib/osoby';

interface Props { obrona: Obrona; lang: Lang }
const { obrona, lang } = Astro.props;
const d = obrona.data;
const href = (a: string) => (isExternal(a) ? a : u(a));
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
// tytuł karty (<title>): „Obrona doktoratu: …”; w banerze samo imię i nazwisko
const { Content, htmlEn, tytul, przyszla, opisZdjecia, dokumenty, haslo, liczby } = await daneObrony(obrona, lang);
// typ pliku z prawej (wzorzec ul.pliki): rozszerzenie („PDF”) albo „strona ↗” dla linku bez rozszerzenia
const typPliku = (a: string) => {
  const m = a.split(/[?#]/)[0].match(/\.([a-z0-9]{2,4})$/i);
  return m ? m[1].toUpperCase() : isExternal(a) ? T('strona', 'website') : '';
};
---
<Podstrona lang={lang} tytul={d.kandydat} tytulKarty={tytul} opis={d.tytul_rozprawy} opublikowany={d.opublikowany} typ="article" uklad="zwarta portal-baner"
  haslo={haslo} wstecz={{ etykieta: T('Wszystkie obrony doktorskie', 'All PhD defences'), telefon: t(lang, 'obrony'), adres: '/obrony-doktorskie' }}
  dzial="nauka" klasa="tresc z-obr">
  <Fragment slot="baner">
    <LiczbyBanera lang={lang} pozycje={liczby} />
    <p class="lead rozprawa" lang="en">{d.tytul_rozprawy}</p>
  </Fragment>

  <section aria-label={T('Szczegóły obrony', 'Defence details')}>
    <div class="termin">
      <time class="dz" datetime={d.termin.slice(0, 10)}>{dayNum(d.termin)}<small> {monthShort(d.termin, lang)} {parse(d.termin).y}</small></time>
      <div>
        {/* bez przycisku „Dodaj do kalendarza” (decyzja: nigdzie na stronie); po terminie — informacja, że obrona się odbyła */}
        {!przyszla && <p class="etyk">{t(lang, 'odbylo')}</p>}
        <dl class="para">
          <dt>{t(lang, 'kiedy')}</dt><dd>{longWithDay(d.termin, lang)}</dd>
          {d.miejsce && <><dt>{t(lang, 'gdzie')}</dt><dd>{miejsce(d.miejsce, lang)}</dd></>}
          {d.promotorzy.length > 0 && <><dt>{t(lang, 'promotorzy')}</dt><dd>{d.promotorzy.map((p) => tytulyWJezyku(p, lang)).join(', ')}</dd></>}
        </dl>
      </div>
    </div>
    {d.zdjecie && (
      <figure class="foto">
        <ZdjecieZ src={d.zdjecie} alt={opisZdjecia} sizes="(min-width: 780px) 720px, calc(100vw - 32px)" />
        {opisZdjecia && <figcaption>{opisZdjecia}</figcaption>}
      </figure>
    )}
    {/* na /en: tresc_en albo zaproszenie po angielsku złożone z danych (src/lib/widoki/obrona.ts) */}
    <div class="prose opis">{htmlEn ? <Fragment set:html={htmlEn} /> : <Content />}</div>
  </section>

  {(dokumenty.length > 0 || d.bip || d.data_ogloszenia) && (
    <section id="z-dokumenty" aria-labelledby={dokumenty.length > 0 ? 'h-dok' : undefined}>
      {dokumenty.length > 0 && (
        <>
          <h2 id="h-dok">{t(lang, 'dokumenty')}</h2>
          <ul class="pliki">{dokumenty.map((x) => <li><Link href={href(x.plik)}><Ikona nazwa="plik" rozmiar={18} /><span>{x.nazwa}</span><span class="typ">{typPliku(x.plik)}</span></Link></li>)}</ul>
        </>
      )}
      {d.bip && <p class="bip"><Link href={d.bip}>{t(lang, 'bip')}</Link></p>}
      {d.data_ogloszenia && <p class="data">{t(lang, 'opublikowano')} {short(d.data_ogloszenia, lang)}</p>}
    </section>
  )}
</Podstrona>

<style>
  /* Termin obrony: dzień | pary etykieta–wartość (dl.para ze wzorca). Reszta — wzorzec treści .tresc (src/styles/zal-tresc.css). */
  .termin { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 18px; align-items: start; }
  .termin .dz { font-family: var(--f-display); font-size: 34px; line-height: 1; color: var(--d-a); }
  .termin .dz small { display: block; margin-top: 4px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  .termin dl { padding-top: 2px; font-size: 15.5px; }
  .foto { margin: 28px 0 0; max-width: 720px; }
  .foto :global(img) { display: block; width: 100%; height: auto; }
  .foto figcaption { margin-top: 6px; font-size: 13.5px; color: var(--muted); }
  .opis { margin-top: 24px; }
  .opis > :global(:last-child) { margin-bottom: 0; }
  .bip { margin: 18px 0 0; font-weight: 600; }
  .data { margin: 14px 0 0; font-size: 14px; color: var(--muted); }
  /* tytuł rozprawy w banerze (jak dotąd: półgruby, biały) */
  .rozprawa { font-weight: 600; color: #fff; }

  /* ---------- telefon (≤ 760 px) ---------- */
  @media (max-width: 760px) {
    .termin { grid-template-columns: 54px minmax(0, 1fr); gap: 12px; }
    .termin .dz { font-size: 28px; }
    .termin .dz small { font-size: 12.5px; white-space: nowrap; }
    .termin dl { font-size: 15px; }
    .rozprawa { margin-top: 12px; font-size: 16px; line-height: 1.4; color: #fff; text-wrap: pretty; }
  }
</style>
