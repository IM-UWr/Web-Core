---
// Strona działu „Studia” (/studia, /en/studia): baner działu z liczbami, pod nim blok TrescDzialu — podstrony w grupach jak
// w menu, „O studiach” z „W skrócie” i aktualności dla studentów. Teksty: src/data/studia.md (Web-Studia, „Strona działu
// Studia”; zlecenie 30); reszta z kolekcji
// i menu, więc nowy kierunek, specjalność czy link w menu „Studia” sam pojawia się na tej stronie.
// Jedna wersja HTML: komputer i telefon (≤ 1023 px, jedna kolumna) — src/styles/zal-dzialy.css.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import TrescDzialu from '../components/zal/TrescDzialu.astro';
import Sekcja from '../components/zal/dzial/Sekcja.astro';
import Wiersz from '../components/zal/dzial/Wiersz.astro';
import { RODZAJE, bezSierotek } from '../lib/i18n';
import { type Lang } from '../lib/daty';
import { daneDzialuStudia } from '../lib/widoki/dzialStudia';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const T = (pl: string, angielski: string) => (en ? angielski : pl);
const { liczby, grupy, oStudiach, fakty, aktualnosci, tytul, wstep, haslo } = await daneDzialuStudia(lang);
---
<Baza tytul={tytul} opis={wstep} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={tytul} lead={wstep} haslo={haslo || undefined} lang={lang} okruszki={[{ etykieta: tytul }]}>
    {liczby.length > 0 && (
      <ul class="pt-liczby">
        {liczby.map((x) => <li><span class="n">{x.n}</span>{bezSierotek(x.l)}</li>)}
      </ul>
    )}
  </NaglowekStrony>
  <TrescDzialu dzial="studia" lang={lang} grupy={grupy} tekst={{ tytul: T('O studiach', 'About our programmes'), akapity: [], html: oStudiach, fakty }}>
    <Sekcja id="z-dz-aktualnosci" tytul={T('Aktualności dla studentów', 'News for students')} lang={lang}
      linki={[{ etykieta: T('Wszystkie', 'All'), adres: '/aktualnosci?dla=studenci' }]}
      opis={aktualnosci.length ? undefined : T('Na razie brak aktualności dla studentów.', 'No news for students at the moment.')}>
      {aktualnosci.length > 0 && (
        <div class="z-dz-wiersze">
          {aktualnosci.map((p) => (
            <Wiersz data={p.data} lang={lang} etykieta={RODZAJE[p.rodzaj]?.[lang]} tytul={p.tytul} adres={p.href} zajawka={p.zajawka} />
          ))}
        </div>
      )}
    </Sekcja>
  </TrescDzialu>
</Baza>
