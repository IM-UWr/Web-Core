---
// Lista „Warto wiedzieć” (/warto-wiedziec, /en/warto-wiedziec): wszystkie opublikowane pozycje kolekcji warto_wiedziec.
// Kierunek „Założyciele”, szablon podstrony (zal/Podstrona.astro) i wzorzec treści (klasa .tresc — src/styles/zal-tresc.css;
// zlecenie 11, zalecenie 14). W nagłówku tytuł i hasło (pole warto_wiedziec_haslo / warto_wiedziec_haslo_en
// w src/data/dzialy/instytut.json). Treść: wiersze pozycji (WartoWiedziec.astro, uklad „lista”: rok, tytuł, zajawka,
// miniatura), pod nimi link do „Sukcesów”. Bez sekcji z nagłówkami — bez spisu „Na tej stronie”.
// Jedna wersja HTML: komputer i telefon (≤ 760 px).
import Podstrona from '../components/zal/Podstrona.astro';
import WartoWiedziec from '../components/WartoWiedziec.astro';
import { u } from '../lib/url';
import { wJezyku } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { daneListyWartoWiedziec } from '../lib/widoki/listaWartoWiedziec';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const { ile, tytul, lead, haslo } = await daneListyWartoWiedziec(lang);
---
<Podstrona lang={lang} tytul={tytul} opis={lead} lead={lead} haslo={haslo} dzial="instytut" klasa="tresc">
  <section>
    {ile > 0 ? <WartoWiedziec lang={lang} uklad="lista" /> : <p>{T('Na razie brak pozycji.', 'Nothing here yet.')}</p>}
    <p class="ww-sukcesy">
      <a href={u(wJezyku('/nauka/sukcesy', lang))}>{T('Bieżące nagrody, granty i stypendia — Sukcesy', 'Recent prizes, grants and scholarships — Achievements')}</a> →
    </p>
  </section>
</Podstrona>

<style>
  .ww-sukcesy { margin: 24px 0 0; font-size: 15.5px; }
</style>
