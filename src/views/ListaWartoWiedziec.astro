---
// Lista „Warto wiedzieć” (/instytut/warto-wiedziec, /en/instytut/warto-wiedziec; zlecenie 47, punkt 4; wygląd: prototyp v4.15,
// C-prototyp/strona/index.html). Szablon podstrony (zal/Podstrona.astro) pod Instytutem: „← Instytut” nad tytułem, baner jak strony
// działów (hasło z pola i trzy liczby: lata od pierwszego wykładu, sylwetki, 4 rektorów UWr), spis „Na tej stronie” z trzema grupami.
// Treść: wstęp z pola Opis (p.wst, słowo „Aktualnościach” to link do /aktualnosci), potem:
// - Sylwetki: zdanie pod nagłówkiem i siatka kart (ww/SiatkaSylwetek.astro), kolejność wg roku urodzenia z pola „Lata”;
// - Nagrody i wyróżnienia: wiersze bez roku (WartoWiedziec.astro) z licznikiem laureatów, kolejność z pola „Kolejność”;
// - Historie: pozioma oś czasu (ww/OsHistorii.astro).
// Bez przełącznika widoków, wyszukiwarki i „Następnej strony w dziale”. Grupa bez widocznych wpisów — bez sekcji (i bez pozycji w spisie).
import Podstrona from '../components/zal/Podstrona.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import WartoWiedziec from '../components/WartoWiedziec.astro';
import SiatkaSylwetek from '../components/ww/SiatkaSylwetek.astro';
import OsHistorii from '../components/ww/OsHistorii.astro';
import { u } from '../lib/url';
import { wJezyku } from '../lib/i18n';
import { nazwaGrupy } from '../lib/wartoWiedziec';
import type { Lang } from '../lib/daty';
import { daneListyWartoWiedziec } from '../lib/widoki/listaWartoWiedziec';
import '../styles/warto-wiedziec.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const { tytul, opis, opisPl, haslo, liczby, sylwetki, nagrody, historie } = await daneListyWartoWiedziec(lang);

// wstęp: zwykły tekst z pola Opis; pierwsze „Aktualnościach” („News” w Opisie EN) prowadzi do listy Aktualności
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const wstep = opis ? esc(opis).replace(/Aktualnościach|Aktualności|the News|News/, (m) => `<a href="${u(wJezyku('/aktualnosci', lang))}">${m}</a>`) : '';
const sekcje = [
  { id: 'sylwetki', ile: sylwetki.length },
  { id: 'nagrody', ile: nagrody.length },
  { id: 'historie', ile: historie.filter((w) => w.rok !== undefined).length },
].filter((s) => s.ile > 0).map((s) => ({ id: s.id, etykieta: nazwaGrupy(s.id as 'sylwetki', lang) }));
const od = historie.find((w) => w.rok !== undefined)?.rok;
---
<Podstrona lang={lang} tytul={tytul} opis={opis} uklad="zwarta portal-baner" haslo={haslo} wstecz={{ etykieta: T('Instytut', 'Institute'), adres: '/instytut' }}
  dzial="instytut" spis={sekcje} klasa="tresc z-ww2">
  <Fragment slot="baner"><LiczbyBanera lang={lang} pozycje={liczby} /></Fragment>
  {wstep && <p class="wst ww2-wst" lang={opisPl ? 'pl' : undefined} set:html={wstep} />}
  {sylwetki.length > 0 && (
    <section id="sylwetki" aria-labelledby="sylwetki-h">
      <h2 id="sylwetki-h">{nazwaGrupy('sylwetki', lang)}</h2>
      <p class="ww2-sek-opis">{T('Ludzie, którzy zbudowali Instytut i jego pozycję. Każda sylwetka łączy się z historiami i wyróżnieniami z tej strony.', 'The people who built the Institute and its standing. Each profile links to the stories and distinctions on this page.')}</p>
      <SiatkaSylwetek wpisy={sylwetki} lang={lang} />
    </section>
  )}
  {nagrody.length > 0 && (
    <section id="nagrody" aria-labelledby="nagrody-h">
      <h2 id="nagrody-h">{nazwaGrupy('nagrody', lang)}</h2>
      <WartoWiedziec lang={lang} wpisy={nagrody} />
    </section>
  )}
  {od !== undefined && (
    <section id="historie" aria-labelledby="historie-h">
      <h2 id="historie-h">{nazwaGrupy('historie', lang)}</h2>
      <p class="ww2-sek-opis">{T(`Wydarzenia i odkrycia od ${od} roku. Najedź na punkt na osi albo go wybierz.`, `Events and discoveries since ${od}. Hover over a point on the timeline or select it.`)}</p>
      <OsHistorii wpisy={historie} lang={lang} />
    </section>
  )}
</Podstrona>
