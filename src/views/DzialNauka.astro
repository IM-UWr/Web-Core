---
// Strona działu „Nauka” (/nauka, /en/nauka): wstęp, liczby, kafelki z menu „Nauka”, obszary badań zakładów,
// seminaria w tym tygodniu, konferencje, realizowane projekty i obrony doktorskie.
// Teksty edytowalne w CMS: src/data/dzialy/nauka.json — reszta wylicza się sama z kolekcji treści.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import Ikona from '../components/Ikona.astro';
import ListaReferatow from '../components/ListaReferatow.astro';
import WartoWiedziec from '../components/WartoWiedziec.astro';
import dzial from '../data/dzialy/nauka.json';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz, RODZAJE_GRANTOW } from '../lib/i18n';
import { today, addDays, range, dayNum, monthShort, longWithDay, type Lang } from '../lib/daty';
import { menuGlowne } from '../lib/menu';
import {
  zaklady, seminaria, konferencje, granty, obrony, referatyWTygodniu, tydzienSeminariow, trwaLubBedzie, slugOf,
  type Grant, type Konferencja, type Obrona, type Zaklad,
} from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));

// Odmiana po liczebniku: 1 / 2–4 (bez 12–14) / 5+ ; po angielsku: 1 / reszta.
const odm = (n: number, pl: [string, string, string], en: [string, string]) => {
  if (lang === 'en') return n === 1 ? en[0] : en[1];
  if (n === 1) return pl[0];
  const j = n % 10, d = n % 100;
  return j >= 2 && j <= 4 && (d < 12 || d > 14) ? pl[1] : pl[2];
};

const [listaZakladow, listaSeminariow, listaKonferencji, listaGrantow, listaObron] = await Promise.all([
  zaklady(), seminaria(), konferencje(), granty(), obrony(),
]);
const dzis = today();
const rok = Number(dzis.slice(0, 4));

// Projekty realizowane — tak samo jak na /nauka/granty: rok zakończenia ≥ bieżący rok.
const realizowane = listaGrantow.filter((g) => (g.data.rok_do ?? 0) >= rok);
const maOpis = (g: Grant) => !!g.body?.trim();
// Przykłady: najpierw projekty z opisem, potem najnowsze (każdy ma własną podstronę).
const przyklady = [...realizowane.filter(maOpis), ...realizowane.filter((g) => !maOpis(g))].slice(0, 4);
const lata = (g: Grant) => (g.data.rok_od && g.data.rok_do && g.data.rok_od !== g.data.rok_do ? `${g.data.rok_od}–${g.data.rok_do}` : String(g.data.rok_od ?? g.data.rok_do ?? ''));
const tytulGrantu = (g: Grant) => (lang === 'en' && g.data.tytul_en) || g.data.tytul;

const aktywneSeminaria = listaSeminariow.filter((s) => s.data.aktywne !== false);
const referaty = await referatyWTygodniu(lang);
const tydzien = tydzienSeminariow();
const naglowekSeminariow = t(lang, tydzien.przyszly ? 'seminariaPrzyszly' : 'seminariaTydzien');

// Konferencje: nadchodzące i trwające (najbliższe najpierw); gdy brak — trzy ostatnie.
const konfTrwa = (k: Konferencja) => trwaLubBedzie({ poczatek: k.data.poczatek, koniec: k.data.koniec });
const nadchodzaceKonf = listaKonferencji.filter(konfTrwa).reverse().slice(0, 3);
const pokazKonf = nadchodzaceKonf.length ? nadchodzaceKonf : listaKonferencji.filter((k) => !konfTrwa(k)).slice(0, 3);
const konfWRoku = listaKonferencji.filter((k) => k.data.poczatek.slice(0, 4) === String(rok) && !k.data.odwolana);

// Obrony: najbliższe, a po nich ostatnio odbyte — razem trzy.
const obronaBedzie = (o: Obrona) => trwaLubBedzie({ poczatek: o.data.termin });
const odbyteObrony = listaObron.filter((o) => !obronaBedzie(o));
const pokazObrony = [...listaObron.filter(obronaBedzie).reverse(), ...odbyteObrony].slice(0, 3);
const rokTemu = addDays(dzis, -365);
const obronyRok = odbyteObrony.filter((o) => o.data.termin.slice(0, 10) >= rokTemu);

// Pasek liczb (pozycje z zerem pomijamy).
const liczby = [
  { n: realizowane.length, l: odm(realizowane.length, ['realizowany projekt badawczy', 'realizowane projekty badawcze', 'realizowanych projektów badawczych'], ['ongoing research project', 'ongoing research projects']) },
  { n: aktywneSeminaria.length, l: odm(aktywneSeminaria.length, ['aktywne seminarium', 'aktywne seminaria', 'aktywnych seminariów'], ['active seminar', 'active seminars']) },
  { n: konfWRoku.length, l: `${odm(konfWRoku.length, ['konferencja', 'konferencje', 'konferencji'], ['conference', 'conferences'])} ${T(`w ${rok} roku`, `in ${rok}`)}` },
  { n: obronyRok.length, l: `${odm(obronyRok.length, ['obrona doktorska', 'obrony doktorskie', 'obron doktorskich'], ['PhD defence', 'PhD defences'])} ${T('w ostatnich 12 miesiącach', 'in the last 12 months')}` },
].filter((x) => x.n > 0);

// Kafelki: grupy i linki z menu „Nauka” (nowy link w menu sam pojawi się tutaj).
const pozycja = (await menuGlowne()).find((m) => m.etykieta === 'Nauka' || m.etykieta_en === 'Research');
const grupy = (pozycja?.grupy ?? []).filter((g) => g.linki.length > 0);

const nazwaKrotka = (z: Zaklad) =>
  lang === 'en' ? z.data.nazwa_krotka_en || z.data.nazwa_en || z.data.nazwa_krotka || z.data.nazwa : z.data.nazwa_krotka || z.data.nazwa;
const obszaryZakladu = (z: Zaklad) => (lang === 'en' && z.data.obszary_en.length ? z.data.obszary_en : z.data.obszary);

const naglowek = T('Nauka', 'Research');
const lead = wybierz(dzial, 'wstep', lang);
const obszaryOpis = wybierz(dzial, 'obszary_opis', lang);
---
<Baza tytul={naglowek} opis={lead || undefined}>
  {/* Wariant „Portal”: liczby w jednym wierszu w nagłówku (komputer i telefon). */}
  <NaglowekStrony tytul={naglowek} lead={lead || undefined} lang={lang} okruszki={[{ etykieta: naglowek }]}>
    {liczby.length > 0 && (
      <ul class="pt-liczby">
        {liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}
      </ul>
    )}
  </NaglowekStrony>

  {/* Komputer (≥ 761 px) — wariant „Portal”: linki działu w kolumnach, potem „co się dzieje” (seminaria | konferencje |
       obrony) w trzech kolumnach, zakłady w zwartej siatce, na końcu projekty i „Warto wiedzieć” obok siebie. */}
  <div class="wrap dz-wrap tylko-komputer">
    {grupy.length > 0 && (
      <section class="zsec" aria-labelledby="w-dziale">
        <h2 id="w-dziale">{T('W tym dziale', 'In this section')}</h2>
        <div class="pt-grid pt-rowne">
          {grupy.map((g) => (
            <div class="pt-box">
              <div class="pt-h"><h3>{wybierz(g, 'nazwa', lang)}</h3></div>
              <ul class="pt-links">
                {g.linki.map((l) => (
                  <li>
                    <a href={href(l.adres)}>
                      <span>{wybierz(l, 'etykieta', lang)}</span>
                      <Ikona nazwa={isExternal(l.adres) ? 'zewnetrzny' : 'strzalka'} rozmiar={16} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="zsec">
      <div class="pt-grid">
        <section class="pt-box" aria-labelledby="seminaria">
          <div class="pt-h">
            <span class="pt-h-l">
              <h2 id="seminaria">{naglowekSeminariow}</h2>
              <span class="pt-zakres">{range(tydzien.od, tydzien.do, lang)}</span>
            </span>
          </div>
          <ListaReferatow
            wiersze={referaty}
            lang={lang}
            etykieta={naglowekSeminariow}
            pusty={t(lang, tydzien.przyszly ? 'brakReferatowPrzyszly' : 'brakReferatow')}
          />
          <p class="pt-stopka"><a class="pt-all" href={href('/seminaria')}>{t(lang, 'wszystkieSeminaria')}<Ikona nazwa="strzalka" rozmiar={14} /></a></p>
        </section>

        <section class="pt-box" aria-labelledby="konferencje">
          <div class="pt-h"><h2 id="konferencje">{nadchodzaceKonf.length ? T('Najbliższe konferencje', 'Upcoming conferences') : T('Konferencje', 'Conferences')}</h2></div>
          {nadchodzaceKonf.length === 0 && (
            <p class="pt-opis">
              {T('Nie zapowiedziano jeszcze kolejnych konferencji.', 'No upcoming conferences have been announced yet.')}
              {pokazKonf.length > 0 && ` ${T('Ostatnio odbyły się:', 'Most recent:')}`}
            </p>
          )}
          {pokazKonf.length > 0 && (
            <ul class="pt-list">
              {pokazKonf.map((k) => (
                <li>
                  <a class="pt-item" href={href(`/nauka/konferencje/${slugOf(k.id)}`)}>
                    <span class={`pt-dbox${nadchodzaceKonf.length ? '' : ' light'}`} aria-hidden="true"><span class="d">{dayNum(k.data.poczatek)}</span><span class="m">{monthShort(k.data.poczatek, lang)}</span></span>
                    <span class="pt-b">
                      <span class="pt-k">{range(k.data.poczatek, k.data.koniec, lang)}</span>
                      <span class="pt-t">{wybierz(k.data, 'tytul', lang)}</span>
                      {k.data.miejsce && <span class="pt-s">{k.data.miejsce}</span>}
                      {k.data.odwolana && <span><span class="badge">{T('odwołana', 'cancelled')}</span></span>}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          <p class="pt-stopka"><a class="pt-all" href={href('/nauka/konferencje')}>{T('Wszystkie konferencje', 'All conferences')}<Ikona nazwa="strzalka" rozmiar={14} /></a></p>
        </section>

        <section class="pt-box pt-szeroka-sr" aria-labelledby="obrony">
          <div class="pt-h"><h2 id="obrony">{t(lang, 'obrony')}</h2></div>
          {pokazObrony.length === 0 && <p class="pt-pusto">{T('Brak zapowiedzianych obron.', 'No PhD defences announced.')}</p>}
          {pokazObrony.length > 0 && (
            <ul class="pt-list">
              {pokazObrony.map((o) => {
                const bedzie = obronaBedzie(o);
                return (
                  <li>
                    <a class="pt-item" href={href(`/obrony-doktorskie/${slugOf(o.id)}`)}>
                      <span class={`pt-dbox${bedzie ? '' : ' light'}`} aria-hidden="true"><span class="d">{dayNum(o.data.termin)}</span><span class="m">{monthShort(o.data.termin, lang)}</span></span>
                      <span class="pt-b">
                        <span class="pt-k">{bedzie && <>{T('nadchodząca', 'upcoming')} · </>}<span class="pt-k-m">{longWithDay(o.data.termin, lang)}</span></span>
                        <span class="pt-t">{o.data.kandydat}</span>
                        <span class="pt-s" lang="en">{o.data.tytul_rozprawy}</span>
                        {o.data.miejsce && <span class="pt-s">{o.data.miejsce}</span>}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
          <p class="pt-stopka"><a class="pt-all" href={href('/obrony-doktorskie')}>{T('Wszystkie obrony', 'All PhD defences')}<Ikona nazwa="strzalka" rozmiar={14} /></a></p>
        </section>
      </div>
    </div>

    {listaZakladow.length > 0 && (
      <section class="zsec" aria-labelledby="obszary">
        <div class="dz-head">
          <h2 id="obszary">{T('Obszary badań', 'Research areas')}</h2>
          <a class="pt-all" href={href('/instytut/struktura')}>{T('Struktura i zakłady', 'Structure and departments')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
        </div>
        {obszaryOpis && <p class="dz-intro">{obszaryOpis}</p>}
        <div class="pt-cards pt-cards-3">
          {listaZakladow.map((z) => (
            <article class="pt-card pt-link">
              <h3 class="n"><a href={href(`/instytut/zaklady/${z.id}`)}>{nazwaKrotka(z)}</a></h3>
              {obszaryZakladu(z).length > 0 && <p class="pt-hasla">{obszaryZakladu(z).map((o) => <span>{o}</span>)}</p>}
              <p class="f">{wybierz(z.data, 'nazwa', lang)}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <div class="zsec" style="margin-bottom:0">
      <div class="pt-grid">
        <section class="pt-box pt-span-2" aria-labelledby="granty">
          <div class="pt-h">
            <span class="pt-h-l">
              <h2 id="granty">{T('Realizowane projekty', 'Ongoing projects')}</h2>
              <span class="pt-zakres">({realizowane.length})</span>
            </span>
            <a class="pt-all" href={href('/nauka/granty')}>{T('Wszystkie projekty i granty', 'All projects and grants')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
          </div>
          {realizowane.length === 0 && <p class="pt-pusto">{T('Obecnie brak realizowanych projektów.', 'No ongoing projects at the moment.')}</p>}
          {realizowane.length > przyklady.length && <p class="pt-opis">{T(`Wybrane spośród ${realizowane.length} realizowanych projektów.`, `A selection of ${realizowane.length} ongoing projects.`)}</p>}
          {przyklady.length > 0 && (
            <div class="pt-cards pt-cards-2 dz-projekty">
              {przyklady.map((g) => (
                <article class="pt-card pt-link">
                  <div class="news-meta">
                    <span class={`badge${g.data.rodzaj === 'ncn' ? ' badge-wydarzenie' : g.data.rodzaj === 'ue' ? ' badge-sukces' : ''}`}>{RODZAJE_GRANTOW[g.data.rodzaj][lang]}</span>
                    {g.data.program && <span class="badge">{g.data.program}</span>}
                    {lata(g) && <span>{lata(g)}</span>}
                  </div>
                  <h3 class="n"><a href={href(`/nauka/granty/${slugOf(g.id)}`)}>{tytulGrantu(g)}</a></h3>
                  {g.data.kierownik && <p class="o"><span class="muted">{T('Kierownik', 'Principal investigator')}:</span> {g.data.kierownik}</p>}
                  {(g.data.kod || g.data.strona) && (
                    <p class="f">
                      {g.data.kod && <span class="dz-kod">{g.data.kod}</span>}
                      {g.data.strona && <a href={g.data.strona}>{T('Strona projektu', 'Project website')} <Ikona nazwa="zewnetrzny" rozmiar={13} /></a>}
                    </p>
                  )}
                </article>
              ))}
            </div>
          )}
        </section>
        <div class="pt-col pt-szeroka-sr">
          <WartoWiedziec lang={lang} dzial="nauka" uklad="portal" komputer />
        </div>
      </div>
    </div>
  </div>

  {/* Telefon (≤ 760 px) — wygląd „Portal” jak na głównej gałęzi: „W tym dziale” w ramkach, zaraz pod nimi seminaria,
       konferencje i obrony, obszary badań w zwartych kartach, projekty w ramce i na końcu „Warto wiedzieć”.
       Cały blok jest poza wyszukiwarką, a id mają przyrostek „-tel” (ta sama treść jest w bloku na komputer). */}
  <div class="wrap dz-wrap tylko-telefon" data-pagefind-ignore>
    {grupy.length > 0 && (
      <section class="zsec" aria-labelledby="w-dziale-tel">
        <h2 id="w-dziale-tel">{T('W tym dziale', 'In this section')}</h2>
        <div class="dz-groups">
          {grupy.map((g) => (
            <div class="dz-g">
              <h3>{wybierz(g, 'nazwa', lang)}</h3>
              <div class="tiles dz-tiles">
                {g.linki.map((l) => (
                  <a class="tile dz-tile" href={href(l.adres)}>
                    <span>{wybierz(l, 'etykieta', lang)}</span>
                    <Ikona nazwa={isExternal(l.adres) ? 'zewnetrzny' : 'strzalka'} rozmiar={20} />
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="zsec dz-tel">
      <section class="pt-box" aria-labelledby="seminaria-tel">
        <div class="pt-h">
          <span class="pt-h-l">
            <h2 id="seminaria-tel">{naglowekSeminariow}</h2>
            <span class="pt-zakres">{range(tydzien.od, tydzien.do, lang)}</span>
          </span>
        </div>
        <ListaReferatow
          wiersze={referaty}
          lang={lang}
          etykieta={naglowekSeminariow}
          pusty={t(lang, tydzien.przyszly ? 'brakReferatowPrzyszly' : 'brakReferatow')}
        />
        <p class="pt-stopka"><a class="pt-all" href={href('/seminaria')}>{t(lang, 'wszystkieSeminaria')}<Ikona nazwa="strzalka" rozmiar={14} /></a></p>
      </section>

      <section class="pt-box" aria-labelledby="konferencje-tel">
        <div class="pt-h"><h2 id="konferencje-tel">{nadchodzaceKonf.length ? T('Najbliższe konferencje', 'Upcoming conferences') : T('Konferencje', 'Conferences')}</h2></div>
        {nadchodzaceKonf.length === 0 && (
          <p class="pt-opis">
            {T('Nie zapowiedziano jeszcze kolejnych konferencji.', 'No upcoming conferences have been announced yet.')}
            {pokazKonf.length > 0 && ` ${T('Ostatnio odbyły się:', 'Most recent:')}`}
          </p>
        )}
        {pokazKonf.length > 0 && (
          <ul class="pt-list">
            {pokazKonf.map((k) => (
              <li>
                <a class="pt-item" href={href(`/nauka/konferencje/${slugOf(k.id)}`)}>
                  <span class={`pt-dbox${nadchodzaceKonf.length ? '' : ' light'}`} aria-hidden="true"><span class="d">{dayNum(k.data.poczatek)}</span><span class="m">{monthShort(k.data.poczatek, lang)}</span></span>
                  <span class="pt-b">
                    <span class="pt-k">{range(k.data.poczatek, k.data.koniec, lang)}</span>
                    <span class="pt-t">{wybierz(k.data, 'tytul', lang)}</span>
                    {k.data.miejsce && <span class="pt-s">{k.data.miejsce}</span>}
                    {k.data.odwolana && <span><span class="badge">{T('odwołana', 'cancelled')}</span></span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
        <p class="pt-stopka"><a class="pt-all" href={href('/nauka/konferencje')}>{T('Wszystkie konferencje', 'All conferences')}<Ikona nazwa="strzalka" rozmiar={14} /></a></p>
      </section>

      <section class="pt-box" aria-labelledby="obrony-tel">
        <div class="pt-h"><h2 id="obrony-tel">{t(lang, 'obrony')}</h2></div>
        {pokazObrony.length === 0 && <p class="pt-pusto">{T('Brak zapowiedzianych obron.', 'No PhD defences announced.')}</p>}
        {pokazObrony.length > 0 && (
          <ul class="pt-list">
            {pokazObrony.map((o) => {
              const bedzie = obronaBedzie(o);
              return (
                <li>
                  <a class="pt-item" href={href(`/obrony-doktorskie/${slugOf(o.id)}`)}>
                    <span class={`pt-dbox${bedzie ? '' : ' light'}`} aria-hidden="true"><span class="d">{dayNum(o.data.termin)}</span><span class="m">{monthShort(o.data.termin, lang)}</span></span>
                    <span class="pt-b">
                      <span class="pt-k">{bedzie && <>{T('nadchodząca', 'upcoming')} · </>}<span class="pt-k-m">{longWithDay(o.data.termin, lang)}</span></span>
                      <span class="pt-t">{o.data.kandydat}</span>
                      <span class="pt-s" lang="en">{o.data.tytul_rozprawy}</span>
                      {o.data.miejsce && <span class="pt-s">{o.data.miejsce}</span>}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
        <p class="pt-stopka"><a class="pt-all" href={href('/obrony-doktorskie')}>{T('Wszystkie obrony', 'All PhD defences')}<Ikona nazwa="strzalka" rozmiar={14} /></a></p>
      </section>
    </div>

    {listaZakladow.length > 0 && (
      <section class="zsec dz-karty" aria-labelledby="obszary-tel">
        <h2 id="obszary-tel">{T('Obszary badań', 'Research areas')}</h2>
        <a class="pt-all dz-head-link" href={href('/instytut/struktura')}>{T('Struktura i zakłady', 'Structure and departments')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
        {obszaryOpis && <p class="dz-intro">{obszaryOpis}</p>}
        <div class="spec-grid">
          {listaZakladow.map((z) => (
            <article class="spec spec-link">
              <h3><a href={href(`/instytut/zaklady/${z.id}`)}>{nazwaKrotka(z)}</a></h3>
              {obszaryZakladu(z).length > 0 && <p class="dz-tags">{obszaryZakladu(z).map((o) => <span class="badge">{o}</span>)}</p>}
              <p class="foot"><span class="muted">{wybierz(z.data, 'nazwa', lang)}</span></p>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="zsec dz-ramka-sek" aria-labelledby="granty-tel">
      <h2 id="granty-tel">{T('Realizowane projekty', 'Ongoing projects')} <span class="muted dz-ile">({realizowane.length})</span></h2>
      <a class="pt-all dz-head-link" href={href('/nauka/granty')}>{T('Wszystkie projekty i granty', 'All projects and grants')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
      <span class="dz-kreska" aria-hidden="true"></span>
      {realizowane.length === 0 && <p class="dz-intro">{T('Obecnie brak realizowanych projektów.', 'No ongoing projects at the moment.')}</p>}
      {realizowane.length > przyklady.length && <p class="dz-intro">{T(`Wybrane spośród ${realizowane.length} realizowanych projektów.`, `A selection of ${realizowane.length} ongoing projects.`)}</p>}
      {przyklady.length > 0 && (
        <div class="dz-granty">
          {przyklady.map((g) => (
            <article class="spec spec-link">
              <div class="news-meta">
                <span class={`badge${g.data.rodzaj === 'ncn' ? ' badge-wydarzenie' : g.data.rodzaj === 'ue' ? ' badge-sukces' : ''}`}>{RODZAJE_GRANTOW[g.data.rodzaj][lang]}</span>
                {g.data.program && <span class="badge">{g.data.program}</span>}
                {lata(g) && <span>{lata(g)}</span>}
              </div>
              <h3><a href={href(`/nauka/granty/${slugOf(g.id)}`)}>{tytulGrantu(g)}</a></h3>
              {g.data.kierownik && <p><span class="lbl">{T('Kierownik', 'Principal investigator')}</span>{g.data.kierownik}</p>}
              {(g.data.kod || g.data.strona) && (
                <p class="foot">
                  {g.data.kod && <span class="dz-kod">{g.data.kod}</span>}
                  {g.data.strona && <a href={g.data.strona}>{T('Strona projektu', 'Project website')} <Ikona nazwa="zewnetrzny" rozmiar={13} /></a>}
                </p>
              )}
            </article>
          ))}
        </div>
      )}
    </section>

    <div>
      <WartoWiedziec lang={lang} dzial="nauka" uklad="portal" />
    </div>
  </div>
</Baza>

<style>
  /* Układ wspólny ze stroną działu „Instytut” (DzialInstytut.astro). Blok na komputer i blok na telefon:
     mało miejsca nad i pod treścią, jak w wariancie „Portal”. */
  .dz-wrap { padding-top: 4px; padding-bottom: 36px; }
  .dz-intro { margin: -2px 0 10px; max-width: 860px; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .dz-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 20px 16px; }
  .dz-g h3 { margin: 0 0 10px; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .dz-tiles { grid-template-columns: 1fr; gap: 8px; padding-top: 0; }
  .dz-tile { flex-direction: row; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; }
  .dz-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  /* Tylko na stronie „Nauka”. */
  .dz-ile { font-size: 16px; font-weight: 600; }
  .dz-granty { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 14px; }
  .dz-granty h3 { font-size: 17px; line-height: 1.3; }
  .dz-kod { color: var(--muted); font-variant-numeric: tabular-nums; }

  /* ---------- komputer (≥ 761 px): wariant „Portal” (blok .tylko-komputer) ---------- */
  .dz-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 20px; margin-bottom: 8px; }
  .dz-head h2 { margin: 0; font-size: 22px; font-weight: 800; scroll-margin-top: 16px; }
  .dz-projekty { margin-top: 8px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dz-projekty .news-meta { font-size: 13px; gap: 4px 8px; }
  .dz-projekty .f { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 12px; }

  /* ---------- telefon (≤ 760 px): wygląd „Portal” (wspólny ze stroną „Instytut”) ---------- */
  @media (max-width: 760px) {
    /* „W tym dziale”: każda grupa w ramce, linki jako wiersze (napis z lewej, strzałka z prawej) */
    .dz-groups { display: flex; flex-direction: column; gap: 12px; }
    .dz-g { padding: 10px 14px 8px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); }
    .dz-g h3, .dz-ramka-sek > h2 { margin: 0 0 4px; padding-bottom: 7px; border-bottom: 2px solid var(--ink); font-size: 18px; font-weight: 800; line-height: 1.3; letter-spacing: -0.01em; text-transform: none; color: var(--ink); }
    .dz-g h3::before, .dz-ramka-sek > h2::before { content: ''; display: inline-block; width: 4px; height: .85em; margin-right: 9px; border-radius: 2px; background: var(--accent); vertical-align: -.05em; }
    :global(:root[data-theme='dark']) .dz-g h3 { border-bottom-color: var(--line); }
    .dz-tiles { display: block; }
    .dz-tile { gap: 10px; min-height: 40px; padding: 6px 4px; border: 0; border-radius: 0; background: transparent; box-shadow: none; font-size: 15px; line-height: 1.3; }
    .dz-tile + .dz-tile { min-height: 41px; border-top: 1px solid var(--line); }
    .dz-tile:hover { background: var(--tint); }
    .dz-tile :global(svg) { width: 16px !important; height: 16px !important; color: var(--muted); }
    :global(:root[data-theme='dark']) .dz-tile :global(svg) { color: var(--muted); }
    /* seminaria, konferencje, obrony (blok tylko na telefon): ramki jedna pod drugą */
    .dz-tel { display: flex; flex-direction: column; gap: 12px; }
    /* obszary badań: tytuł i link w jednym wierszu, zwarte karty (hasła jako tekst) */
    .dz-karty { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; column-gap: 20px; }
    .dz-karty > * { flex: 1 1 100%; min-width: 0; }
    .dz-karty > h2 { flex: 0 1 auto; margin: 0 0 8px; }
    .dz-karty > .dz-head-link, .dz-ramka-sek > .dz-head-link { flex: 0 0 auto; }
    .dz-karty > .dz-head-link { margin-bottom: 8px; }
    .dz-karty .spec-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .dz-karty .spec { gap: 3px; padding: 11px 14px 12px; border-radius: var(--radius-s); line-height: 1.45; }
    .dz-karty .spec-link:hover, .dz-karty .spec-link:focus-within, .dz-ramka-sek .spec-link:hover, .dz-ramka-sek .spec-link:focus-within { box-shadow: none; transform: none; }
    .dz-karty .spec h3 { font-size: 16px; line-height: 1.3; }
    .dz-tags { display: block; margin: 2px 0 0; font-size: 14px; line-height: 1.45; color: var(--text); }
    .dz-tags .badge { display: inline; padding: 0; border-radius: 0; background: none; color: inherit; font-size: inherit; font-weight: 400; line-height: inherit; }
    .dz-tags .badge + .badge::before { content: ' · '; color: var(--muted); }
    /* (jak w wariancie: akapit stopki karty zachowuje zwykły odstęp akapitu pod spodem) */
    .dz-karty .spec .foot { margin-bottom: 1em; }
    .dz-karty .spec .foot, .dz-ramka-sek .spec .foot { margin-top: auto; padding-top: 6px; border-top: 0; font-size: 13.5px; line-height: 1.4; color: var(--muted); }
    /* projekty: sekcja w ramce (kreska sekcji nad nią zostaje); ramka narysowana pod treścią (::after) */
    .zsec.dz-ramka-sek { position: relative; isolation: isolate; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; column-gap: 14px; margin-bottom: 12px; padding: 27px 15px 9px; }
    .zsec.dz-ramka-sek::after { content: ''; position: absolute; inset: 16px 0 0; z-index: -1; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); pointer-events: none; }
    .dz-ramka-sek > * { flex: 1 1 100%; min-width: 0; }
    .dz-ramka-sek > h2 { flex: 0 1 auto; margin: 0; padding-bottom: 0; border-bottom: 0; }
    /* kreska pod tytułem i linkiem (osobny element, bo tytuł musi zostać bezpośrednio w sekcji) */
    .dz-kreska { display: block; height: 2px; margin: 7px 0 4px; background: var(--ink); }
    :global(:root[data-theme='dark']) .dz-kreska { background: var(--line); }
    .dz-ramka-sek .dz-ile { margin-left: 4px; font-size: 13px; font-weight: 700; }
    .dz-ramka-sek .dz-intro { margin: 6px 0 4px; font-size: 14px; line-height: 1.45; }
    .dz-granty { margin-top: 8px; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .dz-granty .spec { gap: 3px; padding: 11px 14px 12px; border-radius: var(--radius-s); line-height: 1.45; }
    .dz-granty h3 { font-size: 16px; }
    .dz-granty .news-meta { font-size: 13px; gap: 4px 8px; }
    .dz-granty .lbl { display: inline; margin-right: .3em; font-size: inherit; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--muted); }
    .dz-granty .lbl::after { content: ':'; }
    .dz-granty .spec > p:not(.foot) { margin: 1em 0; font-size: 14px; }
    .dz-granty .foot { flex-direction: row; flex-wrap: wrap; justify-content: space-between; gap: 2px 12px; margin-bottom: 1em; }
  }
  @media (max-width: 560px) {
    .dz-karty .spec-grid, .dz-granty { grid-template-columns: minmax(0, 1fr); }
  }
</style>
