---
// Strona działu „Nauka” (/nauka, /en/nauka): baner działu z liczbami (konferencje w ostatnim roku), pod nim blok TrescDzialu —
// podstrony w grupach jak w menu, „Badania w Instytucie” z „W skrócie”, realizowane projekty i konferencje.
// Teksty edytowalne w CMS: src/data/dzialy/nauka.json — reszta wylicza się sama z kolekcji treści.
// Jedna wersja HTML: komputer i telefon (≤ 760 px, jedna kolumna) — src/styles/zal-dzialy.css.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import TrescDzialu from '../components/zal/TrescDzialu.astro';
import Sekcja from '../components/zal/dzial/Sekcja.astro';
import Wiersz from '../components/zal/dzial/Wiersz.astro';
import { u, isExternal } from '../lib/url';
import { wJezyku, wybierz, RODZAJE_GRANTOW, bezSierotek } from '../lib/i18n';
import { range, type Lang } from '../lib/daty';
import { slugOf, miejsce, type Grant } from '../lib/tresci';
import { daneDzialuNauka } from '../lib/widoki/dzialNauka';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
const lata = (g: Grant) => (g.data.rok_od && g.data.rok_do && g.data.rok_od !== g.data.rok_do ? `${g.data.rok_od}–${g.data.rok_do}` : String(g.data.rok_od ?? g.data.rok_do ?? ''));
const tytulGrantu = (g: Grant) => (lang === 'en' && g.data.tytul_en) || g.data.tytul;

const { realizowane, przyklady, nadchodzaceKonf, pokazKonf, liczby, liczbyKomputer, grupy, naglowek, lead, haslo, badania, fakty } = await daneDzialuNauka(lang);
---
<Baza tytul={naglowek} opis={lead || undefined} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={naglowek} lead={lead || undefined} haslo={haslo || undefined} lang={lang} okruszki={[{ etykieta: naglowek }]}>
    {/* liczby w banerze: konferencje w ostatnim roku (gdy są), inaczej liczby działu z danych */}
    {(liczbyKomputer.length > 0 ? liczbyKomputer : liczby).length > 0 && (
      <ul class="pt-liczby">
        {(liczbyKomputer.length > 0 ? liczbyKomputer : liczby).map((x) => <li><span class="n">{x.n}</span>{bezSierotek(x.l)}</li>)}
      </ul>
    )}
  </NaglowekStrony>
  <TrescDzialu dzial="nauka" lang={lang} grupy={grupy} tekst={{ tytul: T('Badania w Instytucie', 'Research at the Institute'), akapity: badania, fakty }}>
    <Sekcja id="z-dz-projekty" tytul={`${T('Realizowane projekty', 'Ongoing projects')} (${realizowane.length})`} lang={lang}
      linki={[{ etykieta: T('Wszystkie projekty i granty', 'All projects and grants'), adres: '/nauka/granty' }]}
      opis={realizowane.length === 0 ? T('Obecnie brak realizowanych projektów.', 'No ongoing projects at the moment.')
        : realizowane.length > przyklady.length ? T(`Wybrane spośród ${realizowane.length} realizowanych projektów.`, `A selection of ${realizowane.length} ongoing projects.`) : undefined}>
      {przyklady.length > 0 && (
        <div class="z-dz-kart">
          {przyklady.map((g) => (
            <article class="z-dz-klik">
              <div class="gora">{[RODZAJE_GRANTOW[g.data.rodzaj][lang], lata(g)].filter(Boolean).join(' · ')}</div>
              <h3><a href={href(`/nauka/granty/${slugOf(g.id)}`)}>{tytulGrantu(g)}</a></h3>
              {g.data.kierownik && <p>{T('Kierownik', 'Principal investigator')}: {g.data.kierownik}</p>}
              {g.data.kod && <p class="nr">{g.data.kod}</p>}
            </article>
          ))}
        </div>
      )}
    </Sekcja>
    <Sekcja id="z-dz-konferencje" tytul={nadchodzaceKonf.length ? T('Najbliższe konferencje', 'Upcoming conferences') : T('Konferencje', 'Conferences')} lang={lang}
      linki={[{ etykieta: T('Wszystkie konferencje', 'All conferences'), adres: '/nauka/konferencje' }]}
      opis={nadchodzaceKonf.length ? undefined : `${T('Nie zapowiedziano jeszcze kolejnych konferencji.', 'No upcoming conferences have been announced yet.')}${pokazKonf.length ? ` ${T('Ostatnio odbyły się:', 'Most recent:')}` : ''}`}>
      {pokazKonf.length > 0 && (
        <div class="z-dz-wiersze jedna">
          {pokazKonf.map((k) => (
            <Wiersz data={k.data.poczatek} lang={lang} tytul={wybierz(k.data, 'tytul', lang)} adres={k.data.strona || undefined} odwolana={k.data.odwolana}
              etykieta={[range(k.data.poczatek, k.data.koniec, lang), miejsce(k.data.miejsce, lang)].filter(Boolean).join(' · ')} />
          ))}
        </div>
      )}
    </Sekcja>
  </TrescDzialu>
</Baza>
