---
// Strona działu „Nauka” (/nauka, /en/nauka): wstęp, liczby, kafelki z menu „Nauka”, tekst „Badania w Instytucie”
// (z ramką „W skrócie” na komputerze), realizowane projekty i konferencje
// („Warto wiedzieć” tylko na stronie głównej i na /warto-wiedziec — decyzja 30.10.2026)
// (seminaria tygodnia i obrony są na swoich stronach; liczby w banerze zostają).
// Teksty edytowalne w CMS: src/data/dzialy/nauka.json — reszta wylicza się sama z kolekcji treści.
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal” (liczby działu w jednym wierszu w banerze),
// reszta strony jak w wariancie „Zwarta” (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok niżej).
// Telefon (≤ 760 px): wygląd „Portal” (bloki .tylko-telefon i style w @media (max-width: 760px)).
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import Ikona from '../components/Ikona.astro';
import TytulZewn from '../components/TytulZewn.astro';
import dzial from '../data/dzialy/nauka.json';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz, RODZAJE_GRANTOW } from '../lib/i18n';
import { today, addDays, range, dayNum, monthShort, longWithDay, type Lang } from '../lib/daty';
import { menuGlowne } from '../lib/menu';
import {
  seminaria, konferencje, granty, obrony, trwaLubBedzie, slugOf,
  type Grant, type Konferencja, type Obrona,
} from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));

// Odmiana po liczebniku: 1 / 2–4 (bez 12–14) / 5+ ; po angielsku: 1 / reszta.
const odm = (n: number, pl: [string, string, string], en: [string, string]) => {
  if (lang === 'en') return n === 1 ? en[0] : en[1];
  if (n === 1) return pl[0];
  const j = n % 10, d = n % 100;
  return j >= 2 && j <= 4 && (d < 12 || d > 14) ? pl[1] : pl[2];
};

const [listaSeminariow, listaKonferencji, listaGrantow, listaObron] = await Promise.all([
  seminaria(), konferencje(), granty(), obrony(),
]);
const dzis = today();
const rok = Number(dzis.slice(0, 4));

// Projekty realizowane — tak samo jak na /nauka/granty: rok zakończenia ≥ bieżący rok.
const realizowane = listaGrantow.filter((g) => (g.data.rok_do ?? 0) >= rok);
const maOpis = (g: Grant) => !!g.body?.trim();
// Przykłady: najpierw projekty z opisem, potem najnowsze (każdy ma własną podstronę).
const przyklady = [...realizowane.filter(maOpis), ...realizowane.filter((g) => !maOpis(g))].slice(0, 4);
const lata = (g: Grant) => (g.data.rok_od && g.data.rok_do && g.data.rok_od !== g.data.rok_do ? `${g.data.rok_od}–${g.data.rok_do}` : String(g.data.rok_od ?? g.data.rok_do ?? ''));
const tytulGrantu = (g: Grant) => (lang === 'en' && g.data.tytul_en) || g.data.tytul;

const aktywneSeminaria = listaSeminariow.filter((s) => s.data.aktywne !== false);

// Konferencje: nadchodzące i trwające (najbliższe najpierw); gdy brak — trzy ostatnie.
const konfTrwa = (k: Konferencja) => trwaLubBedzie({ poczatek: k.data.poczatek, koniec: k.data.koniec });
const nadchodzaceKonf = listaKonferencji.filter(konfTrwa).reverse().slice(0, 3);
const pokazKonf = nadchodzaceKonf.length ? nadchodzaceKonf : listaKonferencji.filter((k) => !konfTrwa(k)).slice(0, 3);
const konfWRoku = listaKonferencji.filter((k) => k.data.poczatek.slice(0, 4) === String(rok) && !k.data.odwolana);

// Obrony: najbliższe, a po nich ostatnio odbyte — razem trzy.
const obronaBedzie = (o: Obrona) => trwaLubBedzie({ poczatek: o.data.termin });
const odbyteObrony = listaObron.filter((o) => !obronaBedzie(o));
const rokTemu = addDays(dzis, -365);
const obronyRok = odbyteObrony.filter((o) => o.data.termin.slice(0, 10) >= rokTemu);

// Pasek liczb (pozycje z zerem pomijamy).
const liczby = [
  { n: realizowane.length, l: odm(realizowane.length, ['realizowany projekt badawczy', 'realizowane projekty badawcze', 'realizowanych projektów badawczych'], ['ongoing research project', 'ongoing research projects']) },
  { n: aktywneSeminaria.length, l: odm(aktywneSeminaria.length, ['aktywne seminarium', 'aktywne seminaria', 'aktywnych seminariów'], ['active seminar', 'active seminars']) },
  { n: konfWRoku.length, l: `${odm(konfWRoku.length, ['konferencja', 'konferencje', 'konferencji'], ['conference', 'conferences'])} ${T(`w ${rok} roku`, `in ${rok}`)}` },
  { n: obronyRok.length, l: `${odm(obronyRok.length, ['obrona doktorska', 'obrony doktorskie', 'obron doktorskich'], ['PhD defence', 'PhD defences'])} ${T('w ostatnich 12 miesiącach', 'in the last 12 months')}` },
].filter((x) => x.n > 0);

// Kafelki: grupy i linki z menu „Nauka” (nowy link w menu sam pojawi się tutaj).
const pozycja = (await menuGlowne()).find((m) => m.etykieta === 'Nauka' || m.etykieta_en === 'Research');
const grupy = (pozycja?.grupy ?? []).filter((g) => g.linki.length > 0);

const naglowek = T('Nauka', 'Research');
const lead = wybierz(dzial, 'wstep', lang);
// „Badania w Instytucie”: akapity z CMS (pole badania_tekst / badania_tekst_en; akapity oddzielone pustą linią).
const badania = ((wybierz(dzial, 'badania_tekst', lang) as string) || '').split(/\n\s*\n/).map((a) => a.trim()).filter(Boolean);
// Ramka „W skrócie” obok tekstu (komputer): lista {wartosc, opis, opis_en} z CMS; pozycje bez wartości pomijamy.
type Fakt = { wartosc?: string; opis?: string; opis_en?: string };
const fakty = (((dzial as any).badania_fakty ?? []) as Fakt[])
  .filter((f) => f?.wartosc?.trim())
  .map((f) => ({ w: f.wartosc!.trim(), o: (lang === 'en' && f.opis_en) || f.opis || '' }));
---
<Baza tytul={naglowek} opis={lead || undefined} uklad="zwarta portal-baner">
  {/* Liczby działu w jednym wierszu w banerze (komputer i telefon, jak w wariancie „Portal”).
       Telefon (≤ 760 px) — wygląd „Portal”: „W tym dziale” w ramkach, zaraz pod nimi
       konferencje (osobny blok .tylko-telefon — na komputerze pod projektami), tekst „Badania w Instytucie”
       (bez ramki „W skrócie”), projekty w ramce. */}
  <NaglowekStrony tytul={naglowek} lead={lead || undefined} lang={lang} okruszki={[{ etykieta: naglowek }]}>
    {liczby.length > 0 && (
      <ul class="pt-liczby">
        {liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}
      </ul>
    )}
  </NaglowekStrony>
  <div class="wrap dz-wrap">
    {grupy.length > 0 && (
      <section class="zsec dz-pierwsza" aria-labelledby="w-dziale">
        <h2 id="w-dziale">{T('W tym dziale', 'In this section')}</h2>
        <div class="dz-groups">
          {grupy.map((g) => (
            <div class="dz-g">
              <h3>{wybierz(g, 'nazwa', lang)}</h3>
              <div class="tiles dz-tiles">
                {g.linki.map((l) => (
                  <a class="tile dz-tile" href={href(l.adres)}>
                    <span>{wybierz(l, 'etykieta', lang)}</span>
                    <Ikona nazwa={isExternal(l.adres) ? 'zewnetrzny' : 'strzalka'} rozmiar={20} />
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="zsec dz-tel tylko-telefon" data-pagefind-ignore>
      <section class="pt-box" aria-labelledby="konferencje-tel">
        <div class="pt-h">
          <h2 id="konferencje-tel">{nadchodzaceKonf.length ? T('Najbliższe konferencje', 'Upcoming conferences') : T('Konferencje', 'Conferences')}</h2>
          <a class="pt-all" href={href('/nauka/konferencje')}>{T('Wszystkie konferencje', 'All conferences')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
        </div>
        {nadchodzaceKonf.length === 0 && (
          <p class="pt-opis">
            {T('Nie zapowiedziano jeszcze kolejnych konferencji.', 'No upcoming conferences have been announced yet.')}
            {pokazKonf.length > 0 && ` ${T('Ostatnio odbyły się:', 'Most recent:')}`}
          </p>
        )}
        {pokazKonf.length > 0 && (
          <ul class="pt-list">
            {pokazKonf.map((k) => { const Tag = k.data.strona ? 'a' : 'div'; return (
              <li>
                <Tag class:list={['pt-item', !k.data.strona && 'dz-bez-linku']} href={k.data.strona || undefined}>
                  <span class={`pt-dbox${konfTrwa(k) ? '' : ' minione'}`} aria-hidden="true"><span class="d">{dayNum(k.data.poczatek)}</span><span class="m">{monthShort(k.data.poczatek, lang)}</span></span>
                  <span class="pt-b">
                    <span class="pt-k">{range(k.data.poczatek, k.data.koniec, lang)}</span>
                    <span class="pt-t"><TytulZewn tekst={wybierz(k.data, 'tytul', lang)} zewn={!!k.data.strona} rozmiar={13} /></span>
                    {k.data.miejsce && <span class="pt-s">{k.data.miejsce}</span>}
                    {k.data.odwolana && <span><span class="badge">{T('odwołana', 'cancelled')}</span></span>}
                  </span>
                </Tag>
              </li>
            ); })}
          </ul>
        )}
      </section>
    </div>

    {/* „Badania w Instytucie” — kilka akapitów z CMS (Ustawienia → Strona działu „Nauka”, pole „Badania w Instytucie”;
         akapity oddzielone pustą linią; puste = brak sekcji) i ramka „W skrócie” (tylko komputer).
         Pełna lista zakładów jest na /instytut/struktura (dział „Instytut”). Wygląd jak „O Instytucie” na /instytut. */}
    {badania.length > 0 && (
      <section class="zsec dz-o" aria-labelledby="badania">
        <h2 id="badania">{T('Badania w Instytucie', 'Research at the Institute')}</h2>
        <div class="dz-o-uklad">
          <div class="dz-o-tekst">{badania.map((a) => <p>{a}</p>)}</div>
          {fakty.length > 0 && (
            <aside class="dz-o-fakty tylko-komputer" aria-labelledby="w-skrocie">
              <p class="dz-o-fakty-h" id="w-skrocie">{T('W skrócie', 'At a glance')}</p>
              <dl>
                {fakty.map((f) => <div><dt>{f.w}</dt>{f.o && <dd>{f.o}</dd>}</div>)}
              </dl>
            </aside>
          )}
        </div>
      </section>
    )}

    <section class="zsec dz-ramka-sek" aria-labelledby="granty">
      <div class="zsec-head">
        <h2 id="granty">{T('Realizowane projekty', 'Ongoing projects')} <span class="muted dz-ile">({realizowane.length})</span></h2>
        <a class="link-arrow" href={href('/nauka/granty')}>{T('Wszystkie projekty i granty', 'All projects and grants')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
      </div>
      {realizowane.length === 0 && <p class="dz-intro">{T('Obecnie brak realizowanych projektów.', 'No ongoing projects at the moment.')}</p>}
      {realizowane.length > przyklady.length && <p class="dz-intro">{T(`Wybrane spośród ${realizowane.length} realizowanych projektów.`, `A selection of ${realizowane.length} ongoing projects.`)}</p>}
      {przyklady.length > 0 && (
        <div class="dz-granty">
          {przyklady.map((g) => (
            <article class="spec spec-link">
              <div class="news-meta">
                <span class={`badge${g.data.rodzaj === 'ncn' ? ' badge-wydarzenie' : g.data.rodzaj === 'ue' ? ' badge-sukces' : ''}`}>{RODZAJE_GRANTOW[g.data.rodzaj][lang]}</span>
                {g.data.program && <span class="badge">{g.data.program}</span>}
                {lata(g) && <span>{lata(g)}</span>}
              </div>
              <h3><a href={href(`/nauka/granty/${slugOf(g.id)}`)}>{tytulGrantu(g)}</a></h3>
              {g.data.kierownik && <p><span class="lbl">{T('Kierownik', 'Principal investigator')}</span>{g.data.kierownik}</p>}
              {(g.data.kod || g.data.strona) && (
                <p class="foot">
                  {g.data.kod && <span class="dz-kod">{g.data.kod}</span>}
                  {g.data.strona && <a href={g.data.strona}>{T('Strona projektu', 'Project website')} <Ikona nazwa="zewnetrzny" rozmiar={13} /></a>}
                </p>
              )}
            </article>
          ))}
        </div>
      )}
    </section>

    <section class="zsec tylko-komputer" aria-labelledby="konferencje">
      <div class="zsec-head">
        <h2 id="konferencje">{nadchodzaceKonf.length ? T('Najbliższe konferencje', 'Upcoming conferences') : T('Konferencje', 'Conferences')}</h2>
        <a class="link-arrow" href={href('/nauka/konferencje')}>{T('Wszystkie konferencje', 'All conferences')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
      </div>
      {nadchodzaceKonf.length === 0 && (
        <p class="dz-intro">
          {T('Nie zapowiedziano jeszcze kolejnych konferencji.', 'No upcoming conferences have been announced yet.')}
          {pokazKonf.length > 0 && ` ${T('Ostatnio odbyły się:', 'Most recent:')}`}
        </p>
      )}
      {pokazKonf.length > 0 && (
        <div class="event-grid">
          {pokazKonf.map((k) => { const Tag = k.data.strona ? 'a' : 'div'; return (
            <Tag class:list={['event dz-event', !k.data.strona && 'dz-bez-linku']} href={k.data.strona || undefined}>
              <span class={`datebox${konfTrwa(k) ? '' : ' minione'}`} aria-hidden="true"><span class="d">{dayNum(k.data.poczatek)}</span><span class="m">{monthShort(k.data.poczatek, lang)}</span></span>
              <span class="event-body">
                <span class="k">{range(k.data.poczatek, k.data.koniec, lang)}</span>
                <span class="t"><TytulZewn tekst={wybierz(k.data, 'tytul', lang)} zewn={!!k.data.strona} rozmiar={13} /></span>
                {k.data.miejsce && <span class="s">{k.data.miejsce}</span>}
                {k.data.odwolana && <span><span class="badge">{T('odwołana', 'cancelled')}</span></span>}
              </span>
            </Tag>
          ); })}
        </div>
      )}
    </section>
  </div>
</Baza>

<style>
  /* Układ wspólny ze stroną działu „Instytut” (DzialInstytut.astro). */
  .dz-wrap { padding-top: 32px; padding-bottom: 64px; }
  .dz-intro { margin: -4px 0 16px; max-width: 760px; color: var(--muted); font-size: 16px; line-height: 1.6; }
  /* „W tym dziale” zaraz pod banerem — bez kreski sekcji nad nagłówkiem (komputer i telefon; jak „Najbliższe seminaria”
     w ListaSeminariow.astro): tytuł zaczyna się w odstępie .dz-wrap od banera */
  .zsec.dz-pierwsza { border-top: 0; padding-top: 0; }
  .zsec.dz-pierwsza::before, .zsec.dz-pierwsza > h2::before { display: none; }
  /* Linki do pełnych podstron („Wszystkie projekty i granty”, „Wszystkie konferencje”) — w nagłówku sekcji, z prawej
     (.zsec-head w global.css; na telefonie w nagłówku ramki), nie pod kartami. */
  .dz-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 20px 16px; }
  .dz-g h3 { margin: 0 0 10px; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .dz-tiles { grid-template-columns: 1fr; gap: 8px; padding-top: 0; }
  .dz-tile { flex-direction: row; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; }
  /* „Badania w Instytucie”: zwykłe akapity w wygodnej szerokości do czytania (jak „O Instytucie” na stronie „Instytut”) */
  .dz-o-tekst p { max-width: 820px; margin: 0 0 12px; font-size: 16px; line-height: 1.65; }
  .dz-o-tekst p:last-child { margin-bottom: 0; }
  /* ramka „W skrócie” (tylko komputer): duże wartości z bursztynową kreską, opis pod spodem */
  .dz-o-fakty { padding: 18px 20px; border: 1px solid var(--line); border-radius: var(--radius-l); background: var(--bg); }
  .dz-o-fakty-h { margin: 0 0 12px; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .dz-o-fakty dl { display: grid; gap: 14px; margin: 0; }
  .dz-o-fakty dl > div { padding-left: 12px; border-left: 3px solid var(--accent); }
  .dz-o-fakty dt { font-size: 26px; font-weight: 800; line-height: 1.1; color: var(--ink); }
  .dz-o-fakty dd { margin: 3px 0 0; font-size: 14px; line-height: 1.4; color: var(--muted); }
  /* komputer: tekst i ramka obok siebie (ramka 300 px po prawej) */
  @media (min-width: 761px) {
    .dz-o-uklad { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 32px; align-items: start; }
  }
  /* Tylko na stronie „Nauka”. */
  .dz-ile { font-size: 16px; font-weight: 600; }
  .dz-ramka { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  /* konferencje w takich samych kartach jak projekty (.spec): tło strony i cienka ramka */
  .dz-event { background: var(--bg); border: 1px solid var(--line); }
  /* konferencje nie mają naszych podstron: link na stronę konferencji (ikona przy tytule); bez strony — bez linku
     i bez podświetlenia po najechaniu */
  .dz-event.dz-bez-linku:hover { box-shadow: none; }
  .pt-item.dz-bez-linku:hover { background: none; }
  .pt-item.dz-bez-linku:hover .pt-t { text-decoration: none; }
  .dz-granty { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 14px; }
  .dz-granty h3 { font-size: 17px; line-height: 1.3; }
  .dz-kod { color: var(--muted); font-variant-numeric: tabular-nums; }

  /* ---------- komputer (≥ 761 px): wariant „Zwarta” — mniejsze odstępy, niższe kafelki i ramki (jak na „Instytucie”) ----------
     Odstęp nad pierwszą sekcją stały (24 px): bursztynowy początek kreski sekcji nie przylega do dolnej krawędzi banera. */
  @media (min-width: 761px) {
    .dz-wrap { padding-top: 24px; padding-bottom: var(--tresc-dol); }
    .dz-intro { margin: -4px 0 10px; max-width: 820px; font-size: 15px; line-height: 1.5; }
    .dz-groups { gap: 12px 16px; }
    .dz-g h3 { margin: 0 0 6px; }
    .dz-tiles { gap: 6px; }
    .dz-tile { display: flex; min-height: 42px; padding-block: 6px; }
    .dz-ile { font-size: 15px; }
    .dz-granty { gap: 10px; }
    .dz-granty h3 { font-size: 16px; }
  }

  /* ---------- telefon (≤ 760 px): wygląd „Portal” (wspólny ze stroną „Instytut”) ---------- */
  @media (max-width: 760px) {
    .dz-wrap { padding-top: 4px; padding-bottom: 36px; }
    /* „W tym dziale”: każda grupa w ramce, linki jako wiersze (napis z lewej, strzałka z prawej) */
    .dz-groups { display: flex; flex-direction: column; gap: 12px; }
    .dz-g { padding: 10px 14px 8px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); }
    .dz-g h3, .dz-ramka-sek .zsec-head > h2 { margin: 0 0 4px; padding-bottom: 7px; border-bottom: 2px solid var(--ink); font-size: 18px; font-weight: 800; line-height: 1.3; letter-spacing: -0.01em; text-transform: none; color: var(--ink); }
    .dz-g h3::before, .dz-ramka-sek .zsec-head > h2::before { content: ''; display: inline-block; width: 4px; height: .85em; margin-right: 9px; border-radius: 2px; background: var(--accent); vertical-align: -.05em; }
    :global(:root[data-theme='dark']) .dz-g h3 { border-bottom-color: var(--line); }
    .dz-tiles { display: block; }
    .dz-tile { gap: 10px; min-height: 40px; padding: 6px 4px; border: 0; border-radius: 0; background: transparent; box-shadow: none; font-size: 15px; line-height: 1.3; }
    .dz-tile + .dz-tile { min-height: 41px; border-top: 1px solid var(--line); }
    .dz-tile:hover { background: var(--tint); }
    .dz-tile :global(svg) { width: 16px !important; height: 16px !important; color: var(--muted); }
    :global(:root[data-theme='dark']) .dz-tile :global(svg) { color: var(--muted); }
    /* konferencje (blok tylko na telefon) */
    .dz-tel { display: flex; flex-direction: column; gap: 12px; }
    .dz-o-tekst p { font-size: 15px; line-height: 1.55; }
    .dz-intro { margin: -2px 0 10px; max-width: 860px; font-size: 15px; line-height: 1.5; }
    .dz-ramka-sek .spec-link:hover, .dz-ramka-sek .spec-link:focus-within { box-shadow: none; transform: none; }
    .dz-ramka-sek .spec .foot { margin-top: auto; padding-top: 6px; border-top: 0; font-size: 13.5px; line-height: 1.4; color: var(--muted); }
    /* projekty: sekcja w ramce (kreska sekcji nad nią zostaje); ramka narysowana pod treścią (::after) */
