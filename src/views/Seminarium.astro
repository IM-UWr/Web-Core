---
// Strona seminarium (/seminaria/<id>), kierunek „Założyciele”, szablon podstrony zal/Podstrona.astro: opis seminarium,
// nadchodzące referaty (ze streszczeniami), minione referaty (streszczenie zwinięte; na komputerze dwie kolumny jak minione
// Konferencje, rozwinięte streszczenie na całą szerokość, jedno naraz — zlecenie 65); zapis na powiadomienia e-mail w prawej
// kolumnie pod spisem (slot „bok”, na telefonie pod treścią)
// i link do archiwum. Spis „Na tej stronie” z sekcji; na telefonie zwijany nad treścią.
// Minione według lat akademickich (zlecenie 68, jak lata w Konferencjach i Obronach, zlecenie 57): rok od 1.10 (rokAkademicki
// w src/lib/daty.ts), podsekcja h3#rok-RRRR-RR („2025/26” i liczba referatów), lata od najnowszego, w roku od najnowszego
// referatu; każdy rok ma własną siatkę .ref-dwie (układ zlecenia 65), a details name="streszczenie-minione" jest wspólne
// dla całej strony (rozwinięte jedno streszczenie, także między latami). Tytuł minionego referatu pod rokiem w h4 (wygląd wiersza
// bez zmian). Spis: Nadchodzące, Minione, potem lata (płasko, jak w Konferencjach; wyliczone z danych). Minione tylko z jednego
// roku akademickiego: bez podziału i bez lat w spisie (tytuł w h3, jak przed zleceniem 68). Link do archiwum pod ostatnim rokiem.
// Baner (zlecenie 17, punkt 4): link wstecz, sygnet i nazwa, bez hasła, liczb i podpisu. Koordynatorzy, e-mail i zakład
// na końcu sekcji opisu (wzorzec .kontakty). Referaty z jednym wzorem daty (jak zal/dzial/Wiersz.astro): dzień dużą Brygadą
// w kolorze działu, pod nim „mie rrrr”; obok dzień tygodnia, godzina i sala, tytuł Brygadą, prelegent z afiliacją.
// Kotwice referatów (#<slug>) bez zmian — prowadzą do nich Kalendarz i lista seminariów.
// Referat-szkic (zlecenie 48, tylko Podgląd; przy fladze go nie ma): etykieta „szkic” przy tytule, wiersz na plakietce (StanBudowy.astro).
// Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css, klasa .tresc): sekcje h2 z kreską między nimi,
// etykieta .etyk, pliki ul.pliki. Własne style (na końcu pliku): wiersz referatu z datą, formularz zapisu, blok
// koordynatorów. Jedna wersja HTML: komputer (≥ 1024 px) i telefon (≤ 1023 px).
import Link from '../components/Link.astro';
import Podstrona from '../components/zal/Podstrona.astro';
import Ikona from '../components/Ikona.astro';
import TytulReferatu from '../components/TytulReferatu.astro';
import BrakOsoby from '../components/BrakOsoby.astro';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz, odmiana, RODZAJE, langPola, langTekstu } from '../lib/i18n';
import { dayNum, longWithDay, monthShort, parse, time, type Lang } from '../lib/daty';
import { slugOf, sala, salaReferatu, afiliacjaReferatu, maTresc, jestSzkicem, type Seminarium } from '../lib/tresci';
import { ETYKIETA_SZKICU } from '../lib/szkice';
import { daneSeminarium } from '../lib/widoki/seminarium';
import { mailHtml } from '../lib/limity.mjs';

interface Props { seminarium: Seminarium; lang: Lang }
const { seminarium, lang } = Astro.props;
const d = seminarium.data;
const href = (a: string) => (isExternal(a) ? a : u(a));
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const { nazwa, Content, htmlEn, nadchodzace, minione, lataMinionych, zakladySem, koordynatorzy, brakKoordynatora, adresListy, maKoord } = await daneSeminarium(seminarium, lang);
// linia nad tytułem referatu: (dzień tygodnia ·) godzina · sala — puste pomijane
const dzienTygodnia = (termin: string) => longWithDay(termin, lang).split(', ')[0];
const kiedyGdzie = (termin: string, s: string | undefined, zDniem: boolean) =>
  [zDniem ? dzienTygodnia(termin) : '', time(termin), sala(s, lang) ?? ''].filter(Boolean).join(' · ');
const maOpis = !!htmlEn || maTresc(seminarium.body);
const tytulPow = T('Powiadomienia e-mail', 'Email notifications');
// typ pliku z prawej (wzorzec ul.pliki): rozszerzenie („PDF”) albo „strona ↗” dla linku bez rozszerzenia
const typPliku = (a: string) => {
  const m = a.split(/[?#]/)[0].match(/\.([a-z0-9]{2,4})$/i);
  return m ? m[1].toUpperCase() : isExternal(a) ? T('strona', 'website') : '';
};
// minione: podział na lata akademickie tylko, gdy jest ich więcej niż jeden (inaczej jedna grupa bez nagłówka roku — jak dawniej)
const zLatami = lataMinionych.length > 1;
const grupyMinionych = zLatami ? lataMinionych : minione.length > 0 ? [{ rok: '', id: '', lista: minione }] : [];
const ileRef = (n: number) => `${n} ${odmiana(n, ['referat', 'referaty', 'referatów'], ['talk', 'talks'], lang)}`;
const spis = [
  { id: 'z-nadchodzace', etykieta: t(lang, 'nadchodzace') },
  ...(minione.length > 0 ? [{ id: 'z-minione', etykieta: t(lang, 'minione') }] : []),
  ...(zLatami ? lataMinionych.map((g) => ({ id: g.id, etykieta: g.rok })) : []),
];
---
<Podstrona lang={lang} tytul={nazwa} tytulLang={langPola(d, 'nazwa', lang)} opis={`${RODZAJE.referat[lang]}: ${nazwa}`} opublikowany={d.opublikowany} uklad="zwarta portal-baner"
  bezPodpisu wstecz={{ etykieta: t(lang, 'wszystkieSeminaria'), telefon: t(lang, 'seminaria'), adres: '/seminaria' }}
  dzial="nauka" spis={spis} klasa="tresc z-sm">
  {/* powiadomienia e-mail: w prawej kolumnie pod spisem „Na tej stronie” (zlecenie 11, zalecenie 4), na telefonie pod treścią */}
  <aside slot="bok" class="sem-pow" id="powiadomienia" aria-labelledby="h-pow" data-pagefind-ignore>
    <h2 class="sem-pow-h" id="h-pow">{tytulPow}</h2>
    <p class="pw-opis">{T('Zostaw adres, a o każdym nowym referacie tego seminarium dostaniesz wiadomość (po angielsku). Z listy wypiszesz się jednym kliknięciem w każdej wiadomości.', 'Leave your address to get an email about every new talk in this seminar. Every message has a one-click unsubscribe link.')}</p>
    {adresListy ? (
      <form class="pw-form" data-zapis action={adresListy} method="post" data-ok={T('Sprawdź skrzynkę — wysłaliśmy link potwierdzający zapis (jeśli nie widzisz wiadomości, zajrzyj do spamu).', 'Check your inbox — we have sent a confirmation link (look in the spam folder if you cannot see it).')} data-blad={T('Nie udało się wysłać zgłoszenia. Spróbuj ponownie za chwilę.', 'Something went wrong. Please try again in a moment.')}>
        <input type="hidden" name="akcja" value="zapisz" />
        <input type="hidden" name="seminarium" value={seminarium.id} />
        <input type="hidden" name="jezyk" value={lang} />
        <label class="sr-only" for="zapis-email">{T('Adres e-mail', 'Email address')}</label>
        <div class="pw-wiersz">
          <input id="zapis-email" type="email" name="email" required autocomplete="email" inputmode="email" placeholder={T('twój@adres.pl', 'you@example.com')} />
          <button type="submit"><Ikona nazwa="mail" rozmiar={16} />{T('Zapisz mnie', 'Subscribe')}</button>
        </div>
        <div class="pw-hp" aria-hidden="true"><label>Nie wypełniaj / leave empty <input type="text" name="www" tabindex="-1" autocomplete="off" /></label></div>
        <p class="pw-stan" role="status" aria-live="polite"></p>
      </form>
    ) : (
      <p class="pusto">{T('Zapisy na listę ruszą wkrótce.', 'Sign-up will open soon.')}</p>
    )}
    <p class="pw-uwaga">{T('Adres służy wyłącznie do tych powiadomień —', 'Your address is used only for these notifications —')} <a href={u(wJezyku('/polityka-prywatnosci', lang))}>{T('polityka prywatności', 'privacy policy')}</a>.</p>
  </aside>

  {(maOpis || maKoord) && (
    <section class="opis">
      {maOpis && <div class="prose" lang={lang === 'en' && !htmlEn ? 'pl' : undefined}>{htmlEn ? <Fragment set:html={htmlEn} /> : <Content />}</div>}
      {maKoord && (
        <div class="kontakty sem-dane">
          {(koordynatorzy.length > 0 || brakKoordynatora) && (
            <div>
              <span class="etyk">{koordynatorzy.length > 1 ? T('Koordynatorzy', 'Coordinators') : T('Koordynator', 'Coordinator')}</span>
              {brakKoordynatora ? <b><BrakOsoby lang={lang} /></b>
                : koordynatorzy.map((k) => <b data-limit-linii="2">{k.strona ? <Link href={k.strona}>{k.nazwa}</Link> : k.nazwa}</b>)}
            </div>
          )}
          {d.kontakt && (
            <div>
              <span class="etyk">{T('Kontakt', 'Contact')}</span>
              <a class="wart" href={`mailto:${d.kontakt}`} data-limit-linii="2" set:html={mailHtml(d.kontakt)} />
            </div>
          )}
          {zakladySem.length > 0 && (
            <div>
              <span class="etyk">{zakladySem.length > 1 ? T('Zakłady', 'Departments') : T('Zakład', 'Department')}</span>
              {zakladySem.map((z) => <a class="wart" href={u(wJezyku(`/instytut/zaklady/${z.id}`, lang))}>{wybierz(z.data, 'nazwa', lang)}</a>)}
            </div>
          )}
        </div>
      )}
    </section>
  )}

  <section id="z-nadchodzace" aria-labelledby="h-nad">
    <h2 id="h-nad">{t(lang, 'nadchodzace')}</h2>
    {nadchodzace.length === 0 && <p class="pusto">{t(lang, 'brakNadchodzacych')}</p>}
    {nadchodzace.map(({ r, C, en }) => (
      <article class="ref" id={slugOf(r.id)}>
        <time class="dz" datetime={r.data.termin.slice(0, 10)}>{dayNum(r.data.termin)}<small> {monthShort(r.data.termin, lang)} {parse(r.data.termin).y}</small></time>
        <div>
          <p class="etyk">{kiedyGdzie(r.data.termin, salaReferatu(r.data, lang), true)}</p>
          <h3><TytulReferatu tekst={r.data.tytul} jezyk={r.data.jezyk} lang={lang} />{jestSzkicem(r) && <Fragment set:html={ETYKIETA_SZKICU[lang]} />}</h3>
          <p class="kto">{r.data.prelegent}{afiliacjaReferatu(r.data, lang) && <span> ({afiliacjaReferatu(r.data, lang)})</span>}</p>
          {(en || maTresc(r.body)) && <div class="prose streszcz" lang={en ? undefined : langTekstu(r.body, lang)}>{en ? <Fragment set:html={en} /> : <C />}</div>}
          {r.data.pliki.length > 0 && (
            <ul class="pliki">{r.data.pliki.map((p) => <li><Link href={href(p.plik)}><Ikona nazwa="plik" rozmiar={18} /><span>{p.nazwa || p.plik.split('/').pop()}</span><span class="typ">{typPliku(p.plik)}</span></Link></li>)}</ul>
          )}
        </div>
      </article>
    ))}
  </section>


  {(minione.length > 0 || d.archiwum) && (
    <section id="z-minione" aria-labelledby="h-min">
      {minione.length > 0 && <h2 id="h-min">{t(lang, 'minione')}</h2>}
      {grupyMinionych.map((g) => { const H = g.rok ? 'h4' : 'h3'; return (<>
      {g.rok && <h3 id={g.id} class="sem-rok">{g.rok}<span class="sr-only">, </span> <small>{ileRef(g.lista.length)}</small></h3>}
      <div class="ref-dwie">
      {g.lista.map(({ r, C, en }) => (
        <article class="ref maly" id={slugOf(r.id)}>
          <time class="dz" datetime={r.data.termin.slice(0, 10)}>{dayNum(r.data.termin)}<small> {monthShort(r.data.termin, lang)} {parse(r.data.termin).y}</small></time>
          <div>
            {kiedyGdzie(r.data.termin, salaReferatu(r.data, lang), false) && <p class="etyk">{kiedyGdzie(r.data.termin, salaReferatu(r.data, lang), false)}</p>}
            <H><TytulReferatu tekst={r.data.tytul} jezyk={r.data.jezyk} lang={lang} />{jestSzkicem(r) && <Fragment set:html={ETYKIETA_SZKICU[lang]} />}</H>
            <p class="kto">{r.data.prelegent}{afiliacjaReferatu(r.data, lang) && <span> ({afiliacjaReferatu(r.data, lang)})</span>}</p>
            {(en || maTresc(r.body)) && (
              <details name="streszczenie-minione">
                <summary>{t(lang, 'streszczenie')}</summary>
                <div class="prose streszcz" lang={en ? undefined : langTekstu(r.body, lang)}>{en ? <Fragment set:html={en} /> : <C />}</div>
              </details>
            )}
            {r.data.pliki.length > 0 && (
              <ul class="pliki">{r.data.pliki.map((p) => <li><Link href={href(p.plik)}><Ikona nazwa="plik" rozmiar={18} /><span>{p.nazwa || p.plik.split('/').pop()}</span><span class="typ">{typPliku(p.plik)}</span></Link></li>)}</ul>
            )}
          </div>
        </article>
      ))}
      </div>
      </>); })}
      {d.archiwum && <p class="archiwum"><Link href={d.archiwum}>{t(lang, 'archiwumSem')}</Link></p>}
    </section>
  )}
</Podstrona>

<script>
  // Minione referaty w dwóch kolumnach (komputer; zlecenie 65): rozwinięte streszczenie zajmuje cały rząd (CSS :has(details[open])),
  // rozwinięte jest jedno naraz (details name — rozwinięcie kolejnego zwija poprzednie). Wiersz z prawej kolumny dostaje order
  // tuż przed sąsiadem z lewej: zostaje w swoim rzędzie, a sąsiad schodzi pod niego. Kliknięty wiersz nie ucieka spod kursora:
  // po zmianie układu strona przewija się o tyle, o ile przesunął się jego górny brzeg (np. po zwinięciu streszczenia wyżej).
  // Każdy rok akademicki ma własną siatkę (zlecenie 68); name jest wspólne dla strony, więc rozwinięcie w jednym roku może zwinąć
  // streszczenie w innym — po każdym toggle układ liczy się we wszystkich siatkach naraz.
  const siatki = [...document.querySelectorAll<HTMLElement>('.ref-dwie')];
  if (siatki.length) {
    const wiersze = siatki.map((s) => [...s.children] as HTMLElement[]);
    let kotwica: { el: HTMLElement; y: number } | null = null;
    const uloz = () => {
      siatki.forEach((siatka, k) => {
        const kolumny = getComputedStyle(siatka).gridTemplateColumns.split(' ').filter((s) => s && s !== 'none').length;
        wiersze[k].forEach((w, i) => {
          const c = kolumny > 1 ? i % kolumny : 0;
          w.style.order = String(c && w.querySelector('details[open]') ? 2 * (i - c) - 1 : 2 * i);
        });
      });
      if (kotwica) {
        window.scrollBy({ top: kotwica.el.getBoundingClientRect().top - kotwica.y, behavior: 'instant' });
        kotwica = null;
      }
    };
    siatki.forEach((siatka) => {
      siatka.addEventListener('click', (e) => {
        const w = (e.target as Element).closest('summary')?.closest<HTMLElement>('.ref');
        if (w) kotwica = { el: w, y: w.getBoundingClientRect().top };
      });
      // toggle nie wypływa w górę — nasłuch w fazie przechwytywania
      siatka.addEventListener('toggle', uloz, true);
    });
  }

  // Zapis na listę: wysyłka w tle (bez przeładowania strony). Automat zawsze odpowiada tak samo,
  // żeby nie zdradzać, czy adres już jest na liście.
  document.querySelectorAll<HTMLFormElement>('form[data-zapis]').forEach((f) =>
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const stan = f.querySelector<HTMLElement>('.pw-stan');
      const btn = f.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) btn.disabled = true;
      let ok = true;
      try {
        await fetch(f.action, { method: 'POST', body: new URLSearchParams(new FormData(f) as any) });
      } catch (err) {
        // Odpowiedź automatu bywa blokowana przez przeglądarkę (CORS), choć zgłoszenie dotarło — błąd tylko bez sieci.
        ok = navigator.onLine;
      }
      if (stan) stan.textContent = (ok ? f.dataset.ok : f.dataset.blad) || '';
      if (ok) f.reset();
      if (btn) btn.disabled = false;
    })
  );
</script>

<style>
  /* Wiersz referatu z datą (jak zal/dzial/Wiersz.astro): dzień | etykieta (dzień tygodnia, godzina, sala), tytuł,
     prelegent, streszczenie, pliki. Reszta — wzorzec treści .tresc (src/styles/zal-tresc.css). */
  .opis .prose > :global(:first-child) { margin-top: 0; }
  .opis .prose > :global(:last-child) { margin-bottom: 0; }
  /* koordynatorzy, kontakt i zakład pod opisem: wzorzec .kontakty (src/styles/zal-tresc.css; na telefonie sam daje jedną kolumnę) */
  .prose + .sem-dane { margin-top: 18px; }
  @media (min-width: 1024px) and (min-height: 501px), (min-width: 1024px) and (pointer: fine) {
    :global(.tresc) .kontakty.sem-dane { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  }
  .sem-dane b { margin: 2px 0 0; font-size: 19px; }
  .sem-dane .wart { display: block; margin-top: 3px; font-size: 15.5px; line-height: 1.45; }
  .ref { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .ref .dz { font-family: var(--f-display); font-size: 34px; line-height: 1; color: var(--d-a); }
  .ref .dz small { display: block; margin-top: 4px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  .ref p { margin: 0; max-width: none; }
  .ref .etyk { font-variant-numeric: tabular-nums; }
  /* tytuł: h3 (nadchodzące, minione bez podziału na lata) albo h4 (minione pod rokiem; zlecenie 68) — ten sam wygląd;
     odstęp liter jak h3 w main (zalozyciele.css, zal-telefon.css), bo global.css daje h4 -0.01em */
  .ref :is(h3, h4) { margin: 2px 0 4px; font-family: var(--f-display); font-weight: 500; font-size: 21px; line-height: 1.3; letter-spacing: -0.005em; color: var(--ink); }
  .ref.maly :is(h3, h4) { font-size: 18.5px; }
  .ref .kto { font-size: 15.5px; font-weight: 600; line-height: 1.55; color: var(--ink); }
  /* minione referaty przygaszone jak „Ostatnio” w Szybkim dostępie (zalozyciele-strony.css: .z-w.minelo, .z-przeszle):
     data szara, tytuł i prelegent lżejsze, etykieta lekko przygaszona; kolory z tokenów (tryb ciemny bez osobnych reguł) */
  .ref.maly .dz { color: var(--muted); }
  .ref.maly :is(h3, h4) { color: var(--text); }
  .ref.maly .kto { font-weight: 500; color: var(--text); }
  .ref.maly .etyk { opacity: .8; }
  .ref .kto span { font-weight: 400; color: var(--muted); }
  .ref .streszcz { margin-top: 10px; }
  .ref .streszcz :global(p) { max-width: 42.7em; font-size: 15.5px; line-height: 1.55; }
  .ref .streszcz > :global(:last-child) { margin-bottom: 0; }
  .ref details { margin-top: 6px; }
  .ref summary { width: fit-content; cursor: pointer; font-size: 14px; font-weight: 700; color: var(--d-a); }
  .ref summary:focus-visible { outline: 2px solid var(--d-a); outline-offset: 2px; }
  .ref .pliki { margin-top: 10px; }
  .pusto { font-style: italic; color: var(--muted); }
  .archiwum { margin: 18px 0 0; font-weight: 600; }
  /* rok akademicki (podsekcja h3 minionych, zlecenie 68): wygląd lat w Konferencjach i Obronach — rok wzorcem .tresc h3,
     liczba referatów małym krojem tekstu */
  h3.sem-rok small { margin-left: 8px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  /* kotwice referatów: zapas nad wpisem */
  .ref[id] { scroll-margin-top: 20px; }

  /* powiadomienia e-mail w prawej kolumnie pod spisem (zlecenie 11, zalecenie 4): nagłówek jak nagłówek spisu, tekst 13,5 px,
     pole e-mail na całą szerokość kolumny, „Zapisz mnie” jako główny przycisk (wypełniony kolorem działu), notka 13 px */
  .sem-pow { font-size: 13.5px; line-height: 1.5; color: var(--text); }
  .sem-pow .sem-pow-h { margin: 0 0 8px; font-family: var(--f-text); font-size: 12.5px; font-weight: 700; line-height: 1.35; color: var(--d-a); }
  .sem-pow p { margin: 0; }
  .sem-pow .pw-opis { margin: 0 0 12px; }
  .pw-form { position: relative; margin: 0; }
  .pw-wiersz { display: grid; gap: 8px; justify-items: start; }
  .pw-wiersz input { box-sizing: border-box; width: 100%; min-width: 0; margin: 0; padding: 8px 12px; border: 1px solid var(--line-ui); border-radius: 0;
    background: var(--bg); color: var(--ink); font: inherit; font-size: 15px; }
  .pw-wiersz input::placeholder { color: var(--muted); opacity: 1; }
  .pw-wiersz input:focus { outline: 2px solid var(--d-a); outline-offset: -1px; }
  .pw-wiersz button { display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 7px 14px; border: 1px solid var(--d-a); border-radius: 0;
    background: var(--d-a); color: var(--bg); font: inherit; font-size: 14px; font-weight: 600; line-height: 1.6; cursor: pointer; transition: background-color var(--t-krotki) var(--rytm), border-color var(--t-krotki) var(--rytm); }
