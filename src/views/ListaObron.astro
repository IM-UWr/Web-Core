---
// Obrony doktorskie (/obrony-doktorskie), kierunek „Założyciele”, szablon podstrony zal/Podstrona.astro: tekst wprowadzający
// (src/data/dzialy/nauka.json, pola obrony_tekst / _en; puste = brak), nadchodzące i odbyte obrony, link do archiwum.
// Wiersze z jednym wzorem daty (jak zal/dzial/Wiersz.astro): dzień dużą Brygadą w kolorze działu, pod nim „mie rrrr”;
// obok dzień tygodnia, godzina i miejsce, kandydat Brygadą (cały wiersz prowadzi do strony obrony), tytuł rozprawy.
// Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css, klasa .tresc): sekcje h2 z kreską między nimi,
// etykieta .etyk, pierwszy akapit .wst. Własne style (na końcu pliku) tylko dla wierszy z datą.
// Jedna wersja HTML: komputer (≥ 1024 px) i telefon (≤ 1023 px).
import Podstrona from '../components/zal/Podstrona.astro';
import Link from '../components/Link.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import dzialNauka from '../data/dzialy/nauka.json';
import { u } from '../lib/url';
import { t, wJezyku, wybierz } from '../lib/i18n';
import { dayNum, longWithDay, monthShort, parse, time, type Lang } from '../lib/daty';
import { miejsce, slugOf, type Obrona } from '../lib/tresci';
import { daneListyObron } from '../lib/widoki/listaObron';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { przyszle, odbyte, lead, haslo, liczby, ustawienia } = await daneListyObron(lang);
// tekst wprowadzający z CMS (jak dotychczasowy TekstWstepny.astro)
const wstep = ((wybierz(dzialNauka as Record<string, any>, 'obrony_tekst', lang) as string) || '')
  .split(/\n\s*\n/).map((a) => a.trim()).filter(Boolean);
// etykieta nad kandydatem: dzień tygodnia · godzina · miejsce (puste pomijane)
const etykieta = (o: Obrona) => [longWithDay(o.data.termin, lang).split(', ')[0], time(o.data.termin), miejsce(o.data.miejsce, lang) ?? ''].filter(Boolean).join(' · ');
const sekcje = [
  { id: 'z-nadchodzace', h: t(lang, 'nadchodzaceObrony'), lista: przyszle },
  { id: 'z-odbyte', h: t(lang, 'odbyteObrony'), lista: odbyte },
].filter((s) => s.lista.length > 0);
const spis = sekcje.map((s) => ({ id: s.id, etykieta: s.h }));
const archiwum = `${ustawienia.archiwum}postepowania-w-sprawie-nadania-stopnia-doktora-w-instytucie-matematycznym`;
---
<Podstrona lang={lang} tytul={t(lang, 'obrony')} opis={lead} uklad="zwarta portal-baner" lead={lead} haslo={haslo}
  okruszki={[{ etykieta: lang === 'en' ? 'Research' : 'Nauka', adres: '/nauka' }, { etykieta: t(lang, 'obrony') }]} dzial="nauka" spis={spis} klasa="tresc z-ob">
  <Fragment slot="baner"><LiczbyBanera lang={lang} pozycje={liczby} /></Fragment>

  {wstep.length > 0 && <section>{wstep.map((a, i) => <p class={i === 0 ? 'wst' : undefined}>{a}</p>)}</section>}

  {sekcje.map((s, i) => (
    <section id={s.id} aria-labelledby={`h-${s.id}`}>
      <h2 id={`h-${s.id}`}>{s.h}</h2>
      <ul class="wiersze">
        {s.lista.map((o) => (
          <li class="wiersz klik">
            <time class="dz" datetime={o.data.termin.slice(0, 10)}>{dayNum(o.data.termin)}<small> {monthShort(o.data.termin, lang)} {parse(o.data.termin).y}</small></time>
            <div>
              <p class="etyk">{etykieta(o)}</p>
              <h3><a href={u(wJezyku(`/obrony-doktorskie/${slugOf(o.id)}`, lang))}>{o.data.kandydat}</a></h3>
              <p class="rozprawa" lang="en">{o.data.tytul_rozprawy}</p>
            </div>
          </li>
        ))}
      </ul>
      {i === sekcje.length - 1 && <p class="archiwum">{t(lang, 'archiwumObron')} <Link href={archiwum}>{t(lang, 'archiwum')}</Link>.</p>}
    </section>
  ))}
  {sekcje.length === 0 && <section><p class="archiwum">{t(lang, 'archiwumObron')} <Link href={archiwum}>{t(lang, 'archiwum')}</Link>.</p></section>}
</Podstrona>

<style>
  /* Wiersze z datą (jak zal/dzial/Wiersz.astro): dzień | etykieta, kandydat, tytuł rozprawy. Reszta (sekcje, etykieta
     .etyk, akapity, linki) — wzorzec treści .tresc (src/styles/zal-tresc.css). */
  .wiersze { list-style: none; margin: 0; padding: 0; }
  .wiersze > li { max-width: none; margin: 0; font-size: inherit; }
  .wiersz { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .wiersz .dz { font-family: var(--f-display); font-size: 34px; line-height: 1; color: var(--d-a); }
  .wiersz .dz small { display: block; margin-top: 4px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  .wiersz p { margin: 0; max-width: none; }
  .wiersz h3 { margin: 2px 0 4px; font-family: var(--f-display); font-weight: 500; font-size: 21px; line-height: 1.3; color: var(--ink); }
  .wiersz h3 a { color: inherit; text-decoration: none; }
  .wiersz .rozprawa { font-size: 15.5px; line-height: 1.55; color: var(--text); }
  /* cały wiersz klikalny (link w nazwisku), fokus na całym wierszu */
  .klik { position: relative; }
  .klik h3 a::before { content: ''; position: absolute; inset: 0; } /* nakładka na ::before — ::after to strzałka ↗ linku poza stronę */
  .klik:hover h3 a { color: var(--d-a); }
  .klik h3 a:focus-visible { outline: none; }
  .klik:has(h3 a:focus-visible) { outline: 3px solid var(--d-a); outline-offset: 4px; border-radius: 2px; }
  .archiwum { margin: 22px 0 0; font-size: 15.5px; color: var(--muted); }

  /* ---------- telefon (≤ 1023 px): mniejszy dzień ---------- */
  /* Telefon i komputer: ta sama definicja co MQ_TELEFON i MQ_KOMPUTER w src/lib/media.ts (zlecenie 23, punkt 1) */
  @media (max-width: 1023px), (max-height: 500px) and (pointer: coarse) {
    .wiersz { grid-template-columns: 54px minmax(0, 1fr); gap: 12px; padding: 13px 0; }
    .wiersz .dz { font-size: 28px; }
    .wiersz .dz small { font-size: 12.5px; white-space: nowrap; }
    .wiersz h3 { font-size: 18.5px; }
    .wiersz .rozprawa { font-size: 15px; }
  }
</style>
