---
// Obrony doktorskie (/obrony-doktorskie), kierunek „Założyciele”, szablon podstrony zal/Podstrona.astro — układ jak Konferencje
// (zlecenie 57, decyzja 22.11; wzór: ListaKonferencji.astro): tekst wprowadzający (Treść strony Web-Aktualnosci → Strony →
// Obrony doktorskie; zlecenie 30, src/lib/tekstyStron.ts; pierwszy akapit .wst; brak = bez tekstu), potem sekcje „Nadchodzące”
// (od najbliższej, bez podziału na lata; bez obron — napis) i „Odbyte” (lata jako podsekcje h3 z liczbą obron, kotwice #rok-RRRR,
// od najnowszego roku, w roku od najnowszej obrony). Spis „Na tej stronie”: Nadchodzące i lata (wyliczone z danych).
// Baner bez zmian: hasło bez liczb (jak w Aktualnościach, zlecenie 27, punkt 2), okruszki „← Nauka”. Bez panelu „Pokaż”
// (filtr lat i szukanie) i bez linku do archiwum starej strony (zlecenie 57). Stare adresy ?rok=RRRR (dawny filtr) — skrypt
// na dole przenosi do #rok-RRRR (nieznany rok: góra strony), w adresie nie zostaje ?rok; bez JS cała strona jak zwykle.
// Odbyte (zlecenie 65, decyzja 22.11): układ i styl minionych Konferencji — dwie kolumny na komputerze, wiersz bez wariantu
// „zwarty”, przygaszone; rok bez kreski pod spodem.
// Nadchodzące: WierszWydarzenia.astro (wariant zwarty, bez rodzaju w etykiecie), wygląd jak przed zleceniem 57 — dzień w kolorze Nauki,
// obok dzień tygodnia, godzina i miejsce, kandydat Brygadą (cały wiersz prowadzi do strony obrony), tytuł rozprawy, promotor
// (bez promotorów pomocniczych — promotorzyNaStronie w src/lib/tresci.ts, decyzja 22.11).
// Nagłówek wiersza: h3 pod „Nadchodzące”, h4 pod rokiem. Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css,
// klasa .tresc): sekcje h2 z kreską między nimi, lata h3. Własne style (na końcu pliku): liczba obron przy roku, promotor, odbyte w dwóch kolumnach.
// Jedna wersja HTML: komputer (≥ 1024 px) i telefon (≤ 1023 px; spis zwinięty jak w Konferencjach).
import Podstrona from '../components/zal/Podstrona.astro';
import WierszWydarzenia from '../components/WierszWydarzenia.astro';
import { t, odmiana } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { miejsce, slugOf, promotorzyNaStronie, type Obrona, type Wydarzenie } from '../lib/tresci';
import { tytulyWJezyku } from '../lib/osoby';
import { daneListyObron } from '../lib/widoki/listaObron';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
// html — tekst nad listą — Treść strony (Web-Aktualnosci → Strony → Obrony doktorskie; zlecenie 30), pierwsza sekcja strony
const { przyszle, lata, tytul, lead, haslo, html } = await daneListyObron(lang);
// obrona jako pozycja kalendarza (ten sam wiersz co w Kalendarzu)
const wiersz = (o: Obrona): Wydarzenie => ({
  rodzaj: 'obrona', tytul: o.data.kandydat, podtytul: o.data.tytul_rozprawy, poczatek: o.data.termin, miejsce: miejsce(o.data.miejsce, lang),
  href: `/obrony-doktorskie/${slugOf(o.id)}`, uid: `obr-${slugOf(o.id)}`,
});
const ileObron = (n: number) => `${n} ${odmiana(n, ['obrona', 'obrony', 'obron'], ['defence', 'defences'], lang)}`;
const tytulNadch = T('Nadchodzące', 'Upcoming');
// sekcje: nadchodzące (bez lat) i odbyte (lata jako podsekcje); wspólny wzór wiersza
const sekcje = [
  { id: 'z-nadchodzace', tytul: tytulNadch, grupy: [{ rok: '', lista: przyszle }] },
  ...(lata.length > 0 ? [{ id: 'z-odbyte', tytul: T('Odbyte', 'Past'), grupy: lata }] : []),
];
// spis „Na tej stronie”: Nadchodzące i lata od najnowszego
const spis = [
  { id: 'z-nadchodzace', etykieta: tytulNadch },
  ...lata.map((g) => ({ id: `rok-${g.rok}`, etykieta: g.rok })),
];
---
<Podstrona lang={lang} tytul={tytul} opis={lead} uklad="zwarta portal-baner" lead={lead} haslo={haslo} hasloBezLiczb
  okruszki={[{ etykieta: T('Nauka', 'Research'), adres: '/nauka' }, { etykieta: t(lang, 'obrony') }]} dzial="nauka" spis={spis} klasa="tresc z-ob">

  {html && <section set:html={html} />}

  {sekcje.map((sek) => (
    <section id={sek.id} class="ob-sek" aria-labelledby={`h-${sek.id}`}>
      <h2 id={`h-${sek.id}`}>{sek.tytul}</h2>
      {sek.grupy.every((g) => g.lista.length === 0) && <p class="pusto">{T('Nie zapowiedziano jeszcze kolejnych obron.', 'No upcoming defences announced.')}</p>}
      {sek.grupy.filter((g) => g.lista.length > 0).map((g) => (
        <>
          {g.rok && <h3 id={`rok-${g.rok}`} class="ob-rok">{g.rok}<span class="sr-only">, </span> <small>{ileObron(g.lista.length)}</small></h3>}
          <div class:list={['ob-wiersze', g.rok && 'ob-dwie']}>
            {g.lista.map((o) => (
              <WierszWydarzenia w={wiersz(o)} lang={lang} poziom={g.rok ? 'h4' : 'h3'} dzial="nauka" zwarty={!g.rok} bezRodzaju>
                {promotorzyNaStronie(o).length > 0 && (
                  <p class="ob-prom"><strong>{promotorzyNaStronie(o).length > 1 ? (en ? 'Supervisors:' : 'Promotorzy:') : t(lang, 'promotorzy') + ':'}</strong> {promotorzyNaStronie(o).map((p) => tytulyWJezyku(p, lang)).join(', ')}</p>
                )}
              </WierszWydarzenia>
            ))}
          </div>
        </>
      ))}
    </section>
  ))}
</Podstrona>

<script>
  // Stare adresy z filtrem lat (?rok=RRRR, panel „Pokaż” do zlecenia 57): przejście do sekcji roku (#rok-RRRR) bez przeładowania,
  // nieznany rok — góra strony; w adresie nie zostaje ?rok (inne parametry i kotwica zostają).
  const adres = new URL(location.href);
  const rok = adres.searchParams.get('rok');
  if (rok !== null) {
    adres.searchParams.delete('rok');
    const cel = /^\d{4}$/.test(rok) ? document.getElementById(`rok-${rok}`) : null;
    history.replaceState(history.state, '', adres);
    if (cel) {
      // odstęp nad nagłówkiem: scroll-margin-top (src/styles/zal-podstrona.css), tak samo jak po kliknięciu w spis (zal/SpisStrony.astro;
      // scrollIntoView i przewijanie przeglądarki do kotwicy dodałyby jeszcze scroll-padding-top z html)
      let y = -1;
      const przewin = () => {
        window.scrollTo({ top: window.scrollY + cel.getBoundingClientRect().top - (parseFloat(getComputedStyle(cel).scrollMarginTop) || 20), behavior: 'instant' });
        y = window.scrollY;
      };
      // po wczytaniu krojów i strony układ może się przesunąć (zal/Podstrona.astro) — poprawka, jeśli nikt jeszcze nie przewijał
      const popraw = () => { if (window.scrollY === y) przewin(); };
      przewin();
      document.fonts?.ready.then(popraw);
      // kotwica w adresie dopiero po wczytaniu strony: wcześniej przeglądarka sama przewinęłaby do niej po swojemu
      const kotwica = () => { popraw(); adres.hash = `rok-${rok}`; history.replaceState(history.state, '', adres); };
      if (document.readyState === 'complete') kotwica();
      else window.addEventListener('load', kotwica, { once: true });
    }
  }
</script>

<style>
  /* Sekcje, lata (h3), akapity — wzorzec treści .tresc (src/styles/zal-tresc.css). Nagłówek sekcji tuż nad wierszami; rok jak
     w Konferencjach (Brygada w kolorze działu, liczba obron małym krojem tekstu). */
  .ob-sek h2 { margin-bottom: 0; }
  h3.ob-rok small { margin-left: 8px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  /* Odbyte (lata) jak minione Konferencje (ListaKonferencji.astro; decyzja 22.11): wiersz bez wariantu „zwarty” (dzień 34 px,
     data minionej szara, tytuł 21 px), rok bez kreski pod spodem, na komputerze dwie kolumny; przygaszone jak „Ostatnio”
     w Szybkim dostępie (zalozyciele-strony.css: .z-w.minelo): kandydat w --text, etykieta lekko przygaszona */
  .ob-dwie :global(.ww-t) { color: var(--text); }
  .ob-dwie :global(.ww-rodz) { opacity: .8; }
  .ob-dwie .ob-prom strong { color: var(--text); }
  .pusto { margin: 10px 0 0; font-style: italic; color: var(--muted); }
  /* wiersz jak przed zleceniem 57: link kandydata bez przejścia koloru i odsunięcia podkreślenia linków .tresc (zal-tresc.css) */
  .ob-sek :global(.ww-t a) { transition: initial; text-underline-offset: initial; }
  /* promotor: jak „Kiedy:” w wierszu Aktualności */
  .ob-prom { margin: 2px 0 0; max-width: none; font-size: 13px; line-height: 1.5; color: var(--muted); }
  .ob-prom strong { font-weight: 700; color: var(--ink); }

  /* Telefon i komputer: ta sama definicja co MQ_TELEFON i MQ_KOMPUTER w src/lib/media.ts (zlecenie 23, punkt 1) */
  /* komputer: odbyte w dwóch kolumnach, jak minione Konferencje */
  @media (min-width: 1024px) and (min-height: 501px), (min-width: 1024px) and (pointer: fine) {
    .ob-dwie { display: grid; grid-template-columns: repeat(auto-fill, minmax(max(300px, 45%), 1fr)); gap: 0 48px; }
    .ob-dwie :global(.ww-t) { font-size: 19px; }
  }
  @media (max-width: 1023px), (max-height: 500px) and (pointer: coarse) {
    .ob-sek :global(.ww-t a) { text-underline-offset: 3px; } /* jak main a w telefon.css */
    .ob-prom { font-size: 13.5px; }
  }
</style>
