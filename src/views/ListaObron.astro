---
// Obrony doktorskie: nadchodzące i odbyte — sekcje .zsec jak na stronach działów (kreska sekcji, tytuł h2);
// na komputerze obrony jako osobne białe karty, jak w kalendarzu (.karty-lista w global.css; telefon — wiersze jak dotąd).
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal”, reszta strony jak w wariancie „Zwarta”
// (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok na końcu pliku).
// Tekst wprowadzający zaraz pod banerem (TekstWstepny: src/data/dzialy/nauka.json, pola obrony_tekst / obrony_tekst_en; puste = brak).
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import TekstWstepny from '../components/TekstWstepny.astro';
import ustawienia from '../data/ustawienia.json';
import Ikona from '../components/Ikona.astro';
import { u } from '../lib/url';
import { t, wJezyku } from '../lib/i18n';
import { dayNum, monthShort, longWithDay, short, type Lang } from '../lib/daty';
import { miejsce, obrony, slugOf, trwaLubBedzie, type Obrona } from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const wszystkie = await obrony();
const przyszle = wszystkie.filter((o) => trwaLubBedzie({ poczatek: o.data.termin })).reverse();
const odbyte = wszystkie.filter((o) => !trwaLubBedzie({ poczatek: o.data.termin }));
const lead = lang === 'en'
  ? 'Public defences of doctoral theses in mathematics: notices, theses, abstracts and reviews.'
  : 'Publiczne obrony rozpraw doktorskich z matematyki: zawiadomienia, rozprawy, streszczenia i recenzje.';
---
<Baza tytul={t(lang, 'obrony')} opis={lead} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={t(lang, 'obrony')} lead={lead} lang={lang} okruszki={[{ etykieta: lang === 'en' ? 'Research' : 'Nauka', adres: '/nauka' }, { etykieta: t(lang, 'obrony') }]} />
  <div class="wrap layout">
    <div class="main">
    <TekstWstepny pole="obrony_tekst" lang={lang} />
    {[{ h: t(lang, 'nadchodzaceObrony'), lista: przyszle }, { h: t(lang, 'odbyteObrony'), lista: odbyte }].map(({ h, lista }) => lista.length > 0 && (
      <section class="zsec">
        <h2>{h}</h2>
        <div class="karty-lista">
        {lista.map((o: Obrona) => (
          <a class="row-item" href={u(wJezyku(`/obrony-doktorskie/${slugOf(o.id)}`, lang))}>
            <span class:list={['datebox small', { minione: !trwaLubBedzie({ poczatek: o.data.termin }) }]} aria-hidden="true"><span class="d">{dayNum(o.data.termin)}</span><span class="m">{monthShort(o.data.termin, lang)}</span></span>
            <span class="body">
              <span class="news-meta kropki"><span>{longWithDay(o.data.termin, lang)}</span>{o.data.miejsce && <span class="kropka">{miejsce(o.data.miejsce, lang)}</span>}</span>
              <span class="t" style="font-size:19px">{o.data.kandydat}</span>
              <span class="x" lang="en">{o.data.tytul_rozprawy}</span>
            </span>
          </a>
        ))}
        </div>
      </section>
    ))}
    <p class="muted">{t(lang, 'archiwumObron')} <a href={`${ustawienia.archiwum}postepowania-w-sprawie-nadania-stopnia-doktora-w-instytucie-matematycznym`}>{t(lang, 'archiwum')}</a>.</p>
    </div>
  </div>
</Baza>

<style>
  /* komputer (≥ 761 px): odstęp nad pierwszym blokiem stały (24 px), jak na stronie działu „Nauka” — treść nie przylega
     do banera (reszta odstępów .layout — uklad-zwarta.css) */
  @media (min-width: 761px) { .layout { padding-top: 24px; } }
</style>
