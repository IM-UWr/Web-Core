---
// Struktura Instytutu: liczby (liczone z tabeli pracowników), krótki tekst o organizacji Instytutu (z CMS: pole
// struktura_tekst w src/data/dzialy/instytut.json, akapity oddzielone pustą linią) i karty zakładów.
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal” (liczby w jednym wierszu w banerze),
// reszta strony jak w wariancie „Zwarta” (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok na końcu pliku).
// Telefon (≤ 760 px; zlecenie 01, decyzje 31.10.2026): baner we wspólnym układzie — tytuł, bursztynowe hasło (pole
// struktura_haslo / struktura_haslo_en w src/data/dzialy/instytut.json; puste = opis jak dotąd), kreska i trzy liczby
// (profesorowie · doktorzy habilitowani · doktorzy, LiczbyBanera.astro); dawne kafelki .stats pod banerem usunięte.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import Ikona from '../components/Ikona.astro';
import { u } from '../lib/url';
import { t, wJezyku, wybierz } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { zaklady, pracownicy, rangaStopnia } from '../lib/tresci';
import dzial from '../data/dzialy/instytut.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const lista = await zaklady();
const osoby = await pracownicy();
const kadra = osoby.filter((o) => o.data.grupa === 'nauczyciel');
const ile = (r: number) => kadra.filter((o) => rangaStopnia(o.data.stopien) === r).length;
const liczby = [
  { n: ile(0), l: T('profesorów', 'full professors') },
  { n: ile(1), l: T('doktorów habilitowanych', 'associate professors (dr hab.)') },
  { n: ile(2), l: T('doktorów', 'assistant professors (PhD)') },
  { n: osoby.filter((o) => o.data.grupa === 'doktorant').length, l: T('doktorantów', 'PhD students') },
];
const naglowek = T('Struktura i zakłady', 'Structure and departments');
const tekst = ((wybierz(dzial, 'struktura_tekst', lang) as string) || '').split(/\n\s*\n/).map((a) => a.trim()).filter(Boolean);
const lead = T('W skład Instytutu wchodzi osiem zakładów naukowych i Pracownia Dydaktyki i Popularyzacji Matematyki.', 'The Institute consists of eight research departments and the Mathematics Education and Outreach Unit.');
// Baner na telefonie: hasło z danych działu (po angielsku tylko pole _en — bez polskich resztek) i trzy liczby kadry
// z odmianą po liczebniku (te same wartości co ile(0–2) wyżej; doktoranci są w banerze „Pracowników”). Rzeczowniki
// męskoosobowe: przy 2–4 też dopełniacz („dwóch profesorów”, „43 doktorów” — „43 doktorzy” byłoby błędem).
const haslo = ((lang === 'en' ? (dzial as any).struktura_haslo_en : (dzial as any).struktura_haslo) as string | undefined) || undefined;
const liczbyTel: { n: number; pl: [string, string, string]; en: [string, string] }[] = [
  { n: ile(0), pl: ['profesor', 'profesorów', 'profesorów'], en: ['full professor', 'full professors'] },
  { n: ile(1), pl: ['doktor habilitowany', 'doktorów habilitowanych', 'doktorów habilitowanych'], en: ['habilitated researcher', 'habilitated researchers'] },
  { n: ile(2), pl: ['doktor', 'doktorów', 'doktorów'], en: ['PhD holder', 'PhD holders'] },
];
---
<Baza tytul={naglowek} opis={lead} uklad="zwarta portal-baner">
  {/* Komputer: liczby w jednym wierszu w banerze (.pt-liczby, jak na stronie działu „Instytut”).
       Telefon: pod hasłem kreska i trzy liczby w kolumnach (LiczbyBanera.astro, lista .tylko-telefon). */}
  <NaglowekStrony tytul={naglowek} lead={lead} haslo={haslo} lang={lang} okruszki={[{ etykieta: t(lang, 'instytut'), adres: '/instytut' }, { etykieta: naglowek }]}>
    <ul class="pt-liczby tylko-komputer">
      {liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}
    </ul>
    <LiczbyBanera lang={lang} pozycje={liczbyTel} />
  </NaglowekStrony>
  <div class="wrap lz-wrap">
    {/* tekst o organizacji Instytutu, żeby strona nie zaczynała się od razu od listy zakładów (komputer i telefon) */}
    {tekst.length > 0 && <div class="lz-tekst">{tekst.map((a) => <p>{a}</p>)}</div>}

    {/* karty zakładów pod własnym nagłówkiem sekcji (kreska jak w innych sekcjach), oddzielone od tekstu wstępu */}
    <section class="zsec lz-zaklady" aria-labelledby="zaklady-lista">
      <h2 id="zaklady-lista">{T('Zakłady i pracownia', 'Departments and unit')}</h2>
      <div class="dept-grid">
        {lista.map((z) => {
          const n = osoby.filter((o) => o.data.zaklad === z.id).length;
          const obszary = lang === 'en' && z.data.obszary_en.length ? z.data.obszary_en : z.data.obszary;
          return (
            <a class="dept" href={u(wJezyku(`/instytut/zaklady/${z.id}`, lang))}>
              <span class="t">{wybierz(z.data, 'nazwa', lang)}</span>
              {z.data.opis && <span class="o">{wybierz(z.data, 'opis', lang)}</span>}
              <span class="tags">{obszary.slice(0, 4).map((o) => <span class="badge">{o}</span>)}</span>
              <span class="f">
                {z.data.kierownik && <span><span class="muted">{T('Kierownik', 'Head')}:</span> {z.data.kierownik}</span>}
                <span class="muted">{n} {T('osób', 'people')}</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <p class="muted" style="margin-top:28px;font-size:15px">
      {T('Obszary badań Instytutu: podstawy matematyki, teoria modeli, algebra, kombinatoryka, teoria liczb, geometria i topologia różniczkowa, geometryczna teoria grup, równania różniczkowe, analiza harmoniczna, teoria miary, analiza funkcjonalna, teoria prawdopodobieństwa, procesy stochastyczne, statystyka matematyczna.',
         'Research areas of the Institute: foundations of mathematics, model theory, algebra, combinatorics, number theory, differential geometry and topology, geometric group theory, differential equations, harmonic analysis, measure theory, functional analysis, probability theory, stochastic processes, mathematical statistics.')}
    </p>
  </div>
</Baza>

<style>
  .lz-wrap { padding-top: 32px; padding-bottom: 64px; }
  /* tekst nad kartami — jak „O Instytucie” na stronie działu: akapity w wygodnej szerokości do czytania */
  .lz-tekst { margin: 0 0 28px; }
  .lz-tekst p { max-width: 820px; margin: 0 0 12px; font-size: 16px; line-height: 1.65; }
  .lz-tekst p:last-child { margin-bottom: 0; }
  /* telefon: tekst jest pierwszym elementem pod banerem (kafelki liczb przeszły do banera) — bez górnego marginesu,
     odstęp od pasa daje wspólna reguła (26 px, telefon.css) */
  @media (max-width: 760px) { .lz-tekst { margin: 0 0 22px; } .lz-tekst p { font-size: 15px; line-height: 1.55; } }
  /* komputer (≥ 761 px), wariant „Zwarta”: odstęp od stopki jak na innych podstronach (uklad-zwarta.css);
     nad kartami zakładów stały odstęp 24 px, jak na stronie działu „Instytut” */
  @media (min-width: 761px) { .lz-wrap { padding-top: 24px; padding-bottom: var(--tresc-dol); } }
</style>
