---
// Strona kierunku studiów (np. Matematyka) i szkoły doktorskiej (kierunek „szkola-doktorska”), zlecenie 28.
// Treść: jeden Markdown kierunku — src/content/kierunki/<kierunek>.md (body po polsku, pole tresc_en po angielsku;
// edycja w Pages CMS: Nazwa, Treść, Nazwa EN, Treść EN). Sekcje to nagłówki ## (kotwice i krótkie etykiety spisu
// „Na tej stronie” — src/plugins/kotwice.mjs), bloki wzorca treści z samego tekstu (src/plugins/rehype-bloki.mjs):
// listy „**Tytuł** — opis” → ul.dwa, lista numerowana → ol.etapy, kontakty, listy linków i plików, tabela terminów,
// ### w „Program studiów” → zakładki, ### z „?” w „Pytania” → rozwijane. Wspólny szablon podstrony (zal/Podstrona.astro)
// i wzorzec treści (src/styles/zal-tresc.css, klasa .tresc).
// Baner (opis, hasło, liczby): src/content/kierunki-baner/<kierunek>.json — bez pliku strona ma samą nazwę.
// Kafelki specjalności: z plików specjalności (src/content/specjalnosci), w miejscu sekcji „Specjalności” w treści
// (bez nagłówka w treści — na końcu). Jedna wersja HTML: komputer (≥ 1024 px) i telefon (≤ 1023 px, tabela w bloki).
import type { CollectionEntry } from 'astro:content';
import Podstrona from '../components/zal/Podstrona.astro';
import { u } from '../lib/url';
import { wJezyku, wybierz } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { daneKierunku } from '../lib/widoki/kierunek';

interface Props { kierunek: CollectionEntry<'kierunki'>; lang: Lang }
const { kierunek, lang } = Astro.props;
const en = lang === 'en';
const T = (pl: string, plEn: string) => (en ? plEn : pl);
const w = (o: any, pole: string) => wybierz(o, pole, lang);
const { nazwa, przed, po, sekcje, specjalnosci, nazwyZakladow, opis, lead, haslo, liczby } = await daneKierunku(kierunek, lang);
---
<Podstrona lang={lang} tytul={nazwa} opis={opis} opublikowany={kierunek.data.opublikowany} uklad="zwarta portal-baner"
  lead={lead} haslo={haslo} wstecz={{ etykieta: T('Studia', 'Study'), adres: '/studia' }}
  dzial="studia" spis={sekcje} klasa="tresc" atrybuty={{ 'data-kierunek': '' }}>
  {/* Baner: fakty kierunku w jednym wierszu (na telefonie trzy pierwsze — reguła .kh-liczby niżej). */}
  <Fragment slot="baner">
    {liczby.length > 0 && (
      <ul class="pt-liczby kh-liczby">
        {liczby.map((f) => <li><span class="n">{f.wartosc}</span>{f.etykieta}</li>)}
      </ul>
    )}
  </Fragment>

  <Fragment set:html={przed} />
  {specjalnosci.length > 0 && (
    <ul class="dwa kier-spec">
      {specjalnosci.map((s) => (
        <li>
          {(s.skrot || s.wygaszana) && <span class="etyk">{[s.skrot, s.wygaszana ? T('wygaszana', 'phased out') : ''].filter(Boolean).join(' · ')}</span>}
          <b>{s.strona ? <a href={u(wJezyku(`/studia/${kierunek.id}/${s.strona}`, lang))}>{w(s, 'nazwa')}</a> : w(s, 'nazwa')}</b>
          {s.opis && <span>{w(s, 'opis')}</span>}
          {(s.dla_kogo || s.kariera || s.opiekunowie || (s.zaklad && nazwyZakladow[s.zaklad])) && (
            <dl class="para">
              {s.dla_kogo && <><dt>{T('Dla kogo', 'For whom')}</dt><dd>{w(s, 'dla_kogo')}</dd></>}
              {s.kariera && <><dt>{T('Po studiach', 'Careers')}</dt><dd>{w(s, 'kariera')}</dd></>}
              {s.opiekunowie && <><dt>{T('Opiekun', 'Coordinator')}</dt><dd>{s.opiekunowie}</dd></>}
              {s.zaklad && nazwyZakladow[s.zaklad] && <><dt>{T('Zakład', 'Department')}</dt><dd><a href={u(wJezyku(`/instytut/zaklady/${s.zaklad}`, lang))}>{wybierz(nazwyZakladow[s.zaklad].data, 'nazwa', lang)}</a></dd></>}
            </dl>
          )}
        </li>
      ))}
    </ul>
  )}
  <Fragment set:html={po} />
</Podstrona>

<script>
  // Program studiów: zakładki programów (.tresc-taby, role="tablist"; z ### w sekcji „Program studiów”).
  // Bez JS: zakładki schowane, wszystkie programy jeden pod drugim (z podpisami).
  const box = document.querySelector<HTMLElement>('[data-kierunek]');
  const tabs = Array.from(box?.querySelectorAll<HTMLButtonElement>('.tresc-taby [role="tab"]') ?? []);
  const panels = Array.from(box?.querySelectorAll<HTMLElement>('[data-panel]') ?? []);
  const pokaz = (i: number) => {
    tabs.forEach((t, j) => {
      t.setAttribute('aria-selected', String(i === j));
      t.tabIndex = i === j ? 0 : -1;
    });
    panels.forEach((p, j) => (p.hidden = i !== j));
  };
  if (tabs.length) {
    pokaz(0);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pokaz(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          const j = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
          pokaz(j);
          tabs[j].focus();
        }
      });
    });
  }
</script>

<style>
  /* baner na telefonie: trzy pierwsze fakty w trzech kolumnach (zal-telefon.css), wartości mniejsze, bo bywają słowami („6 semestrów”);
     bez liczb nie byłoby też hasła (zlecenie 11, zalecenie 2: hasło i liczby razem albo wcale) */
  /* Telefon i komputer: ta sama definicja co MQ_TELEFON i MQ_KOMPUTER w src/lib/media.ts (zlecenie 23, punkt 1) */
  @media (max-width: 1023px), (max-height: 500px) and (pointer: coarse) { :global(.z-nagl .z-slot .pt-liczby.kh-liczby .n) { font-size: 21px; } }

  /* Treść z Markdownu (set:html) nie ma atrybutu stylów zakresowych — reguły globalne z prefiksem strony kierunku
     (.tresc[data-kierunek]; specyficzność nie niższa niż dawnych reguł zakresowych w tym pliku). */
  :global(.tresc[data-kierunek] [hidden]) { display: none !important; }
  /* bez JS: bez zakładek, wszystkie programy z podpisami; z JS podpis tylko dla czytników ekranu */
  :global(html:not(.js) .tresc[data-kierunek] .tresc-taby) { display: none; }
  :global(html.js .tresc[data-kierunek] .kier-podpis) { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  :global(.tresc[data-kierunek] .kier-podpis) { margin: 18px 0 4px; font-size: 13px; font-weight: 700; color: var(--d-a); }
  /* opis dokumentu (programu, aktu) pod nazwą */
  :global(.tresc[data-kierunek] .pliki small) { display: block; font-size: 13.5px; color: var(--muted); }
  /* pytania: stary styl .faq z global.css (pogrubienie, wysokość 52 px) nie przecieka do wzorca */
  :global(.tresc[data-kierunek] .faq summary) { min-height: 0; align-items: flex-start; font-weight: 400; }

  /* specjalności (ul.dwa): etykieta skrótu, nazwa, opis i pary; nazwa-link jak tytuł, bez podkreślenia */
  .kier-spec li > b a { color: inherit; text-decoration: none; }
  .kier-spec li > b a:hover { color: var(--d-a); }
  .kier-spec li > b a::after { content: ' →'; font-family: var(--f-text); font-size: 15px; color: var(--muted); }
  .kier-spec dl { margin-top: 8px; }

  @media (min-width: 1024px) and (min-height: 501px), (min-width: 1024px) and (pointer: fine) {
    /* szerokość rzędu faktów (do ciekawostki z prawej, bez drugiego rzędu) ustawia skrypt w NaglowekZ.astro */
    .kh-liczby { margin-top: 6px; }
  }
</style>
