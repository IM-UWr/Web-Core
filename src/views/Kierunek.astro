---
// Strona kierunku studiów (np. Matematyka). Treść: src/content/kierunki/<kierunek>.md (edycja w Pages CMS).
import { zTytulem } from '../lib/osoby';
import { render, getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Baza from '../layouts/Baza.astro';
import Ikona from '../components/Ikona.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import SpisTresci from '../components/SpisTresci.astro';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz } from '../lib/i18n';
import { today, type Lang } from '../lib/daty';
import { renderMarkdown } from '../lib/markdown';
import { zaklady, pracownicy } from '../lib/tresci';

interface Props { kierunek: CollectionEntry<'kierunki'>; lang: Lang }
const { kierunek, lang } = Astro.props;
const d = kierunek.data;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const w = (o: any, pole: string) => wybierz(o, pole, lang);
// Pliki (/pliki/...) nie mają wersji językowych — bez prefiksu /en.
const href = (a: string) => (isExternal(a) ? a : u(a.startsWith('/pliki/') ? a : wJezyku(a, lang)));
const { Content } = await render(kierunek);
const htmlEn = lang === 'en' && d.tresc_en ? await renderMarkdown(d.tresc_en) : '';
const md = (pl?: string, en?: string) => renderMarkdown((lang === 'en' && en) || pl || '');
const kariera = await md(d.kariera, d.kariera_en);
const praktyki = await md(d.praktyki, d.praktyki_en);
const faq = await Promise.all(d.faq.map(async (f) => ({ q: w(f, 'pytanie'), a: await md(f.odpowiedz, f.odpowiedz_en) })));
const nazwyZakladow = Object.fromEntries((await zaklady()).map((z) => [z.id, z]));
// Kafelki specjalności budują się z plików specjalności (src/content/specjalnosci) — jedno miejsce edycji.
const osoby = await pracownicy();
const zTytulemZeSpisu = (n: string) => {
  const kand = osoby.filter((p) => p.data.imie_nazwisko === n.trim());
  const o = kand.find((p) => p.data.grupa === 'nauczyciel') ?? kand.find((p) => p.data.grupa !== 'administracja') ?? kand[0];
  return zTytulem(o?.data.stopien, n);
};
const specjalnosci = (await getCollection('specjalnosci'))
  .filter((s) => s.data.kierunek === kierunek.id && s.data.opublikowany !== false && s.data.na_stronie_kierunku)
  .sort((a, b) => Number(a.data.wygaszana) - Number(b.data.wygaszana) || a.data.kolejnosc - b.data.kolejnosc || a.data.nazwa.localeCompare(b.data.nazwa, 'pl'))
  .map((s) => ({
    ...s.data,
    strona: s.data.bez_podstrony ? undefined : s.id,
    opiekunowie: s.data.opiekunowie.map((o) => zTytulemZeSpisu(o.imie_nazwisko)).join(', '),
    dla_kogo: s.data.kafelek_dla_kogo,
    dla_kogo_en: s.data.kafelek_dla_kogo_en,
    kariera: s.data.kafelek_kariera,
    kariera_en: s.data.kafelek_kariera_en,
  }));

const nazwa = w(d, 'nazwa');
const etapyI = d.etapy.filter((e) => e.stopien === 'I');
const etapyII = d.etapy.filter((e) => e.stopien === 'II');
const etapyIII = d.etapy.filter((e) => e.stopien === 'III');
// Szkoła doktorska (etapy III stopnia, bez I/II): inne napisy niż na kierunkach studiów.
const doktorat = etapyIII.length > 0 && etapyI.length + etapyII.length === 0;
const N = {
  o: doktorat ? T('O szkole doktorskiej', 'About the doctoral school') : T('O kierunku', 'About'),
  przebieg: doktorat ? T('Ścieżka doktoranta', 'The doctoral path') : T('Jak wyglądają studia', 'How the studies work'),
  program: doktorat ? T('Program kształcenia', 'Programme') : T('Program studiów', 'Curriculum'),
};
const rok = Number(today().slice(0, 4));
const lata = Array.from({ length: rok - 2016 + 1 }, (_, i) => rok - i);
// Wybór roku i zakładki tylko przy kilku programach; przy jednym od razu pokazujemy jego dokumenty.
const wieleProgramow = d.programy.length > 1;
// Strona „Egzaminy i dyplom” opisuje egzaminy kierunku matematyka — inne kierunki jej nie linkują.
const linkDyplom = kierunek.id === 'matematyka';

const sekcje = [
  { slug: 'o-kierunku', text: N.o },
  ...(d.etapy.length ? [{ slug: 'przebieg', text: N.przebieg }] : []),
  ...(specjalnosci.length ? [{ slug: 'specjalnosci', text: T('Specjalności', 'Specialisations') }] : []),
  ...(d.programy.length ? [{ slug: 'program', text: N.program }] : []),
  ...(d.terminy.length ? [{ slug: 'terminy', text: T('Terminy i formularze', 'Deadlines and forms') }] : []),
  ...(praktyki ? [{ slug: 'praktyki', text: T('Praktyki pedagogiczne', 'Teaching placements') }] : []),
  ...(kariera ? [{ slug: 'po-studiach', text: T('Po studiach', 'After graduation') }] : []),
  ...(faq.length ? [{ slug: 'pytania', text: T('Pytania i odpowiedzi', 'FAQ') }] : []),
  ...(d.kontakt.length ? [{ slug: 'kontakt', text: T('Kontakt', 'Contact') }] : []),
  ...(d.akty.length ? [{ slug: 'akty', text: T('Akty prawne', 'Regulations') }] : []),
].map((s) => ({ depth: 2, ...s }));
---
<Baza tytul={nazwa} opis={w(d, 'opis')} opublikowany={d.opublikowany}>
  {/* Baner jak na stronie Studia (zdjęcie działu z NaglowekStrony); przyciski w banerze, liczby pod nim.
       Wariant „Portal”: na komputerze spis sekcji jako poziomy pasek pod banerem (zamiast panelu z prawej) — treść ma pełną
       szerokość, „Dlaczego warto” stoi obok tekstu o kierunku, a krótkie sekcje parami obok siebie.
       Telefon (≤ 760 px): jak na głównej gałęzi — fakty 2×2, zwartsze sekcje, spis sekcji jako rozwijana lista (style na dole). */}
  <NaglowekStrony tytul={nazwa} lead={d.opis ? w(d, 'opis') : undefined} lang={lang} nadtytul={d.podtytul ? w(d, 'podtytul') : undefined} wstecz={{ etykieta: T('Studia', 'Study'), adres: '/studia' }}>
    {d.przyciski.length > 0 && (
      <div class="btn-row kh-btns">
        {d.przyciski.map((p, i) => (
          <a class={`btn${i === 0 ? ' btn-accent' : ''}`} href={href(p.adres)}>{w(p, 'etykieta')}{isExternal(p.adres) && <Ikona nazwa="zewnetrzny" rozmiar={14} />}</a>
        ))}
      </div>
    )}
  </NaglowekStrony>

  <SpisTresci naglowki={sekcje} lang={lang} wariant="pasek" />
  <div class="wrap kier">
    <div class="main">
      {d.fakty.length > 0 && (
        <div class="stats kh-fakty">
          {d.fakty.map((f) => <div class="stat"><span class="n">{f.wartosc}</span><span class="l">{w(f, 'etykieta')}</span></div>)}
        </div>
      )}
      <SpisTresci naglowki={sekcje} lang={lang} wariant="gora" />

      <section class="zsec kier-o" aria-labelledby="o-kierunku">
        <h2 id="o-kierunku">{N.o}</h2>
        <div class:list={['kier-o-in', { 'kier-o-2': d.dlaczego.length > 0 }]}>
        <div class="prose">{htmlEn ? <Fragment set:html={htmlEn} /> : <Content />}</div>
        {d.dlaczego.length > 0 && (
          <div class="why-grid">
            {d.dlaczego.map((x) => (
              <div class="why">
                <Ikona nazwa={x.ikona || 'flaga'} rozmiar={24} />
                <strong>{w(x, 'tytul')}</strong>
                <span>{w(x, 'opis')}</span>
              </div>
            ))}
          </div>
        )}
        </div>
      </section>

      {d.etapy.length > 0 && (
        <section class="zsec" aria-labelledby="przebieg">
          <h2 id="przebieg">{N.przebieg}</h2>
          <div class="tracks">
            {[{ h: T('Studia I stopnia (licencjackie)', "Bachelor's studies"), lista: etapyI }, { h: T('Studia II stopnia (magisterskie)', "Master's studies"), lista: etapyII }, { h: T('Kształcenie w szkole doktorskiej', 'Doctoral training'), lista: etapyIII }].map((tr) => tr.lista.length > 0 && (
              <div class="track">
                <h3>{tr.h}</h3>
                <ol class="steps">
                  {tr.lista.map((e) => (
                    <li class="step">
                      <span class="when">{w(e, 'kiedy')}</span>
                      <strong>{w(e, 'tytul')}</strong>
                      {e.opis && <span class="desc">{w(e, 'opis')}</span>}
                      {e.termin && (
                        <span class="deadline">
                          <Ikona nazwa="zegar" rozmiar={14} />{w(e, 'termin')}
                          {e.formularz && (e.formularz_adres ? <a href={e.formularz_adres}>{e.formularz}</a> : <span class="muted"> · {e.formularz}</span>)}
                        </span>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
          {linkDyplom && <p class="muted" style="font-size:15px">{T('Szczegóły egzaminów i prac dyplomowych:', 'Exams and theses in detail:')} <a href={u(wJezyku('/studia/egzaminy-i-dyplom', lang))}>{T('Egzaminy i dyplom', 'Exams and diploma')}</a>.</p>}
        </section>
      )}

      {specjalnosci.length > 0 && (
        <section class="zsec" aria-labelledby="specjalnosci">
          <h2 id="specjalnosci">{T('Specjalności', 'Specialisations')}</h2>
          <div class="spec-grid">
            {specjalnosci.map((s) => (
              <article class={`spec${s.wygaszana ? ' spec-off' : ''}${s.strona ? ' spec-link' : ''}`}>
                <div class="news-meta">
                  {s.skrot && <span class="badge">{s.skrot}</span>}
                  {s.wygaszana && <span class="badge">{T('wygaszana', 'phased out')}</span>}
                </div>
                <h3>{s.strona ? <a href={u(wJezyku(`/studia/${kierunek.id}/${s.strona}`, lang))}>{w(s, 'nazwa')}</a> : w(s, 'nazwa')}</h3>
                {s.opis && <p>{w(s, 'opis')}</p>}
                {s.dla_kogo && <p><span class="lbl">{T('Dla kogo', 'For whom')}</span>{w(s, 'dla_kogo')}</p>}
                {s.kariera && <p><span class="lbl">{T('Po studiach', 'Careers')}</span>{w(s, 'kariera')}</p>}
                {s.strona && <span class="link-arrow" aria-hidden="true" style="min-height:32px">{T('Więcej o specjalności', 'More about this specialisation')}<Ikona nazwa="strzalka" rozmiar={15} /></span>}
                {(s.opiekunowie || (s.zaklad && nazwyZakladow[s.zaklad])) && (
                  <p class="foot">
                    {s.opiekunowie && <span><span class="muted">{T('Opiekun', 'Coordinator')}:</span> {s.opiekunowie}</span>}
                    {s.zaklad && nazwyZakladow[s.zaklad] && <a href={u(wJezyku(`/instytut/zaklady/${s.zaklad}`, lang))}>{wybierz(nazwyZakladow[s.zaklad].data, 'nazwa', lang)}</a>}
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      {d.programy.length > 0 && (
        <section class="zsec" aria-labelledby="program">
          <h2 id="program">{N.program}</h2>
          {wieleProgramow && (
            <label class="year-pick">
              <span>{doktorat ? T('Rozpocząłem / rozpoczęłam kształcenie w roku', 'I started my doctoral training in') : T('Rozpocząłem / rozpoczęłam studia w roku', 'I started my studies in')}</span>
              <select data-rok>
                <option value="">—</option>
                {lata.map((r) => <option value={r}>{r}/{String(r + 1).slice(2)}</option>)}
              </select>
            </label>
          )}
          {wieleProgramow && (
            <div class="tabs" role="tablist" aria-label={N.program}>
              {d.programy.map((p, i) => (
                <button type="button" role="tab" class="chip" id={`tab-${i}`} aria-controls={`prog-${i}`} aria-selected={i === 0 ? 'true' : 'false'} data-od={p.od_roku} data-do={p.do_roku}>{w(p, 'nazwa')}</button>
              ))}
            </div>
          )}
          {d.programy.map((p, i) => (
            <div class="tabpanel" role={wieleProgramow ? 'tabpanel' : undefined} id={`prog-${i}`} aria-labelledby={wieleProgramow ? `tab-${i}` : undefined} data-panel>              {p.dotyczy && <p class="notice" style="margin:0 0 12px">{w(p, 'dotyczy')}</p>}
              <ul class="files">
                {p.dokumenty.map((x) => (
                  <li><a href={href(x.plik)}><Ikona nazwa="plik" /><span>{w(x, 'nazwa')}{x.opis && <small class="muted" style="display:block;font-weight:500">{x.opis}</small>}</span></a></li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )}

      {d.terminy.length > 0 && (
        <section class="zsec" aria-labelledby="terminy">
          <h2 id="terminy">{T('Terminy i formularze', 'Deadlines and forms')}</h2>
          <div class="table-wrap">
            <table class="staff">
              <thead><tr><th>{T('Sprawa', 'What')}</th><th>{T('Kogo dotyczy', 'Who')}</th><th>{T('Termin', 'Deadline')}</th><th>{T('Formularz', 'Form')}</th></tr></thead>
              <tbody>
                {d.terminy.map((x) => (
                  <tr>
                    <td class="n" data-l={T('Sprawa', 'What')}>{w(x, 'co')}</td>
                    <td data-l={T('Kogo dotyczy', 'Who')}>{w(x, 'kogo')}</td>
                    <td data-l={T('Termin', 'Deadline')}><strong>{w(x, 'termin')}</strong></td>
                    <td data-l={T('Formularz', 'Form')}>{x.formularz && (x.formularz_adres ? <a class="btn btn-small" href={x.formularz_adres}>{x.formularz}</a> : x.formularz)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {!doktorat && <p class="muted" style="font-size:15px">{T('Wszystkie formularze i zasady rejestracji:', 'All forms and registration rules:')} <a href={u(wJezyku('/studia/zajecia', lang))}>{T('Zajęcia i konsultacje', 'Classes and office hours')}</a>.</p>}
        </section>
      )}

      <div class="kier-2">
      {praktyki && (
        <section class="zsec" aria-labelledby="praktyki">
          <h2 id="praktyki">{T('Praktyki pedagogiczne', 'Teaching placements')}</h2>
          <div class="prose"><Fragment set:html={praktyki} /></div>
          {d.praktyki_dokumenty.length > 0 && (
            <ul class="files">{d.praktyki_dokumenty.map((x) => <li><a href={href(x.plik)}><Ikona nazwa="plik" />{w(x, 'nazwa')}</a></li>)}</ul>
          )}
        </section>
      )}

      {kariera && (
        <section class="zsec" aria-labelledby="po-studiach">
          <h2 id="po-studiach">{T('Po studiach', 'After graduation')}</h2>
          <div class="prose"><Fragment set:html={kariera} /></div>
        </section>
      )}
      </div>

      {faq.length > 0 && (
        <section class="zsec" aria-labelledby="pytania">
          <h2 id="pytania">{T('Pytania i odpowiedzi', 'FAQ')}</h2>
          <div class="faq">
            {faq.map((f) => (
              <details>
                <summary>{f.q}<Ikona nazwa="dol" class="chev" rozmiar={18} /></summary>
                <div class="prose" style="font-size:16px"><Fragment set:html={f.a} /></div>
              </details>
            ))}
          </div>
        </section>
      )}

      <div class="kier-2">
      {d.kontakt.length > 0 && (
        <section class="zsec" aria-labelledby="kontakt">
          <h2 id="kontakt">{T('Kontakt', 'Contact')}</h2>
          <ul class="people">
            {d.kontakt.map((k) => (
              <li class="person">
                <span class="role" style="font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)">{w(k, 'rola')}</span>
                <span class="os-n">{k.osoba}</span>
                <span class="os-c">
                  {k.email && <a href={`mailto:${k.email}`}>{k.email}</a>}
                  {k.telefon && <span>{T('tel.', 'phone')} {k.telefon}</span>}
                  {k.pokoj && <span>{T('pok.', 'room')} {k.pokoj}</span>}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {d.akty.length > 0 && (
        <section class="zsec" aria-labelledby="akty">
          <h2 id="akty">{T('Akty prawne', 'Regulations')}</h2>
          <details class="more">
            <summary>{T('Pokaż dokumenty', 'Show documents')} ({d.akty.length})</summary>
            <ul class="files" style="margin-top:10px">{d.akty.map((x) => <li><a href={href(x.plik)}><Ikona nazwa="plik" />{w(x, 'nazwa')}</a></li>)}</ul>
          </details>
        </section>
      )}
      </div>
    </div>
  </div>
</Baza>

<script>
  // Zakładki programów studiów + wybór roku rozpoczęcia studiów.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tabs [role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const pokaz = (i: number) => {
    tabs.forEach((t, j) => {
      t.setAttribute('aria-selected', String(i === j));
      t.tabIndex = i === j ? 0 : -1;
    });
    panels.forEach((p, j) => (p.hidden = i !== j));
  };
  if (tabs.length) {
    pokaz(0);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pokaz(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          const j = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
          pokaz(j);
          tabs[j].focus();
        }
      });
    });
    document.querySelector<HTMLSelectElement>('[data-rok]')?.addEventListener('change', (e) => {
      const r = Number((e.target as HTMLSelectElement).value);
      if (!r) return;
      const i = tabs.findIndex((t) => Number(t.dataset.od) <= r && r <= Number(t.dataset.do));
      if (i >= 0) pokaz(i);
    });
  }
</script>

<style>
  .kh-btns { margin-top: 6px; }
  .kh-fakty { margin: 0 0 22px; }
  /* liczby kierunku mniejsze niż w statystykach działów (34 px) — „6 semestrów”, „licencjat” mieszczą się w kafelku */
  .kh-fakty .stat { padding: 16px 18px; }
  .kh-fakty .stat .n { font-size: 24px; letter-spacing: -0.01em; overflow-wrap: anywhere; }

  /* ---------- wariant „Portal” (komputer i telefon) ---------- */
  /* treść na pełną szerokość: bez panelu z prawej (na komputerze spis sekcji jest paskiem pod banerem, na telefonie listą nad treścią) */
  .kier { display: block; padding-top: clamp(14px, 2vw, 22px); padding-bottom: clamp(28px, 4vw, 44px); }
  /* przebieg studiów: „kiedy” w jednym wierszu z nazwą etapu */
  .step { flex-direction: row; flex-wrap: wrap; align-items: baseline; column-gap: 10px; }
  .step > .desc, .step > .deadline { flex-basis: 100%; }
  .step > .deadline { flex-basis: auto; }
  /* specjalności: etykiety („Dla kogo”, „Po studiach”) w wierszu z treścią */
  .spec .lbl { display: inline; margin-right: 6px; }
  .spec-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  /* dokumenty programu, praktyk i akty prawne: siatka (na komputerze i szerszym telefonie dwie kolumny) */
  .tabpanel .files, .zsec > .files, .more .files { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }

  /* ---------- komputer (≥ 761 px): wariant „Portal” ---------- */
  @media (min-width: 761px) {
    /* liczby pod banerem jak na głównej gałęzi (kafelki z odstępem 12 px) */
    .kh-fakty { gap: 12px; }
    .why-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
    /* „O kierunku”: tekst z lewej, „Dlaczego warto” (2×2) z prawej */
    .kier-o-2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px); gap: 16px 32px; align-items: start; }
    .kier-o-2 .why-grid { margin-top: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* krótkie sekcje parami obok siebie (praktyki | po studiach, kontakt | akty prawne) */
    .kier-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 0 36px; align-items: start; }
  }
  @media (min-width: 761px) and (max-width: 980px) {
    .kier-o-2 { grid-template-columns: minmax(0, 1fr); }
  }

  /* ---------- telefon (≤ 760 px): wygląd „Portal” ---------- */
  @media (max-width: 760px) {
    /* nagłówek: tekst, przyciski i fakty (2×2) ciaśniej */
    .kh-btns { margin-top: 4px; }
    .kh-fakty { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 0 0 16px; }
    .kh-fakty .stat { padding: 12px 14px; }
    .kh-fakty .stat .n { font-size: 21px; }
    /* „O kierunku”: „Dlaczego warto” pod tekstem, dwie w rzędzie (na wąskim telefonie jedna) */
    .kier-o .prose { display: flow-root; }
    .kier-o .why-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 16px; }
