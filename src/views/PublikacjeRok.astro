---
// Wykaz prac z danego roku (/nauka/publikacje/RRRR; src/data/publikacje/RRRR.json), kierunek „Założyciele”, szablon podstrony
// zal/Podstrona.astro: nota o pochodzeniu wykazu (ramka uwagi), numerowana lista prac, opcjonalnie w grupach (rodzaje prac —
// sekcje h2 z liczbą prac; przy co najmniej dwóch grupach spis „Na tej stronie”), na końcu starszy i nowszy wykaz.
// Praca: autorzy, tytuł Brygadą, opis, źródło z DOI i IF, uwagi; wiersze oddzielone cienką linią, numer przygaszony z lewej.
// Baner: hasło (nauka.json: rocznik_haslo / _en), „Wykaz w PDF” i liczby (LiczbyBanera) — na każdej szerokości.
// Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css, klasa .tresc); własne style (na końcu pliku) dla listy
// prac, przycisku PDF w banerze i nawigacji między latami. Jedna wersja HTML: komputer (≥ 761 px) i telefon (≤ 760 px).
import Podstrona from '../components/zal/Podstrona.astro';
import Link from '../components/Link.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import Ikona from '../components/Ikona.astro';
import { u, isExternal } from '../lib/url';
import { wJezyku } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { tekstHtml, type Praca } from '../lib/widoki/publikacje';
import { danePublikacjiRoku } from '../lib/widoki/publikacjeRok';

interface Props { rok: number; lang: Lang }
const { rok, lang } = Astro.props;
const en = lang === 'en';
const T = (pl: string, en_: string) => (en ? en_ : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
const doiUrl = (d: string) => `https://doi.org/${encodeURI(d)}`;
const pokazIF = (p: Praca) => p.if && !/^0([.,]0*)?$/.test(p.if.trim());

const { ten, nowszy, starszy, tytul, lead, haslo, liczbyTelefon, grupy, naglowki, zSpisem, uwagi, pochodzenie } = await danePublikacjiRoku(rok, lang);
const spis = zSpisem ? naglowki.map((n) => ({ id: n.slug, etykieta: n.text })) : [];
---
<Podstrona lang={lang} tytul={tytul} opis={lead} uklad="zwarta portal-baner" lead={lead} haslo={haslo}
  wstecz={{ etykieta: T('Publikacje', 'Publications'), adres: '/nauka/publikacje' }} dzial="nauka" spis={spis} klasa="tresc z-pr">
  <Fragment slot="baner">
    {ten.pdf && (
      <p class="pr-akcje">
        <a class="pr-pdf" href={href(ten.pdf)}><Ikona nazwa="plik" rozmiar={18} />{T('Wykaz w PDF', 'List as PDF')}</a>
      </p>
    )}
    <LiczbyBanera lang={lang} pozycje={liczbyTelefon} />
  </Fragment>

  {grupy.map((g, k) => (
    <section id={g.pelny ? g.id : undefined} aria-labelledby={g.pelny ? `h-${g.id}` : undefined}>
      {k === 0 && (pochodzenie || uwagi) && (
        <div class="uwaga"><p>{pochodzenie}{pochodzenie && uwagi ? ' ' : ''}{uwagi}</p></div>
      )}
      {g.pelny && <h2 id={`h-${g.id}`}>{g.pelny}<span class="sr-only">, </span> <small>{g.prace.length}</small></h2>}
      <ol class="prace" start={g.start}>
        {g.prace.map((p) => (
          <li>
            {p.autorzy && <span class="a" set:html={tekstHtml(p.autorzy)} />}
            {p.tytul && <span class="t" set:html={tekstHtml(p.tytul)} />}
            {p.opis && <span class="o" set:html={tekstHtml(p.opis, true, lang)} />}
            {(p.zrodlo || p.doi || pokazIF(p)) && (
              <span class="z">
                {p.zrodlo && <span set:html={tekstHtml(p.zrodlo, true, lang)} />}
                {p.doi && <> <Link class="doi" href={doiUrl(p.doi)}>DOI: {p.doi}</Link></>}
                {pokazIF(p) && <> <abbr class="if" title="Impact Factor">IF {p.if}</abbr></>}
              </span>
            )}
            {p.uwagi && <span class="u">{p.uwagi}</span>}
          </li>
        ))}
      </ol>
    </section>
  ))}

  {(nowszy || starszy) && (
    <nav class="lata" aria-label={T('Inne lata', 'Other years')} data-pagefind-ignore>
      {starszy ? <a href={href(`/nauka/publikacje/${starszy.rok}`)}><small>{T('Starszy wykaz', 'Older list')}</small><span aria-hidden="true">← </span>{starszy.rok}</a> : <span />}
      {nowszy && <a class="nowszy" href={href(`/nauka/publikacje/${nowszy.rok}`)}><small>{T('Nowszy wykaz', 'Newer list')}</small>{nowszy.rok}<span aria-hidden="true"> →</span></a>}
    </nav>
  )}
</Podstrona>

<style>
  /* „Wykaz w PDF” w banerze (na ciemnym tle): przycisk-link z obwódką, bez zaokrągleń */
  .pr-akcje { margin: 14px 0 0; }
  .pr-pdf { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border: 1px solid rgb(255 255 255 / .4); color: #fff;
    font-size: 14.5px; font-weight: 600; text-decoration: none; }
  .pr-pdf:hover { border-color: #fff; background: rgb(255 255 255 / .1); }
  .pr-pdf:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  /* ramka uwagi nad listą */
  .uwaga { margin: 0 0 22px; }
  .uwaga p { font-size: 15.5px; line-height: 1.55; }
  h2 small { margin-left: 10px; font-family: var(--f-text); font-size: 14px; font-weight: 600; color: var(--muted); }

  /* lista prac: numer przygaszony z lewej, autorzy → tytuł → źródło; cienkie linie między pracami */
  .prace { margin: 0; padding: 0 0 0 3.2em; list-style: decimal; }
  .prace li { max-width: none; margin: 0; padding: 13px 0 13px 6px; border-bottom: 1px solid var(--line);
    font-size: 15.5px; line-height: 1.55; overflow-wrap: anywhere; }
  .prace li > span { display: block; }
  .prace li > span + span { margin-top: 2px; }
  .prace li:first-child { border-top: 1px solid var(--line); }
  .prace li::marker { color: var(--muted); font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .prace .a { font-size: 14px; color: var(--muted); }
  .prace .t { font-family: var(--f-display); font-weight: 500; font-size: 18px; line-height: 1.35; color: var(--ink); }
  .prace .o { color: var(--text); }
  .prace .z { font-size: 14.5px; color: var(--text); }
  .prace .u { font-size: 13px; color: var(--muted); }
  .prace .doi { white-space: nowrap; }
  .prace .if { font-size: 12.5px; font-weight: 700; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .prace :global(a) { overflow-wrap: anywhere; }
  .prace :global(.katex) { font-size: 1.05em; }

  /* starszy / nowszy wykaz (jak „Następna strona w dziale”) */
  .lata { display: flex; justify-content: space-between; gap: 24px; margin: 40px 0 0; padding-top: 16px; border-top: 1px solid var(--line); }
  .lata a { font-family: var(--f-display); font-size: 22px; line-height: 1.25; color: var(--ink); text-decoration: none; }
  .lata a:hover { color: var(--d-a); }
  .lata a.nowszy { text-align: right; }
  .lata small { display: block; font-family: var(--f-text); font-size: 12.5px; font-weight: 700; color: var(--d-a); }

  /* ---------- telefon (≤ 760 px) ---------- */
  @media (max-width: 760px) {
    .prace { padding-left: 2.6em; }
    .prace li { padding-left: 2px; font-size: 15px; }
    .prace .t { font-size: 17px; }
    .lata a { font-size: 20px; }
  }
</style>
