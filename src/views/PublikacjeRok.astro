---
// Wykaz prac z danego roku (src/data/publikacje/RRRR.json): numerowana lista, opcjonalnie w grupach (rodzaje prac).
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import SpisTresci from '../components/SpisTresci.astro';
import Ikona from '../components/Ikona.astro';
import { u, isExternal } from '../lib/url';
import { wJezyku, wybierz } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { lata, odmiana, tekstHtml, type Praca } from './publikacjeDane';

interface Props { rok: number; lang: Lang }
const { rok, lang } = Astro.props;
const en = lang === 'en';
const T = (pl: string, en_: string) => (en ? en_ : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));

const wszystkie = lata();
const ten = wszystkie.find((r) => r.rok === rok)!;
const w = ten.wykaz!;
const zWykazem = wszystkie.filter((r) => r.wykaz);
const i = zWykazem.findIndex((r) => r.rok === rok);
const nowszy = i > 0 ? zWykazem[i - 1] : undefined;
const starszy = i >= 0 && i < zWykazem.length - 1 ? zWykazem[i + 1] : undefined;

const tytul = `${T('Publikacje', 'Publications')} ${rok}`;
const n = ten.liczba;
const lead = en
  ? `List of works published in ${rok} — ${n} ${n === 1 ? 'entry' : 'entries'}.`
  : `Wykaz prac opublikowanych w roku ${rok} — ${n} ${odmiana(n, 'pozycja', 'pozycje', 'pozycji')}.`;

// Grupy (np. „Artykuły problemowe”); nagłówek z innym rokiem wydania: „Rok 2017: …”.
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ł/g, 'l').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
let start = 1;
const grupy = w.grupy.map((g, k) => {
  const nag = wybierz(g as any, 'naglowek', lang);
  const pelny = nag ? (g.rok_wydania && g.rok_wydania !== rok ? `${T('Rok', 'Year')} ${g.rok_wydania}: ${nag}` : nag) : '';
  const out = { ...g, pelny, id: pelny ? `${slug(pelny)}-${k + 1}` : '', start };
  start += g.prace.length;
  return out;
});
const naglowki = grupy.filter((g) => g.pelny).map((g) => ({ depth: 2, slug: g.id, text: g.pelny }));
const zSpisem = naglowki.length >= 2;
const uwagi = wybierz(w as any, 'uwagi', lang);
const pochodzenie = w.pochodzenie === 'pdf'
  ? T('Wersja tekstowa przygotowana na podstawie wykazu w pliku PDF. W razie rozbieżności rozstrzyga plik PDF.', 'Text version prepared from the PDF list. In case of discrepancies, the PDF prevails.')
  : w.pochodzenie === 'strona'
    ? T('Wykaz przeniesiony z poprzedniej strony internetowej Instytutu.', 'List transferred from the previous website of the Institute.')
    : '';
const doiUrl = (d: string) => `https://doi.org/${encodeURI(d)}`;
const pokazIF = (p: Praca) => p.if && !/^0([.,]0*)?$/.test(p.if.trim());
---
<Baza tytul={tytul} opis={lead}>
  <NaglowekStrony tytul={tytul} lead={lead} lang={lang} wstecz={{ etykieta: T('Publikacje', 'Publications'), adres: '/nauka/publikacje' }}>
    {ten.pdf && (
      <p class="pr-akcje">
        <a class="pr-pdf" href={href(ten.pdf)}><Ikona nazwa="plik" rozmiar={18} />{T('Wykaz w PDF', 'List as PDF')}</a>
      </p>
    )}
  </NaglowekStrony>
  <div class={`wrap ${zSpisem ? 'layout' : 'pr-wrap'}`}>
    <div class="main pr-main">
      {zSpisem && <SpisTresci naglowki={naglowki} lang={lang} wariant="gora" />}
      {(pochodzenie || uwagi) && (
        <p class="pr-nota">{pochodzenie}{pochodzenie && uwagi ? ' ' : ''}{uwagi}</p>
      )}
      {grupy.map((g) => (
        <section class="pr-grupa" aria-labelledby={g.id || undefined}>
          {g.pelny && <h2 id={g.id} class="pr-h">{g.pelny}<span class="pr-ile">{g.prace.length}</span></h2>}
          <ol class="pr-lista" start={g.start}>
            {g.prace.map((p) => (
              <li class="pr"><div class="pr-b">
                {p.autorzy && <span class="pr-a" set:html={tekstHtml(p.autorzy)} />}
                {p.tytul && <span class="pr-t" set:html={tekstHtml(p.tytul)} />}
                {p.opis && <span class="pr-o" set:html={tekstHtml(p.opis, true)} />}
                {(p.zrodlo || p.doi || pokazIF(p)) && (
                  <span class="pr-z">
                    {p.zrodlo && <span set:html={tekstHtml(p.zrodlo, true)} />}
                    {p.doi && <> <a class="pr-doi" href={doiUrl(p.doi)}>DOI: {p.doi}</a></>}
                    {pokazIF(p) && <> <span class="pr-if" title="Impact Factor">IF {p.if}</span></>}
                  </span>
                )}
                {p.uwagi && <span class="pr-u">{p.uwagi}</span>}
              </div></li>
            ))}
          </ol>
        </section>
      ))}

      {(nowszy || starszy) && (
        <nav class="pr-nav" aria-label={T('Inne lata', 'Other years')} data-pagefind-ignore>
          {starszy ? <a class="pr-nav-a" href={href(`/nauka/publikacje/${starszy.rok}`)}><Ikona nazwa="wstecz" rozmiar={16} /><span><small>{T('Starszy wykaz', 'Older list')}</small>{starszy.rok}</span></a> : <span />}
          {nowszy && <a class="pr-nav-a pr-nav-n" href={href(`/nauka/publikacje/${nowszy.rok}`)}><span><small>{T('Nowszy wykaz', 'Newer list')}</small>{nowszy.rok}</span><Ikona nazwa="strzalka" rozmiar={16} /></a>}
        </nav>
      )}
    </div>
    {zSpisem && (
      <aside class="side" data-pagefind-ignore>
        <SpisTresci naglowki={naglowki} lang={lang} wariant="bok" />
      </aside>
    )}
  </div>
</Baza>

<style>
  .pr-akcje { margin: 4px 0 0; }
  .pr-pdf { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--bg); font-size: 15px; font-weight: 800; color: var(--ink); text-decoration: none; }
  .pr-pdf:hover { border-color: var(--ink); color: var(--ink); }
  .pr-wrap { padding-top: clamp(24px, 4vw, 40px); padding-bottom: clamp(40px, 6vw, 72px); }
  .pr-main { max-width: 880px; }
  .pr-nota { margin: 0 0 8px; padding: 12px 16px; border-radius: var(--radius); background: var(--surface); font-size: 14px; line-height: 1.55; color: var(--muted); }
  .pr-grupa + .pr-grupa { margin-top: 12px; }
  .pr-h { margin: 28px 0 4px; font-size: 20px; font-weight: 800; line-height: 1.3; scroll-margin-top: 16px; }
  .pr-ile { display: inline-flex; align-items: center; justify-content: center; min-width: 26px; height: 22px; margin-left: 10px; padding: 0 8px; border-radius: 999px; background: var(--surface); color: var(--muted); font-size: 12px; font-weight: 800; vertical-align: 3px; }

  /* Lista prac: numer w lewej kolumnie, autorzy → tytuł → źródło. */
  .pr-lista { list-style: decimal; margin: 0; padding: 0 0 0 3.4em; }
  .pr { padding: 14px 0 14px 6px; border-top: 1px solid var(--line); line-height: 1.5; overflow-wrap: anywhere; }
  .pr-lista > .pr:first-child { border-top: 0; }
  .pr::marker { color: var(--muted); font-size: 14px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .pr-b { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .pr-a { font-size: 14px; color: var(--muted); }
  .pr-t { font-size: 16px; font-weight: 700; color: var(--ink); }
  .pr-o { font-size: 15px; color: var(--text); }
  .pr-z { font-size: 14px; color: var(--text); }
  .pr-u { font-size: 13px; color: var(--muted); }
  .pr-if { display: inline-flex; align-items: center; padding: 0 8px; border-radius: 999px; background: var(--tint); color: var(--tint-ink); font-size: 12px; font-weight: 800; white-space: nowrap; }
  .pr-doi { white-space: nowrap; }
  .pr :global(a) { overflow-wrap: anywhere; }
  .pr :global(.katex) { font-size: 1.05em; }

  .pr-nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--line); }
  .pr-nav-a { display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 6px 16px; border-radius: var(--radius); border: 1px solid var(--line); text-decoration: none; color: var(--ink); font-weight: 800; font-size: 18px; }
  .pr-nav-a:hover { border-color: var(--ink); color: var(--ink); }
  .pr-nav-a span { display: flex; flex-direction: column; line-height: 1.2; }
  .pr-nav-n span { align-items: flex-end; }
  .pr-nav-a small { font-size: 12px; font-weight: 700; color: var(--muted); }
  @media (max-width: 520px) { .pr-lista { padding-left: 2.8em; } .pr { padding-left: 2px; } .pr-t { font-size: 15.5px; } }
</style>

