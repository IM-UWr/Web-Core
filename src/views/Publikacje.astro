---
// Publikacje (/nauka/publikacje), kierunek „Założyciele”, szablon podstrony zal/Podstrona.astro: wykazy prac według lat
// (rok → podstrona z listą w HTML, PDF-y) i czasopisma redagowane w Instytucie. Spis „Na tej stronie”: obie sekcje.
// Treść: src/data/publikacje.json (CMS) i src/data/publikacje/RRRR.json (wykazy). Liczby liczą się z wykazów.
// Tekst wprowadzający pod banerem (src/data/dzialy/nauka.json, pola publikacje_tekst / _en; puste = brak), krótki tekst
// o czasopismach na początku ich sekcji (pola czasopisma_tekst / _en; puste = brak; bez czasopism nie ma też tekstu).
// Baner (bez zmian): hasło (nauka.json: publikacje_haslo / _en) i liczby w jednej liście .pt-liczby — na telefonie
// pokazywała się już ta sama lista (zal-telefon.css), więc dawnej listy telefonu (LiczbyBanera, liczbyTelefon) nie ma.
// Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css, klasa .tresc): sekcje h2, czasopisma jako podsekcje h3
// z parami dl.para, akapit .wst. Własne style (na końcu pliku): siatka lat z cienkimi liniami (bez kart).
// Jedna wersja HTML: komputer (≥ 761 px) i telefon (≤ 760 px).
import Link from '../components/Link.astro';
import Podstrona from '../components/zal/Podstrona.astro';
import Ikona from '../components/Ikona.astro';
import dzialNauka from '../data/dzialy/nauka.json';
import { u, isExternal } from '../lib/url';
import { wJezyku, wybierz } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { danePublikacji, odmiana } from '../lib/widoki/publikacje';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const T = (pl: string, en_: string) => (en ? en_ : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
const nPozycji = (n: number) => (en ? (n === 1 ? 'entry' : 'entries') : odmiana(n, 'pozycja', 'pozycje', 'pozycji'));
// teksty z CMS (jak dotychczasowy TekstWstepny.astro): akapity oddzielone pustą linią
const akapity = (pole: string) => ((wybierz(dzialNauka as Record<string, any>, pole, lang) as string) || '')
  .split(/\n\s*\n/).map((a) => a.trim()).filter(Boolean);

const { tytul, lead, wszystkie, najnowszy, czasopisma, liczby, haslo, nagCzasopisma, archiwum } = await danePublikacji(lang);
const wstep = akapity('publikacje_tekst');
const oCzasopismach = czasopisma.length > 0 ? akapity('czasopisma_tekst') : [];
const tytulWykazow = T('Wykazy prac według lat', 'Lists of publications by year');
const spis = [
  { id: 'wykazy', etykieta: tytulWykazow, krotka: T('Wykazy prac', 'Lists by year') },
  ...(czasopisma.length > 0 ? [{ id: 'czasopisma', etykieta: nagCzasopisma, krotka: T('Czasopisma', 'Journals') }] : []),
];
---
<Podstrona lang={lang} tytul={tytul} opis={lead} uklad="zwarta portal-baner" lead={lead} haslo={haslo}
  wstecz={{ etykieta: T('Nauka', 'Research'), adres: '/nauka' }} dzial="nauka" spis={spis} klasa="tresc z-pub">
  <Fragment slot="baner">
    {liczby.length > 0 && (
      <ul class="pt-liczby">
        {liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}
      </ul>
    )}
  </Fragment>

  {wstep.length > 0 && <section>{wstep.map((a, i) => <p class={i === 0 ? 'wst' : undefined}>{a}</p>)}</section>}

  <section id="wykazy" aria-labelledby="h-wykazy">
    <h2 id="h-wykazy">{tytulWykazow}</h2>
    <p>{T(
      'Wybierz rok, aby zobaczyć listę prac. Pliki PDF to wykazy w oryginalnej postaci.',
      'Choose a year to see the list of works. The PDF files are the lists in their original form.',
    )}</p>
    <ol class="lata" role="list">
      {wszystkie.map((r) => {
        const cel = r.wykaz ? href(`/nauka/publikacje/${r.rok}`) : r.pdf ? href(r.pdf) : undefined;
        const uwaga = wybierz(r as any, 'uwagi', lang);
        return (
          <li>
            <p class="rok">{cel ? <a href={cel}>{r.rok}</a> : r.rok}</p>
            <p class="ile">
              {r.wykaz ? `${r.liczba} ${nPozycji(r.liczba)}` : r.pdf ? T('wykaz w PDF', 'PDF list') : ''}
              {r.rok === najnowszy && <span class="nowy">{T('najnowszy', 'latest')}</span>}
            </p>
            {uwaga && <p class="uw">{uwaga}</p>}
            {r.wykaz && r.pdf && (
              <a class="pdf" href={href(r.pdf)} aria-label={T(`Wykaz ${r.rok} — PDF`, `List ${r.rok} — PDF`)}><Ikona nazwa="plik" rozmiar={15} />PDF</a>
            )}
          </li>
        );
      })}
    </ol>
  </section>

  {czasopisma.length > 0 && (
    <section id="czasopisma" aria-labelledby="h-czasopisma">
      <h2 id="h-czasopisma">{nagCzasopisma}</h2>
      {oCzasopismach.map((a) => <p>{a}</p>)}
      {czasopisma.map((c) => {
        const opis = wybierz(c as any, 'opis', lang);
        const wydawca = wybierz(c as any, 'wydawca', lang);
        const redakcja = wybierz(c as any, 'redakcja', lang);
        const wsparcie = wybierz(c as any, 'wsparcie', lang);
        const issn = [c.issn && `${c.issn}${c.eissn ? T(' (druk)', ' (print)') : ''}`, c.eissn && `${c.eissn} (online)`].filter(Boolean).join(' · ');
        return (
          <div class="czas">
            <h3>{c.nazwa}</h3>
            {opis && <p class="cz-o">{opis}</p>}
            {(wydawca || wsparcie || redakcja || issn || c.kontakt) && (
              <dl class="para">
                {wydawca && <><dt>{T('Wydawca', 'Publisher')}</dt><dd>{wydawca}</dd></>}
                {wsparcie && <><dt>{T('Wsparcie', 'Sponsored by')}</dt><dd>{wsparcie}</dd></>}
                {redakcja && <><dt>{T('Redakcja', 'Editorial office')}</dt><dd>{redakcja}</dd></>}
                {c.kontakt && <><dt>{T('Kontakt', 'Contact')}</dt><dd><a href={`mailto:${c.kontakt}`}>{c.kontakt}</a></dd></>}
                {issn && <><dt>ISSN</dt><dd>{issn}</dd></>}
              </dl>
            )}
            {c.adres && <p class="cz-link"><Link href={href(c.adres)}>{T('Strona czasopisma', 'Journal website')}</Link></p>}
          </div>
        );
      })}
      {archiwum && <p class="arch">{archiwum}</p>}
    </section>
  )}
</Podstrona>

<style>
  /* Lata: siatka z cienkimi liniami (kreska nad każdym rokiem), rok Brygadą — odnośnik do wykazu, pod nim liczba pozycji
     i PDF. Reszta — wzorzec treści .tresc (src/styles/zal-tresc.css). */
  .lata { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 32px; margin: 18px 0 0; padding: 0; list-style: none; }
  .lata li { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 10px; max-width: none; margin: 0; padding: 10px 0 12px;
    border-top: 1px solid var(--line); font-size: inherit; }
  .lata p { margin: 0; max-width: none; }
  .rok { flex: 1 1 auto; font-family: var(--f-display); font-weight: 500; font-size: 28px; line-height: 1.15; color: var(--ink); font-variant-numeric: tabular-nums; }
  .rok a { color: inherit; text-decoration: none; }
  .rok a:hover { color: var(--d-a); }
  .ile { order: 3; flex-basis: 100%; font-size: 14px; line-height: 1.5; color: var(--muted); }
  .nowy { margin-left: 8px; font-size: 12.5px; font-weight: 700; color: var(--d-a); }
  .uw { order: 4; flex-basis: 100%; font-size: 13px; line-height: 1.45; color: var(--muted); }
  /* „PDF” jako przycisk-link (zlecenie 11, zalecenie 4): ramka 1 px, bez zaokrągleń, 14 px; po najechaniu ramka i tekst w kolorze */
  .lata .pdf { order: 2; align-self: center; display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border: 1px solid var(--line-ui);
    font-size: 14px; font-weight: 600; line-height: 1.5; color: var(--ink); text-decoration: none; transition: border-color var(--t-krotki) var(--rytm), color var(--t-krotki) var(--rytm); }
  .lata .pdf:hover { border-color: var(--d-a); color: var(--d-a); }
  .lata .pdf:focus-visible { outline: 2px solid var(--d-a); outline-offset: 2px; }
  .lata .pdf :global(svg) { color: var(--d-a); }
  @media (prefers-reduced-motion: reduce) { .lata .pdf { transition: none; } }
  /* czasopisma: podsekcje h3 (wzorzec), opis i pary etykieta–wartość */
  .cz-o { font-size: 15.5px; line-height: 1.55; }
  .czas dl { margin-top: 10px; }
  .cz-link { margin: 10px 0 0; font-weight: 600; }
  .arch { margin: 30px 0 0; font-size: 15.5px; color: var(--muted); }

  /* ---------- telefon (≤ 760 px): trzy kolumny lat ---------- */
  @media (max-width: 760px) {
    .lata { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 14px; }
    .rok { font-size: 23px; }
    .ile { font-size: 13px; }
    .nowy { display: block; margin: 0; }
  }
</style>
