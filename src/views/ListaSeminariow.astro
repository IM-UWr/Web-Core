---
// Lista seminariów z najbliższym referatem.
// Każdy zakład ma swoje seminarium (pole „zaklad”); seminarium bez zakładu (pole puste albo zakład,
// którego nie ma na stronie) to seminarium niezależne — pokazuje się w osobnej grupie.
// Między najbliższymi seminariami a grupami — tekst wprowadzający z CMS (TekstWstepny: src/data/dzialy/nauka.json,
// pola seminaria_tekst / _en; akapity oddzielone pustą linią, puste pole = bez tekstu). Sekcje jak na stronach działów: .zsec z tytułem h2
// (kreska sekcji, odstępy i rozmiar tytułu z global.css, tlo.css, telefon.css i uklad-zwarta.css).
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal”, reszta strony jak w wariancie „Zwarta”
// (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok na końcu pliku).
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import TabelaReferatow from '../components/TabelaReferatow.astro';
import TytulReferatu from '../components/TytulReferatu.astro';
import TekstWstepny from '../components/TekstWstepny.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import dzial from '../data/dzialy/nauka.json';
import { wPrzyszlosci, ETYKIETY } from '../lib/liczbyTerminow';
import { u } from '../lib/url';
import { t, wJezyku, wybierz } from '../lib/i18n';
import { long, now, today, hasTime, type Lang } from '../lib/daty';
import { seminaria, referaty, zaklady, seminariumReferatu, referatyWTygodniu, tydzienSeminariow, sala } from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const sem = await seminaria();
const ref = await referaty();
const zak = await zaklady();
const n = now();
const nastepny = (id: string) =>
  ref.find((r) => seminariumReferatu(r) === id && (hasTime(r.data.termin) ? r.data.termin >= n : r.data.termin >= today()));
// zakłady seminarium (tylko te, które są na stronie), w kolejności zakładów
const zakladySem = (s: (typeof sem)[number]) => zak.filter((z) => s.data.zaklad.includes(z.id));
const kolejnosc = (s: (typeof sem)[number]) => zakladySem(s)[0]?.data.kolejnosc ?? Infinity;
const aktywne = sem.filter((s) => s.data.aktywne);
const nieaktywne = sem.filter((s) => !s.data.aktywne);
const zakladowe = aktywne.filter((s) => zakladySem(s).length > 0).sort((a, b) => kolejnosc(a) - kolejnosc(b));
const niezalezne = aktywne.filter((s) => zakladySem(s).length === 0);
const grupy = [
  { id: 'h-zakladow', tytul: T('Seminaria zakładów', 'Department seminars'), lista: zakladowe },
  { id: 'h-niezalezne', tytul: T('Seminaria niezależne', 'Independent seminars'), lista: niezalezne },
].filter((g) => g.lista.length > 0);
const tydzien = tydzienSeminariow();
const wTygodniu = await referatyWTygodniu(lang);
const nazwa = (s: (typeof sem)[number]) => (lang === 'en' && s.data.nazwa_en) || s.data.nazwa;
const lead = lang === 'en'
  ? 'Research seminars of the Mathematical Institute. Everyone is welcome.'
  : 'Seminaria naukowe Instytutu Matematycznego. Zapraszamy wszystkich zainteresowanych.';
// Telefon (≤ 760 px; zlecenie 01, decyzja 31.10.2026): hasło zamiast opisu (src/data/dzialy/nauka.json, seminaria_haslo / _en)
// i trzy liczby pod kreską: seminaria (aktywne, jak karty niżej) · zapowiedziane referaty (wszystkich seminariów, definicja
// wspólna z Kalendarzem — src/lib/liczbyTerminow.ts) · referaty w archiwum (minione referaty opublikowanych seminariów).
const haslo = ((dzial as Record<string, any>)[lang === 'en' ? 'seminaria_haslo_en' : 'seminaria_haslo'] as string | undefined) || undefined;
const idSem = new Set(sem.map((s) => s.id));
const refSem = ref.filter((r) => idSem.has(seminariumReferatu(r)));
const zapowiedziane = refSem.filter((r) => wPrzyszlosci(r.data.termin)).length;
const liczby = [
  { n: aktywne.length, pl: ['seminarium', 'seminaria', 'seminariów'] as [string, string, string], en: ['seminar', 'seminars'] as [string, string] },
  { n: zapowiedziane, ...ETYKIETY.referaty },
  { n: refSem.length - zapowiedziane, ...ETYKIETY.archiwum },
];
---
<Baza tytul={t(lang, 'seminaria')} opis={lead} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={t(lang, 'seminaria')} lead={lead} haslo={haslo} lang={lang} wstecz={{ etykieta: lang === 'en' ? 'Research' : 'Nauka', adres: '/nauka' }}>
    <LiczbyBanera lang={lang} pozycje={liczby} />
  </NaglowekStrony>
  <div class="wrap ls-wrap">
    <section class="zsec ls-pierwsza" aria-labelledby="h-tydzien">
      <h2 id="h-tydzien">{t(lang, tydzien.przyszly ? 'seminariaPrzyszly' : 'seminariaTydzien')}</h2>
      <div class="ls-ramka">
        <TabelaReferatow wiersze={wTygodniu} lang={lang} etykieta={t(lang, 'seminariaTydzien')} pusty={t(lang, tydzien.przyszly ? 'brakReferatowPrzyszly' : 'brakReferatow')} />
      </div>
    </section>

    <TekstWstepny pole="seminaria_tekst" lang={lang} />

    {grupy.map((g) => (
      <section class="zsec" aria-labelledby={g.id}>
        <h2 id={g.id}>{g.tytul}</h2>
        <div class="sem-cards">
          {g.lista.map((s) => {
            const r = nastepny(s.id);
            const zs = zakladySem(s);
            return (
              <a class="sem-card" href={u(wJezyku(`/seminaria/${s.id}`, lang))}>
                {zs.length > 0 && <span class="muted ls-zaklad">{zs.map((z) => wybierz(z.data, 'nazwa', lang)).join(' · ')}</span>}
                <span class="t">{nazwa(s)}</span>
                {r ? (
                  <span class="ls-ref">
                    <strong>{long(r.data.termin, lang)}{r.data.sala && `, ${sala(r.data.sala, lang)}`}</strong> — <TytulReferatu tekst={r.data.tytul} /> <span class="muted">({r.data.prelegent})</span>
                  </span>
                ) : (
                  <span class="muted ls-ref ls-brak">{t(lang, 'brakNadchodzacych')}</span>
                )}
              </a>
            );
          })}
        </div>
      </section>
    ))}

    {nieaktywne.length > 0 && (
      <section class="zsec" aria-labelledby="h-nieaktywne">
        <h2 id="h-nieaktywne">{T('Pozostałe seminaria', 'Other seminars')}</h2>
        <ul>
          {nieaktywne.map((s) => <li><a href={u(wJezyku(`/seminaria/${s.id}`, lang))}>{nazwa(s)}</a></li>)}
        </ul>
      </section>
    )}
  </div>
</Baza>

<style>
  /* sekcje .zsec jak na stronach działów (odstępy między nimi — margines .zsec); odstępy kontenera jak .dz-wrap */
  .ls-wrap { padding-top: 32px; padding-bottom: 64px; }
  .ls-ramka { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  /* „Najbliższe seminaria” zaraz pod banerem — bez kreski sekcji nad nagłówkiem (komputer i telefon) */
  .zsec.ls-pierwsza { border-top: 0; padding-top: 0; }
  .zsec.ls-pierwsza::before, .zsec.ls-pierwsza > h2::before { display: none; }
  /* karta seminarium: zakład nad nazwą, pod kreską najbliższy referat albo „brak” */
  .ls-zaklad { font-size: 14px; font-weight: 600; }
  .ls-ref { font-size: 15px; padding-top: 10px; border-top: 1px solid var(--line); }
  .ls-ref strong { color: var(--ink); }
  .ls-brak { font-size: 14px; }

  /* komputer (≥ 761 px), wariant „Zwarta”: odstęp od stopki jak na innych podstronach (uklad-zwarta.css); nad pierwszą
     sekcją stały odstęp 24 px, jak na stronie działu „Nauka” */
  @media (min-width: 761px) { .ls-wrap { padding-top: 24px; padding-bottom: var(--tresc-dol); } }
  /* telefon (≤ 760 px): odstępy jak na stronach działów (wygląd „Portal”) */
  @media (max-width: 760px) {
    .ls-wrap { padding-top: 4px; padding-bottom: 36px; }
  }
</style>
