---
// Lista seminariów (/seminaria), kierunek „Założyciele”, szablon podstrony zal/Podstrona.astro (spis „Na tej stronie” z prawej,
// na telefonie zwijany nad treścią). Jedna wersja HTML: komputer (≥ 761 px) i telefon (≤ 760 px) — style na końcu pliku.
// Sekcje: najbliższe referaty (tydzień albo przyszły tydzień), tekst wprowadzający z CMS (src/data/dzialy/nauka.json,
// pola seminaria_tekst / _en; akapity oddzielone pustą linią, puste pole = bez tekstu), seminaria zakładów i niezależne
// z najbliższym referatem (siatka boksów ul.boksy, zlecenie 17, punkt 6), pozostałe (nieaktywne) seminaria. Każdy zakład ma swoje seminarium (pole „zaklad”); seminarium
// bez zakładu (pole puste albo zakład, którego nie ma na stronie) to seminarium niezależne.
// Wiersze z jednym wzorem daty (jak zal/dzial/Wiersz.astro): dzień dużą Brygadą w kolorze działu, pod nim „mie rrrr”.
// Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css, klasa .tresc): sekcje h2 z kreską między nimi,
// etykieta .etyk, pierwszy akapit .wst, lista linków ul.linki. Własne style (na końcu pliku) tylko dla wierszy z datą.
import Podstrona from '../components/zal/Podstrona.astro';
import TytulReferatu from '../components/TytulReferatu.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import dzialNauka from '../data/dzialy/nauka.json';
import { u } from '../lib/url';
import { t, wJezyku, wybierz, langPola, odmiana } from '../lib/i18n';
import { dayNum, dayShort, monthShort, parse, time, type Lang } from '../lib/daty';
import { sala, salaReferatu, type Seminarium } from '../lib/tresci';
import { daneListySeminariow } from '../lib/widoki/listaSeminariow';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const nazwa = (s: Seminarium) => (lang === 'en' && s.data.nazwa_en) || s.data.nazwa;
const { nastepny, zakladySem, nieaktywne, grupy, tydzien, wTygodniu, lead, haslo, liczby } = await daneListySeminariow(lang);
// tekst wprowadzający z CMS (jak dotychczasowy TekstWstepny.astro)
const wstep = ((wybierz(dzialNauka as Record<string, any>, 'seminaria_tekst', lang) as string) || '')
  .split(/\n\s*\n/).map((a) => a.trim()).filter(Boolean);
const tytulTygodnia = t(lang, tydzien.przyszly ? 'seminariaPrzyszly' : 'seminariaTydzien');
// sekcje strony (id w treści) — spis „Na tej stronie”
const idGrupy = (id: string) => id.replace(/^h-/, 'z-');
const spis = [
  { id: 'z-tydzien', etykieta: tytulTygodnia },
  ...grupy.map((g) => ({ id: idGrupy(g.id), etykieta: g.tytul })),
  ...(nieaktywne.length > 0 ? [{ id: 'z-nieaktywne', etykieta: T('Pozostałe seminaria', 'Other seminars') }] : []),
];
// część wiersza: godzina i sala (puste pomijane)
const kiedyGdzie = (termin: string, s?: string) => [time(termin), sala(s, lang) ?? ''].filter(Boolean).join(' · ');
// prowadzący w boksie: do dwóch nazwisk, przy większej liczbie „i N innych” (cały skład jest na stronie seminarium)
const osoby = (l: string[]) => l.length <= 2
  ? l.join(', ')
  : `${l.slice(0, 2).join(', ')} ${T('i', 'and')} ${l.length - 2} ${odmiana(l.length - 2, ['inna osoba', 'inne osoby', 'innych osób'], ['other', 'others'], lang)}`;
---
<Podstrona lang={lang} tytul={t(lang, 'seminaria')} opis={lead} uklad="zwarta portal-baner" lead={lead} haslo={haslo}
  wstecz={{ etykieta: T('Nauka', 'Research'), adres: '/nauka' }} dzial="nauka" spis={spis} klasa="tresc z-sem">
  <Fragment slot="baner"><LiczbyBanera lang={lang} pozycje={liczby} /></Fragment>

  <section id="z-tydzien" aria-labelledby="h-tydzien">
    <h2 id="h-tydzien">{tytulTygodnia}</h2>
    {wTygodniu.length === 0 && <p class="pusto">{t(lang, tydzien.przyszly ? 'brakReferatowPrzyszly' : 'brakReferatow')}</p>}
    {wTygodniu.length > 0 && (
      <ul class="wiersze">
        {wTygodniu.map((w) => (
          <li class="wiersz klik">
            <time class="dz" datetime={w.termin.slice(0, 10)}>{dayNum(w.termin)}<small> {monthShort(w.termin, lang)} {parse(w.termin).y}</small></time>
            <div>
              <p class="etyk">{[dayShort(w.termin, lang), kiedyGdzie(w.termin, w.sala)].filter(Boolean).join(' · ')}</p>
              <h3><a href={u(wJezyku(w.href, lang))}><TytulReferatu tekst={w.tytul} jezyk={w.jezyk} lang={lang} /></a></h3>
              <p class="kto">{w.prelegent}<span class="sem"> · {w.seminarium}</span></p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  {wstep.length > 0 && <section>{wstep.map((a, i) => <p class={i === 0 ? 'wst' : undefined}>{a}</p>)}</section>}

  {grupy.map((g) => (
    <section id={idGrupy(g.id)} aria-labelledby={g.id}>
      <h2 id={g.id}>{g.tytul}</h2>
      <div class="boksy-ramka">
        <ul class="boksy">
          {g.lista.map((s) => {
            const r = nastepny(s.id);
            const zs = zakladySem(s);
            const hasloSem = (lang === 'en' ? s.data.haslo_en : s.data.haslo)?.trim();
            const prow = s.data.prowadzacy.map((p) => p.trim()).filter(Boolean);
            return (
              <li class="boks">
                {zs.length > 0 && <p class="etyk">{zs.map((z) => wybierz(z.data, 'nazwa', lang)).join(' · ')}</p>}
                <h3 lang={langPola(s.data, 'nazwa', lang)}><a href={u(wJezyku(`/seminaria/${s.id}`, lang))}>{nazwa(s)}</a></h3>
                {hasloSem && <p class="haslo">{hasloSem}</p>}
                {r ? (
                  <div class="b-ref">
                    <time class="dz" datetime={r.data.termin.slice(0, 10)}>{dayNum(r.data.termin)}<small> {monthShort(r.data.termin, lang)} {parse(r.data.termin).y}</small></time>
                    <p>
                      {kiedyGdzie(r.data.termin, salaReferatu(r.data, lang)) && <span class="kiedy">{kiedyGdzie(r.data.termin, salaReferatu(r.data, lang))}</span>}
                      <TytulReferatu tekst={r.data.tytul} jezyk={r.data.jezyk} lang={lang} /> <span class="kto">({r.data.prelegent})</span>
                    </p>
                  </div>
                ) : (
                  <p class="b-brak pusto">{t(lang, 'brakNadchodzacych')}</p>
                )}
                {prow.length > 0 && <dl class="para"><dt>{prow.length > 1 ? T('Prowadzą', 'Led by') : T('Prowadzi', 'Led by')}</dt><dd>{osoby(prow)}</dd></dl>}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ))}

  {nieaktywne.length > 0 && (
    <section id="z-nieaktywne" aria-labelledby="h-nieaktywne">
      <h2 id="h-nieaktywne">{T('Pozostałe seminaria', 'Other seminars')}</h2>
      <ul class="linki">
        {nieaktywne.map((s) => <li lang={langPola(s.data, 'nazwa', lang)}><a href={u(wJezyku(`/seminaria/${s.id}`, lang))}>{nazwa(s)}</a></li>)}
      </ul>
    </section>
  )}
</Podstrona>

<style>
  /* Wiersze z datą (jak zal/dzial/Wiersz.astro): dzień | etykieta, tytuł, prelegent albo najbliższy referat. Reszta
     (sekcje, etykieta .etyk, akapity, ul.linki) — wzorzec treści .tresc (src/styles/zal-tresc.css). */
  .wiersze { list-style: none; margin: 0; padding: 0; }
  .wiersze > li { max-width: none; margin: 0; font-size: inherit; }
  .wiersz { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .wiersz .dz { font-family: var(--f-display); font-size: 34px; line-height: 1; color: var(--d-a); }
  .wiersz .dz small { display: block; margin-top: 4px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  .wiersz p { margin: 0; max-width: none; }
  .wiersz h3 { margin: 2px 0 4px; font-family: var(--f-display); font-weight: 500; font-size: 21px; line-height: 1.3; color: var(--ink); }
  .wiersz h3 a { color: inherit; text-decoration: none; }
  .wiersz .kto { font-size: 15.5px; line-height: 1.55; color: var(--text); }
  .wiersz .sem { color: var(--muted); }
  .pusto { font-style: italic; color: var(--muted); }
  /* cały wiersz klikalny (link w tytule), fokus na całym wierszu */
  .klik { position: relative; }
  .klik h3 a::before { content: ''; position: absolute; inset: 0; } /* nakładka na ::before — ::after to strzałka ↗ linku poza stronę */
  .klik:hover h3 a { color: var(--d-a); }
  .klik h3 a:focus-visible { outline: none; }
  .klik:has(h3 a:focus-visible) { outline: 3px solid var(--d-a); outline-offset: 4px; border-radius: 2px; }

  /* najbliższy referat w boksie seminarium (siatka: src/styles/zal-tresc.css): dzień jak w wierszach, mniejszy, jak na telefonie */
  .b-ref { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 12px; margin-top: 6px; }
  .b-ref .dz { font-family: var(--f-display); font-size: 28px; line-height: 1; color: var(--d-a); }
  .b-ref .dz small { display: block; margin-top: 4px; font-family: var(--f-text); font-size: 12.5px; font-weight: 600; color: var(--muted); white-space: nowrap; }
  .b-ref p { line-height: 1.5; color: var(--text); }
  .b-ref .kiedy { display: block; font-size: 13.5px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
  .b-ref .kto { color: var(--muted); }
  .b-brak { margin-top: 6px !important; }

  /* ---------- telefon (≤ 760 px): jedna kolumna, mniejszy dzień ---------- */
  @media (max-width: 760px) {
    .wiersz { grid-template-columns: 54px minmax(0, 1fr); gap: 12px; padding: 13px 0; }
    .wiersz .dz { font-size: 28px; }
    .wiersz .dz small { font-size: 12.5px; white-space: nowrap; }
    .wiersz h3 { font-size: 18.5px; }
    .wiersz .kto { font-size: 15px; }
  }
</style>
