---
// Plan zajęć Instytutu: /studia/plan-zajec (EN: /en/studia/plan-zajec), kierunek „Założyciele” (prototyp: trescPlan).
// Wszystkie przedmioty semestru w kategoriach (O, L, M, E, S, H, N, NP, pozostałe), przy przedmiocie zajęcia: typ, grupa,
// prowadzący, dzień, godziny, sala, uwagi. Przyklejony pasek: semestr, wyszukiwarka (przedmiot, prowadzący, sala, uwagi;
// także bez polskich znaków) i filtr dni. Semestr wg daty albo adresu #zimowy / #letni; bez JS pasek schowany, oba semestry
// jeden pod drugim. Dane: src/data/plan/plan.json — pobierane automatycznie z USOS (skrypty/plan/pobierz_plan.py,
// workflow .github/workflows/plan-zajec.yml). Danych nie edytuje się ręcznie.
// Jedna wersja HTML: komputer — zajęcia w równych kolumnach; telefon (≤ 760 px) — przedmiot jako blok, zajęcia w dwóch
// liniach, pasek w dwóch rzędach, spis kategorii zwijany nad planem (src/styles/zal-granty-plan.css, zal-podstrona.css).
import Podstrona from '../components/zal/Podstrona.astro';
import Link from '../components/Link.astro';
import type { Lang } from '../lib/daty';
import { danePlanuZajec } from '../lib/widoki/planZajec';
import '../styles/zal-granty-plan.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const { haslo, typPelny, typKrotki, salaW, grupa, semestry, wiele, aktywny, liczby, idKategorii, spisKomputer } = await danePlanuZajec(lang);

const T = en
  ? {
      tytul: 'Timetable',
      lead: 'Timetable of the Mathematical Institute, updated automatically from USOS.',
      dni: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      kol: { gr: 'gr.', typ: 'type', prow: 'teacher', dzien: 'day', godz: 'time', sala: 'room', uwagi: 'notes' },
      gr: 'gr.', sala: 'room',
      aktualizacja: 'Last update of the data',
      uwagiOgolne: ['Click a course name to see its description in USOS.', 'Groups 99 are intended for students repeating a course who have already passed its classes.'],
      brak: 'The timetable has not been downloaded from USOS yet.',
      brakSem: 'The timetable for this semester is not available in USOS yet.',
      czest: { nieparzyste: 'odd weeks', parzyste: 'even weeks', co_dwa_tygodnie: 'every two weeks', co_miesiac: 'once a month', raz: 'once', inna: 'other frequency' } as Record<string, string>,
      zrodlo: 'Data source: USOS, University of Wrocław.',
    }
  : {
      tytul: 'Plan zajęć',
      lead: 'Plan zajęć Instytutu Matematycznego, aktualizowany automatycznie z USOS.',
      dni: ['poniedziałek', 'wtorek', 'środa', 'czwartek', 'piątek', 'sobota', 'niedziela'],
      kol: { gr: 'gr.', typ: 'typ', prow: 'prowadzący', dzien: 'dzień', godz: 'godziny', sala: 'sala', uwagi: 'uwagi' },
      gr: 'gr.', sala: 'sala',
      aktualizacja: 'Data ostatniej aktualizacji danych',
      uwagiOgolne: ['Kliknij nazwę przedmiotu, by zobaczyć opis w USOSie.', 'Grupy 99 przeznaczone są dla powtarzających przedmiot mających zaliczenia ćwiczeń.'],
      brak: 'Plan zajęć nie został jeszcze pobrany z USOS.',
      brakSem: 'Plan na ten semestr nie jest jeszcze dostępny w USOS.',
      czest: { nieparzyste: 'tyg. nieparzyste', parzyste: 'tyg. parzyste', co_dwa_tygodnie: 'co dwa tygodnie', co_miesiac: 'raz w miesiącu', raz: 'jednorazowo', inna: 'inna częstotliwość' } as Record<string, string>,
      zrodlo: 'Źródło danych: USOS Uniwersytetu Wrocławskiego.',
    };

// Skróty dni w kolumnie „dzień” i w filtrze dni (pon.–pt.), tekst do wyszukiwania.
const DNI_KROTKO = en ? ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] : ['pon.', 'wt.', 'śr.', 'czw.', 'pt.', 'sob.', 'niedz.'];
const tekstUwag = (u?: (string | { t: string })[]) => (u || []).map((f) => (typeof f === 'string' ? f : f.t)).join('');
const doSzukania = (...cz: string[]) => cz.join(' ').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ł/g, 'l');
// sekcja kategorii z kotwicą bez semestru (#z-pl-o): w semestrze wybranym podczas budowania; gdy go nie ma — w pierwszym, który ją ma
const wlascicielKategorii = (kat: string) => (semestry.find((x) => x.kotwica === aktywny && x.sekcje.some((k) => k.id === kat)) ?? semestry.find((x) => x.sekcje.some((k) => k.id === kat)))?.kotwica;
const L = en
  ? { semestr: 'Semester', szukaj: 'Search for a course, teacher or room', szukajEt: 'Search the timetable', dni: 'Days', pusto: 'Nothing matches your search.', dane: 'USOS data of', uwagi: 'Click a course name to see its description in USOS. Groups 99 are intended for students repeating a course who have already passed its classes.' }
  : { semestr: 'Semestr', szukaj: 'Szukaj przedmiotu, prowadzącego albo sali', szukajEt: 'Szukaj w planie', dni: 'Dni', pusto: 'Nic nie pasuje do wyszukiwania.', dane: 'dane z USOS z', uwagi: 'Kliknij nazwę przedmiotu, by zobaczyć opis w USOSie. Grupy 99 przeznaczone są dla powtarzających przedmiot mających zaliczenia ćwiczeń.' };

---
<Podstrona lang={lang} tytul={T.tytul} opis={T.lead} uklad="zwarta portal-baner" lead={T.lead} haslo={haslo}
  okruszki={[{ etykieta: en ? 'Study' : 'Studia', adres: '/studia' }, { etykieta: T.tytul }]} dzial="studia" spis={spisKomputer}
  klasa="z-pl" atrybuty={{ 'data-z-plan': '' }}>
  {/* liczby w nagłówku: przedmioty w semestrze i ostatnia aktualizacja z USOS */}
  <Fragment slot="baner">{liczby.length > 0 && <ul class="pt-liczby">{liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}</ul>}</Fragment>
    {semestry.length === 0 && <p class="pl-info">{T.brak}</p>}
    {semestry.length > 0 && (
      <div class="pl-narz" data-pagefind-ignore>
        {wiele && (
          <div class="pl-sem" role="group" aria-label={L.semestr}>
            {semestry.map((x) => <button type="button" aria-pressed={x.kotwica === aktywny ? 'true' : 'false'} data-z-sem={x.kotwica}>{x.przycisk}</button>)}
          </div>
        )}
        <input type="search" class="pl-szukaj" placeholder={L.szukaj} aria-label={L.szukajEt} autocomplete="off" data-z-szukaj />
        <div class="pl-dni" role="group" aria-label={L.dni}>
          {DNI_KROTKO.slice(0, 5).map((d, i) => <button type="button" aria-pressed="false" data-z-dzien={i} title={T.dni[i]}>{d}</button>)}
        </div>
      </div>
    )}
    {semestry.map((x) => (
      <div class="pl-semestr" id={x.kotwica} data-z-panel={x.kotwica} data-z-aktywny={x.kotwica === aktywny ? '' : undefined} data-od={x.s.od ?? ''} data-do={x.s.do ?? ''}>
        <p class="pl-info">{`${x.opis}${x.aktualizacja ? ` · ${L.dane} ${x.aktualizacja.pelna}` : ''}. ${L.uwagi}`}</p>
        {x.sekcje.length === 0 && <p class="pl-info">{T.brakSem}</p>}
        {x.sekcje.map((k) => (
          <section class="pl-kat" id={wlascicielKategorii(k.id) === x.kotwica ? idKategorii(k.id) : `${idKategorii(k.id)}-${x.kotwica}`} data-z-kat={idKategorii(k.id)}>
            <h2>{k.nazwa}</h2>
            <div class="pl-nagl" aria-hidden="true"><span>{T.kol.typ}</span><span>{T.kol.gr}</span><span>{T.kol.prow}</span><span>{T.kol.dzien}</span><span>{T.kol.godz}</span><span>{T.kol.sala}</span><span>{T.kol.uwagi}</span></div>
            {k.przedmioty.map((p) => (
              <div class="pl-p">
                <h3><Link href={p.usos}>{p.nazwaW}</Link></h3>
                <div>
                  {p.zajecia.map((z) => (
                    <div class="pl-w" data-d={z.dzien ?? ''} data-t={doSzukania(p.nazwaW, p.nazwa, ...(z.prowadzacy || []), z.sala || '', salaW(z.sala) || '', tekstUwag(z.uwagi))}>
                      <span class="typ"><abbr title={typPelny(z.typ)}>{typKrotki(z.typ)}</abbr></span>
                      <span class="gr">{grupa(z) && <><span class="sr-only">{T.gr} </span>{grupa(z)}</>}</span>
                      <span class="prow">{(z.prowadzacy || []).map((o, i) => <>{i > 0 && <br />}{o}</>)}</span>
                      <span class="dz">{z.dzien != null && <abbr title={T.dni[z.dzien]}>{DNI_KROTKO[z.dzien]}</abbr>}</span>
                      <span class="godz">{z.od && z.do ? `${z.od}–${z.do}` : ''}{z.czestotliwosc && T.czest[z.czestotliwosc] && <small>{T.czest[z.czestotliwosc]}</small>}</span>
                      <span class="sala">{z.sala && <>{salaW(z.sala) === z.sala && <span class="sr-only">{T.sala} </span>}{salaW(z.sala)}</>}</span>
                      <span class="uw">{(z.uwagi || []).map((f) => (typeof f === 'string' ? f : <Link href={f.a}>{f.t}</Link>))}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </section>
        ))}
      </div>
    ))}
    <p class="pl-pusto" role="status" data-z-pusto hidden>{L.pusto}</p>
</Podstrona>

<script>
  // Plan zajęć (blok .z-pl): semestr, wyszukiwarka i filtr dni. Semestr z adresu (#zimowy / #letni albo kotwica w panelu),
  // inaczej wg dzisiejszej daty (wyborSemestru.ts); wybrany semestr zapisuje się w adresie.
  import { today } from '../lib/daty';
  import { wybierzSemestr } from '../components/wyborSemestru';

  const plan = document.querySelector<HTMLElement>('[data-z-plan]');
  if (plan) {
    const panele = Array.from(plan.querySelectorAll<HTMLElement>('[data-z-panel]'));
    const przyciski = Array.from(plan.querySelectorAll<HTMLButtonElement>('[data-z-sem]'));
    const dni = Array.from(plan.querySelectorAll<HTMLButtonElement>('[data-z-dzien]'));
    const szukaj = plan.querySelector<HTMLInputElement>('[data-z-szukaj]');
    const pusto = plan.querySelector<HTMLElement>('[data-z-pusto]');
    let biezacy = Math.max(0, panele.findIndex((p) => p.hasAttribute('data-z-aktywny')));

    const filtruj = () => {
      const q = (szukaj?.value || '').trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ł/g, 'l');
      const wybrane = new Set(dni.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.zDzien));
      const widoczne = panele.map((panel) => {
        let wp = 0;
        panel.querySelectorAll<HTMLElement>('.pl-kat').forEach((kat) => {
          let wk = 0;
          kat.querySelectorAll<HTMLElement>('.pl-p').forEach((p) => {
            let w = 0;
            p.querySelectorAll<HTMLElement>('.pl-w').forEach((r) => {
              const ok = (!q || (r.dataset.t || '').includes(q)) && (!wybrane.size || wybrane.has(r.dataset.d));
              r.hidden = !ok;
              if (ok) w++;
            });
            p.hidden = !w;
            wk += w;
          });
          kat.hidden = !wk;
          wp += wk;
        });
        return wp;
      });
      if (pusto) pusto.hidden = !panele.length || widoczne[biezacy] > 0;
      // spis „Na tej stronie” (zal/SpisStrony.astro) chowa kategorie bez widocznych zajęć
      document.dispatchEvent(new Event('z-spis'));
    };

    // pokazany semestr: panel, przyciski, kotwice spisu (#z-pl-o wskazuje sekcję w pokazanym semestrze)
    const pokaz = (i: number) => {
      biezacy = i;
      panele.forEach((p, j) => {
        p.toggleAttribute('data-z-aktywny', i === j);
        p.querySelectorAll<HTMLElement>('[data-z-kat]').forEach((s) => { s.id = i === j ? s.dataset.zKat! : `${s.dataset.zKat}-${p.dataset.zPanel}`; });
      });
      przyciski.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
      filtruj();
    };

    if (panele.length > 1) {
      // semestr z adresu (#letni, #letni-m — kotwice dotychczasowego planu — albo kotwica sekcji w panelu), inaczej wg daty
      let h = '';
      try { h = decodeURIComponent(location.hash.slice(1)); } catch { /* zły adres */ }
      const zAdresu = h ? panele.findIndex((p) => h === p.dataset.zPanel || h.startsWith(`${p.dataset.zPanel}-`) || !!p.querySelector(`[id="${CSS.escape(h)}"]`)) : -1;
      pokaz(zAdresu >= 0 ? zAdresu : wybierzSemestr(panele.map((p) => ({ od: p.dataset.od, do: p.dataset.do })), today(), biezacy));
      przyciski.forEach((b, j) => b.addEventListener('click', () => {
        pokaz(j);
        history.replaceState(history.state, '', `#${panele[j].dataset.zPanel}`);
      }));
    } else {
      pokaz(0);
    }

    szukaj?.addEventListener('input', filtruj);
    dni.forEach((b) => b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      filtruj();
    }));
  }
</script>
