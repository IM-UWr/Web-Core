---
// Rok akademicki (/studia/rok-akademicki, EN /en/studia/rok-akademicki) — jedna strona zamiast dawnych „Rok akademicki”
// i „Kalendarz zajęć”. Kolejność: Dziś (kolor dnia / zamiana) → Kolory dni (przełącznik semestrów + kalendarz)
// → Rok w skrócie (terminy semestru, dni wolne, zamiany dni + wspólny tekst z src/data/rok-akademicki.md) → PDF-y
// → pole „dalej” (podstawa prawna). Przełącznik semestrów steruje kalendarzem i sekcją „Rok w skrócie”
// (data-ps-dla); bez JS widać oba semestry, każdy podpisany.
// Jedno źródło dat: terminy semestru, okresy zajęć, dni wolne i zamiany dni są w src/data/kolory-dni.json (Pages CMS),
// kolory liczy src/lib/kolory-dni.ts — ta strona jest też podglądem dla redaktora.
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal”, reszta strony jak w wariancie „Zwarta”
// (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok na końcu pliku). Telefon (≤ 760 px) bez zmian.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import Ikona from '../components/Ikona.astro';
import SpisTresci from '../components/SpisTresci.astro';
import PrzelacznikSemestrow from '../components/PrzelacznikSemestrow.astro';
import KoloryDniSemestr from './KoloryDniSemestr.astro';
import * as Opis from '../data/rok-akademicki.md';
import { u, isExternal } from '../lib/url';
import { t, wJezyku } from '../lib/i18n';
import { renderMarkdownZNaglowkami } from '../lib/markdown';
import { today, long, longWithDay, range, daysBetween, type Lang } from '../lib/daty';
import {
  semestry, nazwaSemestru, tekstDnia, wolneSemestru, zamianySemestru, terminySemestru, nazwaDnia, dzienTygodnia, opisZamiany,
  NAZWA_KOLORU, SKROT_PLANU, type Semestr,
} from '../lib/kolory-dni';
import { wybierzSemestr } from '../components/wyborSemestru';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const T = (pl: string, plEn: string) => (en ? plEn : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
const wielka = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Część opisowa (Pages CMS: „Rok akademicki — tekst”).
const fm = (Opis.frontmatter ?? {}) as Record<string, string | undefined>;
const naglowek = (en && fm.tytul_en) || fm.tytul || T('Rok akademicki', 'Academic year');
const lead = (en && fm.opis_en) || fm.opis || '';
const tekstEn = en && fm.tresc_en ? await renderMarkdownZNaglowkami(fm.tresc_en) : undefined;
const tylkoPolski = en && !fm.tresc_en;
const naglowkiTekstu = tekstEn ? tekstEn.naglowki : Opis.getHeadings();
const dalej = await renderMarkdownZNaglowkami((en && fm.dalej_en) || fm.dalej || '');
const dalejPolski = en && !fm.dalej_en && !!fm.dalej;

const dzis = today();
const t0 = tekstDnia(dzis, lang);

// Semestry: trwające i przyszłe jako przyciski przełącznika (co najmniej dwa — w razie potrzeby z ostatnio zakończonymi),
// starsze w zwijanym archiwum.
const wszystkie = semestry();
const zakladki: Semestr[] = wszystkie.filter((s) => s.koniec >= dzis).slice(0, 4);
const zakonczone = wszystkie.filter((s) => s.koniec < dzis);
while (zakladki.length < 2 && zakonczone.length) zakladki.unshift(zakonczone.pop()!);
const archiwum = zakonczone.reverse();
const rodzaj = (s: Semestr) => (/zimow|winter/i.test(s.nazwa) ? 'zimowy' : /letn|summer/i.test(s.nazwa) ? 'letni' : '');
const idPanelu = (s: Semestr) => {
  const r = rodzaj(s);
  return r && zakladki.filter((x) => rodzaj(x) === r).length === 1 ? r : `sem-${s.poczatek}`;
};
const iAktywny = wybierzSemestr(zakladki.map((s) => ({ od: s.poczatek, do: s.koniec })), dzis);
const aktywny = zakladki[iAktywny] ? idPanelu(zakladki[iAktywny]) : '';
const panele = zakladki.length > 1;

// Dni wolne i zamiany dni semestrów z przełącznika (z kolory-dni.json).
const dniTygodnia = (od: string, d: string) =>
  od === d ? nazwaDnia(dzienTygodnia(od), lang) : daysBetween(od, d) <= 6 ? `${nazwaDnia(dzienTygodnia(od), lang)}–${nazwaDnia(dzienTygodnia(d), lang)}` : '';
const zakresDat = (od: string, d: string) => range(od, od === d ? undefined : d, lang);
const sem = zakladki.map((s) => ({ s, id: idPanelu(s), terminy: terminySemestru(s, lang), wolne: wolneSemestru(s), zamiany: zamianySemestru(s) }));
const saTerminy = sem.some((x) => x.terminy.length > 0);
const saWolne = sem.some((x) => x.wolne.length > 0);
const saZamiany = sem.some((x) => x.zamiany.length > 0);
const tekstRoku = tekstEn ? tekstEn.html.trim() : ((Opis as any).rawContent?.() ?? '').trim();
const pdfy = [...zakladki, ...archiwum].filter((s) => s.pdf);
// blok jednego semestru, przełączany razem z kalendarzem (PrzelacznikSemestrow: data-ps-dla)
const ps = (id: string) => (panele ? { 'data-ps-dla': id, 'data-ps-aktywny': id === aktywny ? '' : undefined } : {});
const semestrySwitch = zakladki.map((s) => ({ id: idPanelu(s), etykieta: nazwaSemestru(s, lang), od: s.poczatek, do: s.koniec }));

const ID = {
  kolory: T('kolory-dni', 'day-colours'),
  rok: T('rok-w-skrócie', 'the-year-at-a-glance'),
  pobranie: T('do-pobrania', 'downloads'),
};
const naglowki = [
  { depth: 2, slug: ID.kolory, text: T('Kolory dni', 'Day colours') },
  ...(saTerminy || tekstRoku || saWolne || saZamiany ? [{ depth: 2, slug: ID.rok, text: T('Rok w skrócie', 'The year at a glance') }] : []),
  ...naglowkiTekstu,
  ...(pdfy.length ? [{ depth: 2, slug: ID.pobranie, text: T('Do pobrania', 'Downloads') }] : []),
  ...dalej.naglowki,
];
---
<Baza tytul={naglowek} opis={lead} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={naglowek} lead={lead} lang={lang} okruszki={[{ etykieta: T('Studia', 'Study'), adres: '/studia' }, { etykieta: naglowek }]} />
  <div class="wrap layout kd">
    <div class="main">
      <SpisTresci naglowki={naglowki} lang={lang} wariant="gora" />

      <section class="kd-dzis" data-kd-dzis data-dzien={dzis} data-kolor={t0.kolor ?? 'brak'} data-zamiana={t0.zamiana ?? ''} data-nastepny={t0.nastepnyKolor ?? ''} aria-labelledby="kd-dzis-h" data-pagefind-ignore>
        <span class="kd-kolko" aria-hidden="true" data-kd-litera>{t0.litera}</span>
        <div class="kd-dzis-txt">
          <p class="kd-data" data-kd-data>{wielka(longWithDay(dzis, lang))}</p>
          <h2 id="kd-dzis-h" class="kd-tytul" data-kd-tytul>{t0.tytul}</h2>
          <p class="kd-opis" data-kd-opis hidden={!t0.opisDlugi}>{t0.opisDlugi}</p>
        </div>
      </section>

      <section class="kd-kolory" aria-labelledby={ID.kolory}>
        <h2 id={ID.kolory} class="kd-h2">{T('Kolory dni', 'Day colours')}</h2>
        <p class="kd-wstep">{T(
          'W Instytucie nie obowiązuje parzystość tygodni podawana przez USOS, tylko kolory dni: w przypadku zajęć odbywających się co drugi tydzień jedna grupa ma zajęcia w dni pomarańczowe, a druga w niebieskie.',
          'At the Institute we do not use the week parity shown in USOS, but day colours: for classes held every other week, one group meets on orange days and the other on blue days.',
        )} {T(
          'Dni wolnych od zajęć się nie liczy, a dzień z zamianą liczy się jak dzień, według którego planu są zajęcia.',
          'Days without classes are not counted, and a swapped day counts as the day whose timetable it follows.',
        )}</p>
        <ul class="kd-legenda" aria-label={T('Legenda', 'Legend')}>
          <li><span class="kd-wzor niebieski" aria-hidden="true"></span><span><strong>{T('Dzień niebieski', 'Blue day')}</strong> — {T('dzień tygodnia występuje w semestrze po raz nieparzysty', 'the weekday occurs in the semester for an odd time')}</span></li>
          <li><span class="kd-wzor pomaranczowy" aria-hidden="true"></span><span><strong>{T('Dzień pomarańczowy', 'Orange day')}</strong> — {T('dzień tygodnia występuje w semestrze po raz parzysty', 'the weekday occurs in the semester for an even time')}</span></li>
          <li><span class="kd-wzor niebieski kd-wzor-zam" aria-hidden="true">{SKROT_PLANU[lang][3]}</span><span><strong>{T('Zamiana dni', 'Day swap')}</strong> — {T('zajęcia według planu innego dnia; skrót podaje którego (np. „ŚR” — według planu środy)', 'classes follow another day’s timetable; the abbreviation tells which (e.g. “WED” — Wednesday timetable)')}</span></li>
          <li><span class="kd-wzor wolne" aria-hidden="true"></span><span>{T('Dzień wolny od zajęć (święto, przerwa, dzień rektorski)', 'No classes (public holiday, break, Rector’s day off)')}</span></li>
          <li><span class="kd-wzor weekend" aria-hidden="true"></span><span>{T('Sobota i niedziela', 'Saturday and Sunday')}</span></li>
          <li><span class="kd-wzor kd-wzor-dzis" aria-hidden="true"></span><span>{T('Dziś', 'Today')}</span></li>
        </ul>

        {wszystkie.length === 0 && <p class="muted">{T('Brak danych o kolorach dni.', 'No day colour data yet.')}</p>}

        <PrzelacznikSemestrow semestry={semestrySwitch} aktywny={aktywny} lang={lang} />
        {zakladki.map((s) => <KoloryDniSemestr s={s} lang={lang} dzis={dzis} id={idPanelu(s)} panel={panele} aktywny={idPanelu(s) === aktywny} />)}
        {archiwum.length > 0 && (
          <details class="kd-archiwum">
            <summary>{T('Zakończone semestry', 'Past semesters')} ({archiwum.length})</summary>
            {archiwum.map((s) => <KoloryDniSemestr s={s} lang={lang} dzis={dzis} listy />)}
          </details>
        )}
      </section>

      {(saTerminy || tekstRoku || saWolne || saZamiany) && (
        <div class="prose kd-tekst">
          {/* Jedna sekcja na semestr wybrany przełącznikiem nad kalendarzem: terminy, dni wolne od zajęć, zamiany dni. */}
          <h2 id={ID.rok}>{T('Rok w skrócie', 'The year at a glance')}</h2>
          {sem.filter((x) => x.terminy.length > 0 || saWolne || saZamiany).map((x) => (
            <div {...ps(x.id)} class="kd-sem">
              <p class:list={['kd-podpis', { 'kd-podpis-ps': panele }]}>{nazwaSemestru(x.s, lang)}</p>
              {x.terminy.length > 0 && (
                <table class="kd-terminy">
                  <tbody>
                    {x.terminy.map((w) => (
                      <tr class:list={{ wazne: w.wazne }}><th scope="row">{w.etykieta}</th><td>{w.wartosc}</td></tr>
                    ))}
                  </tbody>
                </table>
              )}
              {saWolne && (
                <>
                  <h3>{T('Dni wolne od zajęć', 'Days without classes')}</h3>
                  {x.wolne.length > 0 ? (
                    <ul>
                      {x.wolne.map((w) => {
                        const dt = dniTygodnia(w.od, w.do);
                        return (
                          <li>
                            <strong>{zakresDat(w.od, w.do)}</strong>{dt && ` (${dt})`} — {T(w.opis, w.opis_en)}{w.swieto && w.od === w.do ? T(' (dzień ustawowo wolny od pracy)', ' (statutory public holiday)') : ''}
                          </li>
                        );
                      })}
                    </ul>
                  ) : <p>{T('W tym semestrze nie ma dni wolnych od zajęć poza sobotami i niedzielami.', 'There are no days without classes in this semester apart from weekends.')}</p>}
                </>
              )}
              {saZamiany && (
                <>
                  <h3>{T('Zamiany dni', 'Day swaps')}</h3>
                  {x.zamiany.length > 0 ? (
                    <>
                      <p>{T('W te dni zajęcia odbywają się ', 'On these days classes follow ')}<strong>{T('według planu innego dnia tygodnia', 'the timetable of a different weekday')}</strong>:</p>
                      <ul>
                        {x.zamiany.map((d) => (
                          <li>
                            <strong>{long(d.data, lang, false)}</strong> ({nazwaDnia(d.dzienTygodnia, lang)}) — {opisZamiany(d.plan ?? 1, lang)}{d.kolor ? `, ${T(`dzień ${NAZWA_KOLORU.pl[d.kolor]}`, `${NAZWA_KOLORU.en[d.kolor]} day`)}` : ''}
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : <p>{T('W tym semestrze nie ma zamian dni.', 'There are no day swaps in this semester.')}</p>}
                </>
              )}
            </div>
          ))}
          {tekstRoku && (
            <>
              {tylkoPolski && <p class="notice">{t('en', 'wersjaPolska')}</p>}
              <div lang={tylkoPolski ? 'pl' : undefined} class="kd-wspolny">
                {tekstEn ? <Fragment set:html={tekstEn.html} /> : <Opis.Content />}
              </div>
            </>
          )}
        </div>
      )}

      {pdfy.length > 0 && (
        <section class="kd-pobranie" aria-labelledby={ID.pobranie}>
          <h2 id={ID.pobranie} class="kd-h2">{T('Do pobrania', 'Downloads')}</h2>
          <ul class="files">
            {pdfy.map((s) => <li><a href={href(s.pdf!)}><Ikona nazwa="plik" /><span>{T('Kolory dni', 'Day colours')} — {nazwaSemestru(s, lang)} (PDF)</span></a></li>)}
          </ul>
        </section>
      )}

      {dalej.html && (
        <div class="prose kd-tekst" lang={dalejPolski ? 'pl' : undefined}>
          <Fragment set:html={dalej.html} />
        </div>
      )}
    </div>

    <aside class="side" data-pagefind-ignore>
      <SpisTresci naglowki={naglowki} lang={lang} wariant="bok" />
    </aside>
  </div>
</Baza>

<script>
  import { tekstDnia } from '../lib/kolory-dni';
  import { today, longWithDay } from '../lib/daty';

  // Dzisiejsza data w strefie Europe/Warsaw — HTML ma wartość z dnia budowania, tu ją odświeżamy.
  const lang = document.documentElement.lang === 'en' ? 'en' : 'pl';
  const dzis = today();
  const box = document.querySelector<HTMLElement>('[data-kd-dzis]');
  if (box && box.dataset.dzien !== dzis) {
    const t = tekstDnia(dzis, lang);
    const d = longWithDay(dzis, lang);
    box.dataset.dzien = dzis;
    box.dataset.kolor = t.kolor ?? 'brak';
    box.dataset.zamiana = t.zamiana ? String(t.zamiana) : '';
    box.dataset.nastepny = t.nastepnyKolor ?? '';
    const ust = (sel: string, txt: string, ukryj = true) => {
      const el = box.querySelector<HTMLElement>(sel);
      if (el) { el.textContent = txt; if (ukryj) el.hidden = !txt; }
    };
    ust('[data-kd-litera]', t.litera, false);
    ust('[data-kd-data]', d.charAt(0).toUpperCase() + d.slice(1));
    ust('[data-kd-tytul]', t.tytul);
    ust('[data-kd-opis]', t.opisDlugi);
  }
  document.querySelectorAll<HTMLElement>('.kd-mies td.dzis').forEach((td) => {
    if (td.dataset.data === dzis) return;
    td.classList.remove('dzis');
    td.removeAttribute('aria-current');
  });
  document.querySelectorAll<HTMLElement>(`.kd-mies td[data-data="${dzis}"]`).forEach((td) => {
    td.classList.add('dzis');
    td.setAttribute('aria-current', 'date');
  });
</script>

<style>
  /* Kolory dni — jasny i ciemny tryb. Kolor nie jest jedyną informacją: opis dla czytników ekranu, legenda, skrót dnia przy zamianie. */
  .kd {
    --kd-n: #a3ebf8; --kd-n-ink: #053947; --kd-n-mocny: #0e9cbc;
    --kd-p: #ffd699; --kd-p-ink: #4a2900; --kd-p-mocny: #e0841b;
    --kd-kreski: rgb(17 26 46 / .12);
  }
  :global(:root[data-theme='dark']) .kd {
    --kd-n: #0d4a58; --kd-n-ink: #cdf5fe; --kd-n-mocny: #3cc8e6;
    --kd-p: #5c3708; --kd-p-ink: #ffe1b3; --kd-p-mocny: #f2a33a;
    --kd-kreski: rgb(255 255 255 / .12);
  }

  /* --- dziś --- */
  .kd-dzis { display: flex; align-items: center; gap: 20px; padding: 22px 24px; margin-bottom: 8px; border-radius: var(--radius-l); border: 2px solid var(--line); background: var(--surface); color: var(--ink); }
  .kd-dzis[data-kolor='niebieski'] { background: var(--kd-n); border-color: var(--kd-n-mocny); color: var(--kd-n-ink); }
  .kd-dzis[data-kolor='pomaranczowy'] { background: var(--kd-p); border-color: var(--kd-p-mocny); color: var(--kd-p-ink); }
  .kd-kolko { flex: none; display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%; border: 3px dashed var(--line); background: var(--bg); color: var(--muted); font-size: 36px; font-weight: 800; line-height: 1; }
  [data-kolor='niebieski'] > .kd-kolko { border: 0; background: var(--kd-n-mocny); color: #04222b; }
  [data-kolor='pomaranczowy'] > .kd-kolko { border: 0; background: var(--kd-p-mocny); color: #2b1700; }
  .kd-dzis:not([data-zamiana='']) > .kd-kolko { font-size: 26px; font-weight: 900; letter-spacing: .02em; box-shadow: 0 0 0 4px var(--bg); }
  .kd-dzis-txt { min-width: 0; }
  .kd-data { margin: 0; font-size: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .kd-tytul { margin: 2px 0 0; font-size: clamp(26px, 4vw, 36px); font-weight: 800; letter-spacing: -0.02em; color: inherit; }
  .kd-opis { margin: 6px 0 0; font-size: 16px; line-height: 1.5; }
  .kd-dzis[data-kolor='brak'][data-nastepny] .kd-opis::before { content: ''; display: inline-block; width: 12px; height: 12px; margin-right: 8px; border-radius: 50%; vertical-align: -1px; }
  .kd-dzis[data-kolor='brak'][data-nastepny='niebieski'] .kd-opis::before { background: var(--kd-n-mocny); }
  .kd-dzis[data-kolor='brak'][data-nastepny='pomaranczowy'] .kd-opis::before { background: var(--kd-p-mocny); }
  .kd-dzis[data-kolor='brak'][data-nastepny=''] .kd-opis::before { display: none; }
  @media (max-width: 520px) {
    .kd-dzis { align-items: flex-start; gap: 14px; padding: 18px; }
    .kd-kolko { width: 56px; height: 56px; font-size: 26px; }
    .kd-dzis:not([data-zamiana='']) > .kd-kolko { font-size: 20px; }
  }

  /* --- sekcje --- */
  .kd-h2 { margin: 1.4em 0 .5em; font-size: 26px; font-weight: 800; scroll-margin-top: 16px; }
  .kd-wstep { margin: 0 0 16px; max-width: 760px; font-size: 17px; line-height: 1.6; }
  .kd-tekst { margin-top: 8px; }
  .kd-pobranie .files { max-width: 760px; }

  /* --- legenda --- */
  .kd-legenda { list-style: none; margin: 0 0 22px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 10px 24px; font-size: 15px; line-height: 1.45; }
  .kd-legenda li { display: flex; align-items: flex-start; gap: 10px; }
  .kd-wzor { position: relative; flex: none; display: grid; place-items: center; width: 34px; height: 30px; border-radius: 8px; font-size: 13px; font-weight: 900; line-height: 1; }
  .kd-wzor-zam { width: auto; min-width: 34px; padding: 0 5px; box-shadow: inset 0 0 0 2.5px var(--kd-n-mocny); }
  .kd-wzor-dzis { outline: 2.5px solid var(--ink); outline-offset: -2.5px; }

  /* --- wzory w legendzie (te same kolory co w kalendarzu: KoloryDniSemestr.astro) --- */
  .niebieski { background: var(--kd-n); color: var(--kd-n-ink); }
  .pomaranczowy { background: var(--kd-p); color: var(--kd-p-ink); }
  .wolne { background: repeating-linear-gradient(135deg, var(--surface) 0 5px, var(--kd-kreski) 5px 7px); background-color: var(--surface); }
  .weekend { background: var(--surface); }
  .kd-archiwum { margin-top: 34px; border-top: 1px solid var(--line); padding-top: 14px; }
  .kd-archiwum summary { min-height: 44px; display: flex; align-items: center; font-weight: 800; color: var(--ink); cursor: pointer; }

  /* --- Rok w skrócie: terminy jednego semestru --- */
  .kd-terminy th { width: 46%; background: none; font-weight: 600; color: var(--text); }
  .kd-terminy tr.wazne th, .kd-terminy tr.wazne td { font-weight: 800; color: var(--ink); }
  .kd-terminy caption { padding: 0 0 6px; text-align: left; }
  /* podpis semestru: widoczny bez JS (oba semestry naraz), z przełącznikiem tylko dla czytników ekranu */
  .kd-podpis { margin: 0 0 6px; font-weight: 800; color: var(--ink); }
