---
// Podstrona specjalności (/studia/<kierunek>/<specjalność>), zlecenie 29. Treść: jeden Markdown — src/content/specjalnosci/<id>.md
// (body po polsku, pole tresc_en po angielsku; edycja w Pages CMS: Nazwa, Treść, Nazwa EN, Treść EN). Sekcje to nagłówki ##
// (kotwice typu „specjalnosc” i krótka etykieta spisu „Jak przebiega” — src/plugins/kotwice.mjs), bloki wzorca treści z samego
// tekstu (src/plugins/rehype-bloki.mjs): „**Tytuł** — opis” → ul.dwa, lista numerowana „**Kiedy: Tytuł** — opis” → ol.etapy,
// ### w „Czego się uczysz” → grupy przedmiotów, zwykła lista w „Co będziesz umieć” i „Przykładowe tematy prac” → ul.kreski
// („Tytuł — opis”: opis szary), lista linków → ul.linki / ul.pliki, ### z „?” → rozwijane pytania, cytat „> **Dla kogo**” → ramka.
// Sekcje liczone z innych danych (wstawia je ten widok w miejscu <!--wstaw:…--> z treści): Seminaria (pole „Seminaria”),
// Opiekun(owie) specjalności (spis pracowników) z zakładem, ramka „Wybór specjalności” (pod osią, a bez osi — w „O specjalności”).
// Baner i kafelek na stronie kierunku: formularz „Baner i kafelek” (src/content/specjalnosci-baner/<id>.json, src/lib/specjalnosci.ts):
// liczby (LiczbyBanera) i etykiety specjalności. Tytuł karty „Specjalność — Kierunek” jak dotąd.
// Wspólny szablon podstrony (zal/Podstrona.astro), wzorzec treści (src/styles/zal-tresc.css, klasa .tresc). Jedna wersja HTML:
// komputer (≥ 1024 px) i telefon (≤ 1023 px, jedna kolumna — zal-tresc.css).
import Link from '../components/Link.astro';
import { zTytulem } from '../lib/osoby';
import Podstrona from '../components/zal/Podstrona.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import { u } from '../lib/url';
import { wJezyku, wybierz } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import type { Specjalnosc } from '../lib/specjalnosci';
import { daneSpecjalnosci } from '../lib/widoki/specjalnosc';
import { mailHtml } from '../lib/limity.mjs';

interface Props { specjalnosc: Specjalnosc; lang: Lang }
const { specjalnosc, lang } = Astro.props;
const d = specjalnosc.data;
const en = lang === 'en';
const T = (pl: string, plEn: string) => (en ? plEn : pl);
const w = (o: any, pole: string) => wybierz(o, pole, lang);
const { czesci, sekcje, nazwaKierunku, zaklad, opiekunowie, nazwa, sem, haslo, liczbyTel } = await daneSpecjalnosci(specjalnosc, lang);
const doTerminow = u(wJezyku(`/studia/${d.kierunek}#terminy`, lang));
---
<Podstrona lang={lang} tytul={nazwa} tytulKarty={`${nazwa} — ${nazwaKierunku}`} opis={w(d, 'opis')} opublikowany={d.opublikowany}
  uklad="zwarta portal-baner" lead={d.opis ? w(d, 'opis') : undefined} haslo={haslo}
  wstecz={{ etykieta: nazwaKierunku, adres: `/studia/${d.kierunek}#specjalnosci` }} dzial="studia" spis={sekcje} klasa="tresc"
  atrybuty={{ 'data-specjalnosc': '' }}>
  {/* Baner: liczby i etykiety specjalności (na każdej szerokości). */}
  <Fragment slot="baner">
    <LiczbyBanera lang={lang} pozycje={liczbyTel} />
    <div class="tags">
      {d.skrot && <span class="badge">{d.skrot}</span>}
      {d.poziom && <span class="badge">{w(d, 'poziom')}</span>}
      {d.wygaszana && <span class="badge">{T('wygaszana', 'phased out')}</span>}
    </div>
  </Fragment>

  {czesci.map((c) => 'html' in c ? <Fragment set:html={c.html} />
    : c.wstawka === 'seminaria' ? (
      <ul class="linki">
        {sem.map((s) => <li><a href={u(wJezyku(`/seminaria/${s.id}`, lang))}>{wybierz(s.data, 'nazwa', lang)}</a></li>)}
      </ul>
    ) : c.wstawka === 'opiekun' ? (
      <>
        <div class="kontakty">
          {opiekunowie.map((o) => (
            <div>
              {o.rola && <span class="etyk">{w(o, 'rola')}</span>}
              <b data-limit-linii="2">{o.osoba?.data.strona
                ? <Link href={o.osoba.data.strona}>{zTytulem(o.osoba.data.stopien, o.osoba.data.imie_nazwisko, lang)}</Link>
                : o.osoba ? zTytulem(o.osoba.data.stopien, o.osoba.data.imie_nazwisko, lang) : o.imie_nazwisko}</b>
              {o.osoba && (o.osoba.data.email || o.osoba.data.pokoj || o.osoba.data.telefon) && (
                <dl class="para">
                  {o.osoba.data.email && <><dt>e-mail</dt><dd><a href={`mailto:${o.osoba.data.email}`} data-limit-linii="2" set:html={mailHtml(o.osoba.data.email)} /></dd></>}
                  {o.osoba.data.pokoj && <><dt>{T('pokój', 'room')}</dt><dd>{o.osoba.data.pokoj}</dd></>}
                  {o.osoba.data.telefon && <><dt>{T('tel.', 'phone')}</dt><dd>{o.osoba.data.telefon}</dd></>}
                </dl>
              )}
            </div>
          ))}
        </div>
        {zaklad && (
          <ul class="linki sp-zaklad">
            <li><a href={u(wJezyku(`/instytut/zaklady/${zaklad.id}`, lang))}>{wybierz(zaklad.data, 'nazwa', lang)}</a></li>
          </ul>
        )}
      </>
    ) : (
      <div class="uwaga sp-wybor">
        <span class="etyk">{T('Wybór specjalności', 'Choosing a specialisation')}</span>
        <p>{T('Terminy deklaracji i formularze znajdziesz na stronie kierunku: ', 'Declaration deadlines and forms are listed on the programme page: ')}<a href={doTerminow}>{T('Terminy i formularze', 'Deadlines and forms')}</a>.</p>
      </div>
    ))}
</Podstrona>

<style>
  /* Treść z Markdownu (set:html) nie ma atrybutu stylów zakresowych — reguły globalne z prefiksem strony specjalności
     (.tresc[data-specjalnosc]; specyficzność nie niższa niż dawnych reguł zakresowych w tym pliku), jak na stronie kierunku. */
  /* pytania: stary styl .faq z global.css (pogrubienie, wysokość 52 px) nie przecieka do wzorca */
  :global(.tresc[data-specjalnosc] .faq summary) { min-height: 0; align-items: flex-start; font-weight: 400; }
  /* „Dla kogo” w ramce uwagi: akapity z Markdown jak tekst ramki */
  :global(.tresc[data-specjalnosc] .sp-dla p) { margin: 0 0 10px; }
  :global(.tresc[data-specjalnosc] .uwaga + .uwaga) { margin-top: 12px; }
  :global(.tresc[data-specjalnosc] .etapy + .sp-wybor) { margin-top: 8px; }
  /* przykładowe tematy prac: opis po tytule szary */
  :global(.tresc[data-specjalnosc] .sp-opis) { color: var(--muted); }
  .sp-zaklad { margin-top: 18px; }
  /* opis dokumentu pod nazwą */
  :global(.tresc[data-specjalnosc] .pliki small) { display: block; font-size: 13.5px; color: var(--muted); }
</style>
