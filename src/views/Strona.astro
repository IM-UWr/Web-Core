---
// Strona stała (Markdown z src/content/strony). Adres = ścieżka pliku, np. studia/matematyka.md → /studia/matematyka
import type { CollectionEntry } from 'astro:content';
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import Ikona from '../components/Ikona.astro';
import SpisTresci from '../components/SpisTresci.astro';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { daneStrony } from '../lib/widoki/strona';
import BocznaNawigacja from '../components/zal/BocznaNawigacja.astro';

interface Props { strona: CollectionEntry<'strony'>; lang: Lang }
const { strona, lang } = Astro.props;
const { d, tytul, opis, haslo, liczby, Content, htmlEn, naglowki, tylkoPolski, adres, dzial, linkiDzialu, rodzic, pasek, wygladPortalZwarta, dzialZ, spisZ } = await daneStrony(strona, lang);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
---
<Baza tytul={tytul} opis={opis} opublikowany={d.opublikowany} uklad={wygladPortalZwarta ? 'zwarta portal-baner' : undefined}>
  <NaglowekStrony tytul={tytul} lead={opis} haslo={haslo} lang={lang} okruszki={[...(dzial ? [{ etykieta: wybierz(dzial, 'etykieta', lang), adres: dzial.adres }] : []), ...(rodzic ? [{ etykieta: wybierz(rodzic, 'etykieta', lang), adres: rodzic.adres }] : []), { etykieta: tytul }]}>
    <LiczbyBanera lang={lang} pozycje={liczby} />
  </NaglowekStrony>
  <div class:list={['wrap layout', wygladPortalZwarta && 'st-odstep']}>
    <div class="main">
      {(pasek === 'spis' || pasek === 'oba') && <SpisTresci naglowki={naglowki} lang={lang} wariant="gora" />}
      {tylkoPolski && <p class="notice">{t('en', 'wersjaPolska')}</p>}
      <div class="prose" lang={tylkoPolski ? 'pl' : undefined}>
        {htmlEn ? <Fragment set:html={htmlEn} /> : <Content />}
      </div>
    </div>
    {pasek !== 'brak' && (
    <aside class="side" data-pagefind-ignore>
      {(pasek === 'spis' || pasek === 'oba') && <SpisTresci naglowki={naglowki} lang={lang} wariant="bok" />}
      {(pasek === 'menu' || pasek === 'oba') && linkiDzialu.length > 0 && (
        <nav class="side-box side-nav" aria-label={wybierz(dzial, 'etykieta', lang)}>
          <h2>{wybierz(dzial, 'etykieta', lang)}</h2>
          <div style="display:flex;flex-direction:column">
            {linkiDzialu.map((l) => (
              <a href={href(l.adres)} aria-current={l.adres === adres ? 'page' : l === rodzic ? 'true' : undefined}>
                {wybierz(l, 'etykieta', lang)}{isExternal(l.adres) && <Ikona nazwa="zewnetrzny" rozmiar={13} />}
              </a>
            ))}
          </div>
        </nav>
      )}
    </aside>
    )}
    {/* komputer (kierunek „Założyciele”): boczna nawigacja działu z lewej (siatka .layout w zal-podstrony.css), stary pasek
         boczny schowany; na telefonie ten element nie istnieje (.tylko-komputer) */}
    {dzialZ && <BocznaNawigacja dzial={dzialZ} lang={lang} spis={spisZ} class="tylko-komputer" />}
  </div>
</Baza>

<style>
  /* komputer (≥ 761 px), strony Instytutu i Studiów: odstęp nad treścią stały (24 px), jak na stronach działów — kreska
     pierwszej sekcji nie przylega do banera (reszta odstępów .layout — uklad-zwarta.css) */
  @media (min-width: 761px) { .st-odstep { padding-top: 24px; } }
</style>
