---
// Strona stała (Markdown z src/content/strony). Adres = ścieżka pliku, np. studia/matematyka.md → /studia/matematyka
// Szablon podstrony (zal/Podstrona.astro): treść, spis „Na tej stronie” z nagłówków ## (pole „Prawy pasek”: spis albo oba —
// ze spisem; menu albo brak — bez spisu), na telefonie (≤ 760 px) spis zwijany nad treścią.
import type { CollectionEntry } from 'astro:content';
import Podstrona from '../components/zal/Podstrona.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import { t, wybierz } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { daneStrony } from '../lib/widoki/strona';

interface Props { strona: CollectionEntry<'strony'>; lang: Lang }
const { strona, lang } = Astro.props;
const { d, tytul, opis, haslo, liczby, Content, htmlEn, naglowki, tylkoPolski, adres, dzial, linkiDzialu, rodzic, pasek, wygladPortalZwarta, dzialZ, spisZ } = await daneStrony(strona, lang);
const okruszki = [...(dzial ? [{ etykieta: wybierz(dzial, 'etykieta', lang) as string, adres: dzial.adres }] : []), ...(rodzic ? [{ etykieta: wybierz(rodzic, 'etykieta', lang) as string, adres: rodzic.adres }] : []), { etykieta: tytul }];
---
<Podstrona lang={lang} tytul={tytul} opis={opis} opublikowany={d.opublikowany} uklad={wygladPortalZwarta ? 'zwarta portal-baner' : undefined}
  lead={opis} haslo={haslo} okruszki={okruszki} dzial={dzialZ} spis={pasek === 'spis' || pasek === 'oba' ? spisZ : []}
  klasaRamy={wygladPortalZwarta ? 'z-pd-zwarta' : undefined}>
  <Fragment slot="baner"><LiczbyBanera lang={lang} pozycje={liczby} /></Fragment>
  {tylkoPolski && <p class="notice">{t('en', 'wersjaPolska')}</p>}
  <div class="prose" lang={tylkoPolski ? 'pl' : undefined}>
    {htmlEn ? <Fragment set:html={htmlEn} /> : <Content />}
  </div>
</Podstrona>
