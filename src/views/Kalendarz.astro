---
// Kalendarz (/kalendarz, EN /en/kalendarz): nadchodzące i minione wydarzenia, obrony, konferencje i referaty seminaryjne
// (subskrypcja kanałów .ics zdjęta ze strony — decyzja właściciela; pliki .ics nadal się generują). Wspólny szablon podstrony
// (zal/Podstrona.astro; zlecenie 12, etap 3). Strona poza działami: granatowy nagłówek z hasłem i trzema liczbami (obrony,
// referaty, wydarzenia — LiczbyBanera; zlecenie 01), bez spisu „Na tej stronie” (miesiące to grupy listy).
// Widok „Nadchodzące” / „Archiwum” (w adresie #archiwum), filtr rodzaju (w adresie także ?rodzaj=…) i szukanie po tekście
// pozycji działają razem. Pozycje po miesiącach: nagłówek miesiąca Brygadą, wiersze z cienkimi liniami i datą jak na
// stronach działów (WierszWydarzenia.astro). Jedna wersja HTML: komputer (≥ 761 px) — przyklejony pasek: widok, rodzaje
// i pole szukania w jednym wierszu (jak w Planie zajęć); telefon (≤ 760 px) — widok, rodzaje (lista wyboru) i pole
// szukania jedno pod drugim, pasek nieprzyklejony. Bez JS: pasek schowany, widać oba widoki jeden pod drugim (z podpisami).
import Podstrona from '../components/zal/Podstrona.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import WierszWydarzenia from '../components/WierszWydarzenia.astro';
import { t, RODZAJE_FILTRY } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { daneKalendarza } from '../lib/widoki/kalendarz';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const { widoki, lead, haslo, liczby, filtrEtykieta, szukajDlugo } = await daneKalendarza(lang);
const tytul = t(lang, 'kalendarz');
// rodzaje w kolejności dotychczasowych przycisków na komputerze, nazwy w liczbie mnogiej jak w Aktualnościach (referaty — „Seminaria”)
const rodzaje = ['wydarzenie', 'obrona', 'konferencja', 'referat'];
---
<Podstrona lang={lang} tytul={tytul} opis={lead} uklad="zwarta portal-baner" lead={lead} haslo={haslo}
  wstecz={{ etykieta: T('Nauka', 'Research'), adres: '/nauka' }} klasa="z-kal" atrybuty={{ 'data-kalendarz': '' }}>
  <Fragment slot="baner"><LiczbyBanera lang={lang} pozycje={liczby} /></Fragment>

  <div class="kal-narz" data-pagefind-ignore>
    <div class="kal-widok" role="group" aria-label={T('Widok', 'View')}>
      {widoki.map((v, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-widok-btn={v.id}>{v.etykieta}</button>)}
    </div>
    <div class="kal-rodzaje" role="group" aria-label={filtrEtykieta}>
      <button type="button" aria-pressed="true" data-rodzaj="">{t(lang, 'wszystkie')}</button>
      {rodzaje.map((r) => <button type="button" aria-pressed="false" data-rodzaj={r}>{RODZAJE_FILTRY[r][lang]}</button>)}
    </div>
    {/* telefon: rodzaje jako lista wyboru (zlecenie 11, zalecenie 4), zsynchronizowana z przyciskami */}
    <label class="z-pole-wyboru kal-rodzaj-lista">
      <span class="sr-only">{filtrEtykieta}</span>
      <select data-rodzaj-lista autocomplete="off">
        <option value="">{t(lang, 'wszystkie')}</option>
        {rodzaje.map((r) => <option value={r}>{RODZAJE_FILTRY[r][lang]}</option>)}
      </select>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
    </label>
    <input type="search" class="kal-szukaj" placeholder={szukajDlugo} aria-label={szukajDlugo} autocomplete="off" data-szukaj />
  </div>

  {widoki.map((v, i) => (
    <div class="kal-panel" data-widok={v.id} data-aktywny={i === 0 ? '' : undefined} data-pagefind-ignore={v.id === 'archiwum' ? '' : undefined}>
      <p class="kal-podpis">{v.etykieta}</p>
      {v.grupy.length === 0 && <p class="kal-pusto">{v.pusty}</p>}
      {v.grupy.map((g) => (
        <section class="kal-mies" data-grupa>
          <h2>{g.miesiac}</h2>
          {g.pozycje.map((w) => <WierszWydarzenia w={w} lang={lang} />)}
        </section>
      ))}
      <p class="kal-pusto" role="status" data-pusty-filtr data-pusty-rodzaj={T('Brak pozycji tego rodzaju.', 'Nothing of this kind here.')} data-pusty-szukaj={T('Brak pozycji spełniających wybrane kryteria.', 'No items match the selected filters.')} hidden></p>
    </div>
  ))}
</Podstrona>

<script>
  // Widok (Nadchodzące / Archiwum, w adresie #archiwum), filtr rodzaju (?rodzaj=… z adresu) i szukanie po tekście pozycji
  // (etykieta, termin, miejsce, tytuł, prelegent, seminarium — bez daty z lewej) działają razem.
  const kal = document.querySelector<HTMLElement>('[data-kalendarz]');
  if (kal) {
    const btnRodzaj = Array.from(kal.querySelectorAll<HTMLButtonElement>('button[data-rodzaj]'));
    const rodzajLista = kal.querySelector<HTMLSelectElement>('[data-rodzaj-lista]');
    const btnWidok = Array.from(kal.querySelectorAll<HTMLButtonElement>('button[data-widok-btn]'));
    const widoki = Array.from(kal.querySelectorAll<HTMLElement>('[data-widok]'));
    const szukaj = kal.querySelector<HTMLInputElement>('[data-szukaj]');
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ł/g, 'l');
    const znanyRodzaj = (r: string) => btnRodzaj.some((b) => (b.dataset.rodzaj ?? '') === r);
    let rodzaj = '';
    let widok = location.hash === '#archiwum' ? 'archiwum' : 'nadchodzace';
    const pokaz = () => {
      const q = norm(szukaj?.value.trim() ?? '');
      btnWidok.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.widokBtn === widok)));
      btnRodzaj.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.rodzaj ?? '') === rodzaj)));
      if (rodzajLista) rodzajLista.value = rodzaj;
      widoki.forEach((v) => {
        v.toggleAttribute('data-aktywny', v.dataset.widok === widok);
        v.querySelectorAll<HTMLElement>('[data-ww]').forEach((p) => {
          p.hidden = (!!rodzaj && p.dataset.rodzaj !== rodzaj) || (!!q && !norm(p.querySelector('.ww-tresc')?.textContent ?? '').includes(q));
        });
        const grupy = Array.from(v.querySelectorAll<HTMLElement>('[data-grupa]'));
        grupy.forEach((g) => (g.hidden = !g.querySelector('[data-ww]:not([hidden])')));
        // komunikat „brak pozycji” tylko, gdy widok ma pozycje, ale filtr (albo szukanie) wszystkie schował
        const pf = v.querySelector<HTMLElement>('[data-pusty-filtr]');
        if (pf) {
          pf.textContent = (q ? pf.dataset.pustySzukaj : pf.dataset.pustyRodzaj) ?? '';
          pf.hidden = grupy.length === 0 || grupy.some((g) => !g.hidden);
        }
      });
    };
    const ustawRodzaj = (r: string) => { rodzaj = znanyRodzaj(r) ? r : ''; pokaz(); };
    btnRodzaj.forEach((b) => b.addEventListener('click', () => ustawRodzaj(b.dataset.rodzaj ?? '')));
    rodzajLista?.addEventListener('change', () => ustawRodzaj(rodzajLista.value));
    szukaj?.addEventListener('input', pokaz);
    btnWidok.forEach((b) => b.addEventListener('click', () => {
      widok = b.dataset.widokBtn ?? 'nadchodzace';
      history.replaceState(null, '', widok === 'archiwum' ? '#archiwum' : location.pathname + location.search);
      pokaz();
    }));
    ustawRodzaj(new URLSearchParams(location.search).get('rodzaj') ?? '');
  }
</script>

<style>
  [hidden] { display: none !important; }
  /* bez JS: bez paska, oba widoki jeden pod drugim z podpisami; z JS — tylko wybrany widok, bez podpisu */
  :global(html:not(.js)) .kal-narz { display: none; }
  :global(html.js) .kal-panel:not([data-aktywny]) { display: none; }
  :global(html.js) .kal-podpis { display: none; }
  .kal-podpis { margin: 30px 0 0; font-size: 13px; font-weight: 700; color: var(--d-a); }

  .kal-widok, .kal-rodzaje { display: flex; border: 1px solid var(--line-ui); }
  .kal-narz button { margin: 0; font: inherit; font-weight: 600; border: 0; border-radius: 0; background: transparent; color: var(--text); cursor: pointer; }
  .kal-narz button + button { border-left: 1px solid var(--line-ui); }
  .kal-narz button:hover { color: var(--d-a); }
  .kal-narz button[aria-pressed='true'] { background: var(--d-a); color: var(--bg); }
  .kal-narz button:focus-visible { position: relative; outline: 2px solid var(--d-a); outline-offset: 2px; }
  .kal-szukaj { min-width: 0; margin: 0; font: inherit; border: 1px solid var(--line-ui); border-radius: 0; background: var(--bg); color: var(--ink); }
  .kal-szukaj::placeholder { color: var(--muted); opacity: 1; }
  .kal-szukaj:focus { outline: 2px solid var(--d-a); outline-offset: -1px; }

  /* miesiąc: nagłówek Brygadą, wiersze z cienkimi liniami (bez kreski i odstępów sekcji szablonu) */
  .kal-mies { margin: 0; padding: 0; border: 0; }
  .kal-mies h2 { margin: 26px 0 0; padding-bottom: 6px; border-bottom: 1px solid var(--line); font-family: var(--f-display); font-weight: 500;
    font-size: 23px; line-height: 1.4; color: var(--d-a); }
  .kal-pusto { margin: 18px 0 0; font-style: italic; color: var(--muted); }

  /* ---------- komputer (≥ 761 px): pasek przyklejony u góry, jak w Planie zajęć ---------- */
  @media (min-width: 761px) {
    .kal-rodzaj-lista { display: none; }
    .kal-narz { position: sticky; top: var(--gora); z-index: 2; display: flex; flex-wrap: wrap; align-items: center; gap: 14px; padding: 12px 0;
      background: var(--bg); border-bottom: 2px solid var(--rule); }
    .kal-narz button { font-size: 14px; padding: 7px 12px; }
    .kal-szukaj { flex: 1; min-width: 200px; font-size: 15px; padding: 8px 12px; }
  }

  /* ---------- telefon (≤ 760 px): widok, rodzaje po trzy w rzędzie i pole szukania jedno pod drugim ---------- */
  @media (max-width: 760px) {
    .kal-narz { display: grid; gap: 8px; padding-bottom: 12px; border-bottom: 2px solid var(--rule); }
    .kal-narz button { min-height: 40px; padding: 6px 4px; font-size: 13.5px; }
    .kal-widok, .kal-rodzaje { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* rodzaje jako lista wyboru (zlecenie 11, zalecenie 4: na telefonie lista zamiast paska, w stylu pola) */
    .kal-rodzaje { display: none; }
    .kal-rodzaj-lista { display: flex; width: 100%; }
    .kal-szukaj { width: 100%; padding: 8px 10px; font-size: 16px; }
    .kal-mies h2 { margin-top: 22px; font-size: 20px; }
  }
</style>
