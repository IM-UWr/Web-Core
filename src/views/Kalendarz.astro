---
// Kalendarz: nadchodzące wydarzenia, obrony i referaty (subskrypcja kanałów .ics zdjęta ze strony — decyzja właściciela; pliki .ics nadal się generują).
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal”, reszta jak w „Zwarta” (uklad="zwarta portal-baner"),
// miesiące jako sekcje z kreską jak na stronach działów, pozycje jako osobne białe karty (.karty-lista w global.css). Filtry rodzaju w banerze;
// pod banerem przyciski widoku „Nadchodzące” / „Archiwum”. Telefon (≤ 760 px): poza przyciskami widoku bez zmian.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import Ikona from '../components/Ikona.astro';
import { u, absolute } from '../lib/url';
import { t, wJezyku, RODZAJE } from '../lib/i18n';
import { monthYear, dayNum, monthShort, dayShort, range, time, hasTime, type Lang } from '../lib/daty';
import { wszystkieWydarzenia, trwaLubBedzie, seminaria } from '../lib/tresci';
import { adresIcs } from '../lib/kalendarz';

interface Props { lang: Lang }
const { lang } = Astro.props;
// Dwa widoki: „Nadchodzące” (trwające i przyszłe, od najbliższego) i „Archiwum” (cała historia, od najnowszego).
const wszystkie = await wszystkieWydarzenia(lang);
type W = (typeof wszystkie)[number];
const poMiesiacach = (lista: W[]) => {
  const grupy: { miesiac: string; pozycje: W[] }[] = [];
  for (const w of lista) {
    const m = monthYear(w.poczatek, lang);
    const ost = grupy[grupy.length - 1];
    if (ost && ost.miesiac === m) ost.pozycje.push(w);
    else grupy.push({ miesiac: m, pozycje: [w] });
  }
  return grupy;
};
const widoki = [
  { id: 'nadchodzace', etykieta: lang === 'en' ? 'Upcoming' : 'Nadchodzące', grupy: poMiesiacach(wszystkie.filter(trwaLubBedzie)), pusty: t(lang, 'brakWydarzen') },
  { id: 'archiwum', etykieta: lang === 'en' ? 'Archive' : 'Archiwum', grupy: poMiesiacach(wszystkie.filter((w) => !trwaLubBedzie(w)).reverse()), pusty: lang === 'en' ? 'No past events.' : 'Brak minionych wydarzeń.' },
];
const sem = (await seminaria()).filter((s) => s.data.aktywne);
const kanaly = [
  { nazwa: t(lang, 'wszystkieWydarzeniaKal'), plik: 'wszystko' },
  { nazwa: t(lang, 'tylkoWydarzenia'), plik: 'wydarzenia' },
  ...sem.map((s) => ({ nazwa: `${RODZAJE.referat[lang]}: ${(lang === 'en' && s.data.nazwa_en) || s.data.nazwa}`, plik: `seminarium-${s.id}` })),
];
const webcal = (plik: string) => absolute(adresIcs(plik), Astro.site).replace(/^https?:/, 'webcal:');
const lead = lang === 'en'
  ? 'Events, PhD defences, conferences and seminar talks at the Mathematical Institute — upcoming and past.'
  : 'Wydarzenia, obrony doktorskie, konferencje i referaty seminaryjne w Instytucie Matematycznym — nadchodzące i archiwalne.';
---
<Baza tytul={t(lang, 'kalendarz')} opis={lead} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={t(lang, 'kalendarz')} lead={lead} lang={lang} wstecz={{ etykieta: lang === 'en' ? 'Research' : 'Nauka', adres: '/nauka' }}>
    <div class="filters">
      <div class="chips" role="group" aria-label={lang === 'en' ? 'Filter' : 'Filtruj'}>
        <button type="button" class="chip" aria-pressed="true" data-rodzaj="">{t(lang, 'wszystkie')}</button>
        <button type="button" class="chip" aria-pressed="false" data-rodzaj="wydarzenie">{RODZAJE.wydarzenie[lang]}</button>
        <button type="button" class="chip" aria-pressed="false" data-rodzaj="obrona">{RODZAJE.obrona[lang]}</button>
        <button type="button" class="chip" aria-pressed="false" data-rodzaj="konferencja">{RODZAJE.konferencja[lang]}</button>
        <button type="button" class="chip" aria-pressed="false" data-rodzaj="referat">{t(lang, 'seminaria')}</button>
      </div>
    </div>
  </NaglowekStrony>

  <div class="wrap layout kal-wrap">
    <div class="main">
      {/* widok pod banerem: nadchodzące / archiwum (przyciski jak w tabeli pracowników) */}
      <div class="chips kal-widok" role="group" aria-label={lang === 'en' ? 'View' : 'Widok'}>
        {widoki.map((v, i) => <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-widok-btn={v.id}>{v.etykieta}</button>)}
      </div>
      {widoki.map((v, i) => (
        <div data-widok={v.id} hidden={i > 0} data-pagefind-ignore={v.id === 'archiwum' ? '' : undefined}>
          {v.grupy.length === 0 && <p class="muted kal-pusto">{v.pusty}</p>}
          {v.grupy.map((g) => (
            <section class="lista-miesiac" data-grupa>
              <h2 class="month">{g.miesiac}</h2>
              <div class="karty-lista">
              {g.pozycje.map((w) => (
                <a class="row-item" href={u(wJezyku(w.href, lang))} data-rodzaj={w.rodzaj}>
                  <span class={`datebox small${w.rodzaj === 'referat' ? ' light' : ''}`} aria-hidden="true">
                    <span class="d">{dayNum(w.poczatek)}</span><span class="m">{monthShort(w.poczatek, lang)}</span>
                  </span>
                  <span class="body">
                    <span class="news-meta">
                      <span class={`badge badge-${w.rodzaj}`}>{RODZAJE[w.rodzaj][lang]}</span>
                      <span>{dayShort(w.poczatek, lang)} {hasTime(w.poczatek) ? time(w.poczatek) : range(w.poczatek, w.koniec, lang)}</span>
                      {w.miejsce && <span>· {w.miejsce}</span>}
                    </span>
                    <span class="t" style="font-size:18px">{w.tytul}</span>
                    {w.podtytul && <span class="x">{w.podtytul}</span>}
                    {w.rodzaj === 'referat' && w.opis && <span class="x muted" style="font-size:14px">{w.opis}</span>}
                  </span>
                </a>
              ))}
              </div>
            </section>
          ))}
          <p class="muted kal-pusto" data-pusty-filtr hidden>{lang === 'en' ? 'Nothing of this kind here.' : 'Brak pozycji tego rodzaju.'}</p>
        </div>
      ))}
    </div>

  </div>
</Baza>

<script>
  // Widok (Nadchodzące / Archiwum, w adresie #archiwum) i filtr rodzaju — działają razem.
  const btnRodzaj = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-rodzaj]'));
  const btnWidok = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-widok-btn]'));
  const widoki = Array.from(document.querySelectorAll<HTMLElement>('[data-widok]'));
  let rodzaj = '';
  let widok = location.hash === '#archiwum' ? 'archiwum' : 'nadchodzace';
  const pokaz = () => {
    btnWidok.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.widokBtn === widok)));
    btnRodzaj.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.rodzaj ?? '') === rodzaj)));
    widoki.forEach((v) => {
      v.hidden = v.dataset.widok !== widok;
      v.querySelectorAll<HTMLElement>('.row-item[data-rodzaj]').forEach((p) => (p.hidden = !!rodzaj && p.dataset.rodzaj !== rodzaj));
      const grupy = Array.from(v.querySelectorAll<HTMLElement>('[data-grupa]'));
      grupy.forEach((g) => (g.hidden = !g.querySelector('.row-item:not([hidden])')));
      // komunikat „brak pozycji tego rodzaju” tylko, gdy widok ma pozycje, ale filtr wszystkie schował
      const pf = v.querySelector<HTMLElement>('[data-pusty-filtr]');
      if (pf) pf.hidden = grupy.length === 0 || grupy.some((g) => !g.hidden);
    });
  };
  btnRodzaj.forEach((b) => b.addEventListener('click', () => { rodzaj = b.dataset.rodzaj ?? ''; pokaz(); }));
  btnWidok.forEach((b) => b.addEventListener('click', () => {
    widok = b.dataset.widokBtn ?? 'nadchodzace';
    history.replaceState(null, '', widok === 'archiwum' ? '#archiwum' : location.pathname + location.search);
    pokaz();
  }));
  pokaz();
</script>

<style>
  /* ---------- komputer (≥ 761 px): wygląd „Zwarta” jak na stronach działów ----------
     24 px od banera; miesiąc = sekcja z kreską (.lista-miesiac, global.css — jak .zsec przy oprawie „linia”;
     klasy .zsec nie dajemy, bo zmieniłaby telefon);
     pozycje miesiąca jako osobne białe karty (.karty-lista, global.css); pusty kalendarz — komunikat w takiej karcie. */
  @media (min-width: 761px) {
    .kal-wrap { padding-top: 24px; padding-bottom: var(--tresc-dol); }
    .kal-pusto { border: 1px solid var(--line); border-radius: var(--radius-l); background: var(--bg); }
    .kal-pusto { margin: 0; padding: 16px 18px; }
  }
  /* przyciski widoku pod banerem, nad listą miesięcy */
  .kal-widok { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
</style>
