---
// Projekty i granty (/nauka/granty), kierunek „Założyciele” (prototyp: trescGranty): wstęp (nauka.json: granty_tekst),
// Realizowane z paskami czasu na wspólnej osi lat i przerywaną linią „dziś” (data budowania), Zakończone według roku
// zakończenia z małymi paskami (oś co 4 lata), Pozostałe (bez lat). Liczby w banerze wyliczone z kolekcji.
// Jedna wersja HTML: komputer — wiersz z paskiem z prawej; telefon (≤ 760 px) — wiersz w jednej kolumnie, pasek pod tytułem
// na całą szerokość, oś lat nad listą (src/styles/zal-granty-plan.css). Szablon podstrony: zal/Podstrona.astro.
import Podstrona from '../components/zal/Podstrona.astro';
import { u } from '../lib/url';
import { wJezyku, wybierz, RODZAJE_GRANTOW } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { lataGrantu, slugOf, type Grant } from '../lib/tresci';
import { daneListyGrantow, odm } from '../lib/widoki/listaGrantow';
import { programGrantu } from '../lib/widoki/grant';
import '../styles/zal-granty-plan.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const ileProjektow = (n: number) => (lang === 'en' ? `${n} project${n === 1 ? '' : 's'}` : `${n} ${odm(n, 'projekt', 'projekty', 'projektów')}`);
const tytul = (g: Grant) => (lang === 'en' && g.data.tytul_en) || g.data.tytul;
const adresGrantu = (g: Grant) => u(wJezyku(`/nauka/granty/${slugOf(g.id)}`, lang));

const {
  realizowane, zakonczone, bezLat, grupy, kier, zakladProjektu, liczby, haslo, naglowek, lead, wstep, osRealizowanych, osZakonczonych, pasek, dzisNaOsi, spisKomputer,
} = await daneListyGrantow(lang);
// Wiersz „Kierownik: … · zakład · numer” i krótka linia pod tytułem w małych wierszach.
const rodzaj = (g: Grant) => RODZAJE_GRANTOW[g.data.rodzaj]?.[lang] ?? '';
const kierownicyTekst = (g: Grant) => kier(g).map((x) => x.nazwa).join(', ');
// części linii pod tytułem (puste pomijane); na końcu numer projektu cyframi tabelarycznymi (.nr), a bez numeru — program (jak w prototypie)
const czesciKont = (g: Grant, ...czesci: string[]) => [
  ...czesci.filter(Boolean).map((t) => ({ t, nr: false })),
  ...(g.data.kod ? [{ t: g.data.kod, nr: true }] : g.data.program ? [{ t: programGrantu(g.data.program, lang), nr: false }] : []),
];
const dzisR = osRealizowanych && dzisNaOsi(osRealizowanych);
const dzisZ = osZakonczonych && dzisNaOsi(osZakonczonych);
---
<Podstrona lang={lang} tytul={naglowek} opis={lead} uklad="zwarta portal-baner" lead={lead} haslo={haslo}
  okruszki={[{ etykieta: T('Nauka', 'Research'), adres: '/nauka' }, { etykieta: naglowek }]} dzial="nauka" spis={spisKomputer} klasa="z-gr">
  <Fragment slot="baner">
      <ul class="pt-liczby">
        {liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}
      </ul>
  </Fragment>
    {wstep.length > 0 && <section class="tresc">{wstep.map((a, i) => <p class={i === 0 ? 'wst' : undefined}>{a}</p>)}</section>}

    <section id="z-realizowane" aria-labelledby="z-h-realizowane">
      <h2 id="z-h-realizowane">{T('Realizowane', 'Ongoing')} ({realizowane.length})</h2>
      {realizowane.length === 0 && <p>{T('Obecnie brak realizowanych projektów.', 'No ongoing projects at the moment.')}</p>}
      {osRealizowanych && (
        <div class="os-lat" aria-hidden="true"><span></span><span class="tor-os">{osRealizowanych.podzialka.map((p) => <b style={`left:${p.x}%`}>{p.rok}</b>)}</span></div>
      )}
      {osRealizowanych && realizowane.map((g) => {
        const z = zakladProjektu(g);
        const k = kier(g);
        const p = pasek(g, osRealizowanych);
        const lata = lataGrantu(g);
        return (
          <div class="gr-w">
            <div>
              <div class="rola">{[rodzaj(g), lata].filter(Boolean).join(' · ')}</div>
              <div class="imie"><a href={adresGrantu(g)}>{tytul(g)}</a></div>
              <div class="kont">
                {czesciKont(g,
                  k.length > 0 ? `${k.length > 1 ? T('Kierownicy', 'Principal investigators') : T('Kierownik', 'Principal investigator')}: ${kierownicyTekst(g)}` : '',
                  z ? wybierz(z.data, 'nazwa', lang) : '',
                ).map((c, i) => <>{i > 0 && ' · '}{c.nr ? <span class="nr">{c.t}</span> : c.t}</>)}
              </div>
            </div>
            <span class="tor duzy" aria-hidden="true">{p && <span class="pas" style={`left:${p.left}%;width:${p.width}%`}></span>}{dzisR && <i style={`left:${dzisR}%`}></i>}</span>
          </div>
        );
      })}
    </section>

    {zakonczone.length > 0 && osZakonczonych && (
      <section id="z-zakonczone" aria-labelledby="z-h-zakonczone">
        <h2 id="z-h-zakonczone">{T('Zakończone', 'Completed')} ({zakonczone.length})</h2>
        <div class="os-lat maly" aria-hidden="true"><span></span><span class="tor-os">{osZakonczonych.podzialka.map((p) => <b style={`left:${p.x}%`}>{p.rok}</b>)}</span></div>
        {grupy.map((gr) => (
          <>
            <h3 class="gr-rok">{gr.rok}<span class="sr-only">, </span> <small>{ileProjektow(gr.lista.length)}</small></h3>
            {gr.lista.map((g) => {
              const p = pasek(g, osZakonczonych);
              return (
                <div class="gr-w maly">
                  <div>
                    <a href={adresGrantu(g)} class="gr-t">{tytul(g)}</a>
                    <div class="kont">
                      {czesciKont(g, rodzaj(g), kierownicyTekst(g), lataGrantu(g)).map((c, i) => <>{i > 0 && ' · '}{c.nr ? <span class="nr">{c.t}</span> : c.t}</>)}
                    </div>
                  </div>
                  <span class="tor" aria-hidden="true">{p && <span class="pas" style={`left:${p.left}%;width:${p.width}%`}></span>}{dzisZ && <i style={`left:${dzisZ}%`}></i>}</span>
                </div>
              );
            })}
          </>
        ))}
      </section>
    )}

    {bezLat.length > 0 && (
      <section id="z-pozostale" aria-labelledby="z-h-pozostale">
        <h2 id="z-h-pozostale">{T('Pozostałe', 'Other')} ({bezLat.length})</h2>
        {bezLat.map((g) => (
          <div class="gr-w maly">
            <div>
              <a href={adresGrantu(g)} class="gr-t">{tytul(g)}</a>
              <div class="kont">
                {czesciKont(g, rodzaj(g), kierownicyTekst(g)).map((c, i) => <>{i > 0 && ' · '}{c.nr ? <span class="nr">{c.t}</span> : c.t}</>)}
              </div>
            </div>
            <span></span>
          </div>
        ))}
      </section>
    )}
</Podstrona>
