---
// Konferencje: nadchodzące u góry (sekcja .zsec jak na stronach działów), minione według lat.
// Konferencje nie mają naszych podstron: każda pozycja prowadzi od razu na stronę konferencji (pole `strona`, ta sama
// karta przeglądarki, ikona „zewnętrzny” przy tytule); konferencja bez strony — pozycja bez linku (<div>, bez podświetlenia).
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal”, reszta strony jak w wariancie „Zwarta”
// (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok na końcu pliku); lista jak w kalendarzu — wspólny
// styl list z global.css: rok = sekcja z kreską (.lista-miesiac), konferencje = osobne białe karty (.karty-lista);
// nadchodzące (.event) w takich samych kartach, jedna pod drugą.
// Telefon (≤ 760 px): lata jako małe etykiety, konferencje jako wiersze (cały wiersz jest linkiem); „Nadchodzące”
// z kreską sekcji.
// Tekst wprowadzający zaraz pod banerem (TekstWstepny: src/data/dzialy/nauka.json, pola konferencje_tekst / konferencje_tekst_en; puste = brak).
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import TekstWstepny from '../components/TekstWstepny.astro';
import TytulZewn from '../components/TytulZewn.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import dzial from '../data/dzialy/nauka.json';
import { dayNum, monthShort, range, today, type Lang } from '../lib/daty';
import { miejsce, konferencje, trwaLubBedzie, type Konferencja } from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const wszystkie = await konferencje();
const przyszle = wszystkie.filter((k) => trwaLubBedzie({ poczatek: k.data.poczatek, koniec: k.data.koniec })).reverse();
const minione = wszystkie.filter((k) => !przyszle.includes(k));
const lata: { rok: string; lista: Konferencja[] }[] = [];
for (const k of minione) {
  const r = k.data.poczatek.slice(0, 4);
  const ost = lata[lata.length - 1];
  if (ost && ost.rok === r) ost.lista.push(k);
  else lata.push({ rok: r, lista: [k] });
}
const tytul = (k: Konferencja) => (lang === 'en' && k.data.tytul_en) || k.data.tytul;
// adres strony konferencji (zewnętrzny) albo brak — wtedy pozycja bez linku
const href = (k: Konferencja) => k.data.strona || undefined;
const Tag = (k: Konferencja) => (href(k) ? 'a' : 'div');
const odwolana = lang === 'en' ? 'cancelled' : 'odwołana';
const naglowek = lang === 'en' ? 'Conferences' : 'Konferencje';
const lead = lang === 'en'
  ? 'Conferences and workshops organised or co-organised by members of the Mathematical Institute.'
  : 'Konferencje i warsztaty organizowane lub współorganizowane przez pracowników Instytutu Matematycznego.';
// Telefon (≤ 760 px; zlecenie 01, decyzja 31.10.2026): hasło zamiast opisu (src/data/dzialy/nauka.json,
// konferencje_haslo / _en) i trzy liczby pod kreską — konferencje bez odwołanych: w bieżącym roku (dzień budowania) ·
// wszystkie od pierwszego roku w danych · we Wrocławiu (miejsce zawiera „Wrocław”). Etykieta bez rzeczownika
// („w 2026 roku”), więc ta sama dla każdej liczby.
const haslo = ((dzial as Record<string, any>)[lang === 'en' ? 'konferencje_haslo_en' : 'konferencje_haslo'] as string | undefined) || undefined;
const odbywane = wszystkie.filter((k) => !k.data.odwolana);
const rokTeraz = today().slice(0, 4);
const pierwszyRok = odbywane.map((k) => k.data.poczatek.slice(0, 4)).sort()[0] ?? rokTeraz;
const stala = (pl: string, en: string) => ({ pl: [pl, pl, pl] as [string, string, string], en: [en, en] as [string, string] });
const liczby = [
  { n: odbywane.filter((k) => k.data.poczatek.startsWith(rokTeraz)).length, ...stala(`w ${rokTeraz} roku`, `in ${rokTeraz}`) },
  { n: odbywane.length, ...stala(`od ${pierwszyRok} roku`, `since ${pierwszyRok}`) },
  { n: odbywane.filter((k) => /Wrocław/.test(k.data.miejsce ?? '')).length, ...stala('we Wrocławiu', 'in Wrocław') },
];
---
<Baza tytul={naglowek} opis={lead} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={naglowek} lead={lead} haslo={haslo} lang={lang} okruszki={[{ etykieta: lang === 'en' ? 'Research' : 'Nauka', adres: '/nauka' }, { etykieta: naglowek }]}>
    <LiczbyBanera lang={lang} pozycje={liczby} />
  </NaglowekStrony>
  <div class="wrap layout">
    <div class="main">
      <TekstWstepny pole="konferencje_tekst" lang={lang} />
      <section class="zsec kf-nadch" aria-labelledby="h-nadch">
        <h2 id="h-nadch">{lang === 'en' ? 'Upcoming' : 'Nadchodzące'}</h2>
        {przyszle.length === 0 && <p class="muted kf-brak">{lang === 'en' ? 'No upcoming conferences announced.' : 'Nie zapowiedziano jeszcze kolejnych konferencji.'}</p>}
        <div class="event-grid">
          {przyszle.map((k) => { const T = Tag(k); return (
            <T class:list={['event event-szare', !href(k) && 'kf-bez-linku']} href={href(k)}>
              <span class="datebox" aria-hidden="true"><span class="d">{dayNum(k.data.poczatek)}</span><span class="m">{monthShort(k.data.poczatek, lang)}</span></span>
              <span class="event-body">
                <span class="k">{range(k.data.poczatek, k.data.koniec, lang)}</span>
                <span class="t"><TytulZewn tekst={tytul(k)} zewn={!!href(k)} /></span>
                {k.data.miejsce && <span class="s">{miejsce(k.data.miejsce, lang)}</span>}
              </span>
            </T>
          ); })}
        </div>
      </section>

      {lata.map((g) => (
        <section class="lista-miesiac" aria-labelledby={`rok-${g.rok}`}>
          <h2 id={`rok-${g.rok}`} class="month kf-rok">{g.rok}</h2>
          <div class="karty-lista">
            {g.lista.map((k) => { const T = Tag(k); return (
              <T class:list={['row-item conf-row', !href(k) && 'kf-bez-linku']} href={href(k)}>
                <span class="datebox small minione" aria-hidden="true"><span class="d">{dayNum(k.data.poczatek)}</span><span class="m">{monthShort(k.data.poczatek, lang)}</span></span>
                <span class="body">
                  <span class="t"><TytulZewn tekst={tytul(k)} zewn={!!href(k)} /></span>
                  <span class="news-meta kropki">
                    <span>{range(k.data.poczatek, k.data.koniec, lang)}</span>
                    {k.data.miejsce && <span class="kropka">{miejsce(k.data.miejsce, lang)}</span>}
                    {k.data.odwolana && <span class="badge">{odwolana}</span>}
                  </span>
                </span>
              </T>
            ); })}
          </div>
        </section>
      ))}
    </div>

    <aside class="side" data-pagefind-ignore>
      <nav class="side-box toc toc-side" aria-label={lang === 'en' ? 'Years' : 'Lata'}>
        <h2>{lang === 'en' ? 'Years' : 'Lata'}</h2>
        <ol style="flex-direction:row;flex-wrap:wrap;gap:6px">
          {lata.map((g) => <li><a href={`#rok-${g.rok}`} class="chip" style="display:inline-flex;align-items:center;border-left:1.5px solid var(--line);padding:0 12px;min-height:36px">{g.rok}</a></li>)}
        </ol>
      </nav>
    </aside>
  </div>
</Baza>

<style>
  .kf-brak { margin: 0; }
  .conf-row .t { font-size: 18px; }
  /* konferencja bez strony: bez podświetlenia i podkreślenia po najechaniu */
  .kf-bez-linku:hover { box-shadow: none; }
  .kf-bez-linku:hover .t { text-decoration: none; }
  /* telefon (≤ 760 px): lata jako małe etykiety nad wierszami, jak dotąd (na komputerze — .lista-miesiac w global.css) */
  @media (max-width: 760px) { .kf-rok { margin-top: 28px; font-size: 15px; } }

  /* ---------- komputer (≥ 761 px) ----------
     Odstęp nad pierwszą sekcją stały (24 px), jak na stronie działu „Nauka” (reszta odstępów .layout — uklad-zwarta.css).
     Minione: karty .karty-lista (global.css), jak w kalendarzu. Nadchodzące (.event, tło i ramka z .event-szare) —
     takie same karty jedna pod drugą: odstęp 10 px, wnętrze i data jak w kalendarzu (.row-item z .datebox.small). */
  @media (min-width: 761px) {
    .layout { padding-top: 24px; }
    .karty-lista > .kf-bez-linku:hover { border-color: var(--line); }
    .kf-nadch .event-grid { display: flex; flex-direction: column; gap: 10px; }
    .kf-nadch .event { align-items: flex-start; gap: 14px; padding: 16px 20px; border-radius: var(--radius-l); transition: border-color .15s; }
    .kf-nadch .event:hover { border-color: var(--ink); box-shadow: none; }
    .kf-nadch .event.kf-bez-linku:hover { border-color: var(--line); }
    .kf-nadch .datebox { flex: 0 0 46px; height: 50px; border-radius: 9px; }
    .kf-nadch .datebox .d { font-size: 19px; }
    .kf-nadch .event .t { font-size: 18px; }
  }
  @media (min-width: 761px) and (prefers-reduced-motion: reduce) { .kf-nadch .event { transition: none; } }
</style>
