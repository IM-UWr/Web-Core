---
// Konferencje (/nauka/konferencje), kierunek „Założyciele”, szablon podstrony zal/Podstrona.astro: tekst wprowadzający
// (src/data/dzialy/nauka.json, pola konferencje_tekst / _en; puste = brak), nadchodzące u góry, minione według lat
// (rok jako nagłówek Brygadą w kolorze działu, kotwice #rok-RRRR bez zmian). Spis „Na tej stronie”: Nadchodzące i lata.
// Konferencje nie mają naszych podstron: tytuł prowadzi od razu na stronę konferencji (pole `strona`, ↗; cały wiersz
// klikalny); konferencja bez strony — wiersz bez linku. Wiersze jak na stronie działu (zal/dzial/Wiersz.astro): dzień
// początku dużą Brygadą w kolorze działu, pod nim „mie rrrr”, nad tytułem daty i miejsce.
// Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css, klasa .tresc): sekcje h2 z kreską między nimi,
// lata jako podsekcje h3, etykieta .etyk, pierwszy akapit .wst. Własne style (na końcu pliku) tylko dla wiersza z datą.
// Jedna wersja HTML: komputer (≥ 761 px; minione w dwóch kolumnach) i telefon (≤ 760 px, jedna kolumna).
import Link from '../components/Link.astro';
import Podstrona from '../components/zal/Podstrona.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import dzialNauka from '../data/dzialy/nauka.json';
import { odmiana, wybierz, langPola } from '../lib/i18n';
import { dayNum, monthShort, parse, range, type Lang } from '../lib/daty';
import { miejsce, type Konferencja } from '../lib/tresci';
import { daneListyKonferencji } from '../lib/widoki/listaKonferencji';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const tytul = (k: Konferencja) => (lang === 'en' && k.data.tytul_en) || k.data.tytul;
const { przyszle, lata, odwolana, naglowek, lead, haslo, liczby } = await daneListyKonferencji(lang);
// tekst wprowadzający z CMS (jak dotychczasowy TekstWstepny.astro)
const wstep = ((wybierz(dzialNauka as Record<string, any>, 'konferencje_tekst', lang) as string) || '')
  .split(/\n\s*\n/).map((a) => a.trim()).filter(Boolean);
const etykieta = (k: Konferencja) => [range(k.data.poczatek, k.data.koniec, lang), miejsce(k.data.miejsce, lang)].filter(Boolean).join(' · ');
const ileKonf = (n: number) => `${n} ${odmiana(n, ['konferencja', 'konferencje', 'konferencji'], ['conference', 'conferences'], lang)}`;
const tytulNadch = T('Nadchodzące', 'Upcoming');
// sekcje: nadchodzące i minione (lata jako podsekcje); wspólny wzór wiersza
const sekcje = [
  { id: 'z-nadchodzace', tytul: tytulNadch, grupy: [{ rok: '', lista: przyszle }] },
  ...(lata.length > 0 ? [{ id: 'z-minione', tytul: T('Minione', 'Past'), grupy: lata }] : []),
];
// spis „Na tej stronie”: Nadchodzące i lata (kotwice #rok-RRRR jak dotąd)
const spis = [
  { id: 'z-nadchodzace', etykieta: tytulNadch },
  ...lata.map((g) => ({ id: `rok-${g.rok}`, etykieta: g.rok })),
];
---
<Podstrona lang={lang} tytul={naglowek} opis={lead} uklad="zwarta portal-baner" lead={lead} haslo={haslo}
  okruszki={[{ etykieta: T('Nauka', 'Research'), adres: '/nauka' }, { etykieta: naglowek }]} dzial="nauka" spis={spis} klasa="tresc z-kf">
  <Fragment slot="baner"><LiczbyBanera lang={lang} pozycje={liczby} /></Fragment>

  {wstep.length > 0 && <section>{wstep.map((a, i) => <p class={i === 0 ? 'wst' : undefined}>{a}</p>)}</section>}

  {sekcje.map((sek) => (
    <section id={sek.id} aria-labelledby={`h-${sek.id}`}>
      <h2 id={`h-${sek.id}`}>{sek.tytul}</h2>
      {sek.grupy.every((g) => g.lista.length === 0) && <p class="pusto">{T('Nie zapowiedziano jeszcze kolejnych konferencji.', 'No upcoming conferences announced.')}</p>}
      {sek.grupy.filter((g) => g.lista.length > 0).map((g) => (
        <>
          {g.rok && <h3 id={`rok-${g.rok}`}>{g.rok}<span class="sr-only">, </span> <small>{ileKonf(g.lista.length)}</small></h3>}
          <ul class:list={['wiersze', g.rok && 'dwie']}>
            {g.lista.map((k) => (
              <li class:list={['wiersz', k.data.strona && 'klik']}>
                <time class="dz" datetime={k.data.poczatek.slice(0, 10)}>{dayNum(k.data.poczatek)}<small> {monthShort(k.data.poczatek, lang)} {parse(k.data.poczatek).y}</small></time>
                <div>
                  <p class="etyk">{etykieta(k)}{k.data.odwolana && <span class="odw">{odwolana}</span>}</p>
                  <h4 lang={langPola(k.data, 'tytul', lang)}>
                    {k.data.strona
                      ? <Link href={k.data.strona}>{tytul(k)}</Link>
                      : tytul(k)}
                  </h4>
                </div>
              </li>
            ))}
          </ul>
        </>
      ))}
    </section>
  ))}
</Podstrona>

<style>
  /* Wiersz z datą (jak zal/dzial/Wiersz.astro): dzień | etykieta, tytuł. Reszta (sekcje, podsekcje h3, etykieta .etyk,
     akapity) — wzorzec treści .tresc (src/styles/zal-tresc.css). */
  .wiersze { list-style: none; margin: 0; padding: 0; }
  .wiersze > li { max-width: none; margin: 0; font-size: inherit; }
  .wiersz { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .wiersz .dz { font-family: var(--f-display); font-size: 34px; line-height: 1; color: var(--d-a); }
  .wiersz .dz small { display: block; margin-top: 4px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  .wiersz .etyk { margin: 0; }
  .wiersz .odw { margin-left: 8px; padding: 1px 7px; border: 1px solid var(--line); border-radius: 3px; font-size: 11.5px; font-weight: 700; color: var(--muted); }
  .wiersz h4 { margin: 2px 0 0; font-family: var(--f-display); font-weight: 500; font-size: 21px; line-height: 1.3; color: var(--ink); }
  .wiersz h4 a { color: inherit; text-decoration: none; }
  .wiersz a.zew::after { font-family: var(--f-text); font-size: .75em; color: var(--muted); }
  .pusto { font-style: italic; color: var(--muted); }
  /* cały wiersz klikalny (link w tytule), fokus na całym wierszu */
  .klik { position: relative; }
  .klik h4 a::before { content: ''; position: absolute; inset: 0; } /* nakładka na ::before — ::after to strzałka ↗ linku poza stronę */
  .klik:hover h4 a { color: var(--d-a); }
  .klik h4 a:focus-visible { outline: none; }
  .klik:has(h4 a:focus-visible) { outline: 3px solid var(--d-a); outline-offset: 4px; border-radius: 2px; }
  /* rok (podsekcja): liczba konferencji małym krojem tekstu */
  h3 small { margin-left: 8px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }

  /* ---------- komputer (≥ 761 px): minione w dwóch kolumnach ---------- */
  @media (min-width: 761px) {
    .wiersze.dwie { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; }
    .wiersze.dwie .wiersz h4 { font-size: 19px; }
  }

  /* ---------- telefon (≤ 760 px): jedna kolumna, mniejszy dzień ---------- */
  @media (max-width: 760px) {
    .wiersz { grid-template-columns: 54px minmax(0, 1fr); gap: 12px; padding: 13px 0; }
    .wiersz .dz { font-size: 28px; }
    .wiersz .dz small { font-size: 12.5px; white-space: nowrap; }
    .wiersz h4 { font-size: 18.5px; }
  }
</style>
