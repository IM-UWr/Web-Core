---
// Podstrona pozycji „Warto wiedzieć” (powstaje tylko, gdy pozycja ma treść). Kierunek „Założyciele”, szablon podstrony
// (zal/Podstrona.astro) i wzorzec treści (klasa .tresc — src/styles/zal-tresc.css; zlecenie 11, zalecenie 14).
// W nagłówku tytuł i „← Warto wiedzieć”. Treść: etykieta „rok · dział” (link do działu), zajawka jako pierwszy akapit (.wst),
// zdjęcie z podpisem, treść z Markdown (podzielona na sekcje po nagłówkach ##, żeby działały kreski i spis „Na tej stronie”),
// przycisk-link (pole „link”) i „Zobacz też” — pozostałe pozycje jako lista linków (WartoWiedziec.astro, uklad „linki”;
// powtórzenie, poza indeksem wyszukiwarki). Jedna wersja HTML: komputer i telefon (≤ 760 px).
import type { CollectionEntry } from 'astro:content';
import Podstrona from '../components/zal/Podstrona.astro';
import WartoWiedziec from '../components/WartoWiedziec.astro';
import ZdjecieZ from '../components/ZdjecieZ.astro';
import { u, isExternal } from '../lib/url';
import { t, wJezyku } from '../lib/i18n';
import { slugOf } from '../lib/tresci';
import { renderMarkdown } from '../lib/markdown';
import type { Lang } from '../lib/daty';
import { daneWpisuWartoWiedziec } from '../lib/widoki/wartoWiedziecWpis';

interface Props { wpis: CollectionEntry<'warto_wiedziec'>; lang: Lang }
const { wpis, lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
const { d, tytul, zajawka, htmlEn, tylkoPolski, dzial, haslo, zewnetrzny, etykietaLinku, opisObrazu, wszystkie } = await daneWpisuWartoWiedziec(wpis, lang);

// Treść jako HTML (ten sam renderer co treść kolekcji: remark-math, rehype-katex, rehype-base — astro.config.mjs) i podział
// na sekcje po <h2>: pierwsza część (przed pierwszym nagłówkiem) idzie do sekcji z zajawką i zdjęciem.
const html = htmlEn || (await renderMarkdown(wpis.body ?? '', lang));
const [poczatek, ...dalsze] = html.split(/(?=<h2[\s>])/);
const sekcje = dalsze.map((h) => {
  const m = h.match(/^<h2[^>]*\bid="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/);
  return { html: h, id: m?.[1], etykieta: (m?.[2] ?? '').replace(/<[^>]+>/g, '').trim() };
});
const spis = [
  ...sekcje.filter((s) => s.id).map((s) => ({ id: s.id!, etykieta: s.etykieta })),
  { id: 'zobacz-tez', etykieta: T('Zobacz też', 'See also') },
];
const jezykTresci = tylkoPolski ? 'pl' : undefined;
const przycisk = d.link ? { adres: href(d.link), etykieta: etykietaLinku, zew: zewnetrzny } : undefined;
---
<Podstrona lang={lang} tytul={tytul} opis={zajawka || undefined} obraz={d.obraz} opublikowany={d.opublikowany} typ="article"
  lead={zajawka || undefined} haslo={haslo} wstecz={{ etykieta: wszystkie, adres: '/warto-wiedziec' }} dzial="instytut"
  spis={sekcje.length ? spis : []} klasa="tresc">
  <section>
    <p class="etyk ww-meta">{d.rok && <>{d.rok} · </>}<a href={href(dzial.adres)}>{dzial[lang]}</a></p>
    {zajawka && <p class="wst">{zajawka}</p>}
    {d.obraz && (
      <figure class="ww-foto">
        <ZdjecieZ src={d.obraz} alt={opisObrazu} sizes="(min-width: 820px) 760px, calc(100vw - 32px)" loading="eager" />
        {opisObrazu && <figcaption>{opisObrazu}</figcaption>}
      </figure>
    )}
    {tylkoPolski && <div class="uwaga"><p lang="en">{t('en', 'wersjaPolska')}</p></div>}
    {poczatek && <div class="ww-tresc" lang={jezykTresci} set:html={poczatek} />}
    {przycisk && sekcje.length === 0 && <p class="akcja glowny"><a class="przycisk glowny" href={przycisk.adres}>{przycisk.etykieta}<span aria-hidden="true">{przycisk.zew ? ' ↗' : ' →'}</span></a></p>}
  </section>
  {sekcje.map((s, i) => (
    <section>
      <div class="ww-tresc" lang={jezykTresci} set:html={s.html} />
      {przycisk && i === sekcje.length - 1 && <p class="akcja glowny"><a class="przycisk glowny" href={przycisk.adres}>{przycisk.etykieta}<span aria-hidden="true">{przycisk.zew ? ' ↗' : ' →'}</span></a></p>}
    </section>
  ))}
  <section id="zobacz-tez" aria-labelledby="zobacz-tez-h" data-pagefind-ignore>
    <h2 id="zobacz-tez-h">{T('Zobacz też', 'See also')}</h2>
    <WartoWiedziec lang={lang} uklad="linki" pomin={slugOf(wpis.id)} />
  </section>
</Podstrona>

<style>
  .ww-meta a { color: inherit; text-decoration: none; }
  .ww-meta a:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* zdjęcie pozycji: bez zaokrągleń i cieni, podpis przygaszony */
  .ww-foto { margin: 6px 0 22px; }
  .ww-foto :global(img) { display: block; width: 100%; max-width: 760px; height: auto; }
  .ww-foto figcaption { margin-top: 6px; font-size: 13.5px; line-height: 1.5; color: var(--muted); }
  /* treść z Markdown: listy jak lista z kreskami wzorca (ul.kreski), tabele jak tabela wzorca */
  .ww-tresc :global(ul) { list-style: none; max-width: 42.7em; margin: 0 0 16px; padding: 0; }
  .ww-tresc :global(ul > li) { position: relative; margin: 6px 0; padding-left: 24px; }
  .ww-tresc :global(ul > li)::before { content: ''; position: absolute; left: 0; top: .84em; width: 12px; height: 2px; background: var(--d-a); }
  .ww-tresc :global(ol) { max-width: 42.7em; margin: 0 0 16px; padding-left: 24px; }
  .ww-tresc :global(img) { max-width: 100%; height: auto; }
  .akcja { margin: 22px 0 0; }
</style>
