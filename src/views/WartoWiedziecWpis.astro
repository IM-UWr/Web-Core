---
// Strona nagrody albo historii „Warto wiedzieć” (/instytut/warto-wiedziec/<plik>; zlecenie 47, punkt 6; wygląd: prototyp v4.15 —
// w-medal-uniwersytetu.html, w-pierwsze-wyklady.html). Powstaje tylko, gdy wpis ma Treść (wpis bez Treści prowadzi do karta.link).
// Szablon podstrony (zal/Podstrona.astro) i wzorzec treści (.tresc — src/styles/zal-tresc.css): tytuł, „← Warto wiedzieć”, hasło jak linia meta.
// Treść: linia meta („1945 · Historie”, „Nagrody i wyróżnienia” — link do sekcji listy), zajawka jako wstęp (.wst), zdjęcie z opisem,
// Treść z jawnego Markdownu (sekcje po ##, także :::laureaci i :::pliki) i przycisk linku z karty; dalej „Ludzie w tej historii”
// (przy nagrodzie z laureatami „Sylwetki laureatów”: sylwetki, do których Treść linkuje) i „Zobacz też w »…«” (pozostałe wpisy grupy,
// lista linków; poza indeksem wyszukiwarki). /en bez Treści EN: ramka „Translation in preparation” z linkiem do strony polskiej.
import Link from '../components/Link.astro';
import Podstrona from '../components/zal/Podstrona.astro';
import WartoWiedziec from '../components/WartoWiedziec.astro';
import RamkiWW from '../components/ww/RamkiWW.astro';
import ZdjecieZ from '../components/ZdjecieZ.astro';
import { u, isExternal } from '../lib/url';
import { wJezyku } from '../lib/i18n';
import { parsujLata } from '../lib/ww.mjs';
import { ADRES_WW, portretHtml, type WW } from '../lib/wartoWiedziec';
import { daneWpisuWW, sekcjeWpisu } from '../lib/widoki/wartoWiedziecWpis';
import type { Lang } from '../lib/daty';
import '../styles/warto-wiedziec.css';

interface Props { wpis: WW; lang: Lang }
const { wpis: w, lang } = Astro.props;
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
const { T, tytul, tytulLang, zajawka, zajawkaLang, tresc, bezTlumaczenia, wstecz, nazwaGrupy, wszystkie } = await daneWpisuWW(w, lang);
const { ludzie, ludzieTytul, pozostale, przycisk, opisObrazu } = await sekcjeWpisu(w, wszystkie, lang);
const rok = w.grupa === 'historie' && w.rok !== undefined ? String(w.rok) : '';
const haslo = [rok, nazwaGrupy].filter(Boolean).join(' · ');
const sekcje = (tresc?.sekcje ?? []).map((s, i) => ({ ...s, id: s.id || `sekcja-${i + 1}` }));
const zobacz = lang === 'en' ? `See also in “${nazwaGrupy}”` : `Zobacz też w „${nazwaGrupy}”`;
const spis = [
  ...sekcje.map((s) => ({ id: s.id, etykieta: s.etykieta })),
  ...(tresc?.zrodla ? [{ id: 'zrodla', etykieta: tresc.zrodla.etykieta }] : []),
  ...(ludzie.length ? [{ id: 'ludzie', etykieta: ludzieTytul }] : []),
  ...(pozostale.length ? [{ id: 'zobacz-tez', etykieta: lang === 'en' ? 'See also' : 'Zobacz też' }] : []),
];
const wszystkieSekcje = [...sekcje, ...(tresc?.zrodla ? [{ ...tresc.zrodla, id: 'zrodla' }] : [])];
// przycisk linku z karty: pod Treścią (w ostatniej sekcji albo w pierwszej, gdy Treść nie ma sekcji)
const ostatnia = wszystkieSekcje.length - 1;
---
<Podstrona lang={lang} tytul={tytul} tytulLang={tytulLang} opis={zajawka || undefined} obraz={w.obraz || undefined} opublikowany={w.data.opublikowany} typ="article"
  uklad="zwarta portal-baner" haslo={haslo} hasloBezLiczb wstecz={wstecz} dzial="instytut" spis={spis.length > 1 ? spis : []} klasa="tresc z-ww2">
  <section>
    <p class="etyk ww-meta">{rok && <>{rok} · </>}<a href={href(`${ADRES_WW}#${w.grupa}`)}>{nazwaGrupy}</a></p>
    {zajawka && <p class="wst" lang={zajawkaLang}>{zajawka}</p>}
    {w.obraz && (
      <figure class="ww-foto">
        <ZdjecieZ src={w.obraz} alt={opisObrazu} sizes="(min-width: 820px) 760px, calc(100vw - 32px)" loading="eager" />
        {opisObrazu && <figcaption>{opisObrazu}</figcaption>}
      </figure>
    )}
    <RamkiWW lang={lang} bledy={tresc?.bledy} tlumaczenie={bezTlumaczenia ? `${ADRES_WW}/${w.slug}` : undefined} />
    {tresc?.wstep && <div class="ww2-tresc"><div class="prose" set:html={tresc.wstep} /></div>}
    {przycisk && ostatnia < 0 && <p class="akcja glowny"><Link class="przycisk glowny" href={href(przycisk.adres)} lang={lang}>{przycisk.etykieta}{!przycisk.zew && <span aria-hidden="true"> →</span>}</Link></p>}
  </section>
  {wszystkieSekcje.map((s, i) => (
    <section id={s.id} aria-labelledby={`${s.id}-h`}>
      <h2 id={`${s.id}-h`} set:html={s.naglowek} />
      <div class:list={['ww2-tresc', s.id === 'zrodla' && 'ww2-zrodla']}><div class="prose" set:html={s.html} /></div>
      {przycisk && i === ostatnia && <p class="akcja glowny"><Link class="przycisk glowny" href={href(przycisk.adres)} lang={lang}>{przycisk.etykieta}{!przycisk.zew && <span aria-hidden="true"> →</span>}</Link></p>}
    </section>
  ))}
  {ludzie.length > 0 && (
    <section id="ludzie" aria-labelledby="ludzie-h">
      <h2 id="ludzie-h">{ludzieTytul}</h2>
      <ul class="ww2-ludzie">
        {ludzie.map((o) => (
          <li><a href={href(`${ADRES_WW}/${o.slug}`)}><Fragment set:html={portretHtml(o)} /><span><b>{o.tytul}</b>{o.lata && <small>{parsujLata(o.lata, lang).tekst}</small>}<i>{T('Sylwetka', 'Profile')} <span aria-hidden="true">→</span></i></span></a></li>
        ))}
      </ul>
    </section>
  )}
  {pozostale.length > 0 && (
    <section id="zobacz-tez" aria-labelledby="zobacz-tez-h" data-pagefind-ignore>
      <h2 id="zobacz-tez-h">{zobacz}</h2>
      <WartoWiedziec lang={lang} wpisy={pozostale} uklad="linki" />
    </section>
  )}
</Podstrona>

<style>
  .ww-meta a { color: inherit; text-decoration: none; }
  .ww-meta a:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* zdjęcie wpisu: bez zaokrągleń i cieni, podpis przygaszony */
  .ww-foto { margin: 6px 0 22px; }
  .ww-foto :global(img) { display: block; width: 100%; max-width: var(--szer-akapitu); height: auto; }
  .ww-foto figcaption { margin-top: 6px; font-size: 13.5px; line-height: 1.5; color: var(--muted); }
  .akcja { margin: 22px 0 0; }
</style>
