---
// Pojedyncza aktualność (/aktualnosci/<wpis>, EN /en/aktualnosci/<wpis>) na wspólnym szablonie podstrony
// (zal/Podstrona.astro; zlecenie 12, etap 3). Strona poza działami: granatowy nagłówek podstrony z tytułem wpisu
// i „← Wszystkie aktualności” (dotąd pasek z linkiem powrotu bez banera), bez spisu „Na tej stronie”.
// Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css, klasa .tresc): pierwsza sekcja to wpis — etykieta
// „Rodzaj · Opublikowano … · dla: …”, zajawka jako pierwszy akapit (p.wst), karta ze zdjęciem i blokiem wydarzenia (data jak
// na stronach działów, pary „Kiedy / Gdzie”, stan: trwa / odbyło się), tekst (.prose), pełny album (przycisk-link); dalej sekcje
// „Galeria” (Galeria.tsx — podgląd na pełnym ekranie), „Załączniki” (ul.pliki) i „Najbliższe wydarzenia” (WierszWydarzenia.astro;
// tylko gdy są blisko), kreski między sekcjami; na końcu „Nowszy / Starszy wpis”.
// Bez przycisku „Udostępnij” (decyzja 30.10.2026: nigdzie na stronie).
// Karta (zlecenie 18, punkt 4; podgląd: wariant B „karta boczna”). Jedna wersja HTML:
// - okno ≥ 1104 px: dwie kolumny, treść i przyklejona karta 360 px; sekcja wpisu ma display: contents, żeby karta mogła iść
//   przez całą wysokość lewej kolumny, także obok Galerii i Załączników;
// - okno 1024–1103 px (lewa kolumna miałaby mniej niż 560 px): karta nad tekstem na całą szerokość, zdjęcie z lewej, szczegóły z prawej;
// - telefon (≤ 1023 px): karta ma display: contents, czyli jedna kolumna: blok wydarzenia między liniami, pod nim zdjęcie;
//   „Nowszy / Starszy wpis” jeden pod drugim.
// Wpis bez zdjęcia: karta z samym blokiem wydarzenia. Bez zdjęcia i bez wydarzenia: bez karty, prawa kolumna pusta.
import Link from '../components/Link.astro';
import Podstrona from '../components/zal/Podstrona.astro';
import Ikona from '../components/Ikona.astro';
import WierszWydarzenia from '../components/WierszWydarzenia.astro';
import Galeria from '../components/Galeria.tsx';
import ZdjecieZ from '../components/ZdjecieZ.astro';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz, RODZAJE, ODBIORCY, langPola } from '../lib/i18n';
import { short, longWithDay, range, dayNum, monthShort, parse, hasTime, type Lang } from '../lib/daty';
import { slugOf, type Aktualnosc } from '../lib/tresci';
import { daneAktualnosci } from '../lib/widoki/aktualnosc';
import { zdjecie } from '../lib/zdjecia';
import { sizesTelefon } from '../lib/media';
import { dzialWpisu } from '../lib/patroni';

interface Props {
  wpis: Aktualnosc;
  lang: Lang;
  nowszy?: Aktualnosc;
  starszy?: Aktualnosc;
}
const { wpis, lang, nowszy, starszy } = Astro.props;
const d = wpis.data;
const en = lang === 'en';
const tytulInny = (w?: Aktualnosc) => (w ? (lang === 'en' && w.data.tytul_en) || w.data.tytul : '');
const { tytul, zajawka, opisZdjecia, Content, htmlEn, tylkoPolski, wydarzenie, minelo, trwa, najblizsze, dzialWiersza } = await daneAktualnosci(wpis, lang);
// Wpis o wydarzeniu w kolorze swojego wiersza na liście (zlecenie 21, punkt 6): etykieta, data i linki w tekście; reszta jak dotąd (zalozyciele.css, .akt-wydarzenie).
const oWydarzeniu = d.rodzaj === 'wydarzenie';
const href = (a: string) => (isExternal(a) ? a : u(a));
// typ pliku z prawej w liście plików (wzorzec: „PDF”, „strona ↗”)
const typPliku = (a: string) => (isExternal(a) && !/\.[a-z0-9]{2,5}$/i.test(a.split(/[?#]/)[0]) ? (en ? 'website' : 'strona') : (a.split(/[?#]/)[0].match(/\.([a-z0-9]{2,5})$/i)?.[1] ?? '').toUpperCase());
// karta: zdjęcie nie większe niż plik (małe zdjęcia, np. 400 px, były rozciągane)
const zKarta = !!d.zdjecie || !!wydarzenie;
const szerPliku = (await zdjecie(d.zdjecie))?.width;
const dlaTekst = d.dla.length > 0 ? `${t(lang, 'dla')}: ${d.dla.map((x) => ODBIORCY[x][lang].toLowerCase()).join(', ')}` : '';
---
<Podstrona lang={lang} tytul={tytul} tytulLang={langPola(d, 'tytul', lang)} opis={zajawka} obraz={d.zdjecie} opublikowany={d.opublikowany} typ="article" uklad="zwarta"
  wstecz={{ etykieta: t(lang, 'wszystkieAktualnosci'), adres: '/aktualnosci' }} dzial={oWydarzeniu ? dzialWpisu(d) : undefined}
  klasa={['tresc', zKarta && 'akt-z-karta', oWydarzeniu && 'akt-wydarzenie'].filter(Boolean).join(' ')} klasaRamy={zKarta ? 'z-pd-pelna' : undefined}>
  <section class="akt-wpis">
    <p class="etyk akt-meta"><span>{RODZAJE[d.rodzaj][lang]}</span> · <span>{t(lang, 'opublikowano')} <time datetime={d.data.slice(0, 10)}>{short(d.data, lang)}</time></span>{dlaTekst && <> · <span>{dlaTekst}</span></>}</p>
    {zajawka && <p class="wst" lang={langPola(d, 'zajawka', lang)}>{zajawka}</p>}

    {zKarta && <div class="akt-karta">
    {wydarzenie && (
      <div class="akt-wyd" role="group" aria-label={en ? 'Event details' : 'Szczegóły wydarzenia'}>
        <span class:list={['akt-wyd-data', { minione: minelo && !oWydarzeniu }]} aria-hidden="true">{dayNum(wydarzenie.poczatek)}<small>{monthShort(wydarzenie.poczatek, lang)} {parse(wydarzenie.poczatek).y}</small></span>
        <dl class="para">
          <dt>{t(lang, 'kiedy')}</dt>
          <dd>{wydarzenie.koniec && wydarzenie.koniec.slice(0, 10) !== wydarzenie.poczatek.slice(0, 10) ? range(wydarzenie.poczatek, wydarzenie.koniec, lang) : longWithDay(wydarzenie.poczatek, lang) + (wydarzenie.koniec && hasTime(wydarzenie.koniec) ? `–${wydarzenie.koniec.slice(11, 16)}` : '')}</dd>
          {wydarzenie.miejsce && <><dt>{t(lang, 'gdzie')}</dt><dd>{wydarzenie.miejsce}</dd></>}
        </dl>
        {/* bez przycisku „Dodaj do kalendarza” (decyzja: nigdzie na stronie); zostaje stan: trwa / odbyło się */}
        {(minelo || trwa) && <span class="etyk akt-stan">{t(lang, minelo ? 'odbylo' : 'trwa')}</span>}
      </div>
    )}

    {d.zdjecie && (
      <figure class="akt-fot">
        <ZdjecieZ src={d.zdjecie} alt={opisZdjecia} sizes={`${sizesTelefon('calc(100vw - 32px)')}, (min-width: 1104px) 328px, 240px`} loading="eager" style={szerPliku ? `--szer-pliku: ${szerPliku}px` : undefined} />
        {opisZdjecia && <figcaption>{opisZdjecia}</figcaption>}
      </figure>
    )}
    </div>}

    {tylkoPolski && <p class="akt-uwaga" lang="en">{t('en', 'wersjaPolska')}</p>}
    <div class="prose" lang={tylkoPolski ? 'pl' : undefined}>
      {htmlEn ? <Fragment set:html={htmlEn} /> : <Content />}
    </div>

    {d.album && (
      <p class="akcja"><Link href={d.album}>{t(lang, 'album')}</Link></p>
    )}
  </section>

  {d.galeria.length > 0 && (
    <section class="akt-galeria" aria-labelledby="h-galeria">
      <h2 id="h-galeria">{t(lang, 'galeria')}</h2>
      <Galeria
        client:visible
        zdjecia={d.galeria.map((g) => ({ src: u(g.plik), podpis: g.podpis }))}
        etykieta={t(lang, 'galeria')}
        zamknij={en ? 'Close' : 'Zamknij'}
        poprzednie={en ? 'Previous photo' : 'Poprzednie zdjęcie'}
        nastepne={en ? 'Next photo' : 'Następne zdjęcie'}
      />
    </section>
  )}

  {d.zalaczniki.length > 0 && (
    <section aria-labelledby="h-zal">
      <h2 id="h-zal">{t(lang, 'zalaczniki')}</h2>
      <ul class="pliki">
        {d.zalaczniki.map((z) => (
          <li><Link href={href(z.plik)}><Ikona nazwa="plik" rozmiar={18} /><span>{wybierz(z, 'nazwa', lang) || z.plik.split('/').pop()}</span><span class="typ">{typPliku(z.plik)}</span></Link></li>
        ))}
      </ul>
    </section>
  )}

  {najblizsze.length > 0 && (
    <section aria-labelledby="h-najbl" data-pagefind-ignore>
      <h2 id="h-najbl">{t(lang, 'najblizsze')}</h2>
      <div class="akt-najbl">{najblizsze.map((w) => <WierszWydarzenia w={w} lang={lang} dzial={dzialWiersza(w)} />)}</div>
    </section>
  )}

  {(nowszy || starszy) && (
    <nav class="akt-pn" aria-label={en ? 'Other posts' : 'Inne wpisy'} data-pagefind-ignore>
      {nowszy ? (
        <a href={u(wJezyku(`/aktualnosci/${slugOf(nowszy.id)}`, lang))}><small>← {t(lang, 'nowszy')}</small>{langPola(nowszy.data, 'tytul', lang) ? <span lang="pl">{tytulInny(nowszy)}</span> : tytulInny(nowszy)}</a>
      ) : <span />}
      {starszy && (
        <a class="akt-starszy" href={u(wJezyku(`/aktualnosci/${slugOf(starszy.id)}`, lang))}><small>{t(lang, 'starszy')} →</small>{langPola(starszy.data, 'tytul', lang) ? <span lang="pl">{tytulInny(starszy)}</span> : tytulInny(starszy)}</a>
      )}
    </nav>
  )}
</Podstrona>

<style>
  .akt-meta span:not(:first-child) { color: var(--muted); }
  .akt-meta { margin-bottom: 8px; }

  /* blok wydarzenia: data jak na stronach działów, pary „Kiedy / Gdzie”, stan — między cienkimi liniami, bez ramki */
  .akt-wyd { display: grid; grid-template-columns: 76px minmax(0, 1fr) auto; gap: 18px; align-items: start; max-width: 800px; margin: 4px 0 24px; padding: 16px 0;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .akt-wyd-data { font-family: var(--f-display); font-weight: 500; font-size: 34px; line-height: 1; color: var(--d-a); }
  /* miniona data szara tylko we wpisie innego rodzaju niż wydarzenie (np. ogłoszenie z terminem); wydarzenie ma kolor jak na liście */
  .akt-wyd-data.minione { color: var(--muted); }
  .akt-wyd-data small { display: block; margin-top: 4px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  .akt-wyd dl { gap: 4px 14px; font-size: 15.5px; line-height: 1.55; }
  .akt-wyd dd { color: var(--ink); }
  .akt-wyd .akt-stan { margin: 2px 0 0; color: var(--muted); }

  .akt-fot { margin: 0 0 22px; max-width: 800px; }
  .akt-fot :global(img) { display: block; width: 100%; height: auto; }
  .akt-fot figcaption { margin-top: 8px; font-size: 13.5px; line-height: 1.5; color: var(--muted); }
  .akt-uwaga { font-style: italic; color: var(--muted); }

  /* telefon: karta nie ma własnego pudełka, blok wydarzenia i zdjęcie stoją w toku tekstu */
  .akt-karta { display: contents; }

  /* ---------- karta: komputer (≥ 1024 px), zdjęcie nad blokiem wydarzenia ---------- */
  /* Telefon i komputer: ta sama definicja co MQ_TELEFON i MQ_KOMPUTER w src/lib/media.ts (zlecenie 23, punkt 1) */
  @media (min-width: 1024px) and (min-height: 501px), (min-width: 1024px) and (pointer: fine) {
    .akt-karta { display: grid; gap: 14px; padding: 16px 16px 18px; border-radius: 5px; background: var(--surface); }
    .akt-karta .akt-fot { order: -1; max-width: none; margin: 0; }
    .akt-karta .akt-fot :global(img) { max-width: min(100%, var(--szer-pliku, 100%)); border-radius: 3px; }
    .akt-karta .akt-wyd { grid-template-columns: 56px minmax(0, 1fr); gap: 4px 14px; max-width: none; margin: 0; padding: 0; border: 0; }
    .akt-karta:has(.akt-fot) .akt-wyd { padding-top: 12px; border-top: 1px solid var(--line); }
    .akt-karta .akt-wyd-data { grid-row: 1 / span 2; font-size: 30px; }
    .akt-karta .akt-wyd-data small { white-space: nowrap; }
    .akt-karta .akt-wyd dl { grid-template-columns: minmax(0, 1fr); gap: 0; font-size: 15px; }
    .akt-karta .akt-wyd dd + dt { margin-top: 6px; }
    .akt-karta .akt-wyd .akt-stan { grid-column: 2; }
  }

  /* ---------- okno 1024–1103 px: karta nad tekstem na całą szerokość, zdjęcie z lewej, szczegóły z prawej ---------- */
  @media (min-width: 1024px) and (min-height: 501px) and (max-width: 1103.98px), (min-width: 1024px) and (pointer: fine) and (max-width: 1103.98px) {
    .akt-karta { grid-template-columns: 240px minmax(0, 1fr); column-gap: 20px; align-items: start; margin: 4px 0 24px; }
    .akt-karta:has(.akt-fot) .akt-wyd { padding-top: 0; border-top: 0; }
    .akt-karta:not(:has(.akt-fot)), .akt-karta:not(:has(.akt-wyd)) { grid-template-columns: minmax(0, 1fr); }
    .akt-karta:not(:has(.akt-wyd)) .akt-fot { display: grid; grid-template-columns: 240px minmax(0, 1fr); column-gap: 20px; align-items: start; }
    .akt-karta:not(:has(.akt-wyd)) .akt-fot figcaption { margin-top: 0; }
  }

  /* ---------- okno ≥ 1104 px: dwie kolumny. Rzędy: lewa kolumna idzie po kolei (auto), a ostatni rząd (1fr) bierze nadmiar wysokości,
     gdy karta jest wyższa od tekstu; bez niego nadmiar rozkładałby się na odstępy między akapitami ---------- */
  @media (min-width: 1104px) and (min-height: 501px), (min-width: 1104px) and (pointer: fine) {
    :global(.z-pd-tresc.akt-z-karta) { display: grid; grid-template-columns: minmax(0, 1fr) 360px; grid-template-rows: repeat(12, auto) 1fr; column-gap: 56px; }
    :global(.z-pd-tresc.akt-z-karta > *), .akt-wpis > * { grid-column: 1; min-width: 0; }
    .akt-wpis { display: contents; }
    .akt-wpis > .akt-karta { grid-column: 2; grid-row: 1 / -1; align-self: start; position: sticky; top: calc(var(--gora) + 16px);
      max-height: calc(100vh - var(--gora) - 32px); overflow-y: auto; overscroll-behavior: contain; }
    /* odstęp i kreska po sekcji wpisu (zal-tresc.css: .tresc > section) na jej ostatnim elemencie, bo sama sekcja nie ma pudełka */
    .akt-wpis:not(:last-of-type) > :last-child { padding-bottom: 44px; margin-bottom: 40px; border-bottom: 1px solid var(--line); }
  }
  .akt-galeria :global(.gallery button) { border-radius: 0; }

  /* „Nowszy / Starszy wpis”: jak „Następna strona w dziale” — gruba kreska nad, tytuły Brygadą */
  .akt-pn { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 44px 0 0; padding-top: 14px; border-top: 2px solid var(--rule); }
  .akt-pn a { font-family: var(--f-display); font-weight: 500; font-size: 20px; line-height: 1.3; color: var(--ink); text-decoration: none; }
  .akt-pn a:hover { color: var(--d-a); }
  .akt-pn a:focus-visible { outline: 2px solid var(--d-a); outline-offset: 3px; }
  .akt-pn small { display: block; margin-bottom: 2px; font-family: var(--f-text); font-size: 13px; font-weight: 700; color: var(--d-a); }
  .akt-pn .akt-starszy { text-align: right; }

  @media (max-width: 1023px), (max-height: 500px) and (pointer: coarse) {
    .akt-wyd { grid-template-columns: 54px minmax(0, 1fr); gap: 6px 12px; }
    .akt-wyd-data { font-size: 28px; }
    .akt-wyd-data small { font-size: 12px; }
    .akt-wyd dl { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .akt-wyd dd + dt { margin-top: 4px; }
    .akt-wyd .akt-stan { grid-column: 2; }
    .akt-pn { grid-template-columns: 1fr; gap: 14px; margin-top: 30px; }
    .akt-pn a { font-size: 18.5px; }
    .akt-pn .akt-starszy { text-align: left; }
  }
</style>
