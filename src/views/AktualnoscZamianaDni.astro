---
// Automatyczne ogłoszenie o zamianie dni: /aktualnosci/zamiana-dni-RRRR-MM-DD (EN /en/aktualnosci/…).
// Tekst z szablonu w src/data/kolory-dni.json (pole „aktualnosci”, Pages CMS → Kalendarz zajęć), dane z tej samej zamiany.
// Na listach aktualności pozycja jest tylko w oknie widoczności (od N dni roboczych przed zamianą do dnia zamiany);
// sama strona istnieje zawsze (stare linki działają), poza oknem bez indeksowania i bez wyszukiwarki strony.
// Układ wspólnego szablonu podstrony (rama .z-pd i treść .z-pd-tresc jak w zal/Podstrona.astro, bez spisu; zlecenie 12,
// etap 3) i wzorzec treści (zalecenie 14, src/styles/zal-tresc.css): granatowy nagłówek z tytułem i „← Wszystkie aktualności”,
// etykieta wpisu, ramka uwagi po zamianie, dzień zamiany (kółko w kolorze dnia ze skrótem planu, data, plan, kolor dnia
// i semestr) między cienkimi liniami, tekst, przycisk-link do kalendarza, sekcja „Zobacz też” (ul.linki).
// Szablon Podstrona.astro nie przekazuje do Baza.astro `szukaj` ani slotu „head” (noindex poza oknem), dlatego rama jest
// tu złożona z tych samych elementów ręcznie. Jedna wersja HTML: komputer (≥ 761 px) i telefon (≤ 760 px).
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import { u } from '../lib/url';
import { t, wJezyku, RODZAJE, ODBIORCY } from '../lib/i18n';
import { short, longWithDay, type Lang } from '../lib/daty';
import { nazwaSemestru, opisZamiany, NAZWA_KOLORU, SKROT_PLANU } from '../lib/kolory-dni';
import { daneAktualnosciZamianyDni } from '../lib/widoki/aktualnoscZamianaDni';

interface Props { data: string; lang: Lang }
const { data, lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const { a, d, html, minela, dla, kalendarz } = await daneAktualnosciZamianyDni(data, lang);
const wielka = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<Baza tytul={a.tytul} opis={a.zajawka} typ="article" szukaj={a.wOknie} uklad="zwarta">
  {!a.wOknie && <meta slot="head" name="robots" content="noindex" />}
  <NaglowekStrony tytul={a.tytul} lang={lang} wstecz={{ etykieta: t(lang, 'wszystkieAktualnosci'), adres: '/aktualnosci' }} />
  <div class="z-pd">
    <div class="z-pd-tresc tresc">
      <section class="zd">
        <p class="etyk zd-meta"><span>{RODZAJE.ogloszenie[lang]}</span> · <span>{t(lang, 'opublikowano')} <time datetime={a.od}>{short(a.od, lang)}</time></span> · <span>{t(lang, 'dla')}: {dla.map((x) => ODBIORCY[x][lang].toLowerCase()).join(', ')}</span></p>

        {minela && <div class="uwaga"><p>{T('Ta zamiana dni już się odbyła.', 'This day swap has already taken place.')}</p></div>}

        <div class="zd-dzien" data-kolor={d.kolor ?? 'brak'} role="group" aria-label={T('Zamiana dni', 'Day swap')}>
          <span class="zd-skrot" aria-hidden="true">{SKROT_PLANU[lang][d.plan ?? d.dzienTygodnia]}</span>
          <div>
            <span class="etyk">{wielka(longWithDay(a.data, lang))}</span>
            <p class="zd-plan">{wielka(opisZamiany(d.plan ?? d.dzienTygodnia, lang))}</p>
            {d.kolor && <p class="zd-kolor">{T(`Dzień ${NAZWA_KOLORU.pl[d.kolor]}`, `${wielka(NAZWA_KOLORU.en[d.kolor])} day`)} · {nazwaSemestru(a.semestr, lang)}</p>}
          </div>
        </div>

        <div class="prose">
          <Fragment set:html={html} />
        </div>
        <p class="akcja"><a href={kalendarz}>{T('Kalendarz zajęć — rok akademicki', 'Class calendar — academic year')}</a></p>
      </section>

      <section aria-labelledby="zd-tez-h" data-pagefind-ignore>
        <h2 id="zd-tez-h">{T('Zobacz też', 'See also')}</h2>
        <ul class="linki">
          <li><a href={u(wJezyku('/studia/rok-akademicki', lang))}>{T('Rok akademicki i kolory dni', 'Academic year and day colours')}</a></li>
          <li><a href={u(wJezyku('/studia/plan-zajec', lang))}>{T('Plan zajęć', 'Timetable')}</a></li>
        </ul>
      </section>
    </div>
  </div>
</Baza>

<style>
  .zd {
    --kd-n: #a3ebf8; --kd-n-ink: #053947; --kd-n-mocny: #0e9cbc;
    --kd-p: #ffd699; --kd-p-ink: #4a2900; --kd-p-mocny: #e0841b;
  }
  :global(:root[data-theme='dark']) .zd {
    --kd-n: #0d4a58; --kd-n-ink: #cdf5fe; --kd-n-mocny: #3cc8e6;
    --kd-p: #5c3708; --kd-p-ink: #ffe1b3; --kd-p-mocny: #f2a33a;
  }
  .zd-meta { margin-bottom: 14px; }
  .zd-meta span:not(:first-child) { color: var(--muted); }
  .zd .uwaga { margin: 0 0 18px; }

  /* dzień zamiany: kółko w kolorze dnia ze skrótem planu, obok data, plan i kolor — między cienkimi liniami, bez karty */
  .zd-dzien { display: flex; align-items: center; gap: 20px; max-width: 800px; margin: 4px 0 22px; padding: 16px 0;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .zd-skrot { flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; border: 2px dashed var(--line);
    font-size: 22px; font-weight: 900; letter-spacing: .02em; line-height: 1; color: var(--muted); }
  [data-kolor='niebieski'] > .zd-skrot { border: 0; background: var(--kd-n-mocny); color: #04222b; }
  [data-kolor='pomaranczowy'] > .zd-skrot { border: 0; background: var(--kd-p-mocny); color: #2b1700; }
  .zd-dzien p { margin: 0; }
  .zd-dzien .zd-plan { font-family: var(--f-display); font-weight: 500; font-size: 26px; line-height: 1.25; color: var(--ink); }
  .zd-dzien .zd-kolor { margin-top: 4px; font-size: 15.5px; line-height: 1.55; }
  .zd .akcja { margin-top: 18px; }

  @media (max-width: 760px) {
    .zd-dzien { align-items: flex-start; gap: 14px; }
    .zd-skrot { width: 54px; height: 54px; font-size: 18px; }
    .zd-dzien .zd-plan { font-size: 22px; }
  }
</style>
