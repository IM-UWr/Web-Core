---
// Lista aktualności z filtrem rodzaju i szukaniem (filtrowanie w przeglądarce); ?dla=studenci itp. z linków zawęża listę (z przyciskiem „pokaż wszystkie”).
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal”, reszta strony jak w wariancie „Zwarta”
// (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok niżej).
// Telefon (≤ 760 px; decyzja 31.10.2026): pod hasłem w banerze trzy liczby (nowe ogłoszenia, nadchodzące wydarzenia,
// zapowiedziane referaty — zlecenie 01), filtry w jednym wierszu — lista rozwijana rodzajów i pole szukania z krótką podpowiedzią. Baner, wiersz
// filtrów i etykiety — wspólne z Kalendarzem (LiczbyBanera, FiltrISzukaj, EtykietaRodzaju; jeden styl, decyzja 31.10.2026).
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import WierszAktualnosci from '../components/WierszAktualnosci.astro';
import FiltrISzukaj from '../components/FiltrISzukaj.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import ustawienia from '../data/ustawienia.json';
import { u } from '../lib/url';
import { t, wJezyku, RODZAJE_FILTRY, ODBIORCY } from '../lib/i18n';
import { monthYear, type Lang } from '../lib/daty';
import { listaAktualnosci } from '../lib/tresci';
import { liczbyTerminow, noweOgloszenia, ETYKIETY } from '../lib/liczbyTerminow';

interface Props { lang: Lang }
const { lang } = Astro.props;
const lista = await listaAktualnosci(lang);
// Bez prawego paska „Najbliższe wydarzenia” (decyzja: lista na całą szerokość; wydarzenia są na głównej i w kalendarzu).

// Grupowanie po miesiącach
const grupy: { miesiac: string; pozycje: typeof lista }[] = [];
for (const p of lista) {
  const m = monthYear(p.data, lang);
  const ost = grupy[grupy.length - 1];
  if (ost && ost.miesiac === m) ost.pozycje.push(p);
  else grupy.push({ miesiac: m, pozycje: [p] });
}
const rodzaje = ['ogloszenie', 'wydarzenie', 'sukces', 'kariera', 'obrona'].filter((r) => lista.some((p) => p.rodzaj === r));
const lead = lang === 'en' ? 'Announcements, events and achievements of the Mathematical Institute.' : 'Ogłoszenia, wydarzenia i sukcesy Instytutu Matematycznego.';
// Hasło na telefonie zamiast opisu (NaglowekStrony.astro; decyzja 31.10.2026). Opis zostaje na komputerze i w <meta description>.
const haslo = lang === 'en' ? "What's new at the Institute" : 'Co słychać w Instytucie';
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);

// Liczby w banerze — na razie tylko na telefonie, pod hasłem, jak w innych działach (decyzja 31.10.2026; komputer później):
// nowe ogłoszenia (z datą publikacji z ostatnich 30 dni) · nadchodzące wydarzenia · zapowiedziane referaty — definicje
// wspólne z Kalendarzem i innymi banerami (src/lib/liczbyTerminow.ts; zlecenie 01). Etykiety bez okresu „z 30 dni”
// (zlecenie 01: liczby wydarzeń i referatów nie mają okna czasowego). Pozycje z zerem pomijamy (LiczbyBanera.astro).
const terminy = await liczbyTerminow();
const liczby = [
  { n: await noweOgloszenia(lista), ...ETYKIETY.ogloszenia },
  { n: terminy.wydarzenia, ...ETYKIETY.wydarzenia },
  { n: terminy.referaty, ...ETYKIETY.referaty },
];
// Filtr rodzaju: na komputerze przyciski, na telefonie lista rozwijana obok pola szukania (jeden wiersz; decyzja 31.10.2026;
// FiltrISzukaj.astro — wspólny z Kalendarzem). Nazwy rodzajów w liczbie mnogiej (RODZAJE_FILTRY w i18n.ts), podpowiedź
// w polu szukania na telefonie krótsza.
const filtrEtykieta = T('Filtruj według rodzaju', 'Filter by type');
const szukajDlugo = T('Szukaj w aktualnościach', 'Search news');
const szukajKrotko = T('Szukaj', 'Search');
---
<Baza tytul={t(lang, 'aktualnosci')} opis={lead} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={t(lang, 'aktualnosci')} lead={lead} haslo={haslo} lang={lang} okruszki={[{ etykieta: t(lang, 'aktualnosci') }]}>
    <LiczbyBanera lang={lang} pozycje={liczby} />
  </NaglowekStrony>

  <div class="wrap layout">
    <div class="main" data-lista>
      {/* Rodzaje wpisów i wyszukiwarka w lewej kolumnie, nad listą (wyszukiwarka zaraz za przyciskami; bez wydarzeń kolumna jest szersza). */}
      <div class="filters filters-lewo">
        <div class="chips tylko-komputer" role="group" aria-label={filtrEtykieta}>
          <button type="button" class="chip" aria-pressed="true" data-rodzaj="">{t(lang, 'wszystkie')}</button>
          {rodzaje.map((r) => <button type="button" class="chip" aria-pressed="false" data-rodzaj={r}>{RODZAJE_FILTRY[r][lang]}</button>)}
        </div>
        {/* telefon: te same rodzaje jako lista rozwijana (wspólny stan z przyciskami w skrypcie niżej) i pole szukania */}
        <FiltrISzukaj lang={lang} rodzaje={rodzaje} etykieta={filtrEtykieta} szukajDlugo={szukajDlugo} szukajKrotko={szukajKrotko} />
      </div>
      <p class="dla-info" data-dla-info hidden>
        <span>{lang === 'en' ? 'Showing posts for:' : 'Pokazuję wpisy dla:'} {Object.entries(ODBIORCY).map(([k, v]) => <strong data-dla-etykieta={k} hidden>{v[lang].toLowerCase()}</strong>)}</span>
        <button type="button" class="chip" data-dla-wyczysc>{lang === 'en' ? 'Show all' : 'Pokaż wszystkie'}</button>
      </p>
      {grupy.map((g) => (
        <section class="lista-miesiac" data-grupa>
          <h2 class="month">{g.miesiac}</h2>
          {/* komputer: miesiąc jako sekcja z kreską (.lista-miesiac), wpisy jako osobne białe karty (.karty-lista) — global.css; telefon bez zmian */}
          <div class="karty-lista">{g.pozycje.map((p) => <WierszAktualnosci p={p} lang={lang} />)}</div>
        </section>
      ))}
      <p class="muted" data-pusto hidden>{lang === 'en' ? 'No posts match the selected filters.' : 'Brak wpisów spełniających wybrane kryteria.'}</p>
      <p class="muted la-archiwum">
        {lang === 'en' ? 'Posts published before April 2026 are available in the ' : 'Wpisy sprzed kwietnia 2026 znajdziesz w '}
        <a href={ustawienia.archiwum}>{lang === 'en' ? 'archive of the old website' : 'archiwum starej strony'}</a>.
      </p>
    </div>

  </div>
</Baza>

<script>
  const lista = document.querySelector('[data-lista]');
  const pozycje = Array.from(document.querySelectorAll<HTMLElement>('[data-lista] .row-item'));
  const grupy = Array.from(document.querySelectorAll<HTMLElement>('[data-grupa]'));
  const pusto = document.querySelector<HTMLElement>('[data-pusto]');
  const szukaj = document.querySelector<HTMLInputElement>('[data-szukaj]');
  const rodzajBtn = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-rodzaj]'));
  const rodzajLista = document.querySelector<HTMLSelectElement>('[data-rodzaj-lista]');
  const dlaInfo = document.querySelector<HTMLElement>('[data-dla-info]');
  let rodzaj = '';
  let dla = '';
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ł/g, 'l');
  const znanyRodzaj = (r: string) => rodzajBtn.some((b) => (b.dataset.rodzaj ?? '') === r);

  function filtruj() {
    const q = norm(szukaj?.value.trim() ?? '');
    let ile = 0;
    for (const p of pozycje) {
      const ok = (!rodzaj || p.dataset.rodzaj === rodzaj) && (!dla || (p.dataset.dla ?? '').split(' ').includes(dla)) && (!q || norm(p.textContent ?? '').includes(q));
      p.hidden = !ok;
      if (ok) ile++;
    }
    for (const g of grupy) g.hidden = !g.querySelector('.row-item:not([hidden])');
    if (pusto) pusto.hidden = ile > 0;
    // plakietki odbiorców zwinięte do „+N” (WierszAktualnosci.astro) liczą się tylko w widocznych wierszach — przelicz
    document.dispatchEvent(new Event('wa-przelicz'));
  }
  // Rodzaj: wspólny stan przycisków (komputer) i listy rozwijanej (telefon). Oba elementy są zawsze w dokumencie
  // (jeden schowany przez CSS), więc przejście przez 760 px (obrót telefonu, zmiana okna) nie gubi filtra.
  function ustawRodzaj(r: string) {
    rodzaj = znanyRodzaj(r) ? r : '';
    rodzajBtn.forEach((o) => o.setAttribute('aria-pressed', String((o.dataset.rodzaj ?? '') === rodzaj)));
    if (rodzajLista) rodzajLista.value = rodzaj;
    filtruj();
  }
  rodzajBtn.forEach((b) => b.addEventListener('click', () => ustawRodzaj(b.dataset.rodzaj ?? '')));
  rodzajLista?.addEventListener('change', () => ustawRodzaj(rodzajLista?.value ?? ''));
  // ?dla=… z linku (np. „Aktualności dla studentów”): zawężenie z informacją i przyciskiem „Pokaż wszystkie”
  const ustawDla = (d: string) => {
    const znane = !!d && !!dlaInfo?.querySelector(`[data-dla-etykieta="${CSS.escape(d)}"]`);
    dla = znane ? d : '';
    if (dlaInfo) {
      dlaInfo.hidden = !dla;
      dlaInfo.querySelectorAll<HTMLElement>('[data-dla-etykieta]').forEach((e) => (e.hidden = e.dataset.dlaEtykieta !== dla));
    }
    filtruj();
  };
  dlaInfo?.querySelector('[data-dla-wyczysc]')?.addEventListener('click', () => {
    ustawDla('');
    const url = new URL(location.href);
    url.searchParams.delete('dla');
    history.replaceState(history.state, '', url);
  });
  szukaj?.addEventListener('input', filtruj);
  // (podpowiedź w polu szukania przy zmianie szerokości okna — FiltrISzukaj.astro)
  if (lista) {
    const p = new URLSearchParams(location.search);
    const d = p.get('dla');
    if (d) ustawDla(d);
    const r = p.get('rodzaj');
    // lista rozwijana zawsze zgodna ze stanem (także gdy przeglądarka przywróciła jej wartość po powrocie na stronę)
    ustawRodzaj(r && znanyRodzaj(r) ? r : '');
  }
</script>

<style>
  .la-archiwum { margin-top: 28px; }
  /* telefon (≤ 760 px): filtry w jednym wierszu — FiltrISzukaj.astro, style w telefon.css („Wiersz filtrów list”) */
  /* ---------- komputer (≥ 761 px): wariant „Zwarta” ----------
     Odstęp listy od banera stały (24 px), jak na stronach działów; mniej miejsca nad odnośnikiem do archiwum. */
  @media (min-width: 761px) {
    .layout { padding-top: 24px; }
    /* więcej miejsca między przyciskami filtrów a kreską pierwszego miesiąca (jak odstęp między sekcjami) */
    .filters.filters-lewo { margin-bottom: 22px; }
    /* przyciski rodzajów i wyszukiwarka w jednym wierszu */
    .filters.filters-lewo { flex-wrap: nowrap; }
    .filters.filters-lewo > .chips { flex: 0 1 auto; }
    /* wyszukiwarka trochę szersza (300 px zamiast ok. 255), żeby podpowiedź „Szukaj w aktualnościach” nie była ucinana
       przy szerszych czcionkach (np. na Windowsie) */
    .filters.filters-lewo :global(.search) { width: 300px; }
    .la-archiwum { margin-top: 18px; }
  }
</style>
