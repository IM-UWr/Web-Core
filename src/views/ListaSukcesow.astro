---
// Sukcesy: aktualności z rodzajem „sukces”, pogrupowane według lat (najnowsze na górze). Na komputerze jak w kalendarzu
// (wspólny styl list z global.css): rok = sekcja z kreską (.lista-miesiac), wpisy = osobne białe karty (.karty-lista);
// telefon — lata jako małe etykiety i wiersze, jak dotąd.
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal” (liczby w jednym wierszu w banerze),
// reszta strony jak w wariancie „Zwarta” (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok na końcu pliku).
// Telefon (≤ 760 px; zlecenie 01, decyzje 31.10.2026): baner jak w działach — hasło (nauka.json: sukcesy_haslo /
// sukcesy_haslo_en) zamiast opisu i trzy liczby pod kreską (LiczbyBanera): wpisy o sukcesach · z nich w bieżącym roku ·
// lata w archiwum (od najstarszego wpisu do bieżącego roku). Dawnych kafelków .stats pod banerem już nie ma.
// Tekst wprowadzający zaraz pod banerem (TekstWstepny: src/data/dzialy/nauka.json, pola sukcesy_tekst / sukcesy_tekst_en; puste = brak).
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import TekstWstepny from '../components/TekstWstepny.astro';
import Ikona from '../components/Ikona.astro';
import { u, isExternal } from '../lib/url';
import { wJezyku } from '../lib/i18n';
import { short, type Lang } from '../lib/daty';
import { slugOf, type Aktualnosc } from '../lib/tresci';
import { daneListySukcesow } from '../lib/widoki/listaSukcesow';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const tytul = (a: Aktualnosc) => (lang === 'en' && a.data.tytul_en) || a.data.tytul;
const zajawka = (a: Aktualnosc) => (lang === 'en' && a.data.zajawka_en) || a.data.zajawka;
const href = (a: Aktualnosc) => u(wJezyku(`/aktualnosci/${slugOf(a.id)}`, lang));
const zdjecie = (a: Aktualnosc) => (a.data.zdjecie ? (isExternal(a.data.zdjecie) ? a.data.zdjecie : u(a.data.zdjecie)) : undefined);

const { sukcesy, lata, naglowek, lead, archiwumStarejStrony, liczby, haslo, liczbyTelefon } = await daneListySukcesow(lang);
---
<Baza tytul={naglowek} opis={lead} uklad="zwarta portal-baner">
  {/* Komputer: liczby w jednym wierszu w banerze (.pt-liczby, jak na stronie działu „Nauka”).
       Telefon: hasło zamiast opisu i trzy liczby pod kreską (LiczbyBanera, .tylko-telefon). */}
  <NaglowekStrony tytul={naglowek} lead={lead} haslo={haslo} lang={lang} okruszki={[{ etykieta: T('Nauka', 'Research'), adres: '/nauka' }, { etykieta: naglowek }]}>
    {liczby.length > 0 && (
      <ul class="pt-liczby tylko-komputer">
        {liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}
      </ul>
    )}
    <LiczbyBanera lang={lang} pozycje={liczbyTelefon} />
  </NaglowekStrony>
  <div class="wrap layout">
    <div class="main">
      <TekstWstepny pole="sukcesy_tekst" lang={lang} />
      {sukcesy.length === 0 && <p class="muted">{T('Brak wpisów o sukcesach.', 'No achievement posts yet.')}</p>}

      {lata.map((g) => (
        <section aria-labelledby={`rok-${g.rok}`} class="lista-miesiac sukcesy-rok">
          <h2 id={`rok-${g.rok}`} class="month sukcesy-rok-h">{g.rok}<span class="sukcesy-ile">{g.lista.length}</span></h2>
          <div class="karty-lista">
          {g.lista.map((a) => (
            <a class="row-item" href={href(a)}>
              <span class="body">
                <span class="news-meta"><time datetime={a.data.data}>{short(a.data.data)}</time></span>
                <span class="t">{tytul(a)}</span>
                {zajawka(a) && <span class="x">{zajawka(a)}</span>}
              </span>
              {zdjecie(a) && <span class="thumb sukcesy-thumb"><img src={zdjecie(a)} alt="" loading="lazy" /></span>}
            </a>
          ))}
          </div>
        </section>
      ))}
    </div>

    <aside class="side" data-pagefind-ignore>
      {lata.length > 1 && (
        <nav class="side-box toc toc-side" aria-label={T('Lata', 'Years')}>
          <h2>{T('Lata', 'Years')}</h2>
          <ol style="flex-direction:row;flex-wrap:wrap;gap:6px">
            {lata.map((g) => <li><a href={`#rok-${g.rok}`} class="chip" style="display:inline-flex;align-items:center;border-left:1.5px solid var(--line);padding:0 12px;min-height:36px">{g.rok}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="side-box">
        <h2>{T('Wcześniejsze sukcesy', 'Earlier achievements')}</h2>
        <p style="margin:0;font-size:15px">{T(
          'Wybrane wyróżnienia pracowników i absolwentów Instytutu do 2014 roku zebraliśmy w zestawieniu historycznym.',
          'Selected distinctions of the Institute’s staff and graduates up to 2014 are listed in a historical overview.',
        )}</p>
        <a class="link-arrow" href={u(wJezyku('/nauka/sukcesy/historia', lang))}>{T('Zestawienie historyczne', 'Historical overview')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
        <a class="link-arrow" href={archiwumStarejStrony}>{T('Archiwum starej strony', 'Archive of the old website')}<Ikona nazwa="zewnetrzny" rozmiar={13} /></a>
      </div>
    </aside>
  </div>
</Baza>

<style>
  .sukcesy-rok-h { display: flex; align-items: center; gap: 10px; scroll-margin-top: 16px; }
  /* telefon (≤ 760 px): rok jako mała etykieta nad wierszami (na komputerze — .lista-miesiac w global.css) */
  @media (max-width: 760px) { .sukcesy-rok-h { margin-top: 28px; font-size: 15px; } }
  .sukcesy-ile { display: inline-flex; align-items: center; justify-content: center; min-width: 26px; height: 22px; padding: 0 8px; border-radius: 999px; background: var(--surface); color: var(--muted); font-size: 12px; letter-spacing: 0; }
  .sukcesy-thumb { flex-basis: 112px; height: 112px; }
  .sukcesy-thumb img { object-position: center top; }

  /* ---------- komputer (≥ 761 px): wariant „Zwarta” (odstępy .layout — uklad-zwarta.css) ----------
     Odstęp nad listą stały (24 px), jak na stronie działu „Nauka”; licznik wpisów przy roku w linii tytułu sekcji. */
  @media (min-width: 761px) {
    .layout { padding-top: 24px; }
    .sukcesy-ile { font-weight: 800; }
  }
</style>
