---
// Sukcesy (/nauka/sukcesy), kierunek „Założyciele”, szablon podstrony zal/Podstrona.astro: aktualności z rodzajem „sukces”
// według lat (najnowsze na górze; rok jako podsekcja h3 z liczbą wpisów, kotwice #rok-RRRR bez zmian) i „Wcześniejsze
// sukcesy” (zestawienie historyczne, archiwum starej strony). Spis „Na tej stronie”: lata i wcześniejsze sukcesy.
// Tekst wprowadzający pod banerem (src/data/dzialy/nauka.json, pola sukcesy_tekst / _en; puste = brak).
// Wiersze z jednym wzorem daty (jak zal/dzial/Wiersz.astro): dzień dużą Brygadą w kolorze działu, pod nim „mie rrrr”;
// tytuł Brygadą (cały wiersz prowadzi do wpisu), zajawka, z prawej miniatura zdjęcia wpisu (jeśli jest; na telefonie bez).
// Baner (bez zmian): hasło (nauka.json: sukcesy_haslo / _en) i liczby w jednej liście .pt-liczby — na telefonie
// pokazywała się już ta sama lista (zal-telefon.css), więc dawnej listy telefonu (LiczbyBanera, liczbyTelefon) nie ma.
// Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css, klasa .tresc); własne style (na końcu pliku)
// tylko dla wierszy z datą. Jedna wersja HTML: komputer (≥ 761 px) i telefon (≤ 760 px).
import Podstrona from '../components/zal/Podstrona.astro';
import dzialNauka from '../data/dzialy/nauka.json';
import { u, isExternal } from '../lib/url';
import { odmiana, wJezyku, wybierz } from '../lib/i18n';
import { dayNum, monthShort, parse, type Lang } from '../lib/daty';
import { slugOf, type Aktualnosc } from '../lib/tresci';
import { daneListySukcesow } from '../lib/widoki/listaSukcesow';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const tytul = (a: Aktualnosc) => (lang === 'en' && a.data.tytul_en) || a.data.tytul;
const zajawka = (a: Aktualnosc) => (lang === 'en' && a.data.zajawka_en) || a.data.zajawka;
const href = (a: Aktualnosc) => u(wJezyku(`/aktualnosci/${slugOf(a.id)}`, lang));
const zdjecie = (a: Aktualnosc) => (a.data.zdjecie ? (isExternal(a.data.zdjecie) ? a.data.zdjecie : u(a.data.zdjecie)) : undefined);

const { sukcesy, lata, naglowek, lead, archiwumStarejStrony, liczby, haslo } = await daneListySukcesow(lang);
// tekst wprowadzający z CMS (jak dotychczasowy TekstWstepny.astro)
const wstep = ((wybierz(dzialNauka as Record<string, any>, 'sukcesy_tekst', lang) as string) || '')
  .split(/\n\s*\n/).map((a) => a.trim()).filter(Boolean);
const ileWpisow = (n: number) => `${n} ${odmiana(n, ['wpis', 'wpisy', 'wpisów'], ['post', 'posts'], lang)}`;
const tytulWczesniej = T('Wcześniejsze sukcesy', 'Earlier achievements');
const spis = [
  ...lata.map((g) => ({ id: `rok-${g.rok}`, etykieta: g.rok })),
  { id: 'z-wczesniej', etykieta: tytulWczesniej },
];
---
<Podstrona lang={lang} tytul={naglowek} opis={lead} uklad="zwarta portal-baner" lead={lead} haslo={haslo}
  okruszki={[{ etykieta: T('Nauka', 'Research'), adres: '/nauka' }, { etykieta: naglowek }]} dzial="nauka" spis={spis} klasa="tresc z-suk">
  <Fragment slot="baner">
    {liczby.length > 0 && (
      <ul class="pt-liczby">
        {liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}
      </ul>
    )}
  </Fragment>

  {wstep.length > 0 && <section>{wstep.map((a, i) => <p class={i === 0 ? 'wst' : undefined}>{a}</p>)}</section>}

  <section id="z-wpisy" aria-labelledby="h-wpisy">
    <h2 id="h-wpisy">{T('Według lat', 'By year')}</h2>
    {sukcesy.length === 0 && <p class="pusto">{T('Brak wpisów o sukcesach.', 'No achievement posts yet.')}</p>}
    {lata.map((g) => (
      <>
        <h3 id={`rok-${g.rok}`}>{g.rok}<span class="sr-only">, </span> <small>{ileWpisow(g.lista.length)}</small></h3>
        <ul class="wiersze">
          {g.lista.map((a) => (
            <li class:list={['wiersz', 'klik', zdjecie(a) && 'z-min']}>
              <time class="dz" datetime={a.data.data.slice(0, 10)}>{dayNum(a.data.data)}<small> {monthShort(a.data.data, lang)} {parse(a.data.data).y}</small></time>
              <div>
                <h4><a href={href(a)}>{tytul(a)}</a></h4>
                {zajawka(a) && <p>{zajawka(a)}</p>}
              </div>
              {zdjecie(a) && <img class="min" src={zdjecie(a)} alt="" loading="lazy" />}
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  <section id="z-wczesniej" aria-labelledby="h-wczesniej">
    <h2 id="h-wczesniej">{tytulWczesniej}</h2>
    <p>{T(
      'Wybrane wyróżnienia pracowników i absolwentów Instytutu do 2014 roku zebraliśmy w zestawieniu historycznym.',
      'Selected distinctions of the Institute’s staff and graduates up to 2014 are listed in a historical overview.',
    )}</p>
    <ul class="linki">
      <li><a href={u(wJezyku('/nauka/sukcesy/historia', lang))}>{T('Zestawienie historyczne', 'Historical overview')}</a></li>
      <li><a class="zew" href={archiwumStarejStrony}>{T('Archiwum starej strony', 'Archive of the old website')}</a></li>
    </ul>
  </section>
</Podstrona>

<style>
  /* Wiersze z datą (jak zal/dzial/Wiersz.astro): dzień | tytuł, zajawka | miniatura. Reszta (sekcje, lata h3, akapity,
     ul.linki) — wzorzec treści .tresc (src/styles/zal-tresc.css). */
  .wiersze { list-style: none; margin: 0; padding: 0; }
  .wiersze > li { max-width: none; margin: 0; font-size: inherit; }
  .wiersz { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .wiersz.z-min { grid-template-columns: 76px minmax(0, 1fr) 112px; }
  .wiersz .dz { font-family: var(--f-display); font-size: 34px; line-height: 1; color: var(--d-a); }
  .wiersz .dz small { display: block; margin-top: 4px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  .wiersz p { margin: 0; max-width: 70ch; font-size: 15.5px; line-height: 1.55; color: var(--text); }
  .wiersz h4 { margin: 0 0 4px; font-family: var(--f-display); font-weight: 500; font-size: 21px; line-height: 1.3; color: var(--ink); }
  .wiersz h4 a { color: inherit; text-decoration: none; }
  .wiersz .min { display: block; width: 112px; height: 112px; object-fit: cover; object-position: center top; background: var(--d-t); }
  .pusto { font-style: italic; color: var(--muted); }
  /* cały wiersz klikalny (link w tytule), fokus na całym wierszu */
  .klik { position: relative; }
  .klik h4 a::after { content: ''; position: absolute; inset: 0; }
  .klik:hover h4 a { color: var(--d-a); }
  .klik h4 a:focus-visible { outline: none; }
  .klik:has(h4 a:focus-visible) { outline: 3px solid var(--d-a); outline-offset: 4px; border-radius: 2px; }
  /* rok (podsekcja): liczba wpisów małym krojem tekstu */
  h3 small { margin-left: 8px; font-family: var(--f-text); font-size: 13px; font-weight: 600; color: var(--muted); }
  .linki { margin-top: 8px !important; }

  /* ---------- telefon (≤ 760 px): mniejszy dzień, bez miniatur (jak dotąd na telefonie; obok dnia za mało miejsca) ---------- */
  @media (max-width: 760px) {
    .wiersz { grid-template-columns: 54px minmax(0, 1fr); gap: 12px; padding: 13px 0; }
    .wiersz.z-min { grid-template-columns: 54px minmax(0, 1fr); }
    .wiersz .dz { font-size: 28px; }
    .wiersz .dz small { font-size: 12.5px; white-space: nowrap; }
    .wiersz h4 { font-size: 18px; }
    .wiersz p { font-size: 15px; }
    .wiersz .min { display: none; }
  }
</style>
