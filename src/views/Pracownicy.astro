---
// Lista pracowników. Każda osoba to osobny plik w src/content/pracownicy (edycja w Pages CMS).
// Kolejność: alfabetycznie po nazwisku; doktorantów komponent dzieli dodatkowo według roku studiów.
// Telefony podajemy tylko przy administracji (pilnuje tego skrypty/sprawdz_tresci.py).
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal”, reszta strony jak w wariancie „Zwarta”
// (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok na końcu pliku).
// Telefon (≤ 760 px; zlecenie 01, decyzje 31.10.2026): baner we wspólnym układzie — tytuł, bursztynowe hasło (pole
// pracownicy_haslo / pracownicy_haslo_en w src/data/dzialy/instytut.json; puste = opis jak dotąd), kreska i liczby
// (osoby · zakłady · doktoranci); pod banerem jeden wiersz filtrów jak w Aktualnościach (TabelaPracownikow.tsx).
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import LiczbyBanera from '../components/LiczbyBanera.astro';
import TabelaPracownikow from '../components/TabelaPracownikow.tsx';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { danePracownikow } from '../lib/widoki/pracownicy';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { osoby, grupy, zaklady, haslo, liczby, motywDane, napisy, lead } = await danePracownikow(lang);
---
<Baza tytul={t(lang, 'pracownicy')} opis={lead} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={t(lang, 'pracownicy')} lead={lead} haslo={haslo} lang={lang} okruszki={[{ etykieta: t(lang, 'instytut'), adres: '/instytut' }, { etykieta: t(lang, 'pracownicy') }]} motywDane={motywDane}>
    <LiczbyBanera lang={lang} pozycje={liczby} />
  </NaglowekStrony>
  <div class="wrap pr-wrap">
    <TabelaPracownikow client:load osoby={osoby} grupy={grupy} zaklady={zaklady} napisy={napisy} />
  </div>
</Baza>

<style>
  .pr-wrap { padding-top: 28px; padding-bottom: 64px; }
  /* telefon (≤ 760 px): wygląd „Portal” — mniej miejsca nad i pod spisem */
  @media (max-width: 760px) { .pr-wrap { padding-top: 16px; padding-bottom: 40px; } }
  /* telefon (zlecenie 01): licznik „Znaleziono N osób” pod wierszem filtrów (TabelaPracownikow.tsx) — jak dawny
     „Liczba osób”; pusty (bez filtra) nie zajmuje miejsca */
  @media (max-width: 760px) {
    .pr-wrap :global(.staff-znaleziono) { margin: 0 0 8px; font-size: 14px; color: var(--muted); }
    .pr-wrap :global(.staff-znaleziono:empty) { margin: 0; }
  }
  /* komputer (≥ 761 px), wariant „Zwarta”: odstęp od stopki jak na innych podstronach (uklad-zwarta.css);
     nad wyszukiwarką stały odstęp 24 px, jak na stronie działu „Instytut” */
  @media (min-width: 761px) { .pr-wrap { padding-top: 24px; padding-bottom: var(--tresc-dol); } }
</style>
