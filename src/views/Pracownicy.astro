---
// Lista pracowników. Każda osoba to osobny plik w src/content/pracownicy (edycja w Pages CMS).
// Kolejność: alfabetycznie po nazwisku; doktorantów komponent dzieli dodatkowo według roku studiów.
// Telefony podajemy tylko przy administracji (pilnuje tego skrypty/sprawdz_tresci.py).
// Wygląd na komputerze (≥ 761 px): baner jak w wariancie „Portal”, reszta strony jak w wariancie „Zwarta”
// (uklad="zwarta portal-baner", style: src/styles/uklad-*.css i blok na końcu pliku). Telefon (≤ 760 px) bez zmian.
import { getCollection } from 'astro:content';
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import TabelaPracownikow, { type Osoba } from '../components/TabelaPracownikow.tsx';
import { t, wybierz, wJezyku } from '../lib/i18n';
import { u } from '../lib/url';
import { zaklady as pobierzZaklady } from '../lib/tresci';
import type { Lang } from '../lib/daty';

interface Props { lang: Lang }
const { lang } = Astro.props;
const nazwisko = (s: string) => s.trim().split(/\s+/).pop() ?? s;
const osoby: Osoba[] = (await getCollection('pracownicy'))
  .filter((p) => p.data.opublikowany !== false)
  // funkcja (np. „Sekretariat”) po angielsku z pola funkcja_en, a gdy puste — po polsku
  .map((p) => {
    const funkcja = wybierz(p.data, 'funkcja', lang);
    return { id: p.id, ...p.data, ...(funkcja ? { funkcja } : {}) };
  })
  .sort((a, b) => nazwisko(a.imie_nazwisko).localeCompare(nazwisko(b.imie_nazwisko), 'pl') || a.imie_nazwisko.localeCompare(b.imie_nazwisko, 'pl'))
  .map(({ opublikowany, funkcja_en, ...o }: any) => o);
const grupy = (['nauczyciel', 'doktorant', 'administracja', 'emeryt'] as const)
  .filter((g) => osoby.some((o) => o.grupa === g))
  .map((g) => ({ id: g, nazwa: t(lang, `g_${g}`) }));
const zaklady = (await pobierzZaklady()).map((z) => ({ id: z.id, nazwa: wybierz(z.data, 'nazwa_krotka', lang) || wybierz(z.data, 'nazwa', lang), href: u(wJezyku(`/instytut/zaklady/${z.id}`, lang)) }));
const napisy = {
  szukaj: lang === 'en' ? 'Search by name, room, e-mail…' : 'Szukaj: nazwisko, pokój, e-mail…',
  grupa: lang === 'en' ? 'Group' : 'Grupa',
  wszyscy: t(lang, 'wszyscy'),
  osob: t(lang, 'osob'),
  imie: t(lang, 'imieNazwisko'),
  rok: t(lang, 'rok'),
  rokBrak: lang === 'en' ? 'Year not specified' : 'Rok nieokreślony',
  email: t(lang, 'email'),
  telefon: t(lang, 'telefon'),
  pokoj: t(lang, 'pokoj'),
  strona: t(lang, 'strona'),
  link: 'WWW',
  brak: lang === 'en' ? 'Nobody matches the search.' : 'Nikogo nie znaleziono.',
  zaklad: lang === 'en' ? 'Department' : 'Zakład',
  wszystkieZaklady: lang === 'en' ? 'All departments' : 'Wszystkie zakłady',
};
const lead = lang === 'en'
  ? 'Contact details of the staff, PhD students and administration of the Mathematical Institute.'
  : 'Dane kontaktowe pracowników, doktorantów i administracji Instytutu Matematycznego.';
---
<Baza tytul={t(lang, 'pracownicy')} opis={lead} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={t(lang, 'pracownicy')} lead={lead} lang={lang} okruszki={[{ etykieta: t(lang, 'instytut'), adres: '/instytut' }, { etykieta: t(lang, 'pracownicy') }]} />
  <div class="wrap pr-wrap">
    <TabelaPracownikow client:load osoby={osoby} grupy={grupy} zaklady={zaklady} napisy={napisy} />
  </div>
</Baza>

<style>
  .pr-wrap { padding-top: 28px; padding-bottom: 64px; }
  /* telefon (≤ 760 px): wygląd „Portal” — mniej miejsca nad i pod spisem */
  @media (max-width: 760px) { .pr-wrap { padding-top: 16px; padding-bottom: 40px; } }
  /* komputer (≥ 761 px), wariant „Zwarta”: odstęp od stopki jak na innych podstronach (uklad-zwarta.css);
     nad wyszukiwarką stały odstęp 24 px, jak na stronie działu „Instytut” */
  @media (min-width: 761px) { .pr-wrap { padding-top: 24px; padding-bottom: var(--tresc-dol); } }
</style>
