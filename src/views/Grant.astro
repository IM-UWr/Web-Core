---
// Strona projektu (/nauka/granty/<slug>), kierunek „Założyciele”, szablon podstrony zal/Podstrona.astro.
// Baner (na każdej szerokości): „← Wszystkie projekty i granty”, tytuł, tytuł w drugim języku i plakietki (źródło, program,
// stan). Treść: dane projektu jako pary etykieta–wartość (dl.para: finansowanie, numer, realizacja, kwota, zakład,
// kierownik, wykonawcy), „Strona projektu ↗” (główny przycisk-link), opis (jeśli jest) i inne projekty tego samego zakładu
// (najwyżej 5, wiersze jak zakończone projekty w Projektach i grantach; link do wszystkich projektów zakładu).
// Wzorzec treści (zlecenie 11, zalecenie 14; src/styles/zal-tresc.css, klasa .tresc); bez spisu „Na tej stronie”
// (jedna sekcja z nagłówkiem). Jedna wersja HTML: komputer (≥ 761 px) i telefon (≤ 760 px).
import Link from '../components/Link.astro';
import Podstrona from '../components/zal/Podstrona.astro';
import { u } from '../lib/url';
import { wJezyku, wybierz, RODZAJE_GRANTOW } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { kierownicyGrantu, lataGrantu, slugOf, type Grant } from '../lib/tresci';
import { tytulyWJezyku } from '../lib/osoby';
import { daneGrantu } from '../lib/widoki/grant';

interface Props { grant: Grant; lang: Lang }
const { grant, lang } = Astro.props;
const d = grant.data;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const adresZakladu = (id: string) => u(wJezyku(`/instytut/zaklady/${id}`, lang));

const {
  tytul, tytulDrugi, maOpis, Content, okres, trwa, rodzaj, finansowanie, program, haslo,
  osoby, kierownicy, zaklad, zakladOsoby, inne, opis,
} = await daneGrantu(grant, lang);
// wiersz innego projektu: tytuł i linia „rodzaj · kierownik · lata · numer” (puste pomijane)
const tytulGrantu = (g: Grant) => (lang === 'en' && g.data.tytul_en) || g.data.tytul;
const linia = (g: Grant) => [RODZAJE_GRANTOW[g.data.rodzaj]?.[lang] ?? '', kierownicyGrantu(g.data.kierownik, osoby, lang).map((k) => k.nazwa).join(', '), lataGrantu(g)]
  .filter(Boolean);
---
<Podstrona lang={lang} tytul={tytul} opis={opis} opublikowany={d.opublikowany} uklad="zwarta portal-baner" haslo={haslo}
  wstecz={{ etykieta: T('Wszystkie projekty i granty', 'All projects and grants'), adres: '/nauka/granty' }} dzial="nauka" klasa="tresc z-grant">
  <Fragment slot="baner">
    {/* D5, zlecenie 16: na /en oryginalny polski tytuł z etykietą */}
    {tytulDrugi && (lang === 'en'
      ? <p class="lead">Original title: <span lang="pl">{tytulDrugi.tekst}</span></p>
      : <p class="lead" lang={tytulDrugi.lang}>{tytulDrugi.tekst}</p>)}
    <div class="tags">
      <span class={`badge${d.rodzaj === 'ncn' ? ' badge-wydarzenie' : d.rodzaj === 'ue' ? ' badge-sukces' : ''}`}>{rodzaj}</span>
      {program && <span class="badge">{program}</span>}
      {d.rok_do !== undefined && <span class={`badge gr-stan${trwa ? ' gr-trwa' : ''}`}>{trwa ? T('realizowany', 'ongoing') : T('zakończony', 'completed')}</span>}
    </div>
  </Fragment>

  <section aria-label={T('Informacje o projekcie', 'Project details')}>
    <dl class="para fakty">
      <dt>{T('Finansowanie', 'Funding')}</dt><dd>{finansowanie}{program ? ` — ${program}` : ''}</dd>
      {d.kod && <><dt>{T('Numer', 'Number')}</dt><dd class="nr">{d.kod}</dd></>}
      {okres && <><dt>{T('Realizacja', 'Duration')}</dt><dd>{okres}</dd></>}
      {d.kwota && <><dt>{T('Kwota', 'Budget')}</dt><dd>{d.kwota}</dd></>}
      {zaklad && <><dt>{T('Zakład', 'Department')}</dt><dd><a href={adresZakladu(zaklad.id)}>{wybierz(zaklad.data, 'nazwa', lang)}</a></dd></>}
      {kierownicy.length > 0 && (
        <>
          <dt>{kierownicy.length > 1 ? T('Kierownicy', 'Principal investigators') : T('Kierownik', 'Principal investigator')}</dt>
          <dd>
            {kierownicy.map((k, i) => {
              const z = zakladOsoby(k.osoba?.data.zaklad);
              return (
                <>
                  {i > 0 && ', '}
                  {k.osoba?.data.strona
                    ? <Link href={k.osoba.data.strona}>{k.nazwa}</Link>
                    : z ? <a href={adresZakladu(z)}>{k.nazwa}</a> : k.nazwa}
                </>
              );
            })}
          </dd>
        </>
      )}
      {d.wykonawcy && <><dt>{T('Wykonawcy', 'Team')}</dt><dd>{tytulyWJezyku(d.wykonawcy, lang)}</dd></>}
    </dl>
    {d.strona && <p class="akcja glowny"><Link href={d.strona}>{T('Strona projektu', 'Project website')}</Link></p>}
    {maOpis && <div class="prose opis"><Content /></div>}
  </section>

  {zaklad && inne.length > 0 && (
    <section id="z-inne" aria-labelledby="h-inne">
      <h2 id="h-inne">{T('Inne projekty zakładu', 'Other projects of the department')}</h2>
      <ul class="inne">
        {inne.slice(0, 5).map((g) => (
          <li class="klik">
            <a class="t" href={u(wJezyku(`/nauka/granty/${slugOf(g.id)}`, lang))}>{tytulGrantu(g)}</a>
            <span class="kont">
              {linia(g).map((c, i) => <>{i > 0 && ' · '}{c}</>)}
              {g.data.kod && <>{linia(g).length > 0 && ' · '}<span class="nr">{g.data.kod}</span></>}
            </span>
          </li>
        ))}
      </ul>
      {inne.length > 5 && (
        <p class="wszystkie"><a href={`${adresZakladu(zaklad.id)}#granty`}>{T(`Wszystkie projekty zakładu (${inne.length + 1})`, `All department projects (${inne.length + 1})`)} <span aria-hidden="true">→</span></a></p>
      )}
    </section>
  )}
</Podstrona>

<style>
  /* plakietka stanu w banerze (jak dotąd): „realizowany” z kropką w kolorze działu */
  .gr-stan { background: var(--bg); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line); }
  .gr-trwa { box-shadow: inset 0 0 0 1.5px var(--ink); }
  .gr-trwa::before { content: ''; width: 8px; height: 8px; margin-right: 6px; border-radius: 50%; background: var(--accent); }

  /* dane projektu: pary etykieta–wartość (wzorzec dl.para) w stopniu tekstu z danymi */
  :global(.z-grant) dl.fakty { gap: 6px 18px; font-size: 15.5px; line-height: 1.55; }
  .fakty dd { overflow-wrap: anywhere; }
  .nr { font-variant-numeric: tabular-nums; letter-spacing: .01em; }
  .akcja { margin: 22px 0 0; }
  .opis { margin-top: 28px; }
  .opis > :global(:last-child) { margin-bottom: 0; }

  /* inne projekty zakładu: wiersze jak zakończone projekty w Projektach i grantach (tytuł Brygadą, linia pod nim) */
  .inne { list-style: none; margin: 0; padding: 0; }
  .inne li { max-width: none; margin: 0; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: inherit; line-height: 1.3; }
  .inne li:first-child { border-top: 1px solid var(--line); }
  .inne .t { font-family: var(--f-display); font-size: 17.5px; line-height: 1.3; color: var(--ink); text-decoration: none; }
  .inne .kont { display: block; margin-top: 3px; font-size: 13.5px; line-height: 1.55; color: var(--muted); }
  .klik { position: relative; }
  .klik .t::before { content: ''; position: absolute; inset: 0; } /* nakładka na ::before — ::after to strzałka ↗ linku poza stronę */
  .klik:hover .t { color: var(--d-a); }
  .klik .t:focus-visible { outline: none; }
  .klik:has(.t:focus-visible) { outline: 3px solid var(--d-a); outline-offset: 4px; border-radius: 2px; }
  .wszystkie { margin: 16px 0 0; font-weight: 600; }

  /* ---------- telefon (≤ 760 px) ---------- */
  @media (max-width: 760px) {
    .tags { margin-top: 12px; }
    .inne .t { font-size: 17px; }
  }
</style>
