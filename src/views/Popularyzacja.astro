---
// Strona działu „Popularyzacja” (/popularyzacja, /en/popularyzacja): baner działu z latami tradycji, pod nim blok TrescDzialu —
// podstrony w grupach jak w menu, „O popularyzacji” z „W skrócie”, karty „Dla kogo” (po jednej na stronę działu).
// Dane: src/data/popularyzacja.json i nagłówki stron src/content/strony/popularyzacja/ (edycja w Pages CMS, repozytorium
// Web-Popularyzacja). Jedna wersja HTML: komputer i telefon (≤ 1023 px, jedna kolumna) — src/styles/zal-dzialy.css.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import TrescDzialu from '../components/zal/TrescDzialu.astro';
import Sekcja from '../components/zal/dzial/Sekcja.astro';
import { u } from '../lib/url';
import { wJezyku, bezSierotek } from '../lib/i18n';
import type { Lang } from '../lib/daty';
import { danePopularyzacji } from '../lib/widoki/popularyzacja';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const { tytul, lead, haslo, liczby, grupy, akapity, fakty, karty } = await danePopularyzacji(lang);
---
<Baza tytul={tytul} opis={lead || undefined} uklad="zwarta portal-baner">
  <NaglowekStrony tytul={tytul} lead={lead || undefined} haslo={haslo || undefined} lang={lang} okruszki={[{ etykieta: tytul }]}>
    {liczby.length > 0 && (
      <ul class="pt-liczby">
        {liczby.map((x) => <li><span class="n">{x.n}</span>{bezSierotek(x.l)}</li>)}
      </ul>
    )}
  </NaglowekStrony>
  <TrescDzialu dzial="popularyzacja" lang={lang} grupy={grupy} tekst={{ tytul: T('O popularyzacji', 'About outreach'), akapity, fakty }}>
    {karty.length > 0 && (
      <Sekcja id="z-dz-dla-kogo" tytul={T('Dla kogo', 'Who it’s for')} lang={lang}>
        <div class="z-dz-kart">
          {karty.map((k) => (
            <article class="z-dz-klik">
              <div class="gora">{k.nazwa}</div>
              <h3><a href={u(wJezyku(k.adres, lang))}>{k.tytul}</a></h3>
              {k.opis && <p>{k.opis}</p>}
            </article>
          ))}
        </div>
      </Sekcja>
    )}
  </TrescDzialu>
</Baza>
