---
// Wykaz prac z jednego roku: /nauka/publikacje/RRRR (dla każdego pliku src/data/publikacje/RRRR.json).
import PublikacjeRok from '../../../views/PublikacjeRok.astro';
import { wykazy } from '../../../views/publikacjeDane';
export function getStaticPaths() {
  return Object.keys(wykazy).map((rok) => ({ params: { rok }, props: { rok: Number(rok) } }));
}
const { rok } = Astro.props;
---
<PublikacjeRok rok={rok} lang="pl" />
