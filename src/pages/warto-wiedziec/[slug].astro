---
// Podstrona pozycji „Warto wiedzieć” — tylko dla pozycji z treścią (i widocznych: zlecenie 33, flaga TYLKO_OPUBLIKOWANE).
import { getCollection } from 'astro:content';
import WartoWiedziecWpis from '../../views/WartoWiedziecWpis.astro';
import { slugOf, widoczny } from '../../lib/tresci';
export async function getStaticPaths() {
  const wpisy = (await getCollection('warto_wiedziec')).filter((w) => widoczny(w) && w.body?.trim());
  return wpisy.map((wpis) => ({ params: { slug: slugOf(wpis.id) }, props: { wpis } }));
}
const { wpis } = Astro.props;
---
<WartoWiedziecWpis wpis={wpis} lang="pl" />
