---
// Jedna strona 404 dla obu wersji, więc nagłówek, opis i przyciski są w obu językach naraz (decyzja D15, zlecenie 16).
// Gość z adresu /en/… dostaje linki do angielskiej strony głównej i wyszukiwarki (skrypt na końcu).
import Baza from '../layouts/Baza.astro';
import Link from '../components/Link.astro';
import ustawienia from '../data/ustawienia.json';
import { u } from '../lib/url';
import { t } from '../lib/i18n';
---
{/* poza indeksem (noindex, bez canonical, bez Pagefind), ale bez paska „Podgląd” — strona jest opublikowana (zlecenie 01) */}
<Baza tytul={`${t('pl', 'nieZnaleziono')} · ${t('en', 'nieZnaleziono')}`} pozaIndeksem alternatywa={null} szukaj={false}>
  <div class="wrap" style="padding-top:64px;padding-bottom:96px">
    <p class="badge" style="margin:0 0 12px">404</p>
    <h1 style="font-size:clamp(32px,5vw,48px);margin:0 0 12px">{t('pl', 'nieZnaleziono')} · <span lang="en">{t('en', 'nieZnaleziono')}</span></h1>
    <p style="font-size:18px;max-width:760px">{t('pl', 'nieZnalezionoOpis')}</p>
    <p lang="en" class="muted">{t('en', 'nieZnalezionoOpis')}</p>
    <div class="btn-row" style="margin-top:24px">
      <a class="btn btn-primary" href={u('/')} data-en={u('/en/')}>{t('pl', 'powrot')} · <span lang="en">{t('en', 'powrot')}</span></a>
      <a class="btn" href={u('/szukaj')} data-en={u('/en/szukaj')}>{t('pl', 'szukajNaStronie')} · <span lang="en">{t('en', 'szukajNaStronie')}</span></a>
      <Link class="btn" href={ustawienia.archiwum}>{t('pl', 'archiwum')} · <span lang="en">{t('en', 'archiwum')}</span></Link>
    </div>
  </div>
  <script is:inline>
    if (/\/en(\/|$)/.test(location.pathname)) document.querySelectorAll('a[data-en]').forEach(function (a) { a.href = a.dataset.en; });
  </script>
</Baza>
